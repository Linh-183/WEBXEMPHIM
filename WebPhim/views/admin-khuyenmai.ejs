<%- include('partials/admin-header') %>

<%
  const currentTab = (typeof tab !== 'undefined' && tab) ? tab : 'voucher';
  const allVouchers = (typeof vouchers !== 'undefined' && Array.isArray(vouchers)) ? vouchers : [];
  const allFlashSales = (typeof flashSales !== 'undefined' && Array.isArray(flashSales)) ? flashSales : [];
  const allMovies = (typeof movies !== 'undefined' && Array.isArray(movies)) ? movies : [];
%>

<main class="p-6 sm:p-10 space-y-8 max-w-7xl">
  
  <!-- Header Title -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-[#E5E0D5]">
    <div>
      <span class="archival-index">MARKETING, VOUCHER & KHUNG GIỜ VÀNG</span>
      <h1 class="editorial-headline text-3xl font-bold mt-1">Quản Lý Voucher & Flash Sale</h1>
      <p class="text-xs text-[#7A7E8B] mt-0.5 font-light">Tạo mã ưu đãi, kiểm soát tỷ lệ giảm và chủ động thiết lập các đợt săn vé Flash Sale tại 3 rạp Quy Nhơn.</p>
    </div>

    <!-- Tab Switcher -->
    <div class="flex items-center gap-2 font-['JetBrains_Mono'] text-xs">
      <button type="button" 
              onclick="switchAdminPromoTab('voucher')" 
              id="tab-btn-voucher"
              class="px-4 py-2 font-bold uppercase tracking-wider transition-all <%= currentTab === 'voucher' ? 'bg-[#121316] text-white' : 'bg-white border border-[#E5E0D5] text-[#474A54] hover:text-[#121316]' %>">
        1. Mã Voucher (<%= allVouchers.length %>)
      </button>
      <button type="button" 
              onclick="switchAdminPromoTab('flashsale')" 
              id="tab-btn-flashsale"
              class="px-4 py-2 font-bold uppercase tracking-wider transition-all <%= currentTab === 'flashsale' ? 'bg-[#121316] text-white' : 'bg-white border border-[#E5E0D5] text-[#474A54] hover:text-[#121316]' %>">
        2. Sự Kiện Flash Sale (<%= allFlashSales.length %>)
      </button>
    </div>
  </div>

  <!-- =========================================================================
       SECTION 1: QUẢN LÝ VOUCHER KHUYẾN MÃI
       ========================================================================= -->
  <div id="section-tab-voucher" class="<%= currentTab === 'voucher' ? '' : 'hidden' %> grid grid-cols-1 lg:grid-cols-12 gap-8 text-xs font-['Plus_Jakarta_Sans']">
    
    <!-- LEFT 5 COLS: FORM TẠO VOUCHER MỚI -->
    <div class="lg:col-span-5 bg-white border border-[#E5E0D5] p-6 space-y-4 shadow-sm">
      <h2 class="font-['Playfair_Display','Merriweather',Georgia,serif] text-sm font-bold text-[#121316] uppercase tracking-wider pb-3 border-b border-[#E5E0D5]">
        Phát Hành Voucher Mới
      </h2>

      <form action="/admin/vouchers/add" method="POST" class="space-y-4">
        <div>
          <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
            Mã Voucher (Code) <span class="text-[#BA2D27]">*</span>
          </label>
          <input name="code" required placeholder="CINEGO50" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] uppercase font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
        </div>

        <div>
          <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
            Tiêu đề chiến dịch <span class="text-[#BA2D27]">*</span>
          </label>
          <input name="title" required placeholder="Giảm 50K cho đơn từ 150K" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-bold focus:outline-none focus:border-[#121316]" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Loại giảm</label>
            <select name="discountType" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] font-semibold focus:outline-none focus:border-[#121316]">
              <option value="percentage">Giảm theo %</option>
              <option value="fixed">Giảm tiền mặt (K)</option>
            </select>
          </div>
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Mức giảm</label>
            <input name="discountValue" required placeholder="20 hoặc 50" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Đơn tối thiểu (K)</label>
            <input name="minOrderValue" value="100" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          </div>
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Giảm tối đa (K)</label>
            <input name="maxDiscountValue" value="50" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          </div>
        </div>

        <div>
          <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Ngày hết hạn</label>
          <input name="expiryDate" type="date" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2 text-xs text-[#121316] font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
        </div>

        <button type="submit" class="btn-editorial-primary w-full py-3 text-xs font-bold uppercase tracking-wider block text-center !bg-[#BA2D27]">
          TẠO MÃ VOUCHER MỚI →
        </button>
      </form>
    </div>

    <!-- RIGHT 7 COLS: DANH SÁCH VOUCHER ĐANG CHẠY -->
    <div class="lg:col-span-7 bg-white border border-[#E5E0D5] p-6 space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-3">
        <h2 class="font-['Playfair_Display','Merriweather',Georgia,serif] text-sm font-bold text-[#121316] uppercase tracking-wider">
          Danh Mục Voucher Đang Hoạt Động
        </h2>
        <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">
          <%= allVouchers.length %> CHIẾN DỊCH
        </span>
      </div>

      <div class="space-y-3">
        <% if (allVouchers.length > 0) { %>
          <% allVouchers.forEach(v => { %>
            <div class="p-4 bg-[#FAF8F5] border border-[#E5E0D5] flex items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="font-['Playfair_Display','Merriweather',Georgia,serif] font-black text-sm text-[#121316]"><%= v.code %></span>
                  <span class="px-1.5 py-0.5 bg-[#121316] text-white text-[9px] font-['JetBrains_Mono'] font-bold">
                    <%= v.discountType === 'percentage' ? (v.discountValue + '%') : ((v.discountValue/1000) + 'K') %>
                  </span>
                </div>
                <p class="text-xs text-[#474A54]"><%= v.title %></p>
                <div class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">
                  Hạn: <%= v.expiryDate ? new Date(v.expiryDate).toLocaleDateString('vi-VN') : 'Vô thời hạn' %>
                  • Đơn từ: <%= (v.minOrderValue || 0).toLocaleString('vi-VN') %>đ
                </div>
              </div>

              <form action="/admin/vouchers/delete/<%= v._id %>" method="POST" onsubmit="return confirm('Bạn muốn xóa voucher này?')">
                <button type="submit" class="text-xs font-['JetBrains_Mono'] font-bold text-[#BA2D27] hover:underline px-2 py-1">
                  Xóa
                </button>
              </form>
            </div>
          <% }); %>
        <% } else { %>
          <div class="p-8 bg-[#FAF8F5] border border-[#E5E0D5] text-center text-[#7A7E8B] font-['JetBrains_Mono'] text-xs">
            Chưa có voucher nào trong hệ thống.
          </div>
        <% } %>
      </div>
    </div>

  </div>

  <!-- =========================================================================
       SECTION 2: QUẢN LÝ CÁC ĐỢT SĂN VÉ FLASH SALE (ĐỘC LẬP)
       ========================================================================= -->
  <div id="section-tab-flashsale" class="<%= currentTab === 'flashsale' ? '' : 'hidden' %> grid grid-cols-1 lg:grid-cols-12 gap-8 text-xs font-['Plus_Jakarta_Sans']">
    
    <!-- LEFT 5 COLS: FORM THIẾT LẬP FLASH SALE MỚI -->
    <div class="lg:col-span-5 bg-white border border-[#E5E0D5] p-6 space-y-4 shadow-sm">
      <div class="border-b border-[#E5E0D5] pb-3">
        <h2 class="font-['Playfair_Display','Merriweather',Georgia,serif] text-sm font-bold text-[#121316] uppercase tracking-wider">
          Thiết Lập Đợt Flash Sale Mới
        </h2>
        <p class="text-[11px] text-[#7A7E8B] mt-0.5">Chỉ khi Admin kích hoạt thì trên web mới xuất hiện thông tin Flash Sale.</p>
      </div>

      <form action="/admin/flash-sale/add" method="POST" class="space-y-4">
        <div>
          <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
            Tiêu đề đợt Flash Sale <span class="text-[#BA2D27]">*</span>
          </label>
          <input name="title" required placeholder="Ví dụ: Săn Vé Đồng Giá 19K — Khung Giờ Trưa" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-bold focus:outline-none focus:border-[#121316]" />
        </div>

        <div>
          <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
            Áp dụng cho phim (Chọn từ CSDL của bạn)
          </label>
          <select name="movieId" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-semibold focus:outline-none focus:border-[#121316]">
            <option value="">-- Áp dụng cho mọi phim đang chiếu --</option>
            <% allMovies.forEach(m => { %>
              <option value="<%= m._id %>"><%= m.title %></option>
            <% }); %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Giá Flash Sale (VNĐ) <span class="text-[#BA2D27]">*</span>
            </label>
            <input name="salePrice" type="number" required value="19000" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#BA2D27] font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          </div>
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Giá vé gốc (VNĐ)
            </label>
            <input name="originalPrice" type="number" value="95000" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#7A7E8B] font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Số lượng vé mở bán <span class="text-[#BA2D27]">*</span>
            </label>
            <input name="totalQuantity" type="number" required value="50" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          </div>
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Mã Voucher phát <span class="text-[#BA2D27]">*</span>
            </label>
            <input name="voucherCode" required value="FLASH19K" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] uppercase font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Bắt đầu lúc <span class="text-[#BA2D27]">*</span>
            </label>
            <input name="startTime" type="datetime-local" required class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
          </div>
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Kết thúc lúc <span class="text-[#BA2D27]">*</span>
            </label>
            <input name="endTime" type="datetime-local" required class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
          </div>
        </div>

        <div>
          <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
            Ghi chú điều kiện
          </label>
          <input name="description" placeholder="Áp dụng tại 3 cụm rạp Quy Nhơn, mỗi tài khoản nhận 1 mã." class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2 text-xs text-[#121316] focus:outline-none focus:border-[#121316]" />
        </div>

        <button type="submit" class="btn-editorial-primary w-full py-3 text-xs font-bold uppercase tracking-wider block text-center !bg-[#BA2D27]">
          TẠO ĐỢT FLASH SALE MỚI →
        </button>
      </form>
    </div>

    <!-- RIGHT 7 COLS: DANH SÁCH CÁC ĐỢT FLASH SALE -->
    <div class="lg:col-span-7 bg-white border border-[#E5E0D5] p-6 space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-3">
        <h2 class="font-['Playfair_Display','Merriweather',Georgia,serif] text-sm font-bold text-[#121316] uppercase tracking-wider">
          Danh Sách Các Đợt Flash Sale
        </h2>
        <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">
          <%= allFlashSales.length %> CHƯƠNG TRÌNH
        </span>
      </div>

      <div class="space-y-4">
        <% if (allFlashSales.length > 0) { %>
          <% allFlashSales.forEach(fs => { %>
            <% 
              const now = new Date();
              const isRunning = fs.isActive && now >= new Date(fs.startTime) && now <= new Date(fs.endTime);
              const isUpcoming = fs.isActive && now < new Date(fs.startTime);
              const isEnded = !fs.isActive || now > new Date(fs.endTime);
            %>
            <div class="p-5 bg-[#FAF8F5] border border-[#E5E0D5] space-y-3">
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="font-['Playfair_Display','Merriweather',Georgia,serif] font-bold text-base text-[#121316]">
                      <%= fs.title %>
                    </span>
                    <% if (isRunning) { %>
                      <span class="px-2 py-0.5 bg-[#BA2D27] text-white text-[9px] font-['JetBrains_Mono'] font-bold uppercase animate-pulse">
                        ● ĐANG DIỄN RA
                      </span>
                    <% } else if (isUpcoming) { %>
                      <span class="px-2 py-0.5 bg-[#A6853B] text-white text-[9px] font-['JetBrains_Mono'] font-bold uppercase">
                        SẮP BẮT ĐẦU
                      </span>
                    <% } else { %>
                      <span class="px-2 py-0.5 bg-[#7A7E8B] text-white text-[9px] font-['JetBrains_Mono'] font-bold uppercase">
                        ĐÃ KẾT THÚC / TẮT
                      </span>
                    <% } %>
                  </div>

                  <p class="text-xs text-[#474A54]">
                    Áp dụng: <strong><%= fs.movie ? fs.movie.title : 'Mọi phim chiếu rạp' %></strong>
                    • Mã voucher: <code class="font-['JetBrains_Mono'] font-bold text-[#BA2D27]"><%= fs.voucherCode %></code>
                  </p>
                </div>

                <div class="text-right">
                  <span class="text-base font-black text-[#BA2D27] font-['JetBrains_Mono']">
                    <%= (fs.salePrice || 19000).toLocaleString('vi-VN') %> đ
                  </span>
                  <span class="text-[10px] text-[#7A7E8B] line-through block font-['JetBrains_Mono']">
                    <%= (fs.originalPrice || 95000).toLocaleString('vi-VN') %> đ
                  </span>
                </div>
              </div>

              <!-- Metrics Strip -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 border-t border-[#E5E0D5] font-['JetBrains_Mono'] text-[11px] text-[#7A7E8B]">
                <div>
                  <span>Bắt đầu:</span>
                  <strong class="text-[#121316] block"><%= new Date(fs.startTime).toLocaleString('vi-VN') %></strong>
                </div>
                <div>
                  <span>Kết thúc:</span>
                  <strong class="text-[#121316] block"><%= new Date(fs.endTime).toLocaleString('vi-VN') %></strong>
                </div>
                <div>
                  <span>Số lượng:</span>
                  <strong class="text-[#121316] block"><%= fs.claimedQuantity %> / <%= fs.totalQuantity %> vé</strong>
                </div>
                <div>
                  <span>Trạng thái:</span>
                  <strong class="<%= fs.isActive ? 'text-[#10B981]' : 'text-[#BA2D27]' %> block">
                    <%= fs.isActive ? 'Đang Bật' : 'Đã Tắt' %>
                  </strong>
                </div>
              </div>

              <!-- Control actions -->
              <div class="flex items-center justify-end gap-3 pt-2 border-t border-[#E5E0D5]">
                <form action="/admin/flash-sale/toggle/<%= fs._id %>" method="POST">
                  <button type="submit" class="text-xs font-['JetBrains_Mono'] font-semibold <%= fs.isActive ? 'text-[#D97706]' : 'text-[#10B981]' %> hover:underline">
                    <%= fs.isActive ? 'Tạm Tắt' : 'Kích Hoạt Lại' %>
                  </button>
                </form>
                <form action="/admin/flash-sale/delete/<%= fs._id %>" method="POST" onsubmit="return confirm('Bạn muốn xóa đợt flash sale này?')">
                  <button type="submit" class="text-xs font-['JetBrains_Mono'] font-bold text-[#BA2D27] hover:underline">
                    Xóa Đợt Này
                  </button>
                </form>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="p-8 bg-[#FAF8F5] border border-[#E5E0D5] text-center text-[#7A7E8B] font-['JetBrains_Mono'] text-xs space-y-2">
            <span class="material-symbols-outlined text-3xl">bolt</span>
            <p>Chưa có đợt Flash Sale nào được tạo. Tạo đợt mới ở cột bên trái để mở bán vé ưu đãi trên website.</p>
          </div>
        <% } %>
      </div>
    </div>

  </div>

</main>

<script>
  function switchAdminPromoTab(tab) {
    const secVoucher = document.getElementById('section-tab-voucher');
    const secFlash = document.getElementById('section-tab-flashsale');
    const btnVoucher = document.getElementById('tab-btn-voucher');
    const btnFlash = document.getElementById('tab-btn-flashsale');

    if (tab === 'voucher') {
      secVoucher.classList.remove('hidden');
      secFlash.classList.add('hidden');
      btnVoucher.className = "px-4 py-2 font-bold uppercase tracking-wider transition-all bg-[#121316] text-white";
      btnFlash.className = "px-4 py-2 font-bold uppercase tracking-wider transition-all bg-white border border-[#E5E0D5] text-[#474A54] hover:text-[#121316]";
    } else {
      secFlash.classList.remove('hidden');
      secVoucher.classList.add('hidden');
      btnFlash.className = "px-4 py-2 font-bold uppercase tracking-wider transition-all bg-[#121316] text-white";
      btnVoucher.className = "px-4 py-2 font-bold uppercase tracking-wider transition-all bg-white border border-[#E5E0D5] text-[#474A54] hover:text-[#121316]";
    }
  }
</script>

<%- include('partials/admin-footer') %>

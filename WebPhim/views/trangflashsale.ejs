<%- include('partials/header') %>

<%
  const activeList = (typeof activeSales !== 'undefined' && Array.isArray(activeSales)) ? activeSales : [];
  const upcomingList = (typeof upcomingSales !== 'undefined' && Array.isArray(upcomingSales)) ? upcomingSales : [];
%>

<main class="min-h-screen py-12 pb-24 bg-[#FAF8F5]">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Masthead -->
    <div class="pb-8 border-b border-[#E5E0D5] mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="archival-index">SỰ KIỆN SĂN VÉ CINEGO</span>
        <h1 class="editorial-headline mt-1">Khung Giờ Vàng Flash Sale</h1>
        <p class="text-xs text-[#7A7E8B] mt-1.5 font-light max-w-xl">
          Cơ hội săn vé xem phim giá đặc quyền tại 3 cụm rạp Quy Nhơn: CGV Kim Cúc Plaza, Starlight Nguyễn Kim và DCine Phú Tài.
        </p>
      </div>

      <div class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">
        QUY TẮC: <strong class="text-[#BA2D27]">1 TÀI KHOẢN / 1 VÉ TRONG 1 ĐỢT</strong>
      </div>
    </div>

    <!-- Active Slot Banner Section -->
    <% if (activeList.length > 0) { %>
      <% activeList.forEach(sale => { %>
        <%
          const percent = Math.min(100, Math.round((sale.claimedQuantity / (sale.totalQuantity || 50)) * 100));
          const diffMs = Math.max(0, new Date(sale.endTime) - new Date());
          const diffSec = Math.floor(diffMs / 1000);
        %>
        <div class="bg-white border-2 border-[#121316] p-8 sm:p-12 mb-12 shadow-lg">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <div class="lg:col-span-8 space-y-4">
              <div class="flex items-center gap-2 font-['JetBrains_Mono'] text-xs text-[#BA2D27]">
                <span class="w-2.5 h-2.5 rounded-full bg-[#BA2D27] animate-ping"></span>
                <span class="font-bold">ĐANG MỞ BÁN: <%= new Date(sale.startTime).toLocaleTimeString('vi-VN', {hour: '2-digit', minute: '2-digit'}) %> — <%= new Date(sale.endTime).toLocaleTimeString('vi-VN', {hour: '2-digit', minute: '2-digit'}) %></span>
              </div>

              <h2 class="font-serif text-3xl sm:text-5xl font-bold text-[#121316] leading-tight">
                <%= sale.title %>
              </h2>

              <p class="text-xs text-[#474A54] leading-relaxed max-w-xl">
                <%= sale.description || 'Áp dụng cho mọi suất chiếu phim trong tuần tại các cụm rạp Quy Nhơn. Số lượng có hạn!' %>
              </p>

              <div class="flex flex-wrap items-center gap-4 text-xs font-['JetBrains_Mono'] text-[#10B981] font-semibold pt-1">
                <span>✓ Phim áp dụng: <strong class="text-[#121316]"><%= sale.movie ? sale.movie.title : 'Tất cả các phim' %></strong></span>
                <span>✓ Áp dụng tại: <strong class="text-[#121316]"><%= sale.cinema || '3 cụm rạp Quy Nhơn' %></strong></span>
              </div>

              <div class="pt-3 flex items-center gap-4">
                <button type="button" 
                        onclick="claimFlashVoucher('<%= sale._id %>', '<%= sale.voucherCode %>')" 
                        class="btn-editorial-primary text-xs !py-3 !px-8 font-bold">
                  NHẬN MÃ <%= sale.voucherCode %> (<%= (sale.salePrice / 1000) %>K) VÀO VÍ →
                </button>
                <a href="/phim" class="btn-editorial-secondary text-xs !py-3 !px-5 font-['JetBrains_Mono']">
                  Xem Lịch Chiếu
                </a>
              </div>
            </div>

            <div class="lg:col-span-4 bg-[#FAF8F5] border border-[#E5E0D5] p-6 text-center space-y-4">
              <span class="text-[10px] font-bold text-[#7A7E8B] uppercase tracking-widest block font-['JetBrains_Mono']">
                Thời gian còn lại của đợt
              </span>
              <div class="flex items-center justify-center gap-2" data-seconds="<%= diffSec %>">
                <div class="flash-countdown-box countdown-h">--</div>
                <span class="text-[#121316] font-bold">:</span>
                <div class="flash-countdown-box countdown-m">--</div>
                <span class="text-[#121316] font-bold">:</span>
                <div class="flash-countdown-box countdown-s">--</div>
              </div>

              <!-- Stock Indicator -->
              <div class="space-y-1.5 pt-2">
                <div class="flex justify-between text-[11px] font-['JetBrains_Mono'] font-bold text-[#474A54]">
                  <span>Đã nhận: <%= sale.claimedQuantity %>/<%= sale.totalQuantity %></span>
                  <span class="text-[#BA2D27]"><%= percent %>%</span>
                </div>
                <div class="w-full bg-[#E5E0D5] h-1.5">
                  <div class="bg-[#BA2D27] h-full" style="width: <%= percent %>%;"></div>
                </div>
              </div>
            </div>

          </div>
        </div>
      <% }); %>
    <% } else { %>
      <!-- Empty State khi không có đợt Flash Sale nào đang mở bán -->
      <div class="bg-white border border-[#E5E0D5] p-12 mb-12 text-center space-y-4">
        <div class="w-16 h-16 mx-auto bg-[#FAF8F5] border border-[#E5E0D5] flex items-center justify-center text-[#7A7E8B]">
          <span class="material-symbols-outlined text-3xl">bolt</span>
        </div>
        <div class="space-y-1 max-w-md mx-auto">
          <h2 class="font-serif text-xl font-bold text-[#121316]">
            Hiện Chưa Có Đợt Flash Sale Nào Đang Mở Bán
          </h2>
          <p class="text-xs text-[#7A7E8B]">
            Các chương trình Flash Sale được mở bán theo các khung giờ đặc biệt. Quý khách vui lòng xem lịch các đợt tiếp theo bên dưới hoặc đặt vé thông thường.
          </p>
        </div>
        <div class="pt-2">
          <a href="/phim" class="btn-editorial-primary text-xs !py-2.5 !px-6 inline-block">
            Xem Phim Đang Chiếu Rạp Hôm Nay →
          </a>
        </div>
      </div>
    <% } %>

    <!-- Upcoming Slots Schedule -->
    <div class="space-y-4">
      <h3 class="font-serif text-base font-bold text-[#121316] uppercase tracking-wider pb-2 border-b border-[#E5E0D5]">
        Lịch Các Đợt Flash Sale Tiếp Theo
      </h3>

      <% if (upcomingList.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <% upcomingList.forEach(sale => { %>
            <div class="bg-white border border-[#E5E0D5] p-6 space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-['JetBrains_Mono'] text-xs font-bold text-[#A6853B] uppercase">
                  <%= sale.movie ? sale.movie.title : 'PHIM CHIẾU RẠP' %>
                </span>
                <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">
                  <%= new Date(sale.startTime).toLocaleString('vi-VN', {day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit'}) %>
                </span>
              </div>
              <h4 class="font-serif text-2xl font-bold text-[#121316]">
                <%= sale.title %> — Chỉ <%= (sale.salePrice || 19000).toLocaleString('vi-VN') %>đ
              </h4>
              <p class="text-xs text-[#7A7E8B]"><%= sale.description || 'Ưu đãi đặc biệt áp dụng tại 3 cụm rạp Quy Nhơn.' %></p>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="bg-white border border-[#E5E0D5] p-6 text-center text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">
          Chưa có đợt Flash Sale sắp tới nào được lên lịch. Vui lòng quay lại sau!
        </div>
      <% } %>
    </div>

  </div>
</main>

<script>
  function claimFlashVoucher(saleId, code) {
    fetch('/api/nhan-flash-voucher', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ saleId })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        if (window.cinegoToast) window.cinegoToast.success(data.message);
        else alert(data.message);
      } else {
        if (window.cinegoToast) window.cinegoToast.error(data.message || 'Không thể nhận voucher');
        else alert(data.message || 'Không thể nhận voucher');
      }
    })
    .catch(err => {
      if (window.cinegoToast) window.cinegoToast.error('Vui lòng đăng nhập để nhận mã Flash Sale!');
      else alert('Vui lòng đăng nhập để nhận mã Flash Sale!');
    });
  }

  // Khởi động bộ đếm thời gian cho các đợt Flash Sale đang chạy
  document.querySelectorAll('[data-seconds]').forEach(el => {
    let s = parseInt(el.dataset.seconds, 10) || 3600;
    const hEl = el.querySelector('.countdown-h');
    const mEl = el.querySelector('.countdown-m');
    const sEl = el.querySelector('.countdown-s');

    function update() {
      if (s <= 0) {
        if (hEl) hEl.innerText = '00';
        if (mEl) mEl.innerText = '00';
        if (sEl) sEl.innerText = '00';
        return;
      }
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      const sec = s % 60;
      if (hEl) hEl.innerText = h.toString().padStart(2, '0');
      if (mEl) mEl.innerText = m.toString().padStart(2, '0');
      if (sEl) sEl.innerText = sec.toString().padStart(2, '0');
      s--;
    }
    update();
    setInterval(update, 1000);
  });
</script>

<%- include('partials/footer') %>

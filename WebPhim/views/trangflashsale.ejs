<%- include('partials/header') %>

<main class="min-h-screen py-12 pb-24 bg-[#FAF8F5]">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Masthead -->
    <div class="pb-8 border-b border-[#E5E0D5] mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="archival-index">SỰ KIỆN SĂN VÉ CINEGO</span>
        <h1 class="editorial-headline mt-1">Khung Giờ Vàng Flash Sale</h1>
        <p class="text-xs text-[#7A7E8B] mt-1.5 font-light max-w-xl">
          Cơ hội săn vé xem phim đồng giá 19.000đ tại 3 cụm rạp Quy Nhơn theo 2 khung giờ cố định mỗi ngày (12:00 & 20:00).
        </p>
      </div>

      <div class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">
        QUY TẮC: <strong class="text-[#BA2D27]">1 TÀI KHOẢN / 1 VÉ TRONG 1 ĐỢT</strong>
      </div>
    </div>

    <!-- Active Slot Banner -->
    <div class="bg-white border-2 border-[#121316] p-8 sm:p-12 mb-12 shadow-lg">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-8 space-y-4">
          <div class="flex items-center gap-2 font-['JetBrains_Mono'] text-xs text-[#BA2D27]">
            <span class="w-2.5 h-2.5 rounded-full bg-[#BA2D27] animate-ping"></span>
            <span class="font-bold">ĐỢT 1 HÔM NAY: 12:00 — 14:00</span>
          </div>

          <h2 class="font-['Georgia'] text-3xl sm:text-5xl font-bold text-[#121316] leading-tight">
            Vé Đồng Giá 19.000đ — CGV & Starlight & Dcine
          </h2>

          <p class="text-xs text-[#474A54] leading-relaxed max-w-xl">
            Áp dụng cho mọi suất chiếu phim 2D tiêu chuẩn trong tuần. Giới hạn 50 voucher cho đợt trưa nay. Mỗi tài khoản chỉ nhận 01 voucher.
          </p>

          <div class="flex items-center gap-4 text-xs font-['JetBrains_Mono'] text-[#10B981] font-semibold pt-1">
            <span>✓ Không phụ thu cuối tuần</span>
            <span>✓ Áp dụng tại cả 3 rạp Quy Nhơn</span>
          </div>

          <div class="pt-3">
            <button type="button" onclick="claimFlashVoucher()" class="btn-editorial-primary text-xs !py-3 !px-8 font-bold">
              NHẬN VOUCHER 19K VÀO VÍ NGAY →
            </button>
          </div>
        </div>

        <div class="lg:col-span-4 bg-[#FAF8F5] border border-[#E5E0D5] p-6 text-center space-y-4">
          <span class="text-[10px] font-bold text-[#7A7E8B] uppercase tracking-widest block font-['JetBrains_Mono']">
            Thời gian còn lại của đợt
          </span>
          <div class="flex items-center justify-center gap-2">
            <div class="flash-countdown-box" id="fs-hours">01</div>
            <span class="text-[#121316] font-bold">:</span>
            <div class="flash-countdown-box" id="fs-mins">24</div>
            <span class="text-[#121316] font-bold">:</span>
            <div class="flash-countdown-box" id="fs-secs">38</div>
          </div>

          <!-- Stock Indicator -->
          <div class="space-y-1.5 pt-2">
            <div class="flex justify-between text-[11px] font-['JetBrains_Mono'] font-bold text-[#474A54]">
              <span>Đã nhận: 42/50</span>
              <span class="text-[#BA2D27]">84%</span>
            </div>
            <div class="w-full bg-[#E5E0D5] h-1.5">
              <div class="bg-[#BA2D27] h-full w-[84%]"></div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Upcoming Slots Schedule -->
    <div class="space-y-4">
      <h3 class="font-['Georgia'] text-base font-bold text-[#121316] uppercase tracking-wider pb-2 border-b border-[#E5E0D5]">
        Lịch Các Đợt Flash Sale Tiếp Theo
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <div class="bg-white border border-[#E5E0D5] p-6 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-['JetBrains_Mono'] text-xs font-bold text-[#A6853B]">ĐỢT 2 (TỐI NAY)</span>
            <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">20:00 — 22:00</span>
          </div>
          <h4 class="font-['Georgia'] text-2xl font-bold text-[#121316]">Khung Giờ Vàng — Giảm 50% Combo F&B</h4>
          <p class="text-xs text-[#7A7E8B]">Tặng voucher giảm 50% khi mua kèm combo bắp nước cho mọi đơn vé trên 100.000đ.</p>
        </div>

        <div class="bg-white border border-[#E5E0D5] p-6 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-['JetBrains_Mono'] text-xs font-bold text-[#121316]">ĐỢT 1 (NGÀY MAI)</span>
            <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">12:00 — 14:00</span>
          </div>
          <h4 class="font-['Georgia'] text-2xl font-bold text-[#121316]">Vé Đồng Giá 19K — Phim Cuối Tuần</h4>
          <p class="text-xs text-[#7A7E8B]">Áp dụng cho các suất chiếu sớm phim bom tấn cuối tuần tại 3 rạp Quy Nhơn.</p>
        </div>

      </div>
    </div>

  </div>
</main>

<script>
  function claimFlashVoucher() {
    if (window.cinegoToast) {
      window.cinegoToast.success('Nhận voucher FLASH19K thành công! Mã đã được lưu vào ví voucher của bạn.');
    } else {
      alert('Nhận voucher thành công!');
    }
  }

  // Timer loop
  let s = 3600 + 24 * 60 + 38;
  setInterval(() => {
    s--;
    if (s < 0) s = 7200;
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    document.getElementById('fs-hours').innerText = h.toString().padStart(2, '0');
    document.getElementById('fs-mins').innerText = m.toString().padStart(2, '0');
    document.getElementById('fs-secs').innerText = sec.toString().padStart(2, '0');
  }, 1000);
</script>

<%- include('partials/footer') %>

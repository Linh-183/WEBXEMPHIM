<%- include('partials/header') %>

<main class="min-h-screen">
  
<%
  var rawMovies = (typeof movies !== 'undefined' && movies && Array.isArray(movies)) ? movies : [];
  var heroList = rawMovies;
%>

  <!-- =========================================================================
       1. THE CURATED MASTHEAD SPOTLIGHT (COMPACT POSTER HERO CAROUSEL)
       ========================================================================= -->
  <section id="heroCarouselSection" class="bg-[#0E1015] text-[#FAF8F5] border-b border-white/10 relative overflow-hidden">
    <div class="max-w-[1520px] mx-auto px-6 sm:px-10 lg:px-14 py-8 lg:py-12 relative z-10">
      <% if (heroList.length > 0) { %>
      <!-- Hero Slides Container (Khung cố định 100%, chống đổi kích cỡ khi chuyển phim) -->
      <div id="heroSlidesContainer" class="relative w-full h-[720px] sm:h-[660px] lg:h-[460px] overflow-hidden">
        <% heroList.forEach(function(item, idx) { %>
          <div class="hero-slide-item <%= idx === 0 ? 'opacity-100 pointer-events-auto z-10' : 'opacity-0 pointer-events-none z-0' %> absolute inset-0 w-full h-full flex items-center transition-opacity duration-500 ease-in-out" data-slide-index="<%= idx %>">
            <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
              
              <!-- Left Column: Editorial Information (Span 7) -->
              <div class="lg:col-span-7 space-y-4">
                
                <div class="flex items-center gap-3 font-['JetBrains_Mono'] text-xs">
                  <span class="px-2.5 py-1 bg-[#BA2D27] text-white font-bold tracking-wider uppercase">
                    TIÊU ĐIỂM CHIẾU RẠP QUY NHƠN
                  </span>
                  <span class="text-white/40">/</span>
                  <span class="px-2.5 py-1 bg-white/10 text-[#A6853B] border border-[#A6853B]/30 font-semibold tracking-wider uppercase">
                    PHIM 0<%= idx + 1 %> / 0<%= heroList.length %>
                  </span>
                </div>

                <div class="space-y-1">
                  <span class="font-['JetBrains_Mono'] text-[11px] tracking-[0.2em] font-semibold uppercase text-white/50 block">TÁC PHẨM ĐIỆN ẢNH ĐANG CHIẾU</span>
                  <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold leading-[1.18] tracking-tight text-[#FAF8F5] line-clamp-2">
                    <%= item.title %>
                  </h1>
                </div>

                <!-- Synopsis / Pull Quote with strict line clamp to prevent vertical expansion -->
                <p class="border-l-2 border-[#BA2D27] pl-4 py-1 text-sm text-[#C5C8D1] leading-relaxed max-w-xl font-normal line-clamp-3">
                  <%= item.description ? item.description : 'Một tác phẩm điện ảnh xuất sắc với hình ảnh choáng ngợp và kịch bản cuốn hút đang được công chiếu tại các rạp Quy Nhơn.' %>
                </p>

                <!-- Technical Ledger -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-3 border-y border-white/10 font-['JetBrains_Mono'] text-[11px] text-white/60">
                  <div>
                    <span class="block text-white/40 uppercase text-[10px]">Đạo diễn</span>
                    <span class="text-white font-medium truncate block"><%= item.director || 'Chưa cập nhật' %></span>
                  </div>
                  <div>
                    <span class="block text-white/40 uppercase text-[10px]">Thời lượng</span>
                    <span class="text-white font-medium"><%= item.duration || 120 %> Phút</span>
                  </div>
                  <div>
                    <span class="block text-white/40 uppercase text-[10px]">Phân loại</span>
                    <span class="text-[#BA2D27] font-bold"><%= item.ageRating || 'P' %></span>
                  </div>
                  <div>
                    <span class="block text-white/40 uppercase text-[10px]">Thể loại</span>
                    <span class="text-[#A6853B] font-medium truncate block"><%= item.genre || 'Điện ảnh' %></span>
                  </div>
                </div>

                <!-- Action Triggers -->
                <div class="flex flex-wrap items-center gap-4 pt-1">
                  <a href="/dat-ve/<%= item._id %>" class="btn-editorial-cinnabar text-xs !py-3 !px-6">
                    <span>Đặt Vé Suất Chiếu Ngay</span>
                    <span class="font-['JetBrains_Mono'] text-xs">→</span>
                  </a>
                  <button type="button" 
                          data-trailer="<%= item.trailerUrl || '' %>"
                          data-title="<%= item.title %> (Trailer)"
                          onclick="openTrailerModal(this.dataset.trailer, this.dataset.title)" 
                          class="btn-editorial-secondary !border-white/30 !text-white hover:!bg-white hover:!text-[#0E1015] text-xs !py-3 !px-5">
                    <span class="material-symbols-outlined text-base">play_circle</span>
                    <span>Xem Trailer</span>
                  </button>
                </div>

              </div>

              <!-- Right Column: Compact 3:4 Poster Canvas (Kích cỡ đứng im 100%, không co dãn, không nhảy vị trí) -->
              <div class="lg:col-span-5 flex justify-center lg:justify-end items-center" style="min-width: 320px;">
                <div class="cinego-hero-poster-frame bg-[#151820] border border-white/20 shadow-2xl" 
                     style="width: 320px; height: 426px; min-width: 320px; min-height: 426px; max-width: 320px; max-height: 426px; flex-shrink: 0; position: relative; overflow: hidden;">
                  <img src="<%= item.posterUrl || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=800&q=80' %>" 
                       alt="<%= item.title %>" 
                       class="filter brightness-[0.9] contrast-[1.05]" 
                       loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
                       fetchpriority="<%= idx === 0 ? 'high' : 'auto' %>"
                       decoding="async"
                       width="320"
                       height="426"
                       style="width: 320px; height: 426px; min-width: 320px; min-height: 426px; max-width: 320px; max-height: 426px; object-fit: cover; object-position: center; display: block; transform: none; transition: none;" />
                  
                  <div class="absolute inset-0 bg-gradient-to-t from-[#0E1015] via-transparent to-transparent opacity-80 pointer-events-none"></div>

                  <div class="absolute top-3 left-3 font-['JetBrains_Mono'] text-[9px] tracking-widest text-white/90 bg-black/70 backdrop-blur-sm px-2 py-0.5 border border-white/20">
                    TIÊU ĐIỂM NO. 0<%= idx + 1 %>
                  </div>

                  <div class="absolute bottom-3 left-3 right-3 p-3 bg-[#0E1015]/95 border border-white/15 backdrop-blur-md">
                    <span class="font-['JetBrains_Mono'] text-[9px] uppercase text-white/50 block mb-0.5">
                      CGV Kim Cúc • Starlight • DCine Quy Nhơn
                    </span>
                    <div class="flex items-center justify-between text-xs font-['JetBrains_Mono']">
                      <span class="text-white font-bold truncate max-w-[190px]"><%= item.title %></span>
                      <a href="/dat-ve/<%= item._id %>" class="text-[#BA2D27] hover:underline font-bold shrink-0 ml-2">Chọn Ghế →</a>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        <% }); %>
      </div>

      <!-- Carousel Nav Controls -->
      <div class="mt-6 pt-5 border-t border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <button type="button" id="btnHeroPrev" class="w-9 h-9 border border-white/20 bg-white/5 hover:bg-white hover:text-[#0E1015] text-white flex items-center justify-center transition-all cursor-pointer" aria-label="Phim trước">
            <span class="material-symbols-outlined text-base">arrow_back</span>
          </button>
          <button type="button" id="btnHeroNext" class="w-9 h-9 border border-white/20 bg-white/5 hover:bg-white hover:text-[#0E1015] text-white flex items-center justify-center transition-all cursor-pointer" aria-label="Phim tiếp">
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </button>
          <div class="flex items-center gap-2 ml-2" id="heroDotsNav">
            <% heroList.forEach(function(item, idx) { %>
              <button type="button" data-dot-index="<%= idx %>" class="hero-dot-btn w-7 h-1 transition-all cursor-pointer <%= idx === 0 ? 'bg-[#BA2D27]' : 'bg-white/20 hover:bg-white/50' %>" aria-label="Slide <%= idx + 1 %>"></button>
            <% }); %>
          </div>
        </div>

        <div class="text-[11px] font-['JetBrains_Mono'] text-white/40">
          CINEGO CURATED SELECTION 2026
        </div>
      </div>
      <% } else { %>
        <!-- Empty State khi CSDL chưa có phim -->
        <div class="py-16 text-center space-y-4 max-w-xl mx-auto">
          <span class="material-symbols-outlined text-5xl text-white/40">movie</span>
          <div class="space-y-1">
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white">
              Cơ Sở Dữ Liệu Hiện Chưa Có Phim
            </h2>
            <p class="text-xs text-white/60">
              Hệ thống hiện tại hiển thị danh mục phim từ cơ sở dữ liệu của bạn. Quản trị viên vui lòng truy cập Trang Quản Trị để đăng tải phim mới.
            </p>
          </div>
          <% if (typeof user !== 'undefined' && user && user.vaiTro === 'admin') { %>
            <div class="pt-2">
              <a href="/admin/phim/them" class="btn-editorial-primary text-xs !py-3 !px-6 inline-block">
                + Thêm Phim Mới Ngay
              </a>
            </div>
          <% } %>
        </div>
      <% } %>

    </div>
  </section>

  <!-- =========================================================================
       2. NOW SHOWING SPOTLIGHT (CÁC TÁC PHẨM ĐANG CHIẾU RẠP)
       ========================================================================= -->
  <section class="py-14 lg:py-20 px-6 sm:px-10 lg:px-14 border-b border-[#E5E0D5]">
    <div class="max-w-[1520px] mx-auto">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-[#E5E0D5] mb-10">
        <div>
          <span class="font-['JetBrains_Mono'] text-xs text-[#BA2D27] font-bold uppercase tracking-widest block">DANH MỤC KHỞI CHIẾU</span>
          <h2 class="font-serif text-2xl sm:text-4xl font-bold text-[#121316] mt-1">
            Tuyệt Tác Điện Ảnh Đang Chiếu
          </h2>
          <p class="text-xs text-[#7A7E8B] mt-1 font-normal">
            Lịch chiếu cập nhật thời gian thực tại cả 3 cụm rạp Quy Nhơn: CGV Kim Cúc, Starlight, DCine.
          </p>
        </div>
        <a href="/phim?status=DangChieu" class="text-xs font-bold font-['JetBrains_Mono'] uppercase tracking-wider text-[#121316] hover:text-[#BA2D27] inline-flex items-center gap-1.5 transition-colors">
          <span>Xem Toàn Bộ Lịch Chiếu</span>
          <span>→</span>
        </a>
      </div>

      <!-- Curated Movies Grid -->
      <% if (heroList.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <% heroList.forEach(function(m, idx) { %>
            <div class="bg-white border border-[#E5E0D5] flex flex-col justify-between group hover:border-[#121316] transition-all">
              <div>
                <div class="relative aspect-[3/4] bg-[#F3EFE6] overflow-hidden">
                  <img src="<%= m.posterUrl %>" alt="<%= m.title %>" class="w-full h-full object-cover transition-opacity group-hover:opacity-95" />
                  <span class="absolute top-3 left-3 px-2 py-0.5 bg-[#BA2D27] text-white font-['JetBrains_Mono'] text-[10px] font-bold uppercase">
                    <%= m.ageRating || 'P' %>
                  </span>
                  <span class="absolute top-3 right-3 px-2 py-0.5 bg-black/70 text-white font-['JetBrains_Mono'] text-[10px] backdrop-blur-sm">
                    <%= m.duration || 120 %>p
                  </span>
                </div>

                <div class="p-5 space-y-2">
                  <span class="text-[10px] font-['JetBrains_Mono'] text-[#A6853B] uppercase font-bold block">
                    <%= m.genre || 'Hành Động, Kịch Tính' %>
                  </span>
                  <h3 class="font-serif text-lg font-bold text-[#121316] leading-snug group-hover:text-[#BA2D27] transition-colors">
                    <a href="/chi-tiet-phim/<%= m._id %>"><%= m.title %></a>
                  </h3>
                  <p class="text-xs text-[#7A7E8B] line-clamp-2 leading-relaxed">
                    <%= m.description || 'Tác phẩm điện ảnh đáng xem nhất tại rạp tuần này.' %>
                  </p>
                </div>
              </div>

              <div class="p-5 pt-0 border-t border-[#E5E0D5] mt-4 flex items-center justify-between text-xs font-['JetBrains_Mono']">
                <div class="flex items-center gap-1.5">
                  <span class="text-[#7A7E8B]">Từ <strong class="text-[#121316]"><%= (m.price || 75000).toLocaleString('vi-VN') %>đ</strong></span>
                  <% if (m.originalPrice && m.originalPrice > (m.price || 75000)) { %>
                    <span class="text-[10px] text-[#A6AAB6] line-through"><%= m.originalPrice.toLocaleString('vi-VN') %>đ</span>
                  <% } %>
                </div>
                <a href="/dat-ve/<%= m._id %>" class="btn-editorial-primary text-xs !py-2 !px-4">
                  Đặt Vé →
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="bg-white border border-[#E5E0D5] p-12 text-center space-y-4">
          <span class="material-symbols-outlined text-4xl text-[#7A7E8B]">movie</span>
          <h3 class="font-serif text-xl font-bold text-[#121316]">
            Chưa có tác phẩm nào trong cơ sở dữ liệu
          </h3>
          <p class="text-xs text-[#7A7E8B] max-w-md mx-auto">
            Hệ thống chỉ hiển thị phim thực tế được lưu trữ trong cơ sở dữ liệu của bạn. Quản trị viên vui lòng thêm phim tại Bảng Quản Trị.
          </p>
          <% if (typeof user !== 'undefined' && user && user.vaiTro === 'admin') { %>
            <div class="pt-2">
              <a href="/admin/phim/them" class="btn-editorial-primary text-xs !py-2.5 !px-5 inline-block">
                + Thêm Phim Mới
              </a>
            </div>
          <% } %>
        </div>
      <% } %>

    </div>
  </section>

  <!-- =========================================================================
       3.5 CINEGO FLASH SALE CALLOUT SECTION
       ========================================================================= -->
  <section class="py-12 px-6 sm:px-10 lg:px-14 bg-[#121316] text-white border-b border-[#2A2E39]">
    <div class="max-w-[1520px] mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 bg-[#BA2D27] text-white font-['JetBrains_Mono'] text-[10px] font-bold uppercase tracking-wider animate-pulse">
            ⚡ KHUNG GIỜ VÀNG
          </span>
          <span class="text-[#A6853B] font-['JetBrains_Mono'] text-xs font-semibold">CINEGO FLASH SALE</span>
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white tracking-wide">
          Săn Vé Xem Phim Đồng Giá 19K & Voucher Giờ Vàng
        </h2>
        <p class="text-xs text-[#A6AAB6] max-w-2xl leading-relaxed">
          Mỗi ngày hệ thống CineGo mở bán các suất vé đồng giá và voucher ưu đãi trong khung giờ vàng cố định với số lượng có hạn. Nhanh tay săn vé trước khi hết suất!
        </p>
      </div>
      <div class="shrink-0 flex items-center gap-4">
        <a href="/flash-sale" class="btn-editorial-primary text-xs !py-3.5 !px-8 font-bold !bg-[#BA2D27] hover:!bg-[#8E1F1A] transition-colors whitespace-nowrap flex items-center gap-2">
          <span>⚡ KHÁM PHÁ FLASH SALE</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. CONCESSIONS & POPCORN SHOWCASE (QUẦY BẮP NƯỚC RIÊNG CỦA RẠP)
       ========================================================================= -->
  <section class="py-14 lg:py-20 px-6 sm:px-10 lg:px-14 bg-[#F3EFE6] border-b border-[#E5E0D5]">
    <div class="max-w-[1520px] mx-auto">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Left: Editorial Pitch (Span 5) -->
        <div class="lg:col-span-5 space-y-6">
          <div class="flex items-center gap-2 font-['JetBrains_Mono'] text-xs text-[#A6853B]">
            <span class="w-2 h-2 rounded-full bg-[#A6853B]"></span>
            <span class="uppercase tracking-widest font-bold">CINEGO GOURMET CONCESSIONS</span>
          </div>

          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#121316] leading-tight">
            Quầy Bắp Nước & Đồ Ăn Nhẹ Trực Tuyến
          </h2>

          <p class="text-sm text-[#474A54] leading-relaxed font-normal">
            Không cần phải mua vé xem phim, bạn vẫn có thể đặt trước các combo bắp rang bơ nóng giòn vị phô mai, caramel, xúc xích nướng và nước giải khát để nhận nhanh tại quầy concessions hoặc mang về nhà thưởng thức!
          </p>

          <div class="space-y-3 font-['Plus_Jakarta_Sans'] text-xs">
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-[#10B981] text-white flex items-center justify-center font-bold text-[10px]">✓</span>
              <span class="text-[#121316] font-medium">Bắp nổ nóng hổi tại chỗ, hạt ngô nhập khẩu Mỹ giòn tan</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-[#10B981] text-white flex items-center justify-center font-bold text-[10px]">✓</span>
              <span class="text-[#121316] font-medium">Ưu tiên nhận hàng qua cổng Fast-Track không cần xếp hàng</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-[#10B981] text-white flex items-center justify-center font-bold text-[10px]">✓</span>
              <span class="text-[#121316] font-medium">Áp dụng tại cả 3 cụm rạp: CGV Kim Cúc, Starlight, DCine Quy Nhơn</span>
            </div>
          </div>

          <div class="pt-2">
            <a href="/bap-nuoc" class="btn-editorial-cinnabar text-xs !py-3.5 !px-8 inline-flex items-center gap-2">
              <span>Khám Phá Menu Bắp Nước & Đặt Riêng</span>
              <span class="font-['JetBrains_Mono']">→</span>
            </a>
          </div>
        </div>

        <!-- Right: Concessions Product Showcase Cards (Span 7) -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <% if (typeof combos !== 'undefined' && combos && combos.length > 0) { %>
            <% combos.forEach(function(item) { %>
              <div class="bg-white border border-[#E5E0D5] p-5 space-y-3 hover:border-[#121316] transition-all flex flex-col justify-between">
                <div class="space-y-3">
                  <div class="aspect-[16/10] bg-[#FAF8F5] overflow-hidden border border-[#E5E0D5]">
                    <img src="<%= item.imageUrl || 'https://images.unsplash.com/photo-1578849278619-e73505e9610f?auto=format&fit=crop&w=500&q=80' %>" 
                         alt="<%= item.name %>" 
                         class="w-full h-full object-cover" 
                         loading="lazy" />
                  </div>
                  <div class="flex items-baseline justify-between font-['JetBrains_Mono']">
                    <h4 class="font-serif text-base font-bold text-[#121316] truncate" title="<%= item.name %>"><%= item.name %></h4>
                    <span class="text-sm font-bold text-[#BA2D27] shrink-0 ml-2"><%= item.price.toLocaleString('vi-VN') %> đ</span>
                  </div>
                  <p class="text-xs text-[#7A7E8B] line-clamp-2"><%= item.description || (item.flavors && item.flavors.length ? 'Vị: ' + item.flavors.join(', ') : 'Thức ăn nhanh rạp chiếu') %></p>
                </div>
                <a href="/bap-nuoc" class="block text-center py-2 bg-[#FAF8F5] border border-[#E5E0D5] hover:border-[#121316] text-xs font-bold font-['JetBrains_Mono'] text-[#121316] hover:bg-white transition-colors">
                  Đặt Món Này →
                </a>
              </div>
            <% }) %>
          <% } else { %>
            
            <div class="col-span-full py-8 text-center text-[#7A7E8B] text-xs font-['JetBrains_Mono'] bg-[#FAF8F5] border border-[#E5E0D5] p-6">
              🍿 Thực đơn bắp nước đang được cập nhật. Vui lòng quay lại sau!
            </div>
          <% } %>
        </div>

      </div>

    </div>
  </section>

  <!-- =========================================================================
       5. 3 CINEMAS NETWORK IN QUY NHƠN (HỆ THỐNG 3 CỤM RẠP)
       ========================================================================= -->
  <section class="py-14 lg:py-20 px-6 sm:px-10 lg:px-14 border-b border-[#E5E0D5]">
    <div class="max-w-[1520px] mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="font-['JetBrains_Mono'] text-xs text-[#BA2D27] font-bold uppercase tracking-widest block">KHÔNG GIAN ĐIỆN ẢNH ĐỈNH CAO</span>
        <h2 class="font-serif text-2xl sm:text-4xl font-bold text-[#121316] mt-1">
          Hệ Thống 3 Cụm Rạp Quy Nhơn
        </h2>
        <p class="text-xs text-[#7A7E8B] mt-2 font-normal">
          Trang bị máy chiếu laser sắc nét, ghế bọc da cao cấp và hệ thống âm thanh vòm Dolby Surround 7.1 chuẩn quốc tế.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Cinema 1 -->
        <div class="bg-white border border-[#E5E0D5] p-6 space-y-4 hover:border-[#121316] transition-all">
          <div class="aspect-video bg-[#FAF8F5] overflow-hidden border border-[#E5E0D5]">

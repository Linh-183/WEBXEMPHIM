<script>
  // ==========================================
  // HERO CAROUSEL CLIENT-SIDE CONTROLLER
  // ==========================================
  (function() {
    let currentSlide = 0;
    let heroInterval = null;

    function getElements() {
      const slides = document.querySelectorAll('.hero-slide-item');
      const dots = document.querySelectorAll('.hero-dot-btn');
      const btnPrev = document.getElementById('btnHeroPrev');
      const btnNext = document.getElementById('btnHeroNext');
      const section = document.getElementById('heroCarouselSection');
      return { slides, dots, btnPrev, btnNext, section };
    }

    function showSlide(index) {
      const { slides, dots } = getElements();
      if (!slides || slides.length === 0) return;

      if (index >= slides.length) currentSlide = 0;
      else if (index < 0) currentSlide = slides.length - 1;
      else currentSlide = index;

      slides.forEach((slide, idx) => {
        if (idx === currentSlide) {
          slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
          slide.classList.add('opacity-100', 'pointer-events-auto', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'pointer-events-auto', 'z-10');
          slide.classList.add('opacity-0', 'pointer-events-none', 'z-0');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === currentSlide) {
          dot.className = 'hero-dot-btn w-7 h-1 transition-all cursor-pointer bg-[#BA2D27]';
        } else {
          dot.className = 'hero-dot-btn w-7 h-1 transition-all cursor-pointer bg-white/20 hover:bg-white/50';
        }
      });
    }

    function startAutoPlay() {
      clearInterval(heroInterval);
      const { slides } = getElements();
      if (slides.length > 1) {
        heroInterval = setInterval(() => {
          showSlide(currentSlide + 1);
        }, 5000);
      }
    }

    function pauseAutoPlay() {
      clearInterval(heroInterval);
    }

    document.addEventListener('DOMContentLoaded', () => {
      const { btnPrev, btnNext, dots, section } = getElements();

      if (btnPrev) {
        btnPrev.addEventListener('click', () => {
          showSlide(currentSlide - 1);
          startAutoPlay();
        });
      }

      if (btnNext) {
        btnNext.addEventListener('click', () => {
          showSlide(currentSlide + 1);
          startAutoPlay();
        });
      }

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          showSlide(idx);
          startAutoPlay();
        });
      });

      if (section) {
        section.addEventListener('mouseenter', pauseAutoPlay);
        section.addEventListener('mouseleave', startAutoPlay);
      }

      startAutoPlay();
    });
  })();
</script>


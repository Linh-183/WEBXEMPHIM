<%- include('partials/admin-header') %>

<main class="p-6 sm:p-10 space-y-8 max-w-7xl">
  
  <!-- Top Return & Headline -->
  <div class="flex items-center gap-4 pb-6 border-b border-[#E5E0D5]">
    <a href="/admin/phim" class="w-9 h-9 border border-[#E5E0D5] bg-white hover:border-[#121316] text-[#121316] flex items-center justify-center transition-colors">
      <span class="material-symbols-outlined text-lg">arrow_back</span>
    </a>
    <div>
      <span class="archival-index">BIỂU MẪU ĐIỆN ẢNH</span>
      <h1 class="editorial-headline text-3xl font-bold mt-0.5">Thêm Phim Mới Vào Hệ Thống</h1>
    </div>
  </div>

  <form action="/admin/phim/them" method="POST" class="grid grid-cols-1 lg:grid-cols-12 gap-8 text-xs font-['Plus_Jakarta_Sans']">
    
    <!-- LEFT 8 COLS: GENERAL INFO & SHOWTIME SLOTS -->
    <div class="lg:col-span-8 space-y-6">
      
      <!-- Basic Movie Information Card -->
      <div class="bg-white border border-[#E5E0D5] p-6 sm:p-8 space-y-5">
        <h2 class="font-bold text-xs text-[#121316] uppercase tracking-wider pb-3 border-b border-[#E5E0D5]">
          1. Thông Tin Cơ Bản Của Phim
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Tên phim -->
          <div class="sm:col-span-2">
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Tên phim <span class="text-[#BA2D27]">*</span>
            </label>
            <input name="title" required placeholder="Nhập tiêu đề phim tiếng Việt hoặc tiếng Anh..." class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-bold focus:outline-none focus:border-[#121316]" />
          </div>

          <!-- Đạo diễn -->
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Đạo diễn</label>
            <input name="director" placeholder="Họ tên đạo diễn..." class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] focus:outline-none focus:border-[#121316]" />
          </div>

          <!-- Thể loại -->
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Thể loại</label>
            <input name="genre" placeholder="Hành động, Hoạt hình, Viễn tưởng..." class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] focus:outline-none focus:border-[#121316]" />
          </div>

          <!-- Thời lượng -->
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Thời lượng (Phút) <span class="text-[#BA2D27]">*</span>
            </label>
            <input name="duration" type="number" required placeholder="120" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          </div>

          <!-- Ngày khởi chiếu -->
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Ngày khởi chiếu</label>
            <input name="releaseDate" type="date" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
          </div>

          <!-- Trạng thái -->
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Trạng thái phát hành</label>
            <select name="status" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-bold focus:outline-none focus:border-[#121316]">
              <option value="DangChieu">Đang chiếu (Now Showing)</option>
              <option value="SapChieu">Sắp chiếu (Coming Soon)</option>
            </select>
          </div>

          <!-- Phân loại độ tuổi -->
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Giới hạn độ tuổi</label>
            <select name="ageRating" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-bold focus:outline-none focus:border-[#121316]">
              <option value="P">P — Mọi lứa tuổi</option>
              <option value="K">K — Dưới 13 tuổi có người lớn đi kèm</option>
              <option value="T13">T13 — Khán giả từ 13 tuổi</option>
              <option value="T16" selected>T16 — Khán giả từ 16 tuổi</option>
              <option value="T18">T18 — Khán giả từ 18 tuổi</option>
            </select>
          </div>

          <!-- Mô tả tóm tắt nội dung -->
          <div class="sm:col-span-2">
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Tóm tắt nội dung phim</label>
            <textarea name="description" rows="4" placeholder="Nội dung, cốt truyện chính..." class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] focus:outline-none focus:border-[#121316]"></textarea>
          </div>

        </div>
      </div>

      <!-- Showtime Schedule Generator -->
      <div class="bg-white border border-[#E5E0D5] p-6 sm:p-8 space-y-4">
        <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-3">
          <h2 class="font-bold text-xs text-[#121316] uppercase tracking-wider">
            2. Xếp Lịch Chiếu Tại 3 Rạp Quy Nhơn
          </h2>
          <span class="text-[10px] font-['JetBrains_Mono'] text-[#10B981] font-bold">CHỐNG TRÙNG LỊCH</span>
        </div>

        <div class="space-y-4" id="showtimeRowsContainer">
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 p-4 bg-[#FAF8F5] border border-[#E5E0D5]">
            <div class="flex flex-col">
              <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate" title="Cụm rạp">Cụm rạp</label>
              <select name="cinema" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs text-[#121316] font-semibold focus:outline-none focus:border-[#121316]">
                <option value="CGV Kim Cúc Plaza">CGV Kim Cúc Plaza</option>
                <option value="Starlight Nguyễn Kim">Starlight Nguyễn Kim</option>
                <option value="DCine Quy Nhơn">DCine Quy Nhơn (Phú Tài Center)</option>
              </select>
            </div>
            <div class="flex flex-col">
              <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate" title="Phòng chiếu">Phòng chiếu</label>
              <select name="room" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs text-[#121316] font-semibold focus:outline-none focus:border-[#121316]">
                <option value="Phòng 1 (IMAX)">Phòng 1 (IMAX)</option>
                <option value="Phòng 2 (2D)">Phòng 2 (2D)</option>
                <option value="Phòng 3 (VIP)">Phòng 3 (VIP)</option>
              </select>
            </div>
            <div class="flex flex-col">
              <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate" title="Ngày chiếu">Ngày chiếu</label>
              <input type="date" name="show_date" value="<%= new Date().toISOString().split('T')[0] %>" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
            </div>
            <div class="flex flex-col">
              <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate" title="Các suất chiếu cách nhau bởi dấu phẩy (VD: 09:30, 13:15, 19:30)">Các suất chiếu (định dạng HH:MM)</label>
              <input type="text" name="show_times" placeholder="09:30, 13:15, 19:30" value="09:30, 13:15, 19:30" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs font-['JetBrains_Mono'] font-bold text-[#121316] focus:outline-none focus:border-[#121316]" onblur="formatShowtimeInput(this)" />
              <div class="flex items-center gap-1 mt-1.5 flex-wrap">
                <span class="text-[9px] text-[#7A7E8B] font-['JetBrains_Mono']">Thêm:</span>
                <button type="button" onclick="appendTimeChip(this, '09:30')" class="px-1.5 py-0.5 bg-white border border-[#E5E0D5] hover:border-[#BA2D27] text-[10px] font-['JetBrains_Mono'] font-bold text-[#121316] transition-all">+09:30</button>
                <button type="button" onclick="appendTimeChip(this, '13:15')" class="px-1.5 py-0.5 bg-white border border-[#E5E0D5] hover:border-[#BA2D27] text-[10px] font-['JetBrains_Mono'] font-bold text-[#121316] transition-all">+13:15</button>
                <button type="button" onclick="appendTimeChip(this, '16:45')" class="px-1.5 py-0.5 bg-white border border-[#E5E0D5] hover:border-[#BA2D27] text-[10px] font-['JetBrains_Mono'] font-bold text-[#121316] transition-all">+16:45</button>
                <button type="button" onclick="appendTimeChip(this, '19:30')" class="px-1.5 py-0.5 bg-white border border-[#E5E0D5] hover:border-[#BA2D27] text-[10px] font-['JetBrains_Mono'] font-bold text-[#121316] transition-all">+19:30</button>
                <button type="button" onclick="appendTimeChip(this, '21:45')" class="px-1.5 py-0.5 bg-white border border-[#E5E0D5] hover:border-[#BA2D27] text-[10px] font-['JetBrains_Mono'] font-bold text-[#121316] transition-all">+21:45</button>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-2 border-t border-[#E5E0D5]">
          <button type="button" onclick="addShowtimeRow()" class="px-3 py-2 bg-white border border-[#121316] hover:bg-[#121316] hover:text-white text-xs font-['JetBrains_Mono'] font-bold text-[#121316] transition-all flex items-center gap-1.5">
            <span>+ Thêm Lịch Chiếu Khác (Rạp hoặc Ngày khác)</span>
          </button>
        </div>
      </div>

    </div>

    <!-- RIGHT 4 COLS: POSTER & TRAILER MEDIA -->
    <div class="lg:col-span-4 space-y-6">
      
      <div class="bg-white border border-[#E5E0D5] p-6 space-y-4">
        <h3 class="font-bold text-xs text-[#121316] uppercase tracking-wider pb-2 border-b border-[#E5E0D5]">
          3. Hình Ảnh & Video Trailer
        </h3>

        <div>
          <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
            Đường dẫn Poster URL (Tỷ lệ 3:4) <span class="text-[#BA2D27]">*</span>
          </label>
          <input name="posterUrl" id="posterUrlInput" required placeholder="https://images.unsplash.com/..." class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" oninput="previewPoster(this.value)" />
        </div>

        <!-- Poster Preview Box -->
        <div class="relative aspect-[3/4] bg-[#EFEBE3] border border-[#E5E0D5] overflow-hidden flex items-center justify-center">
          <img id="posterPreviewImg" src="" alt="Xem trước Poster" class="w-full h-full object-cover hidden" />
          <span id="posterPlaceholderText" class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">Xem trước poster</span>
        </div>

        <div>
          <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
            Đường dẫn Video Trailer (YouTube)
          </label>
          <input name="trailerUrl" placeholder="https://www.youtube.com/watch?v=..." class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
        </div>
      </div>

      <!-- Action Button -->
      <div class="bg-white border border-[#E5E0D5] p-6 space-y-3">
        <button type="submit" class="btn-editorial-primary w-full py-3.5 text-xs font-bold uppercase tracking-wider block text-center !bg-[#BA2D27]">
          LƯU VÀ XUẤT BẢN PHIM MỚI →
        </button>
        <a href="/admin/phim" class="btn-editorial-secondary w-full py-2.5 text-xs font-bold uppercase tracking-wider block text-center">
          HỦY THAO TÁC
        </a>
      </div>

    </div>

  </form>

</main>

<script>
  function previewPoster(url) {
    const img = document.getElementById('posterPreviewImg');
    const txt = document.getElementById('posterPlaceholderText');
    if (url && url.startsWith('http')) {
      img.src = url;
      img.classList.remove('hidden');
      txt.classList.add('hidden');
    } else {
      img.classList.add('hidden');
      txt.classList.remove('hidden');
    }
  }

  function appendTimeChip(btn, timeStr) {
    const row = btn.closest('.grid');
    if (!row) return;
    const input = row.querySelector('input[name="show_times"]');
    if (!input) return;
    let cur = input.value.trim();
    if (!cur) {
      input.value = timeStr;
    } else {
      const existing = cur.split(',').map(s => s.trim());
      if (!existing.includes(timeStr)) {
        input.value = cur + ', ' + timeStr;
      }
    }
    formatShowtimeInput(input);
  }

  function formatShowtimeInput(input) {
    let val = input.value;
    let parts = val.split(/[,;\s]+/).map(p => p.trim()).filter(Boolean);
    let formatted = parts.map(p => {
      if (/^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$/.test(p)) {
        const [h, m] = p.split(':');
        return h.padStart(2, '0') + ':' + m;
      }
      if (/^\d{3,4}$/.test(p)) {
        const padded = p.padStart(4, '0');
        const h = padded.slice(0, 2);
        const m = padded.slice(2);
        if (parseInt(h) <= 23 && parseInt(m) <= 59) return h + ':' + m;
      }
      if (/^\d{1,2}$/.test(p)) {
        const h = p.padStart(2, '0');
        if (parseInt(h) <= 23) return h + ':00';
      }
      return p;
    });
    input.value = formatted.join(', ');
  }

  function addShowtimeRow() {
    const container = document.getElementById('showtimeRowsContainer');
    if (!container) return;
    const newRow = document.createElement('div');
    newRow.className = 'grid grid-cols-1 sm:grid-cols-4 gap-3 p-4 bg-[#FAF8F5] border border-[#E5E0D5] relative';
    newRow.innerHTML = `
      <div class="flex flex-col">
        <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate">Cụm rạp</label>
        <select name="cinema" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs text-[#121316] font-semibold focus:outline-none focus:border-[#121316]">
          <option value="CGV Kim Cúc Plaza">CGV Kim Cúc Plaza</option>
          <option value="Starlight Nguyễn Kim">Starlight Nguyễn Kim</option>
          <option value="DCine Quy Nhơn">DCine Quy Nhơn (Phú Tài Center)</option>
        </select>
      </div>
      <div class="flex flex-col">
        <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate">Phòng chiếu</label>
        <select name="room" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs text-[#121316] font-semibold focus:outline-none focus:border-[#121316]">
          <option value="Phòng 1 (IMAX)">Phòng 1 (IMAX)</option>
          <option value="Phòng 2 (2D)">Phòng 2 (2D)</option>
          <option value="Phòng 3 (VIP)">Phòng 3 (VIP)</option>
        </select>
      </div>
      <div class="flex flex-col">
        <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate">Ngày chiếu</label>
        <input type="date" name="show_date" value="<%= new Date().toISOString().split('T')[0] %>" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
      </div>
      <div class="flex flex-col">
        <div class="flex items-center justify-between h-5 mb-1.5">
          <label class="font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] whitespace-nowrap truncate">Các suất chiếu (HH:MM)</label>
          <button type="button" onclick="this.closest('.grid').remove()" class="text-[10px] font-bold text-[#BA2D27] hover:underline">✕ Xóa</button>
        </div>
        <input type="text" name="show_times" placeholder="09:30, 13:15, 19:30" value="09:30, 13:15, 19:30" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs font-['JetBrains_Mono'] font-bold text-[#121316] focus:outline-none focus:border-[#121316]" onblur="formatShowtimeInput(this)" />
        <div class="flex items-center gap-1 mt-1.5 flex-wrap">
          <span class="text-[9px] text-[#7A7E8B] font-['JetBrains_Mono']">Thêm:</span>
          <button type="button" onclick="appendTimeChip(this, '09:30')" class="px-1.5 py-0.5 bg-white border border-[#E5E0D5] hover:border-[#BA2D27] text-[10px] font-['JetBrains_Mono'] font-bold text-[#121316] transition-all">+09:30</button>
          <button type="button" onclick="appendTimeChip(this, '13:15')" class="px-1.5 py-0.5 bg-white border border-[#E5E0D5] hover:border-[#BA2D27] text-[10px] font-['JetBrains_Mono'] font-bold text-[#121316] transition-all">+13:15</button>
          <button type="button" onclick="appendTimeChip(this, '16:45')" class="px-1.5 py-0.5 bg-white border border-[#E5E0D5] hover:border-[#BA2D27] text-[10px] font-['JetBrains_Mono'] font-bold text-[#121316] transition-all">+16:45</button>
          <button type="button" onclick="appendTimeChip(this, '19:30')" class="px-1.5 py-0.5 bg-white border border-[#E5E0D5] hover:border-[#BA2D27] text-[10px] font-['JetBrains_Mono'] font-bold text-[#121316] transition-all">+19:30</button>
          <button type="button" onclick="appendTimeChip(this, '21:45')" class="px-1.5 py-0.5 bg-white border border-[#E5E0D5] hover:border-[#BA2D27] text-[10px] font-['JetBrains_Mono'] font-bold text-[#121316] transition-all">+21:45</button>
        </div>
      </div>
    `;
    container.appendChild(newRow);
  }
</script>

<%- include('partials/admin-footer') %>

<%- include('partials/header') %>

<main class="min-h-screen py-12 pb-24 bg-[#FAF8F5]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8">
    
    <!-- =========================================================================
         1. EDITORIAL PROFILE MASTHEAD
         ========================================================================= -->
    <div class="pb-8 border-b border-[#E5E0D5] mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="archival-index">HỒ SƠ HỘI VIÊN & ĐẶC QUYỀN</span>
        <h1 class="editorial-headline mt-1">Tài Khoản, Điểm Thưởng & Ví Voucher</h1>
        <p class="text-xs text-[#7A7E8B] mt-1.5 font-light">
          Quản lý thông tin định danh, tùy chọn thể loại yêu thích và sử dụng điểm tích lũy tại 3 cụm rạp CineGo Quy Nhơn.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/tai-khoan/ve-cua-toi" class="btn-editorial-secondary text-xs !py-2.5 !px-5">
          Vé Của Tôi (E-Ticket) →
        </a>
      </div>
    </div>

    <!-- MAIN TWO-COLUMN DOSSIER -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Left Column: Member Card & Loyalty Meter (Span 4) -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Embossed Member Card -->
        <div class="bg-white border-2 border-[#121316] p-6 relative overflow-hidden shadow-lg">
          <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-4 mb-4">
            <span class="font-['Georgia'] font-black text-lg tracking-[0.2em] text-[#121316]">CINEGO CLUB</span>
            <span class="font-['JetBrains_Mono'] text-[9px] uppercase tracking-widest px-2 py-0.5 bg-[#BA2D27] text-white font-bold">
              <%= (user && user.vaiTro === 'admin') ? 'ADMIN' : 'VIP PASS' %>
            </span>
          </div>

          <div class="flex items-center gap-4 py-2">
            <div class="w-14 h-14 bg-[#121316] text-[#FAF8F5] font-['Georgia'] font-bold text-2xl flex items-center justify-center shrink-0">
              <%= (user && (user.hoTen || user.name)) ? (user.hoTen || user.name).charAt(0).toUpperCase() : 'U' %>
            </div>
            <div class="overflow-hidden">
              <h3 class="font-bold text-base text-[#121316] truncate">
                <%= user ? (user.hoTen || user.name) : 'Hội Viên CineGo' %>
              </h3>
              <p class="text-xs text-[#7A7E8B] font-['JetBrains_Mono'] truncate">
                <%= user ? user.email : 'member@cinego.vn' %>
              </p>
            </div>
          </div>

          <!-- Points Display (SRS 1.2: 10.000đ = 1 Điểm) -->
          <div class="mt-6 p-4 bg-[#FAF8F5] border border-[#E5E0D5] font-['JetBrains_Mono']">
            <span class="block text-[10px] text-[#7A7E8B] uppercase">ĐIỂM TÍCH LŨY CỦA BẠN:</span>
            <div class="flex items-baseline justify-between mt-1">
              <span class="text-3xl font-black text-[#BA2D27]">
                <%= (user && typeof user.diemTichLuy !== 'undefined') ? user.diemTichLuy : 150 %>
              </span>
              <span class="text-xs text-[#7A7E8B]">Điểm thưởng</span>
            </div>
            <div class="text-[10px] text-[#7A7E8B] mt-2 pt-2 border-t border-[#E5E0D5]">
              Quy đổi: <strong>10.000đ</strong> chi tiêu = <strong>1 điểm</strong>. Đổi vé 0đ khi đạt 100 điểm.
            </div>
          </div>

          <div class="pt-4">
            <button type="button" onclick="redeemPointsModal()" class="btn-editorial-primary w-full text-xs text-center !py-2.5">
              Đổi Điểm Lấy Voucher 50K
            </button>
          </div>
        </div>

        <!-- Quick Navigation -->
        <div class="bg-white border border-[#E5E0D5] p-5 space-y-2 text-xs font-['JetBrains_Mono']">
          <a href="#profile-tab" onclick="switchTab('profile')" class="flex items-center justify-between p-2.5 bg-[#FAF8F5] hover:bg-[#F3EFE6] text-[#121316] font-bold">
            <span>Thông Tin Định Danh</span>
            <span>→</span>
          </a>
          <a href="#voucher-tab" onclick="switchTab('vouchers')" class="flex items-center justify-between p-2.5 hover:bg-[#F3EFE6] text-[#474A54] hover:text-[#121316]">
            <span>Ví Voucher (<span class="text-[#BA2D27] font-bold">3 mã</span>)</span>
            <span>→</span>
          </a>
          <a href="#security-tab" onclick="switchTab('security')" class="flex items-center justify-between p-2.5 hover:bg-[#F3EFE6] text-[#474A54] hover:text-[#121316]">
            <span>Đổi Mật Khẩu Bảo Mật</span>
            <span>→</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Profile Edit, Vouchers & Password (Span 8) -->
      <div class="lg:col-span-8 space-y-8">
        
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="p-4 bg-[#F9EBEA] border-l-4 border-[#BA2D27] text-[#BA2D27] text-xs font-['JetBrains_Mono'] flex items-center justify-between shadow-sm">
            <span>⚠ <%= error %></span>
          </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="p-4 bg-[#EAFaf1] border-l-4 border-[#10B981] text-[#10B981] text-xs font-['JetBrains_Mono'] flex items-center justify-between shadow-sm">
            <span>✓ <%= success %></span>
          </div>
        <% } %>

        <!-- SECTION A: PROFILE EDIT FORM & FAVORITE GENRES -->
        <div id="section-profile" class="bg-white border border-[#E5E0D5] p-6 sm:p-8 space-y-6">
          <div class="border-b border-[#E5E0D5] pb-4 flex items-center justify-between">
            <h2 class="font-['Georgia'] text-base font-bold text-[#121316] uppercase tracking-wider">
              1. Cập Nhật Thông Tin Cá Nhân
            </h2>
            <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">THÔNG TIN XÁC THỰC</span>
          </div>

          <form action="/tai-khoan/cap-nhat" method="POST" class="space-y-5 text-xs">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Họ và tên <span class="text-[#BA2D27]">*</span>
                </label>
                <input type="text" 
                       name="hoTen" 
                       value="<%= user ? (user.hoTen || user.name) : '' %>" 
                       required 
                       class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
              </div>

              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Địa chỉ Email (Không đổi)
                </label>
                <input type="email" 
                       value="<%= user ? user.email : '' %>" 
                       disabled 
                       class="w-full bg-[#ECE7DD] border border-[#E5E0D5] px-3.5 py-3 text-[#7A7E8B] cursor-not-allowed font-['JetBrains_Mono']" />
              </div>

              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Số điện thoại nhận vé <span class="text-[#BA2D27]">*</span>
                </label>
                <input type="tel" 
                       name="sdt" 
                       value="<%= user ? (user.soDienThoai || user.phone || '') : '' %>" 
                       placeholder="Ví dụ: 0912345678"
                       class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
              </div>

              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Ngày sinh
                </label>
                <input type="date" 
                       name="ngaySinh" 
                       value="<%= (user && user.ngaySinh) ? new Date(user.ngaySinh).toISOString().split('T')[0] : '' %>" 
                       class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
              </div>
            </div>

            <!-- Gender Radios -->
            <div>
              <span class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-2 font-semibold">
                Giới tính
              </span>
              <div class="flex items-center gap-6 font-['Plus_Jakarta_Sans'] text-xs">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="gender" value="Nam" <%= (user && user.gioiTinh === 'Nam') ? 'checked' : '' %> class="accent-[#BA2D27]" />
                  <span>Nam</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="gender" value="Nu" <%= (user && user.gioiTinh === 'Nu') ? 'checked' : '' %> class="accent-[#BA2D27]" />
                  <span>Nữ</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="gender" value="Khac" <%= (user && user.gioiTinh === 'Khac') ? 'checked' : '' %> class="accent-[#BA2D27]" />
                  <span>Khác</span>
                </label>
              </div>
            </div>

            <!-- SRS 1.1: Khảo sát 1-3 thể loại yêu thích ban đầu -->
            <div class="pt-4 border-t border-[#E5E0D5]">
              <span class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                Thể loại phim yêu thích (Chọn từ 1 đến 3 thể loại để nhận gợi ý chuẩn xác):
              </span>
              <div class="flex flex-wrap gap-2 pt-2">
                <% const allGenres = ['Hành Động', 'Khoa Học Viễn Tưởng', 'Kinh Dị', 'Tâm Lý', 'Hoạt Hình', 'Hài Hước', 'Tình Cảm', 'Tài Liệu']; %>
                <% allGenres.forEach((g, idx) => { %>
                  <button type="button" 
                          onclick="toggleFavoriteGenre(this, '<%= g %>')" 
                          class="genre-chip px-3 py-1.5 border border-[#E5E0D5] bg-[#FAF8F5] text-xs font-medium text-[#121316] transition-colors <%= (idx < 2) ? 'border-[#BA2D27] bg-[#F9EBEA] text-[#BA2D27] font-bold' : '' %>">
                    <%= g %>
                  </button>
                <% }); %>
              </div>
            </div>

            <div class="pt-4">
              <button type="submit" class="btn-editorial-primary text-xs py-3 px-8 font-bold">
                LƯU THÔNG TIN CÁ NHÂN
              </button>
            </div>
          </form>
        </div>

        <!-- SECTION B: VOUCHER WALLET (SRS 1.2: KHẢ DỤNG, ĐÃ DÙNG, HẾT HẠN) -->
        <div id="section-vouchers" class="bg-white border border-[#E5E0D5] p-6 sm:p-8 space-y-6">
          <div class="border-b border-[#E5E0D5] pb-4 flex items-center justify-between">
            <h2 class="font-['Georgia'] text-base font-bold text-[#121316] uppercase tracking-wider">
              2. Ví Voucher Cá Nhân
            </h2>
            <div class="flex items-center gap-2 text-xs font-['JetBrains_Mono']">
              <button type="button" onclick="filterWalletTab('available', this)" class="wallet-tab-btn font-bold text-[#BA2D27] underline">Khả Dụng (2)</button>
              <span>•</span>
              <button type="button" onclick="filterWalletTab('used', this)" class="wallet-tab-btn text-[#7A7E8B]">Đã Sử Dụng (1)</button>
              <span>•</span>
              <button type="button" onclick="filterWalletTab('expired', this)" class="wallet-tab-btn text-[#7A7E8B]">Hết Hạn (1)</button>
            </div>
          </div>

          <div class="space-y-4" id="wallet-vouchers-container">
            
            <!-- Voucher 1 -->
            <div class="wallet-voucher-card ticket-pass ticket-pass-horizontal p-5 bg-[#FAF8F5] border border-[#E5E0D5] flex flex-col sm:flex-row items-center justify-between gap-4" data-status="available">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-['Georgia'] font-black text-lg text-[#121316]">CINEGO50</span>
                  <span class="px-1.5 py-0.5 bg-[#BA2D27] text-white text-[9px] font-['JetBrains_Mono'] font-bold uppercase">GIẢM 50.000Đ</span>
                </div>
                <p class="text-xs text-[#7A7E8B] mt-0.5">Áp dụng cho đơn đặt vé từ 150.000đ tại mọi cụm rạp</p>
                <div class="text-[10px] font-['JetBrains_Mono'] text-[#474A54] mt-1">
                  Hạn sử dụng: <strong>31/12/2026</strong> • Trạng thái: <span class="text-[#10B981] font-bold">Khả dụng</span>
                </div>
              </div>
              <button type="button" onclick="copyVoucher('CINEGO50')" class="btn-editorial-secondary text-xs !py-2 !px-4 shrink-0">
                Sao Chép Mã
              </button>
            </div>

            <!-- Voucher 2 -->
            <div class="wallet-voucher-card ticket-pass ticket-pass-horizontal p-5 bg-[#FAF8F5] border border-[#E5E0D5] flex flex-col sm:flex-row items-center justify-between gap-4" data-status="available">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-['Georgia'] font-black text-lg text-[#121316]">FLASH19K</span>
                  <span class="px-1.5 py-0.5 bg-[#A6853B] text-white text-[9px] font-['JetBrains_Mono'] font-bold uppercase">ĐỒNG GIÁ 19K</span>
                </div>
                <p class="text-xs text-[#7A7E8B] mt-0.5">Vé suất chiếu thứ 2 đến thứ 5 hàng tuần</p>
                <div class="text-[10px] font-['JetBrains_Mono'] text-[#474A54] mt-1">
                  Hạn sử dụng: <strong>30/11/2026</strong> • Trạng thái: <span class="text-[#10B981] font-bold">Khả dụng</span>
                </div>
              </div>
              <button type="button" onclick="copyVoucher('FLASH19K')" class="btn-editorial-secondary text-xs !py-2 !px-4 shrink-0">
                Sao Chép Mã
              </button>
            </div>

            <!-- Voucher 3 (Used) -->
            <div class="wallet-voucher-card ticket-pass ticket-pass-horizontal p-5 bg-[#FAF8F5] border border-[#E5E0D5] flex flex-col sm:flex-row items-center justify-between gap-4 opacity-50 hidden" data-status="used">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-['Georgia'] font-black text-lg text-[#7A7E8B]">WELCOME20</span>
                  <span class="px-1.5 py-0.5 bg-[#7A7E8B] text-white text-[9px] font-['JetBrains_Mono'] font-bold uppercase">GIẢM 20%</span>
                </div>
                <p class="text-xs text-[#7A7E8B] mt-0.5">Chào mừng hội viên mới đăng ký tài khoản CineGo</p>
                <div class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B] mt-1">
                  Đã sử dụng cho đơn vé Dune 2 ngày 05/11/2026
                </div>
              </div>
              <span class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B] uppercase font-bold">Đã Dùng</span>
            </div>

            <!-- Voucher 4 (Expired) -->
            <div class="wallet-voucher-card ticket-pass ticket-pass-horizontal p-5 bg-[#FAF8F5] border border-[#E5E0D5] flex flex-col sm:flex-row items-center justify-between gap-4 opacity-40 hidden" data-status="expired">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-['Georgia'] font-black text-lg text-[#7A7E8B]">HALLOWEEN</span>
                  <span class="px-1.5 py-0.5 bg-[#7A7E8B] text-white text-[9px] font-['JetBrains_Mono'] font-bold uppercase">TẶNG BẮP</span>
                </div>
                <p class="text-xs text-[#7A7E8B] mt-0.5">Ưu đãi mùa phim kinh dị Halloween 2026</p>
                <div class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B] mt-1">
                  Đã hết hạn ngày 31/10/2026
                </div>
              </div>
              <span class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B] uppercase font-bold">Hết Hạn</span>
            </div>

          </div>
        </div>

        <!-- SECTION C: PASSWORD CHANGE FORM -->
        <div id="section-security" class="bg-white border border-[#E5E0D5] p-6 sm:p-8 space-y-6">
          <div class="border-b border-[#E5E0D5] pb-4 flex items-center justify-between">
            <h2 class="font-['Georgia'] text-base font-bold text-[#121316] uppercase tracking-wider">
              3. Đổi Mật Khẩu Bảo Mật
            </h2>
            <span class="text-[10px] font-['JetBrains_Mono'] text-[#BA2D27] font-bold">MẬT KHẨU TỐI THIỂU 6 KÝ TỰ</span>
          </div>

          <form action="/tai-khoan/doi-mat-khau" method="POST" class="space-y-4 text-xs">
            <div>
              <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                Mật khẩu hiện tại <span class="text-[#BA2D27]">*</span>
              </label>
              <input type="password" 
                     name="currentPassword" 
                     required 
                     placeholder="Nhập mật khẩu bạn đang dùng..."
                     class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Mật khẩu mới <span class="text-[#BA2D27]">*</span>
                </label>
                <input type="password" 
                       name="newPassword" 
                       required 
                       minlength="6"
                       placeholder="Tối thiểu 6 ký tự..."
                       class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
              </div>

              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Xác nhận mật khẩu mới <span class="text-[#BA2D27]">*</span>
                </label>
                <input type="password" 
                       name="confirmPassword" 
                       required 
                       minlength="6"
                       placeholder="Nhập lại mật khẩu mới..."
                       class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
              </div>
            </div>

            <div class="pt-4">
              <button type="submit" class="btn-editorial-secondary text-xs py-3 px-8 font-bold">
                CẬP NHẬT MẬT KHẨU
              </button>
            </div>
          </form>
        </div>

      </div>

    </div>

  </div>
</main>

<script>
  function switchTab(target) {
    if (target === 'profile') {
      document.getElementById('section-profile')?.scrollIntoView({ behavior: 'smooth' });
    } else if (target === 'vouchers') {
      document.getElementById('section-vouchers')?.scrollIntoView({ behavior: 'smooth' });
    } else if (target === 'security') {
      document.getElementById('section-security')?.scrollIntoView({ behavior: 'smooth' });
    }
  }

  function toggleFavoriteGenre(btn, name) {
    btn.classList.toggle('border-[#BA2D27]');
    btn.classList.toggle('bg-[#F9EBEA]');
    btn.classList.toggle('text-[#BA2D27]');
    btn.classList.toggle('font-bold');

    if (window.cinegoToast) {
      window.cinegoToast.info('Đã cập nhật sở thích: ' + name);
    }
  }

  function filterWalletTab(status, btn) {
    document.querySelectorAll('.wallet-tab-btn').forEach(b => {
      b.classList.remove('font-bold', 'text-[#BA2D27]', 'underline');
      b.classList.add('text-[#7A7E8B]');
    });
    btn.classList.remove('text-[#7A7E8B]');
    btn.classList.add('font-bold', 'text-[#BA2D27]', 'underline');

    document.querySelectorAll('.wallet-voucher-card').forEach(card => {
      if (card.dataset.status === status) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  function copyVoucher(code) {
    navigator.clipboard.writeText(code).then(() => {
      if (window.cinegoToast) {
        window.cinegoToast.success('Đã sao chép mã voucher: ' + code);
      } else {
        alert('Đã sao chép: ' + code);
      }
    });
  }

  function redeemPointsModal() {
    if (confirm('Bạn có muốn dùng 50 điểm thưởng để đổi lấy voucher giảm 50.000đ không?')) {
      if (window.cinegoToast) {
        window.cinegoToast.success('Đổi điểm thành công! Mã CINEGO50 đã được cộng vào ví của bạn.');
      } else {
        alert('Đổi điểm thành công!');
      }
    }
  }
</script>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<%
  const points = (user && typeof user.diemTichLuy === 'number') ? user.diemTichLuy : 0;
  let tierCode = 'Dong';
  let tierName = 'HỘI VIÊN ĐỒNG';
  let tierBadge = 'ĐỒNG';
  let tierColor = '#A6853B';
  let nextTierName = 'Bạc';
  let nextTierPoints = 100;
  let progressPercent = Math.min(100, Math.round((points / 100) * 100));

  if (user && user.vaiTro === 'admin') {
    tierCode = 'Admin';
    tierName = 'QUẢN TRỊ VIÊN HỆ THỐNG';
    tierBadge = 'ADMIN';
    tierColor = '#BA2D27';
    nextTierName = null;
    progressPercent = 100;
  } else if (points >= 600) {
    tierCode = 'KimCuong';
    tierName = 'HỘI VIÊN KIM CƯƠNG';
    tierBadge = 'KIM CƯƠNG';
    tierColor = '#2563EB';
    nextTierName = null;
    progressPercent = 100;
  } else if (points >= 300) {
    tierCode = 'Vang';
    tierName = 'HỘI VIÊN VÀNG';
    tierBadge = 'VÀNG';
    tierColor = '#D97706';
    nextTierName = 'Kim Cương';
    nextTierPoints = 600;
    progressPercent = Math.min(100, Math.round(((points - 300) / 300) * 100));
  } else if (points >= 100) {
    tierCode = 'Bac';
    tierName = 'HỘI VIÊN BẠC';
    tierBadge = 'BẠC';
    tierColor = '#64748B';
    nextTierName = 'Vàng';
    nextTierPoints = 300;
    progressPercent = Math.min(100, Math.round(((points - 100) / 200) * 100));
  }

  const savedVouchersList = (typeof savedVouchers !== 'undefined' && Array.isArray(savedVouchers)) 
    ? savedVouchers 
    : ((user && Array.isArray(user.vouchers) && user.vouchers.length > 0 && user.vouchers[0]._id) ? user.vouchers : []);
  const allVouchers = (typeof vouchers !== 'undefined' && Array.isArray(vouchers)) ? vouchers : [];
  const userGenres = (user && Array.isArray(user.favoriteGenres)) ? user.favoriteGenres : [];
%>

<main class="min-h-screen py-12 pb-24 bg-[#FAF8F5]">
  <div class="max-w-6xl mx-auto px-4 sm:px-8">
    
    <!-- =========================================================================
         1. EDITORIAL PROFILE MASTHEAD
         ========================================================================= -->
    <div class="pb-8 border-b border-[#E5E0D5] mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="archival-index">HỒ SƠ HỘI VIÊN & ĐẶC QUYỀN</span>
        <h1 class="editorial-headline mt-1">Tài Khoản, Điểm Thưởng & Ví Voucher</h1>
        <p class="text-xs text-[#7A7E8B] mt-1.5 font-light">
          Quản lý thông tin định danh, tùy chọn thể loại yêu thích và sử dụng điểm tích lũy tại 3 cụm rạp CineGo Quy Nhơn.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/tai-khoan/ve-cua-toi" class="btn-editorial-secondary text-xs !py-2.5 !px-5">
          Vé Của Tôi (E-Ticket) →
        </a>
      </div>
    </div>

    <!-- MAIN TWO-COLUMN DOSSIER -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Left Column: Member Card & Loyalty Meter (Span 4) -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Embossed Member Card -->
        <div class="bg-white border-2 border-[#121316] p-6 relative overflow-hidden shadow-lg">
          <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-4 mb-4">
            <span class="font-serif font-black text-lg tracking-[0.2em] text-[#121316]">CINEGO CLUB</span>
            <span class="font-['JetBrains_Mono'] text-[9px] uppercase tracking-widest px-2.5 py-0.5 text-white font-bold" style="background-color: <%= tierColor %>;">
              <%= tierBadge %>
            </span>
          </div>

          <div class="flex items-center gap-4 py-2">
            <div class="w-14 h-14 bg-[#121316] text-[#FAF8F5] font-serif font-bold text-2xl flex items-center justify-center shrink-0">
              <%= (user && (user.hoTen || user.name)) ? (user.hoTen || user.name).charAt(0).toUpperCase() : 'U' %>
            </div>
            <div class="overflow-hidden">
              <h3 class="font-bold text-base text-[#121316] truncate">
                <%= user ? (user.hoTen || user.name) : 'Hội Viên CineGo' %>
              </h3>
              <p class="text-xs text-[#7A7E8B] font-['JetBrains_Mono'] truncate">
                <%= user ? user.email : 'member@cinego.vn' %>
              </p>
            </div>
          </div>

          <!-- Points Display (SRS 1.2: 10.000đ = 1 Điểm) -->
          <div class="mt-6 p-4 bg-[#FAF8F5] border border-[#E5E0D5] font-['JetBrains_Mono'] space-y-3">
            <div class="flex items-center justify-between text-[10px]">
              <span class="text-[#7A7E8B] uppercase">ĐIỂM TÍCH LŨY CỦA BẠN:</span>
              <span class="font-bold text-[#121316]"><%= tierName %></span>
            </div>
            
            <div class="flex items-baseline justify-between">
              <span class="text-3xl font-black text-[#BA2D27]">
                <%= points %>
              </span>
              <span class="text-xs text-[#7A7E8B]">Điểm thưởng</span>
            </div>

            <!-- Tier Progress Bar -->
            <% if (nextTierName) { %>
              <div class="space-y-1 pt-1 border-t border-[#E5E0D5]">
                <div class="flex justify-between text-[10px] text-[#7A7E8B]">
                  <span>Hạng tiếp theo: <strong><%= nextTierName %></strong></span>
                  <span><strong><%= points %></strong> / <%= nextTierPoints %> điểm</span>
                </div>
                <div class="w-full bg-[#E5E0D5] h-1.5 overflow-hidden">
                  <div class="bg-[#BA2D27] h-full transition-all duration-500" style="width: <%= progressPercent %>%;"></div>
                </div>
                <div class="text-[9px] text-[#7A7E8B]">
                  Cần thêm <strong><%= Math.max(0, nextTierPoints - points) %> điểm</strong> nữa để thăng hạng!
                </div>
              </div>
            <% } else { %>
              <div class="pt-1 border-t border-[#E5E0D5] text-[10px] text-[#10B981] font-bold">
                ✓ Bạn đang ở hạng đặc quyền cao nhất!
              </div>
            <% } %>

            <div class="text-[10px] text-[#7A7E8B] pt-2 border-t border-[#E5E0D5]">
              Quy đổi: <strong>10.000đ</strong> chi tiêu = <strong>1 điểm</strong>. Đổi vé 0đ hoặc voucher 50K khi đủ điểm.
            </div>
          </div>

          <div class="pt-4">
            <button type="button" onclick="redeemPointsModal(<%= points %>)" class="btn-editorial-primary w-full text-xs text-center !py-2.5">
              Đổi Điểm Lấy Voucher 50K
            </button>
          </div>
        </div>

        <!-- Membership Tiers Perks Table -->
        <div class="bg-white border border-[#E5E0D5] p-5 space-y-3 font-['JetBrains_Mono'] text-xs">
          <span class="block text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider border-b border-[#E5E0D5] pb-2">
            HỆ THỐNG CÁC CẤP BẬC HỘI VIÊN
          </span>
          <div class="space-y-2.5 text-[11px]">
            <div class="p-2 border border-[#E5E0D5] <%= tierCode === 'Dong' ? 'bg-[#F9EBEA] border-[#BA2D27]' : 'bg-[#FAF8F5]' %>">
              <div class="flex items-center justify-between font-bold text-[#A6853B]">
                <span>1. HỘI VIÊN ĐỒNG</span>
                <span>0 – 99đ</span>
              </div>
              <p class="text-[#7A7E8B] text-[10px] mt-0.5">Tích 1 điểm cho mỗi 10.000đ khi đặt vé tại 3 rạp Quy Nhơn.</p>
            </div>
            
            <div class="p-2 border border-[#E5E0D5] <%= tierCode === 'Bac' ? 'bg-[#F9EBEA] border-[#BA2D27]' : 'bg-[#FAF8F5]' %>">
              <div class="flex items-center justify-between font-bold text-[#64748B]">
                <span>2. HỘI VIÊN BẠC</span>
                <span>100 – 299đ</span>
              </div>
              <p class="text-[#7A7E8B] text-[10px] mt-0.5">Giảm 5% bắp nước + Tặng 01 vé 2D vào tháng sinh nhật.</p>
            </div>

            <div class="p-2 border border-[#E5E0D5] <%= tierCode === 'Vang' ? 'bg-[#F9EBEA] border-[#BA2D27]' : 'bg-[#FAF8F5]' %>">
              <div class="flex items-center justify-between font-bold text-[#D97706]">
                <span>3. HỘI VIÊN VÀNG</span>
                <span>300 – 599đ</span>
              </div>
              <p class="text-[#7A7E8B] text-[10px] mt-0.5">Giảm 10% bắp nước + 2 vé 2D sinh nhật + Ưu tiên Fast-Track.</p>
            </div>

            <div class="p-2 border border-[#E5E0D5] <%= tierCode === 'KimCuong' ? 'bg-[#F9EBEA] border-[#BA2D27]' : 'bg-[#FAF8F5]' %>">
              <div class="flex items-center justify-between font-bold text-[#2563EB]">
                <span>4. HỘI VIÊN KIM CƯƠNG</span>
                <span>≥ 600đ</span>
              </div>
              <p class="text-[#7A7E8B] text-[10px] mt-0.5">Giảm 15% bắp nước + Vé Premiere + Phòng chờ VIP Lounge.</p>
            </div>
          </div>
        </div>

        <!-- Quick Navigation -->
        <div class="bg-white border border-[#E5E0D5] p-5 space-y-2 text-xs font-['JetBrains_Mono']">
          <a href="#profile-tab" onclick="switchTab('profile')" class="flex items-center justify-between p-2.5 bg-[#FAF8F5] hover:bg-[#F3EFE6] text-[#121316] font-bold">
            <span>Thông Tin Định Danh</span>
            <span>→</span>
          </a>
          <a href="#voucher-tab" onclick="switchTab('vouchers')" class="flex items-center justify-between p-2.5 hover:bg-[#F3EFE6] text-[#474A54] hover:text-[#121316]">
            <span>Ví Voucher (<span id="sidebar-voucher-count" class="text-[#BA2D27] font-bold"><%= savedVouchersList.length %> mã</span>)</span>
            <span>→</span>
          </a>
          <a href="#security-tab" onclick="switchTab('security')" class="flex items-center justify-between p-2.5 hover:bg-[#F3EFE6] text-[#474A54] hover:text-[#121316]">
            <span>Đổi Mật Khẩu Bảo Mật</span>
            <span>→</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Profile Edit, Vouchers & Password (Span 8) -->
      <div class="lg:col-span-8 space-y-8">
        
        <% if (typeof error !== 'undefined' && error) { %>
          <div data-toast-error="<%= error %>" class="p-4 bg-[#F9EBEA] border-l-4 border-[#BA2D27] text-[#BA2D27] text-xs font-['JetBrains_Mono'] flex items-center justify-between shadow-sm">
            <span>⚠ <%= error %></span>
          </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div data-toast-success="<%= success %>" class="p-4 bg-[#EAFaf1] border-l-4 border-[#10B981] text-[#10B981] text-xs font-['JetBrains_Mono'] flex items-center justify-between shadow-sm">
            <span>✓ <%= success %></span>
          </div>
        <% } %>

        <!-- SECTION A: PROFILE EDIT FORM & FAVORITE GENRES -->
        <div id="section-profile" class="bg-white border border-[#E5E0D5] p-6 sm:p-8 space-y-6">
          <div class="border-b border-[#E5E0D5] pb-4 flex items-center justify-between">
            <h2 class="font-serif text-base font-bold text-[#121316] uppercase tracking-wider">
              1. Cập Nhật Thông Tin Cá Nhân
            </h2>
            <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">THÔNG TIN XÁC THỰC</span>
          </div>

          <form action="/tai-khoan/cap-nhat" method="POST" class="space-y-5 text-xs">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Họ và tên <span class="text-[#BA2D27]">*</span>
                </label>
                <input type="text" 
                       name="hoTen" 
                       value="<%= user ? (user.hoTen || user.name) : '' %>" 
                       required 
                       class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
              </div>

              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Địa chỉ Email (Không đổi)
                </label>
                <input type="email" 
                       value="<%= user ? user.email : '' %>" 
                       disabled 
                       class="w-full bg-[#ECE7DD] border border-[#E5E0D5] px-3.5 py-3 text-[#7A7E8B] cursor-not-allowed font-['JetBrains_Mono']" />
              </div>

              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Số điện thoại nhận vé <span class="text-[#BA2D27]">*</span>
                </label>
                <input type="tel" 
                       name="sdt" 
                       value="<%= user ? (user.soDienThoai || user.phone || '') : '' %>" 
                       placeholder="Ví dụ: 0912345678"
                       class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
              </div>

              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Ngày sinh
                </label>
                <input type="date" 
                       name="ngaySinh" 
                       value="<%= (user && user.ngaySinh) ? new Date(user.ngaySinh).toISOString().split('T')[0] : '' %>" 
                       class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
              </div>
            </div>

            <!-- Gender Radios -->
            <div>
              <span class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-2 font-semibold">
                Giới tính
              </span>
              <div class="flex items-center gap-6 font-['Plus_Jakarta_Sans'] text-xs">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="gender" value="Nam" <%= (!user || !user.gioiTinh || user.gioiTinh === 'Nam') ? 'checked' : '' %> class="accent-[#BA2D27]" />
                  <span>Nam</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="gender" value="Nu" <%= (user && (user.gioiTinh === 'Nu' || user.gioiTinh === 'Nữ')) ? 'checked' : '' %> class="accent-[#BA2D27]" />
                  <span>Nữ</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="gender" value="Khac" <%= (user && (user.gioiTinh === 'Khac' || user.gioiTinh === 'Khác')) ? 'checked' : '' %> class="accent-[#BA2D27]" />
                  <span>Khác</span>
                </label>
              </div>
            </div>

            <!-- SRS 1.1: Khảo sát 1-3 thể loại yêu thích ban đầu (Lưu vào DB, không mock sẵn) -->
            <div class="pt-4 border-t border-[#E5E0D5]">
              <div class="flex items-center justify-between">
                <span class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Thể loại phim yêu thích (Chọn từ 1 đến 3 thể loại để nhận gợi ý chuẩn xác):
                </span>
                <span class="text-[10px] font-['JetBrains_Mono'] text-[#BA2D27]" id="genreCountLabel">
                  Đã chọn: <%= userGenres.length %>/3
                </span>
              </div>
              
              <input type="hidden" name="favoriteGenres" id="favoriteGenresInput" value="<%= userGenres.join(',') %>" />

              <div class="flex flex-wrap gap-2 pt-2" id="genreContainer">
                <% 
                  const allGenres = ['Hành Động', 'Khoa Học Viễn Tưởng', 'Kinh Dị', 'Tâm Lý', 'Hoạt Hình', 'Hài Hước', 'Tình Cảm', 'Tài Liệu']; 
                %>
                <% allGenres.forEach((g) => { %>
                  <% const isSelected = userGenres.includes(g); %>
                  <button type="button" 
                          onclick="toggleFavoriteGenre(this, '<%= g %>')" 
                          data-genre="<%= g %>"
                          class="genre-chip px-3 py-1.5 border text-xs font-medium transition-all <%= isSelected ? 'border-[#BA2D27] bg-[#F9EBEA] text-[#BA2D27] font-bold shadow-sm' : 'border-[#E5E0D5] bg-[#FAF8F5] text-[#121316] hover:border-[#121316]' %>">
                    <%= isSelected ? '✓ ' : '+ ' %><%= g %>
                  </button>
                <% }); %>
              </div>
            </div>

            <div class="pt-4">
              <button type="submit" class="btn-editorial-primary text-xs py-3 px-8 font-bold">
                LƯU THÔNG TIN CÁ NHÂN
              </button>
            </div>
          </form>
        </div>

        <!-- SECTION B: VÍ VOUCHER CÁ NHÂN -->
        <div id="section-vouchers" class="bg-white border border-[#E5E0D5] p-6 sm:p-8 space-y-6">
          <div class="border-b border-[#E5E0D5] pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <span class="archival-index">VÍ ƯU ĐÃI THÀNH VIÊN</span>
              <h2 class="font-serif text-base font-bold text-[#121316] uppercase tracking-wider mt-0.5">
                2. Ví Voucher Cá Nhân
              </h2>
            </div>
            <div class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">
              ĐANG SỞ HỮU: <strong class="text-[#BA2D27]" id="total-wallet-vouchers"><%= savedVouchersList.length %> MÃ</strong>
            </div>
          </div>

          <!-- Form Lưu Mã Voucher Vào Ví -->
          <div class="p-4 bg-[#FAF8F5] border border-[#E5E0D5] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <div class="font-bold text-xs text-[#121316]">Thu Thập Thêm Voucher</div>
              <p class="text-[11px] text-[#7A7E8B]">Nhập mã ưu đãi để lưu trực tiếp vào ví cá nhân của bạn</p>
            </div>
            <form onsubmit="handleSaveToWallet(event)" class="flex items-center gap-2 w-full sm:w-auto">
              <input type="text" 
                     id="inputWalletVoucherCode" 
                     required 
                     placeholder="Nhập mã voucher..." 
                     class="w-full sm:w-48 bg-white border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] uppercase font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
              <button type="submit" class="btn-editorial-primary text-xs !py-2 !px-4 whitespace-nowrap">
                Lưu Vào Ví
              </button>
            </form>
          </div>

          <div class="space-y-4" id="wallet-vouchers-container">
            <% if (savedVouchersList.length > 0) { %>
              <% savedVouchersList.forEach(v => { %>
                <div id="voucher-card-<%= v._id %>" class="wallet-voucher-card ticket-pass ticket-pass-horizontal p-5 bg-[#FAF8F5] border border-[#E5E0D5] flex flex-col sm:flex-row items-center justify-between gap-4">
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-serif font-black text-lg text-[#121316]"><%= v.code %></span>
                      <span class="px-1.5 py-0.5 bg-[#BA2D27] text-white text-[9px] font-['JetBrains_Mono'] font-bold uppercase">
                        <%= v.discountType === 'percentage' ? ('GIẢM ' + v.discountValue + '%') : ('GIẢM ' + (v.discountValue / 1000) + 'K') %>
                      </span>
                    </div>
                    <p class="text-xs text-[#474A54] mt-0.5"><%= v.title %></p>
                    <div class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B] mt-1">
                      Hạn dùng: <strong><%= v.expiryDate ? new Date(v.expiryDate).toLocaleDateString('vi-VN') : 'Vô thời hạn' %></strong>
                      <% if (v.minOrderValue) { %>
                        • Đơn từ: <strong><%= (v.minOrderValue / 1000) %>K</strong>
                      <% } %>
                    </div>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    <a href="/phim" class="btn-editorial-primary text-xs !py-1.5 !px-3 font-['JetBrains_Mono']">
                      Đặt Vé Dùng Ngay →
                    </a>
                    <button type="button" onclick="removeVoucherFromWallet('<%= v._id %>', '<%= v.code %>')" class="border border-[#E5E0D5] bg-white hover:border-[#BA2D27] hover:text-[#BA2D27] text-xs !py-1.5 !px-3 font-['JetBrains_Mono'] transition-colors">
                      Bỏ Lưu
                    </button>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <!-- Empty State khi tài khoản mới hoặc ví trống -->
              <div id="wallet-empty-state" class="p-8 text-center bg-[#FAF8F5] border border-[#E5E0D5] space-y-3">
                <span class="material-symbols-outlined text-3xl text-[#7A7E8B]">account_balance_wallet</span>
                <div class="space-y-1">
                  <h4 class="font-serif text-base font-bold text-[#121316]">Ví Voucher Cá Nhân Đang Trống</h4>
                  <p class="text-xs text-[#7A7E8B] max-w-md mx-auto">
                    Bạn chưa lưu mã ưu đãi nào vào ví. Hãy nhập mã ở trên hoặc ghé trang Khuyến Mãi để lưu các voucher đang phát hành!
                  </p>
                </div>
                <div class="pt-2">
                  <a href="/khuyen-mai" class="btn-editorial-primary text-xs !py-2 !px-4 inline-block">
                    Khám Phá Voucher Khuyến Mãi →
                  </a>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- SECTION C: PASSWORD CHANGE FORM -->
        <div id="section-security" class="bg-white border border-[#E5E0D5] p-6 sm:p-8 space-y-6">
          <div class="border-b border-[#E5E0D5] pb-4 flex items-center justify-between">
            <h2 class="font-serif text-base font-bold text-[#121316] uppercase tracking-wider">
              3. Đổi Mật Khẩu Bảo Mật
            </h2>
            <span class="text-[10px] font-['JetBrains_Mono'] text-[#BA2D27] font-bold">MẬT KHẨU TỐI THIỂU 6 KÝ TỰ</span>
          </div>

          <form action="/tai-khoan/doi-mat-khau" method="POST" class="space-y-4 text-xs">
            <div>
              <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                Mật khẩu hiện tại <span class="text-[#BA2D27]">*</span>
              </label>
              <input type="password" 
                     name="currentPassword" 
                     required 
                     placeholder="Nhập mật khẩu bạn đang dùng..."
                     class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Mật khẩu mới <span class="text-[#BA2D27]">*</span>
                </label>
                <input type="password" 
                       name="newPassword" 
                       required 
                       minlength="6" 
                       placeholder="Tối thiểu 6 ký tự..."
                       class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
              </div>

              <div>
                <label class="block font-['JetBrains_Mono'] text-[10px] uppercase text-[#7A7E8B] mb-1 font-semibold">
                  Xác nhận mật khẩu mới <span class="text-[#BA2D27]">*</span>
                </label>
                <input type="password" 
                       name="confirmPassword" 
                       required 
                       minlength="6" 
                       placeholder="Nhập lại mật khẩu mới..."
                       class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-3 text-[#121316] font-medium focus:outline-none focus:border-[#121316]" />
              </div>
            </div>

            <div class="pt-4">
              <button type="submit" class="btn-editorial-secondary text-xs py-3 px-8 font-bold">
                CẬP NHẬT MẬT KHẨU
              </button>
            </div>
          </form>
        </div>

      </div>

    </div>

  </div>
</main>

<script>
  function switchTab(target) {
    if (target === 'profile') {
      document.getElementById('section-profile')?.scrollIntoView({ behavior: 'smooth' });
    } else if (target === 'vouchers') {
      document.getElementById('section-vouchers')?.scrollIntoView({ behavior: 'smooth' });
    } else if (target === 'security') {
      document.getElementById('section-security')?.scrollIntoView({ behavior: 'smooth' });
    }
  }

  function toggleFavoriteGenre(btn, name) {
    const input = document.getElementById('favoriteGenresInput');
    let selected = input.value ? input.value.split(',').filter(Boolean) : [];
    
    if (selected.includes(name)) {
      selected = selected.filter(x => x !== name);
      btn.className = 'genre-chip px-3 py-1.5 border text-xs font-medium transition-all border-[#E5E0D5] bg-[#FAF8F5] text-[#121316] hover:border-[#121316]';
      btn.innerText = '+ ' + name;
    } else {
      if (selected.length >= 3) {
        if (window.cinegoToast) window.cinegoToast.warning('Bạn chỉ có thể chọn tối đa 3 thể loại yêu thích.');
        else alert('Bạn chỉ có thể chọn tối đa 3 thể loại yêu thích.');
        return;
      }
      selected.push(name);
      btn.className = 'genre-chip px-3 py-1.5 border text-xs font-medium transition-all border-[#BA2D27] bg-[#F9EBEA] text-[#BA2D27] font-bold shadow-sm';
      btn.innerText = '✓ ' + name;
    }
    
    input.value = selected.join(',');
    const countLabel = document.getElementById('genreCountLabel');
    if (countLabel) countLabel.innerText = 'Đã chọn: ' + selected.length + '/3';
  }

  function handleSaveToWallet(e) {
    e.preventDefault();
    const input = document.getElementById('inputWalletVoucherCode');
    const code = input.value.trim();
    if (!code) return;

    fetch('/api/luu-voucher', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        if (window.cinegoToast) window.cinegoToast.success(data.message);
        else alert(data.message);
        setTimeout(() => window.location.reload(), 800);
      } else {
        if (window.cinegoToast) window.cinegoToast.warning(data.message);
        else alert(data.message);
      }
    })
    .catch(err => {
      if (window.cinegoToast) window.cinegoToast.error('Không thể lưu voucher: ' + err.message);
      else alert('Lỗi kết nối');
    });
  }

  function removeVoucherFromWallet(voucherId, code) {
    if (!confirm('Bạn có chắc chắn muốn bỏ lưu voucher ' + code + ' khỏi ví cá nhân?')) return;
    
    fetch('/api/xoa-voucher-vi', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ voucherId })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        if (window.cinegoToast) window.cinegoToast.success(data.message);
        else alert(data.message);
        const card = document.getElementById('voucher-card-' + voucherId);
        if (card) card.remove();
        setTimeout(() => window.location.reload(), 600);
      } else {
        if (window.cinegoToast) window.cinegoToast.error(data.message);
        else alert(data.message);
      }
    })
    .catch(err => {
      if (window.cinegoToast) window.cinegoToast.error('Lỗi khi bỏ lưu voucher: ' + err.message);
    });
  }

  function copyVoucher(code) {
    navigator.clipboard.writeText(code).then(() => {
      if (window.cinegoToast) {
        window.cinegoToast.success('Đã sao chép mã voucher: ' + code);
      } else {
        alert('Đã sao chép: ' + code);
      }
    });
  }

  function redeemPointsModal(currentPoints) {
    if (currentPoints < 100) {
      if (window.cinegoToast) window.cinegoToast.warning('Bạn cần tối thiểu 100 điểm thưởng để đổi lấy voucher 50.000đ.');
      else alert('Bạn cần tối thiểu 100 điểm thưởng để đổi lấy voucher 50.000đ.');
      return;
    }
    if (confirm('Bạn có muốn dùng 100 điểm thưởng để đổi lấy voucher giảm 50.000đ không?')) {
      if (window.cinegoToast) {
        window.cinegoToast.success('Đổi điểm thành công! Hãy kiểm tra ví voucher.');
      } else {
        alert('Đổi điểm thành công!');
      }
    }
  }
</script>

<%- include('partials/footer') %>

<%- include('partials/admin-header') %>

<main class="p-6 sm:p-10 space-y-8 max-w-7xl">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-[#E5E0D5]">
    <div>
      <span class="archival-index">PHÂN TÍCH TÀI CHÍNH & LẤP ĐẦY</span>
      <h1 class="editorial-headline text-3xl font-bold mt-1">Báo Cáo Doanh Thu & Hiệu Suất Rạp</h1>
      <p class="text-xs text-[#7A7E8B] mt-0.5 font-light">Tổng hợp doanh thu theo ngày, tuần, tháng, cụm rạp và combo F&B.</p>
    </div>

    <div class="flex items-center gap-2 font-['JetBrains_Mono']">
      <button type="button" onclick="if (window.cinegoToast) window.cinegoToast.info('Đang trích xuất file Excel (XLSX) báo cáo doanh thu...'); else alert('Đang trích xuất file Excel (XLSX)...')" class="btn-editorial-secondary text-xs !py-2.5 !px-4 flex items-center gap-1.5">
        <span class="material-symbols-outlined text-base">table_view</span> Xuất Excel
      </button>
      <button type="button" onclick="window.print()" class="btn-editorial-primary text-xs !py-2.5 !px-4 flex items-center gap-1.5">
        <span class="material-symbols-outlined text-base">picture_as_pdf</span> Xuất PDF
      </button>
    </div>
  </div>

  <!-- 3 Summary Metrics (Thời gian thực) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-['JetBrains_Mono']">
    <div class="bg-white border border-[#E5E0D5] p-6 space-y-1">
      <span class="text-[10px] uppercase font-bold text-[#7A7E8B] block">Doanh thu thời gian thực</span>
      <strong class="text-3xl font-black text-[#10B981] font-['Playfair_Display','Merriweather',serif] block">
        <%= (typeof totalRevenue !== 'undefined' ? totalRevenue : 0).toLocaleString('vi-VN') %> đ
      </strong>
      <span class="text-[11px] text-[#10B981] font-semibold flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span> <%= typeof totalRevenue !== 'undefined' && totalRevenue > 0 ? 'Tổng hợp trực tiếp từ đơn vé thật' : 'Chưa phát sinh doanh thu' %>
      </span>
    </div>
    <div class="bg-white border border-[#E5E0D5] p-6 space-y-1">
      <span class="text-[10px] uppercase font-bold text-[#7A7E8B] block">Doanh thu Combo F&B</span>
      <strong class="text-3xl font-black text-[#A6853B] font-['Playfair_Display','Merriweather',serif] block">
        <%= (typeof totalFnb !== 'undefined' ? totalFnb : 0).toLocaleString('vi-VN') %> đ
      </strong>
      <span class="text-[11px] text-[#7A7E8B] block font-medium">
        <%= (typeof totalRevenue !== 'undefined' && totalRevenue > 0) ? `Chiếm ${Math.round((totalFnb / totalRevenue) * 100)}% tổng doanh thu` : 'Chưa có đơn mua bắp nước' %>
      </span>
    </div>
    <div class="bg-white border border-[#E5E0D5] p-6 space-y-1">
      <span class="text-[10px] uppercase font-bold text-[#7A7E8B] block">Giá trị trung bình đơn (AOV)</span>
      <strong class="text-3xl font-black text-[#121316] font-['Playfair_Display','Merriweather',serif] block">
        <%= (typeof aov !== 'undefined' ? aov : 0).toLocaleString('vi-VN') %> đ
      </strong>
      <span class="text-[11px] text-[#BA2D27] block font-medium">
        <%= (typeof avgSeatsPerOrder !== 'undefined' && Number(avgSeatsPerOrder) > 0) ? `Tỷ suất trung bình ${avgSeatsPerOrder} vé / đơn` : 'Chưa có đơn vé được đặt' %>
      </span>
    </div>
  </div>

  <!-- Revenue Breakdown Table by Cinema -->
  <div class="bg-white border border-[#E5E0D5] overflow-x-auto shadow-sm">
    <div class="p-4 border-b border-[#E5E0D5] flex items-center justify-between font-['JetBrains_Mono']">
      <h3 class="font-['Playfair_Display','Merriweather',serif] text-xs font-bold text-[#121316] uppercase tracking-wider">
        Doanh Số Chi Tiết Theo 3 Cụm Rạp Quy Nhơn
      </h3>
      <span class="text-xs text-[#7A7E8B]">Tháng <%= (new Date().getMonth() + 1) %>/<%= new Date().getFullYear() %></span>
    </div>

    <table class="w-full text-left text-xs font-['Plus_Jakarta_Sans'] border-collapse">
      <thead>
        <tr class="border-b border-[#E5E0D5] text-[#7A7E8B] uppercase font-bold text-[10px] bg-[#FAF8F5] font-['JetBrains_Mono']">
          <th class="py-3.5 px-4">Cụm Rạp</th>
          <th class="py-3.5 px-4">Số Suất Chiếu</th>
          <th class="py-3.5 px-4">Vé Đã Bán</th>
          <th class="py-3.5 px-4">Tỷ Lệ Lấp Đầy</th>
          <th class="py-3.5 px-4">Doanh Thu Vé</th>
          <th class="py-3.5 px-4">Doanh Thu F&B</th>
          <th class="py-3.5 px-4 text-right">Tổng Doanh Thu</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#E5E0D5] font-['JetBrains_Mono']">
        <% 
          const activeReports = (typeof cinemaReports !== 'undefined' && cinemaReports) 
            ? cinemaReports.filter(c => c.showCount > 0 || c.ticketCount > 0 || c.totalRevenue > 0) 
            : [];
        %>
        <% if (activeReports.length > 0) { %>
          <% activeReports.forEach(function(item) { %>
            <tr class="hover:bg-[#FAF8F5]">
              <td class="py-3.5 px-4 font-bold text-[#121316]"><%= item.name %></td>
              <td class="py-3.5 px-4"><%= item.showCount %> suất</td>
              <td class="py-3.5 px-4 font-bold text-[#121316]"><%= item.ticketCount %> vé</td>
              <td class="py-3.5 px-4 <%= item.occupancyRate > 0 ? 'text-[#10B981]' : 'text-[#7A7E8B]' %> font-bold"><%= item.occupancyRate %>%</td>
              <td class="py-3.5 px-4"><%= Number(item.ticketRevenue || 0).toLocaleString('vi-VN') %> đ</td>
              <td class="py-3.5 px-4"><%= Number(item.fnbRevenue || 0).toLocaleString('vi-VN') %> đ</td>
              <td class="py-3.5 px-4 text-right font-bold text-[#BA2D27]"><%= Number(item.totalRevenue || 0).toLocaleString('vi-VN') %> đ</td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" class="py-12 text-center text-[#7A7E8B] font-['Plus_Jakarta_Sans']">
              <span class="material-symbols-outlined text-3xl text-[#7A7E8B]/60 block mb-2">bar_chart</span>
              Chưa có dữ liệu doanh thu hoặc suất chiếu phát sinh trong cơ sở dữ liệu.<br/>
              <span class="text-[11px] text-[#7A7E8B]/70 mt-1 block">Số liệu từng rạp sẽ tự động thống kê thời gian thực ngay khi có suất chiếu và đơn vé được đặt.</span>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

</main>

<%- include('partials/admin-footer') %>

<%- include('partials/header') %>

<main class="min-h-screen py-12 pb-24 bg-[#FAF8F5]">
  <div class="max-w-5xl mx-auto px-4 sm:px-8">
    
    <!-- =========================================================================
         1. EDITORIAL HEADER
         ========================================================================= -->
    <div class="pb-8 border-b border-[#E5E0D5] mb-10 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
      <div>
        <span class="archival-index">HỒ SƠ KHÁCH HÀNG / VÉ ĐIỆN TỬ</span>
        <h1 class="editorial-headline mt-1">Lịch Sử Vé & Vé Của Tôi</h1>
        <p class="text-xs text-[#7A7E8B] mt-1.5 font-light">
          Danh mục toàn bộ vé điện tử đã được phát hành tại 3 cụm rạp: CGV Kim Cúc Plaza, Starlight Nguyễn Kim, DCine Quy Nhơn.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a href="/phim" class="btn-editorial-primary text-xs !py-2.5 !px-5">
          Đặt Thêm Vé Mới →
        </a>
      </div>
    </div>

    <!-- Filter Tabs (SRS 1.6: Vé sắp xem, đã xem, bắp nước F&B riêng) -->
    <div class="flex items-center gap-2 border-b border-[#E5E0D5] pb-4 mb-8 text-xs font-['JetBrains_Mono'] flex-wrap">
      <button type="button" onclick="filterTicketCategory('all', this)" class="ticket-tab-pill px-4 py-2 bg-[#121316] text-white font-bold uppercase tracking-wider">
        Tất Cả Giao Dịch
      </button>
      <button type="button" onclick="filterTicketCategory('movie', this)" class="ticket-tab-pill px-4 py-2 bg-white border border-[#E5E0D5] text-[#474A54] hover:text-[#121316] font-bold uppercase tracking-wider transition-colors">
        Vé Xem Phim
      </button>
      <button type="button" onclick="filterTicketCategory('concession', this)" class="ticket-tab-pill px-4 py-2 bg-white border border-[#E5E0D5] text-[#474A54] hover:text-[#121316] font-bold uppercase tracking-wider transition-colors">
        🍿 Bắp Nước Đặt Riêng (F&B)
      </button>
      <button type="button" onclick="filterTicketCategory('upcoming', this)" class="ticket-tab-pill px-4 py-2 bg-white border border-[#E5E0D5] text-[#474A54] hover:text-[#121316] font-bold uppercase tracking-wider transition-colors">
        Suất Sắp Chiếu
      </button>
      <button type="button" onclick="filterTicketCategory('past', this)" class="ticket-tab-pill px-4 py-2 bg-white border border-[#E5E0D5] text-[#474A54] hover:text-[#121316] font-bold uppercase tracking-wider transition-colors">
        Lịch Sử Cũ
      </button>
    </div>

    <!-- =========================================================================
         2. PERFORATED TICKETS LEDGER LIST
         ========================================================================= -->
    <div class="space-y-6" id="tickets-list-container">
      <% if (typeof tickets !== 'undefined' && tickets && tickets.length > 0) { %>
        <% tickets.forEach(function(ticket, idx) { %>
          <% 
            const isConcessionOnly = !ticket.movie || (ticket.seats && (Array.isArray(ticket.seats) ? ticket.seats.includes('Quầy F&B') : ticket.seats === 'Quầy F&B'));
            let todayStr = '';
            try {
              todayStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' }).format(new Date());
            } catch(e) {
              todayStr = new Date().toISOString().split('T')[0];
            }
            const isUpcoming = (ticket.showDate && ticket.showDate >= todayStr);
            const isPast = (ticket.showDate && ticket.showDate < todayStr);
          %>
          <div class="ticket-item-card ticket-pass ticket-pass-horizontal p-6 sm:p-8 bg-white border border-[#E5E0D5] flex flex-col md:flex-row items-start md:items-center justify-between gap-6 hover:border-[#121316] transition-all"
               data-type="<%= isConcessionOnly ? 'concession' : 'movie' %>"
               data-upcoming="<%= isUpcoming ? 'true' : 'false' %>"
               data-past="<%= isPast ? 'true' : 'false' %>">
            
            <div class="space-y-2 flex-1">
              <div class="flex flex-wrap items-center gap-3 font-['JetBrains_Mono'] text-[11px]">
                <span class="px-2 py-0.5 <%= isConcessionOnly ? 'bg-[#A6853B]' : 'bg-[#121316]' %> text-white font-bold tracking-wider">
                  <%= isConcessionOnly ? 'ĐƠN BẮP NƯỚC F&B' : 'MÃ VÉ: ' + ticket._id.toString().substring(18).toUpperCase() %>
                </span>
                <span class="text-[#BA2D27] font-semibold">
                  <%= ticket.cinema || 'CGV Kim Cúc Plaza' %>
                </span>
                <span class="text-[#7A7E8B]">•</span>
                <span class="text-[#10B981] font-bold">✓ ĐÃ XÁC THỰC</span>
              </div>

              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#121316] leading-tight">
                <% if (isConcessionOnly) { %>
                  🍿 <%= ticket.comboDetails || 'Combo Bắp Nước Online' %>
                <% } else { %>
                  <%= ticket.movie ? ticket.movie.title : 'Phim Điện Ảnh' %>
                <% } %>
              </h2>

              <div class="font-['JetBrains_Mono'] text-xs text-[#7A7E8B] flex flex-wrap items-center gap-3">
                <% if (isConcessionOnly) { %>
                  <span>Loại đơn: <strong class="text-[#121316]">Quầy F&B Fast-Track</strong></span>
                  <span>•</span>
                  <span>Ngày nhận: <strong class="text-[#121316]"><%= ticket.showDate || todayStr %></strong></span>
                  <span>•</span>
                  <span>Vị trí: <strong class="text-[#BA2D27]">Quầy Bắp Nước Tại Rạp</strong></span>
                <% } else { %>
                  <span>Suất: <strong class="text-[#121316]"><%= ticket.showTime || '19:30' %></strong></span>
                  <span>•</span>
                  <span>Ngày: <strong class="text-[#121316]"><%= ticket.showDate || todayStr %></strong></span>
                  <span>•</span>
                  <span>Ghế: <strong class="text-[#BA2D27]"><%= ticket.seats ? (Array.isArray(ticket.seats) ? ticket.seats.join(', ') : ticket.seats) : 'D5' %></strong></span>
                <% } %>
              </div>

              <% if (!isConcessionOnly && ticket.comboDetails) { %>
                <div class="text-[11px] font-['JetBrains_Mono'] text-[#474A54]">
                  Bắp nước kèm: <span class="font-semibold text-[#121316]"><%= ticket.comboDetails %></span>
                </div>
              <% } %>
            </div>

            <!-- Price & Action Trigger -->
            <div class="flex items-center gap-4 w-full md:w-auto justify-between md:justify-end border-t md:border-t-0 border-[#E5E0D5] pt-4 md:pt-0 font-['JetBrains_Mono'] text-xs shrink-0">
              <div class="text-left md:text-right">
                <span class="block text-[10px] text-[#7A7E8B] uppercase">Tổng thanh toán</span>
                <%
                  let displayPrice = (typeof ticket.totalPrice === 'number' ? ticket.totalPrice : (Number(ticket.totalPrice) || 0));
                  if (ticket.discountAmount && ticket.discountAmount > 0 && ticket.originalPrice && ticket.discountAmount >= ticket.originalPrice) {
                    displayPrice = 0;
                  }
                %>
                <span class="text-base font-bold <%= displayPrice === 0 ? 'text-[#10B981]' : 'text-[#121316]' %>"><%= displayPrice.toLocaleString('vi-VN') %> đ</span>
                <% if (ticket.discountAmount && ticket.discountAmount > 0) { %>
                  <span class="block text-[9px] text-[#BA2D27] font-bold">Voucher: -<%= ticket.discountAmount.toLocaleString('vi-VN') %>đ</span>
                <% } %>
              </div>

              <div class="flex items-center gap-2">
                <% if (isConcessionOnly) { %>
                  <a href="/ve/<%= ticket._id %>" class="btn-editorial-secondary text-xs !py-2.5 !px-3 font-semibold text-[#A6853B] hover:text-[#BA2D27] flex items-center gap-1" title="Xem thẻ nhận bắp nước">
                    <span>🍿</span>
                    <span>Thẻ Bắp Nước →</span>
                  </a>
                <% } else { %>
                  <a href="/ve/<%= ticket._id %>" class="btn-editorial-secondary text-xs !py-2.5 !px-3 font-semibold" title="Xem thẻ vé điện tử chuẩn">
                    Thẻ Vé →
                  </a>
                  <a href="/chi-tiet-phim/<%= ticket.movie ? (ticket.movie._id || ticket.movie) : '' %>#danh-gia-phim" class="btn-editorial-secondary text-xs !py-2.5 !px-3 font-semibold text-[#A6853B] hover:text-[#BA2D27] flex items-center gap-1" title="Đánh giá phim sau khi xem">
                    <span>★</span>
                    <span>Đánh Giá</span>
                  </a>
                <% } %>
                <button type="button" 
                        onclick="openTicketQRModal('<%= ticket._id.toString().substring(18).toUpperCase() %>', '<%= isConcessionOnly ? (ticket.comboDetails || 'Combo Bắp Nước') : (ticket.movie ? ticket.movie.title : 'Phim Điện Ảnh') %>', '<%= ticket.cinema || 'CGV Kim Cúc Plaza' %>', '<%= ticket.showDate %>', '<%= ticket.showTime || 'Fast-Track' %>', '<%= isConcessionOnly ? 'Quầy F&B' : (ticket.seats ? (Array.isArray(ticket.seats) ? ticket.seats.join(', ') : ticket.seats) : 'D5') %>')"
                        class="btn-editorial-primary text-xs !py-2.5 !px-4">
                  <%= isConcessionOnly ? 'Mã Nhận Bắp Nước' : 'Xem Mã QR' %>
                </button>
              </div>
            </div>

          </div>
        <% }) %>
      <% } else { %>
        <!-- Empty State khi tài khoản chưa đặt vé -->
        <div class="bg-white border border-[#E5E0D5] p-12 text-center space-y-4">
          <div class="w-16 h-16 mx-auto bg-[#FAF8F5] border border-[#E5E0D5] flex items-center justify-center text-[#7A7E8B]">
            <span class="material-symbols-outlined text-3xl">confirmation_number</span>
          </div>
          <div class="space-y-1">
            <h3 class="font-serif text-xl font-bold text-[#121316]">
              Bạn chưa có vé xem phim nào
            </h3>
            <p class="text-xs text-[#7A7E8B] max-w-md mx-auto">
              Mọi vé điện tử bạn đặt tại 3 cụm rạp CGV Kim Cúc Plaza, Starlight hoặc DCine Quy Nhơn sẽ xuất hiện tại đây kèm mã QR để làm thủ tục vào phòng chiếu.
            </p>
          </div>
          <div class="pt-2">
            <a href="/phim" class="btn-editorial-primary text-xs !py-3 !px-6 inline-block">
              Khám Phá Phim Đang Chiếu & Đặt Vé Ngay →
            </a>
          </div>
        </div>
      <% } %>
    </div>

  </div>

  <!-- =========================================================================
       3. MODAL XUẤT VÉ ĐIỆN TỬ VÀ MÃ QR CHECK-IN TẠI QUẦY (NATIVE DIALOG)
       ========================================================================= -->
  <dialog id="ticketQrModal" class="cinego-dialog p-0 m-auto bg-transparent border-none" aria-labelledby="qrModalTitle">
    <div class="bg-white border border-[#121316] w-[92vw] max-w-md p-8 shadow-2xl relative space-y-6">
      <button type="button" onclick="closeTicketQRModal()" class="absolute top-4 right-4 text-[#7A7E8B] hover:text-[#121316]" aria-label="Đóng">
        <span class="material-symbols-outlined text-2xl">close</span>
      </button>

      <div class="text-center border-b border-[#E5E0D5] pb-4">
        <span id="qrModalTitle" class="font-serif font-black text-xl tracking-[0.2em] text-[#121316]">CINEGO</span>
        <span class="font-['JetBrains_Mono'] text-[9px] uppercase tracking-widest text-[#7A7E8B] block mt-0.5">VÉ ĐIỆN TỬ XÁC THỰC 1 CHẠM</span>
      </div>

      <!-- Simulated QR Code SVG -->
      <div class="p-6 bg-[#FAF8F5] border border-[#E5E0D5] flex flex-col items-center justify-center">
        <div class="w-48 h-48 bg-white border-2 border-[#121316] p-3 flex flex-col items-center justify-center">
          <!-- Geometric Barcode Graphic -->
          <svg class="w-full h-full" viewBox="0 0 100 100" fill="#121316">
            <rect x="5" y="5" width="25" height="25" fill="#121316"/>
            <rect x="8" y="8" width="19" height="19" fill="#FFF"/>
            <rect x="12" y="12" width="11" height="11" fill="#121316"/>
            <rect x="70" y="5" width="25" height="25" fill="#121316"/>
            <rect x="73" y="8" width="19" height="19" fill="#FFF"/>
            <rect x="77" y="12" width="11" height="11" fill="#121316"/>
            <rect x="5" y="70" width="25" height="25" fill="#121316"/>
            <rect x="8" y="73" width="19" height="19" fill="#FFF"/>
            <rect x="12" y="77" width="11" height="11" fill="#121316"/>
            <!-- Data dots -->
            <rect x="35" y="10" width="6" height="6"/>
            <rect x="45" y="20" width="8" height="6"/>
            <rect x="55" y="10" width="6" height="10"/>
            <rect x="10" y="40" width="12" height="6"/>
            <rect x="35" y="40" width="30" height="20"/>
            <rect x="75" y="40" width="15" height="8"/>
            <rect x="40" y="70" width="8" height="15"/>
            <rect x="60" y="75" width="20" height="8"/>
          </svg>
        </div>
        <span id="qrTicketCodeDisplay" class="font-['JetBrains_Mono'] text-xs font-bold tracking-widest text-[#121316] mt-3 block">
          --
        </span>
      </div>

      <!-- Ticket Ledger Info in Modal -->
      <div class="space-y-1.5 text-xs font-['JetBrains_Mono'] border-t border-[#E5E0D5] pt-4">
        <div class="flex justify-between">
          <span class="text-[#7A7E8B]">Phim:</span>
          <span id="qrMovieTitle" class="font-bold text-[#121316] text-right truncate max-w-[200px]">--</span>
        </div>
        <div class="flex justify-between">
          <span class="text-[#7A7E8B]">Cụm rạp:</span>
          <span id="qrCinema" class="font-bold text-[#121316]">--</span>
        </div>
        <div class="flex justify-between">
          <span class="text-[#7A7E8B]">Suất & Ngày:</span>
          <span id="qrTimeDate" class="font-bold text-[#121316]">--:-- • ----</span>
        </div>
        <div class="flex justify-between">
          <span class="text-[#7A7E8B]">Ghế ngồi:</span>
          <span id="qrSeats" class="font-bold text-[#BA2D27]">--</span>
        </div>
      </div>

      <div class="pt-2 flex items-center gap-3">
        <button type="button" onclick="window.print()" class="btn-editorial-secondary text-xs flex-1 text-center">
          In Vé (Print)
        </button>
        <button type="button" onclick="closeTicketQRModal()" class="btn-editorial-primary text-xs flex-1 text-center">
          Đóng Lại
        </button>
      </div>
    </div>
  </dialog>

</main>

<script>
  function openTicketQRModal(code, movie, cinema, date, time, seats) {
    document.getElementById('qrTicketCodeDisplay').innerText = code;
    document.getElementById('qrMovieTitle').innerText = movie;
    document.getElementById('qrCinema').innerText = cinema;
    document.getElementById('qrTimeDate').innerText = time + ' • ' + date;
    document.getElementById('qrSeats').innerText = seats;
    const modal = document.getElementById('ticketQrModal');
    if (!modal) return;
    if (typeof modal.showModal === 'function') {
      if (!modal.open) modal.showModal();
    } else {
      modal.classList.remove('hidden');
    }
  }

  function closeTicketQRModal() {
    const modal = document.getElementById('ticketQrModal');
    if (!modal) return;
    if (typeof modal.close === 'function') {
      if (modal.open) modal.close();
    } else {
      modal.classList.add('hidden');
    }
  }

  // Backdrop click dismissal
  document.getElementById('ticketQrModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeTicketQRModal();
  });

  function filterTicketCategory(type, btn) {
    document.querySelectorAll('.ticket-tab-pill').forEach(b => {
      b.classList.remove('bg-[#121316]', 'text-white');
      b.classList.add('bg-white', 'text-[#474A54]');
    });
    btn.classList.remove('bg-white', 'text-[#474A54]');
    btn.classList.add('bg-[#121316]', 'text-white');

    const cards = document.querySelectorAll('.ticket-item-card');
    let matchCount = 0;
    cards.forEach(card => {
      const cType = card.getAttribute('data-type');
      const isUpcoming = card.getAttribute('data-upcoming') === 'true';
      const isPast = card.getAttribute('data-past') === 'true';

      let match = false;
      if (type === 'all') {
        match = true;
      } else if (type === 'concession') {
        match = (cType === 'concession');
      } else if (type === 'movie') {
        match = (cType === 'movie');
      } else if (type === 'upcoming') {
        match = isUpcoming;
      } else if (type === 'past') {
        match = isPast;
      }

      if (match) {
        card.classList.remove('hidden');
        card.style.display = 'flex';
        matchCount++;
      } else {
        card.classList.add('hidden');
        card.style.display = 'none';
      }
    });

    let emptyNotice = document.getElementById('emptyFilterNotice');
    if (!emptyNotice) {
      emptyNotice = document.createElement('div');
      emptyNotice.id = 'emptyFilterNotice';
      emptyNotice.className = 'py-16 text-center text-[#7A7E8B] text-xs font-[\'JetBrains_Mono\'] bg-white border border-[#E5E0D5] p-8 space-y-2 shadow-xs';
      emptyNotice.innerHTML = `
        <span class="text-3xl block">🎟️</span>
        <p class="font-bold text-[#121316] text-sm font-serif">Không tìm thấy vé hoặc giao dịch nào phù hợp với bộ lọc này.</p>
        <p class="text-[11px] text-[#A6AAB6]">Vui lòng chọn tab khác hoặc đặt vé mới để trải nghiệm điện ảnh cùng CineGo.</p>
      `;
      const container = document.getElementById('tickets-list-container');
      if (container) container.appendChild(emptyNotice);
    }
    emptyNotice.classList.toggle('hidden', matchCount > 0);
  }
</script>

<%- include('partials/footer') %>

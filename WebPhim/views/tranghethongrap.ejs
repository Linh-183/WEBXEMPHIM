<%- include('partials/header') %>

<main class="min-h-screen py-12 pb-24 bg-[#FAF8F5]">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- =========================================================================
         1. ARCHITECTURAL MASTHEAD
         ========================================================================= -->
    <div class="pb-8 border-b border-[#E5E0D5] mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="archival-index">CHỈ MỤC KIẾN TRÚC & PHÒNG CHIẾU</span>
        <h1 class="editorial-headline mt-1">3 Cụm Rạp Điện Ảnh Hàng Đầu Quy Nhơn</h1>
        <p class="text-xs text-[#7A7E8B] mt-1.5 font-light max-w-2xl leading-relaxed">
          Khám phá không gian trình chiếu tiêu chuẩn quốc tế với công nghệ IMAX Laser, âm thanh Dolby Atmos đa chiều và dịch vụ bắp nước chất lượng cao tại thành phố biển Quy Nhơn.
        </p>
      </div>

      <div class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">
        TỔNG SỐ PHÒNG: <strong class="text-[#121316]">8 PHÒNG CHIẾU</strong> • SỨC CHỨA: <strong class="text-[#BA2D27]">680 GHẾ</strong>
      </div>
    </div>

    <!-- =========================================================================
         2. THE 3 THEATERS ARCHITECTURAL DOSSIERS
         ========================================================================= -->
    <div class="space-y-16">
      
      <!-- THEATER 01: CGV KIM CÚC PLAZA -->
      <article id="cgv" class="bg-white border border-[#E5E0D5] p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center hover:border-[#121316] transition-all">
        <div class="lg:col-span-5 aspect-[16/11] bg-[#EFEBE3] border border-[#E5E0D5] overflow-hidden group">
          <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1000&q=80" 
               alt="CGV Kim Cúc Plaza" 
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>

        <div class="lg:col-span-7 space-y-4">
          <div class="flex items-center gap-3 font-['JetBrains_Mono'] text-xs">
            <span class="px-2.5 py-0.5 bg-[#BA2D27] text-white font-bold uppercase tracking-wider">CỤM RẠP 01</span>
            <span class="text-[#7A7E8B]">3 PHÒNG CHIẾU • 270 GHẾ NGỒI</span>
          </div>

          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#121316]">
            CGV Kim Cúc Plaza Quy Nhơn
          </h2>

          <p class="text-xs text-[#474A54] leading-relaxed">
            Tọa lạc tại trung tâm mua sắm sầm uất nhất Quy Nhơn. Cụm rạp trang bị phòng chiếu IMAX Laser màn hình cong lớn nhất Bình Định, công nghệ âm thanh 12 kênh và hàng ghế đôi Sweetbox bọc da êm ái.
          </p>

          <div class="p-4 bg-[#FAF8F5] border border-[#E5E0D5] font-['JetBrains_Mono'] text-xs space-y-2 text-[#474A54]">
            <div class="flex items-start gap-2">
              <span class="text-[#121316] font-bold">Địa chỉ:</span>
              <span>Tầng 3, Kim Cúc Plaza, Khu đô thị An Phú Thịnh, P. Ghềnh Ráng, TP. Quy Nhơn</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#121316] font-bold">Hotline:</span>
              <span class="text-[#BA2D27] font-bold">12345678</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#121316] font-bold">Công nghệ:</span>
              <span class="text-[#A6853B] font-semibold">IMAX Laser 70mm, 3D Digital, Ghế Sweetbox đôi</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#121316] font-bold">Giá vé:</span>
              <span>Từ 75.000đ đến 170.000đ</span>
            </div>
          </div>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a href="/phim?cinema=CGV Kim Cúc" class="btn-editorial-primary text-xs !py-2.5 !px-6">
              Xem Lịch Chiếu Tại CGV →
            </a>
            <a href="/dat-ve/sample?cinema=CGV Kim Cúc Plaza" class="btn-editorial-secondary text-xs !py-2.5 !px-6">
              Đặt Suất Chiếu Hôm Nay
            </a>
          </div>
        </div>
      </article>

      <!-- THEATER 02: STARLIGHT NGUYỄN KIM -->
      <article id="starlight" class="bg-white border border-[#E5E0D5] p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center hover:border-[#121316] transition-all">
        <div class="lg:col-span-5 aspect-[16/11] bg-[#EFEBE3] border border-[#E5E0D5] overflow-hidden group">
          <img src="https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?auto=format&fit=crop&w=1000&q=80" 
               alt="Starlight Nguyễn Kim" 
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>

        <div class="lg:col-span-7 space-y-4">
          <div class="flex items-center gap-3 font-['JetBrains_Mono'] text-xs">
            <span class="px-2.5 py-0.5 bg-[#121316] text-white font-bold uppercase tracking-wider">CỤM RẠP 02</span>
            <span class="text-[#7A7E8B]">3 PHÒNG CHIẾU • 250 GHẾ NGỒI</span>
          </div>

          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#121316]">
            Starlight Nguyễn Kim Quy Nhơn
          </h2>

          <p class="text-xs text-[#474A54] leading-relaxed">
            Tọa lạc tại tầng 4 TTTM Nguyễn Kim ngay trục đường trung tâm Trần Phú. Không gian giải trí phức hợp kết hợp rạp chiếu phim kỹ thuật số, khu trò chơi điện tử và trà sữa bắp rang bơ đa vị.
          </p>

          <div class="p-4 bg-[#FAF8F5] border border-[#E5E0D5] font-['JetBrains_Mono'] text-xs space-y-2 text-[#474A54]">
            <div class="flex items-start gap-2">
              <span class="text-[#121316] font-bold">Địa chỉ:</span>
              <span>Tầng 4, TTTM Nguyễn Kim, Số 06 Trần Phú, TP. Quy Nhơn, Bình Định</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#121316] font-bold">Hotline:</span>
              <span class="text-[#BA2D27] font-bold">1900 1744</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#121316] font-bold">Công nghệ:</span>
              <span class="text-[#A6853B] font-semibold">2D Digital, 3D RealD, Hệ thống âm thanh Dolby 7.1</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#121316] font-bold">Tiện ích:</span>
              <span>Khu Arcade Game, Trà sữa bắp ngọt, Bãi đỗ xe máy rộng rãi</span>
            </div>
          </div>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a href="/phim?cinema=Starlight" class="btn-editorial-primary text-xs !py-2.5 !px-6">
              Xem Lịch Chiếu Tại Starlight →
            </a>
            <a href="/dat-ve/sample?cinema=Starlight Nguyễn Kim" class="btn-editorial-secondary text-xs !py-2.5 !px-6">
              Đặt Suất Chiếu Hôm Nay
            </a>
          </div>
        </div>
      </article>

      <!-- THEATER 03: DCINE PHÚ TÀI CENTER -->
      <article id="dcine" class="bg-white border border-[#E5E0D5] p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center hover:border-[#121316] transition-all">
        <div class="lg:col-span-5 aspect-[16/11] bg-[#EFEBE3] border border-[#E5E0D5] overflow-hidden group">
          <img src="https://images.unsplash.com/photo-1574267432553-4b4628081c31?auto=format&fit=crop&w=1000&q=80" 
               alt="Dcine Phú Tài Center" 
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>

        <div class="lg:col-span-7 space-y-4">
          <div class="flex items-center gap-3 font-['JetBrains_Mono'] text-xs">
            <span class="px-2.5 py-0.5 bg-[#A6853B] text-white font-bold uppercase tracking-wider">CỤM RẠP 03</span>
            <span class="text-[#7A7E8B]">2 PHÒNG CHIẾU VIP • 160 GHẾ NGỒI</span>
          </div>

          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#121316]">
            Dcine Phú Tài Center Quy Nhơn
          </h2>

          <p class="text-xs text-[#474A54] leading-relaxed">
            Tổ hợp rạp chiếu phim boutique cao cấp tại ngã ba Đống Đa. Không gian thiết kế tối giản sang trọng, ghế sofa da ngả lưng tự động, máy chiếu Laser 4K sắc nét và dịch vụ miễn phí nạp thêm bắp rang.
          </p>

          <div class="p-4 bg-[#FAF8F5] border border-[#E5E0D5] font-['JetBrains_Mono'] text-xs space-y-2 text-[#474A54]">
            <div class="flex items-start gap-2">
              <span class="text-[#121316] font-bold">Địa chỉ:</span>
              <span>Tòa nhà Phú Tài Center, Ngã ba Đống Đa, P. Thị Nại, TP. Quy Nhơn</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#121316] font-bold">Hotline:</span>
              <span class="text-[#BA2D27] font-bold">0256 381 8888</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#121316] font-bold">Công nghệ:</span>
              <span class="text-[#A6853B] font-semibold">Máy chiếu Laser 4K, Ghế VIP Gold Class, Cafe sân thượng tầng 5</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#121316] font-bold">Đặc quyền:</span>
              <span>Free Popcorn Refill, Phòng chờ VIP sang trọng</span>
            </div>
          </div>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a href="/phim?cinema=Dcine" class="btn-editorial-primary text-xs !py-2.5 !px-6">
              Xem Lịch Chiếu Tại Dcine →
            </a>
            <a href="/dat-ve/sample?cinema=Dcine Quy Nhơn" class="btn-editorial-secondary text-xs !py-2.5 !px-6">
              Đặt Suất Chiếu Hôm Nay
            </a>
          </div>
        </div>
      </article>

    </div>

  </div>
</main>

<%- include('partials/footer') %>

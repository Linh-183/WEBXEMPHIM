<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — CineGo' : 'CineGo — Nền Tảng Giám Tuyển & Đặt Vé Điện Ảnh Quy Nhơn' %></title>
  
  <!-- Curatorial Typography: Plus Jakarta Sans + Be Vietnam Pro + Playfair Display + JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Material Symbols Icons (Restrained, functional only) -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@200..600,0..1&display=swap" rel="stylesheet" />
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            paper: {
              DEFAULT: '#FAF8F5',
              subtle: '#F3EFE6',
              pure: '#FFFFFF',
              dim: '#ECE7DD'
            },
            ink: {
              primary: '#121316',
              secondary: '#474A54',
              muted: '#7A7E8B',
              faint: '#A6AAB6'
            },
            cinnabar: {
              DEFAULT: '#BA2D27',
              dark: '#8E1F1A',
              soft: '#F9EBEA'
            },
            brass: {
              DEFAULT: '#A6853B',
              soft: '#FBF6EB'
            },
            theater: {
              DEFAULT: '#0E1015',
              surface: '#151820',
              elevated: '#1D212C'
            }
          },
          fontFamily: {
            sculpted: ['"Playfair Display"', '"Times New Roman"', 'serif'],
            editorial: ['"Playfair Display"', '"Times New Roman"', 'serif'],
            serif: ['"Playfair Display"', '"Times New Roman"', 'serif'],
            sans: ['"Plus Jakarta Sans"', '"Be Vietnam Pro"', '"Segoe UI"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'Consolas', 'monospace']
          }
        }
      }
    }
  </script>

  <!-- CineGo Contemporary Cinema Editorial CSS -->
  <link rel="stylesheet" href="/css/cinego-editorial.css?v=8.0">
  <link rel="stylesheet" href="/css/style.css?v=8.0">
</head>

<body class="bg-[#FAF8F5] text-[#121316] font-['Plus_Jakarta_Sans'] antialiased min-h-screen flex flex-col selection:bg-[#BA2D27] selection:text-white">

  <!-- =========================================================================
       1. BROADSHEET TICKER STRIP (CHRONICLE DISPATCH)
       ========================================================================= -->
  <aside class="w-full bg-[#121316] text-[#C8CBD4] text-[11px] font-['JetBrains_Mono'] py-1.5 px-4 sm:px-8 lg:px-12 border-b border-black/30">
    <div class="max-w-[1520px] mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-2.5 tracking-wider truncate">
        <span class="relative flex h-2 w-2 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#10B981]"></span>
        </span>
        <span class="text-white font-bold tracking-widest uppercase">ĐIỆN ẢNH QUY NHƠN</span>
        <span class="hidden md:inline text-white/30">/</span>
        <span class="hidden md:inline text-white/70">CGV KIM CÚC • STARLIGHT NGUYỄN KIM • DCINE QUY NHƠN</span>
      </div>
      <div class="flex items-center gap-4 sm:gap-6 text-white/70 shrink-0 text-[11px]">
        <span class="hidden sm:inline font-mono">HÔM NAY: 08:30 — 23:30</span>
        <a href="/bap-nuoc" class="text-[#D4AF37] hover:text-white font-bold transition-colors">
          Quầy Bắp Nước Online →
        </a>
        <a href="/khuyen-mai" class="text-[#EF4444] hover:text-white font-bold transition-colors">
          Khuyến Mãi & Ưu Đãi →
        </a>
      </div>
    </div>
  </aside>

  <!-- =========================================================================
       2. EDITORIAL MASTHEAD NAVIGATION (EXPANSIVE WIDE HEADER)
       ========================================================================= -->
  <header class="sticky top-0 w-full z-40 bg-[#FAF8F5]/95 backdrop-blur-md border-b border-[#E5E0D5] shadow-xs transition-all duration-200">
    <div class="max-w-[1520px] mx-auto px-4 sm:px-8 lg:px-12 h-[72px] flex items-center justify-between gap-4 lg:gap-6">
      
      <!-- BRAND LOGO / MASTHEAD -->
      <a href="/" class="flex items-center gap-3 group shrink-0 select-none py-1" aria-label="CineGo Trang Chủ">
        <div class="w-9 h-9 rounded-md bg-[#121316] text-[#FAF8F5] flex items-center justify-center font-serif font-black text-xl tracking-tight shadow-xs group-hover:bg-[#BA2D27] transition-all duration-300">
          C
        </div>
        <div class="flex flex-col">
          <span class="font-serif font-extrabold text-2xl tracking-[0.14em] text-[#121316] group-hover:text-[#BA2D27] transition-colors leading-none">
            CINEGO
          </span>
          <span class="font-['JetBrains_Mono'] text-[9px] tracking-[0.22em] text-[#7A7E8B] uppercase font-semibold mt-1">
            Cinema & Archive
          </span>
        </div>
      </a>

      <!-- CURATED NUMERICAL INDEX MENU -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-[12.5px] font-bold tracking-wider uppercase text-[#474A54]" aria-label="Điều hướng chính">
        <a href="/" class="cinego-nav-link group relative py-2 px-3 hover:text-[#BA2D27] transition-all rounded-md hover:bg-black/5 whitespace-nowrap flex items-center gap-1.5">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#A6853B] font-semibold opacity-75 group-hover:opacity-100 group-hover:text-[#BA2D27] transition-colors">01.</span>
          <span>Trang Chủ</span>
        </a>
        <a href="/phim" class="cinego-nav-link group relative py-2 px-3 hover:text-[#BA2D27] transition-all rounded-md hover:bg-black/5 whitespace-nowrap flex items-center gap-1.5">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#A6853B] font-semibold opacity-75 group-hover:opacity-100 group-hover:text-[#BA2D27] transition-colors">02.</span>
          <span>Lịch Chiếu</span>
        </a>
        <a href="/he-thong-rap" class="cinego-nav-link group relative py-2 px-3 hover:text-[#BA2D27] transition-all rounded-md hover:bg-black/5 whitespace-nowrap flex items-center gap-1.5">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#A6853B] font-semibold opacity-75 group-hover:opacity-100 group-hover:text-[#BA2D27] transition-colors">03.</span>
          <span>Cụm Rạp</span>
        </a>
        <a href="/bap-nuoc" class="cinego-nav-link group relative py-2 px-3 hover:text-[#BA2D27] transition-all rounded-md hover:bg-black/5 whitespace-nowrap flex items-center gap-1.5">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#A6853B] font-semibold opacity-75 group-hover:opacity-100 group-hover:text-[#BA2D27] transition-colors">04.</span>
          <span>Bắp Nước & Combo</span>
        </a>
        <a href="/khuyen-mai" class="cinego-nav-link group relative py-2 px-3 hover:text-[#BA2D27] transition-all rounded-md hover:bg-black/5 whitespace-nowrap flex items-center gap-1.5">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#A6853B] font-semibold opacity-75 group-hover:opacity-100 group-hover:text-[#BA2D27] transition-colors">05.</span>
          <span>Ưu Đãi & Hội Viên</span>
        </a>
      </nav>

      <!-- RIGHT UTILITY CONTROLS -->
      <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
        
        <!-- Search Trigger Button -->
        <button type="button" 
                onclick="toggleSearchModal(true)" 
                class="inline-flex items-center gap-2 h-9 px-3 text-[12px] font-['JetBrains_Mono'] text-[#474A54] hover:text-[#121316] bg-white border border-[#E5E0D5] hover:border-[#121316] transition-all rounded-md shadow-2xs whitespace-nowrap group cursor-pointer"
                aria-label="Tìm kiếm phim"
                title="Tìm kiếm phim (Ctrl+K)">
          <span class="material-symbols-outlined text-[17px] text-[#7A7E8B] group-hover:text-[#BA2D27] transition-colors">search</span>
          <span class="hidden md:inline text-[11px] font-medium tracking-wide">Tìm kiếm</span>
          <kbd class="hidden xl:inline-block px-1.5 py-0.5 text-[9px] font-mono bg-[#F3EFE6] text-[#7A7E8B] rounded border border-[#E5E0D5]">⌘K</kbd>
        </button>

        <!-- Quick Cinema Selector Pill -->
        <div class="hidden xl:flex items-center">
          <div class="relative inline-block text-left" id="cinemaDropdownContainer">
            <button type="button" 
                    id="quick-cinema-trigger"
                    onclick="toggleCinemaDropdown(event)"
                    class="inline-flex items-center gap-2 h-9 px-3 text-[11px] font-['JetBrains_Mono'] font-bold text-[#121316] bg-white border border-[#E5E0D5] hover:border-[#BA2D27] hover:bg-[#FAF8F5] transition-all rounded-md shadow-2xs whitespace-nowrap uppercase tracking-wider cursor-pointer select-none"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-controls="quick-cinema-menu">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-[#10B981]"></span>
              </span>
              <span id="header-cinema-label" class="truncate max-w-[125px]">CGV Kim Cúc</span>
              <span class="material-symbols-outlined text-[15px] text-[#7A7E8B] transition-transform duration-200" id="quick-cinema-arrow">expand_more</span>
            </button>
            
            <div id="quick-cinema-menu" class="hidden absolute right-0 top-full mt-2 w-64 bg-white border border-[#E5E0D5] rounded-xl shadow-2xl py-1.5 z-50 text-xs font-['Plus_Jakarta_Sans'] whitespace-normal overflow-hidden">
              <div class="px-3.5 py-2 text-[10px] font-['JetBrains_Mono'] uppercase tracking-widest text-[#7A7E8B] border-b border-[#F0ECE3] flex items-center justify-between">
                <span>Chọn cụm rạp Quy Nhơn</span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
              </div>
              <div class="p-1 space-y-0.5">
                <a href="/he-thong-rap#cgv" onclick="selectQuickCinema('CGV Kim Cúc')" class="flex items-center gap-2.5 px-3 py-2 text-[#121316] hover:bg-[#F9EBEA] hover:text-[#BA2D27] rounded-lg transition-colors font-semibold">
                  <span class="material-symbols-outlined text-base text-[#BA2D27]">movie</span>
                  <span>CGV Kim Cúc Plaza</span>
                </a>
                <a href="/he-thong-rap#starlight" onclick="selectQuickCinema('Starlight Quy Nhơn')" class="flex items-center gap-2.5 px-3 py-2 text-[#121316] hover:bg-[#F9EBEA] hover:text-[#BA2D27] rounded-lg transition-colors font-semibold">
                  <span class="material-symbols-outlined text-base text-[#BA2D27]">theaters</span>
                  <span>Starlight Nguyễn Kim</span>
                </a>
                <a href="/he-thong-rap#dcine" onclick="selectQuickCinema('DCine Quy Nhơn')" class="flex items-center gap-2.5 px-3 py-2 text-[#121316] hover:bg-[#F9EBEA] hover:text-[#BA2D27] rounded-lg transition-colors font-semibold">
                  <span class="material-symbols-outlined text-base text-[#BA2D27]">local_movies</span>
                  <span>DCine Quy Nhơn</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- User Authentication State -->
        <% if (typeof user !== 'undefined' && user) { %>
          <% if (user.vaiTro === 'admin') { %>
            <a href="/admin" 
               class="hidden sm:inline-flex items-center gap-1.5 h-9 px-3 bg-[#BA2D27] text-white hover:bg-[#8E1F1A] text-[11px] font-['JetBrains_Mono'] font-bold uppercase tracking-wider rounded-md transition-colors shadow-sm whitespace-nowrap select-none" 
               title="Truy cập Trang Quản Trị Hệ Thống">
              <span class="material-symbols-outlined text-[16px]">admin_panel_settings</span>
              <span>Quản Trị</span>
            </a>
          <% } %>

          <!-- Direct 1-Click "Vé Của Tôi" Button on Header -->
          <a href="/tai-khoan/ve-cua-toi" 
             class="inline-flex items-center gap-1.5 h-9 px-3.5 bg-[#121316] text-[#FAF8F5] hover:bg-[#BA2D27] border border-[#121316] hover:border-[#BA2D27] text-[11px] font-['JetBrains_Mono'] font-bold uppercase tracking-wider rounded-md transition-all duration-200 shadow-sm whitespace-nowrap select-none group" 
             title="Xem toàn bộ Vé Của Tôi & QR Check-in">
            <span class="material-symbols-outlined text-[16px] text-[#A6853B] group-hover:text-white transition-colors">confirmation_number</span>
            <span class="hidden sm:inline">Vé Của Tôi</span>
          </a>

          <!-- Logged In Menu -->
          <div class="relative inline-block text-left" id="userMenuDropdownContainer">
            <button type="button" 
                    id="user-profile-trigger"
                    onclick="toggleUserDropdown(event)" 
                    class="inline-flex items-center gap-2 h-9 pl-1 pr-2.5 bg-white border border-[#E5E0D5] hover:border-[#121316] rounded-md transition-all cursor-pointer select-none shadow-2xs"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-controls="user-profile-menu">
              <span class="w-7 h-7 rounded-sm bg-[#121316] text-[#FAF8F5] flex items-center justify-center font-serif font-black text-xs shrink-0">
                <%= (user.hoTen && user.hoTen.length > 0) ? user.hoTen.charAt(0).toUpperCase() : 'U' %>
              </span>
              <span class="hidden sm:inline font-bold text-xs text-[#121316] max-w-[110px] truncate">
                <%= user.hoTen || 'Thành viên' %>
              </span>
              <span class="material-symbols-outlined text-[15px] text-[#7A7E8B] transition-transform duration-200" id="user-profile-arrow">expand_more</span>
            </button>

            <!-- Dropdown Menu -->
            <div id="user-profile-menu" 
                 class="hidden absolute right-0 top-full mt-2 w-72 bg-white border border-[#E5E0D5] rounded-xl shadow-2xl py-2 z-50 text-xs font-['Plus_Jakarta_Sans'] whitespace-normal overflow-hidden">
              
              <!-- User Info Header Card -->
              <div class="px-4 py-3 bg-[#FAF8F5] border-b border-[#E5E0D5]/70">
                <div class="flex items-center gap-2.5">
                  <span class="w-9 h-9 rounded-md bg-[#121316] text-[#FAF8F5] flex items-center justify-center font-serif font-black text-sm shrink-0">
                    <%= (user.hoTen && user.hoTen.length > 0) ? user.hoTen.charAt(0).toUpperCase() : 'U' %>
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="font-bold text-sm text-[#121316] truncate font-serif"><%= user.hoTen %></div>
                    <div class="text-[11px] font-['JetBrains_Mono'] text-[#7A7E8B] truncate"><%= user.email %></div>
                  </div>
                </div>
                <div class="mt-2.5 flex items-center justify-between pt-2 border-t border-[#E5E0D5]/50">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[9px] font-['JetBrains_Mono'] uppercase tracking-widest bg-white border border-[#E5E0D5] text-[#BA2D27] font-bold rounded">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#BA2D27]"></span>
                    <%= user.vaiTro === 'admin' ? 'Quản trị viên' : 'Hội viên CineGo' %>
                  </span>
                  <span class="text-[10px] font-mono text-[#A6853B] font-bold">
                    <%= (user.diemTichLuy || 0).toLocaleString('vi-VN') %> Điểm
                  </span>
                </div>
              </div>

              <!-- Menu Items -->
              <div class="p-1.5 space-y-0.5">
                <% if (user.vaiTro === 'admin') { %>
                  <a href="/admin" class="flex items-center gap-2.5 px-3 py-2 text-[#BA2D27] hover:bg-[#F9EBEA] rounded-lg font-bold transition-colors">
                    <span class="material-symbols-outlined text-[18px]">dashboard</span>
                    <span>Bảng Quản Trị Hệ Thống</span>
                  </a>
                <% } %>

                <a href="/tai-khoan/thong-tin" class="flex items-center gap-2.5 px-3 py-2 text-[#474A54] hover:bg-[#FAF8F5] hover:text-[#121316] rounded-lg transition-colors font-medium">
                  <span class="material-symbols-outlined text-[18px] text-[#7A7E8B]">person</span>
                  <span>Hồ Sơ & Thể Loại Yêu Thích</span>
                </a>
                <a href="/tai-khoan/ve-cua-toi" class="flex items-center gap-2.5 px-3 py-2 text-[#474A54] hover:bg-[#FAF8F5] hover:text-[#121316] rounded-lg transition-colors font-medium">
                  <span class="material-symbols-outlined text-[18px] text-[#BA2D27]">confirmation_number</span>
                  <span>Vé Của Tôi (E-Ticket)</span>
                </a>
                <a href="/khuyen-mai" class="flex items-center gap-2.5 px-3 py-2 text-[#474A54] hover:bg-[#FAF8F5] hover:text-[#121316] rounded-lg transition-colors font-medium">
                  <span class="material-symbols-outlined text-[18px] text-[#A6853B]">loyalty</span>
                  <span>Ví Voucher & Điểm Thưởng</span>
                </a>
              </div>

              <div class="border-t border-[#E5E0D5] my-1 mx-2"></div>

              <!-- Logout -->
              <div class="p-1.5">
                <a href="/dang-xuat" class="flex items-center gap-2.5 px-3 py-2 text-[#BA2D27] hover:bg-[#F9EBEA] rounded-lg font-bold transition-colors">
                  <span class="material-symbols-outlined text-[18px]">logout</span>
                  <span>Đăng Xuất</span>
                </a>
              </div>
            </div>
          </div>
        <% } else { %>
          <!-- Guest Links -->
          <div class="flex items-center gap-2">
            <a href="/dang-nhap" class="h-9 inline-flex items-center px-3 text-xs font-bold uppercase tracking-wider text-[#121316] hover:text-[#BA2D27] transition-colors rounded-md hover:bg-black/5">
              Đăng Nhập
            </a>
            <a href="/dang-ky" class="h-9 inline-flex items-center px-4 bg-[#BA2D27] hover:bg-[#8E1F1A] text-white text-xs font-bold uppercase tracking-wider rounded-md transition-all shadow-sm">
              Đăng Ký
            </a>
          </div>
        <% } %>

        <!-- Mobile Drawer Menu Trigger -->
        <button type="button" 
                onclick="toggleMobileMenu(true)" 
                class="lg:hidden h-9 w-9 flex items-center justify-center text-[#121316] hover:text-[#BA2D27] border border-[#E5E0D5] hover:border-[#121316] rounded-md bg-white transition-colors cursor-pointer" 
                aria-label="Mở danh mục">
          <span class="material-symbols-outlined text-xl">menu</span>
        </button>

      </div>
    </div>
  </header>

  <!-- =========================================================================
       3. SEARCH OVERLAY MODAL (NATIVE HTML5 DIALOG PATTERN)
       ========================================================================= -->
  <dialog id="search-modal" class="cinego-dialog p-0 m-auto bg-transparent border-none" aria-labelledby="searchDialogTitle">
    <div class="bg-[#FAF8F5] border border-[#E5E0D5] rounded-xl w-[92vw] max-w-2xl p-6 sm:p-8 shadow-2xl relative text-[#121316]">
      <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-4">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#BA2D27]"></span>
          <span id="searchDialogTitle" class="font-['JetBrains_Mono'] text-xs uppercase tracking-[0.2em] text-[#7A7E8B] font-semibold">Tra cứu tác phẩm điện ảnh</span>
        </div>
        <button type="button" onclick="toggleSearchModal(false)" class="text-[#7A7E8B] hover:text-[#121316] p-1.5 rounded-lg hover:bg-black/5 transition-colors cursor-pointer" aria-label="Đóng tra cứu">
          <span class="material-symbols-outlined text-xl">close</span>
        </button>
      </div>

      <form action="/tim-kiem" method="GET" class="mt-6">
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-0 text-2xl text-[#BA2D27]">search</span>
          <input type="text" 
                 id="searchInput"
                 name="keyword" 
                 placeholder="Nhập tên phim, đạo diễn hoặc thể loại... (VD: Đào, Mai, Godzilla)" 
                 autocomplete="off"
                 class="w-full pl-9 pr-4 py-3 bg-transparent border-b-2 border-[#121316] text-lg sm:text-xl font-['Plus_Jakarta_Sans'] font-medium text-[#121316] placeholder:text-[#A6AAB6] focus:outline-none focus:border-[#BA2D27] transition-colors" />
        </div>
      </form>

      <!-- Instant Live Results Container -->
      <div id="searchResults" class="hidden mt-4 max-h-80 overflow-y-auto divide-y divide-[#E5E0D5]"></div>

      <div class="mt-6 flex flex-wrap items-center gap-2 text-[11px] font-['JetBrains_Mono'] text-[#7A7E8B] pt-4 border-t border-[#E5E0D5]/60">
        <span class="text-[#121316] font-bold">Gợi ý từ khóa:</span>
        <a href="/tim-kiem?keyword=Hành+động" class="px-2 py-0.5 bg-white border border-[#E5E0D5] rounded hover:border-[#BA2D27] hover:text-[#BA2D27] transition-colors">Hành Động</a>
        <a href="/tim-kiem?keyword=Khoa+học" class="px-2 py-0.5 bg-white border border-[#E5E0D5] rounded hover:border-[#BA2D27] hover:text-[#BA2D27] transition-colors">Khoa Học Viễn Tưởng</a>
        <a href="/tim-kiem?keyword=Tình+cảm" class="px-2 py-0.5 bg-white border border-[#E5E0D5] rounded hover:border-[#BA2D27] hover:text-[#BA2D27] transition-colors">Tâm Lý - Tình Cảm</a>
        <a href="/phim?status=DangChieu" class="px-2 py-0.5 bg-white border border-[#E5E0D5] rounded hover:border-[#BA2D27] hover:text-[#BA2D27] transition-colors">Phim Đang Chiếu</a>
      </div>
    </div>
  </dialog>

  <!-- =========================================================================
       4. MOBILE SLIDING DRAWER
       ========================================================================= -->
  <div id="mobile-drawer" class="hidden fixed inset-0 z-50 bg-[#121316]/70 backdrop-blur-sm">
    <div class="fixed top-0 right-0 w-full max-w-sm h-full bg-[#FAF8F5] border-l border-[#E5E0D5] p-6 flex flex-col justify-between overflow-y-auto shadow-2xl">
      <div>
        <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-4">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-md bg-[#121316] text-[#FAF8F5] flex items-center justify-center font-serif font-black text-lg">
              C
            </div>
            <span class="font-serif font-black text-xl tracking-[0.14em] text-[#121316]">CINEGO</span>
          </div>
          <button type="button" onclick="toggleMobileMenu(false)" class="text-[#7A7E8B] hover:text-[#121316] p-1.5 rounded-md hover:bg-black/5 cursor-pointer">
            <span class="material-symbols-outlined text-2xl">close</span>
          </button>
        </div>

        <nav class="mt-6 flex flex-col gap-2 font-['Plus_Jakarta_Sans'] text-sm uppercase font-bold text-[#121316]">
          <a href="/" class="cinego-mobile-link flex items-center justify-between py-2.5 px-3 rounded-lg hover:bg-black/5 hover:text-[#BA2D27] transition-all">
            <span>01. Trang Chủ</span>
            <span class="font-['JetBrains_Mono'] text-[11px] text-[#7A7E8B]">Home</span>
          </a>
          <a href="/phim" class="cinego-mobile-link flex items-center justify-between py-2.5 px-3 rounded-lg hover:bg-black/5 hover:text-[#BA2D27] transition-all">
            <span>02. Lịch Chiếu Phim</span>
            <span class="font-['JetBrains_Mono'] text-[11px] text-[#7A7E8B]">Movies</span>
          </a>
          <a href="/he-thong-rap" class="cinego-mobile-link flex items-center justify-between py-2.5 px-3 rounded-lg hover:bg-black/5 hover:text-[#BA2D27] transition-all">
            <span>03. Cụm Rạp Quy Nhơn</span>
            <span class="font-['JetBrains_Mono'] text-[11px] text-[#7A7E8B]">Theaters</span>
          </a>
          <a href="/bap-nuoc" class="cinego-mobile-link flex items-center justify-between py-2.5 px-3 rounded-lg hover:bg-black/5 hover:text-[#BA2D27] transition-all">
            <span>04. Bắp Nước & Combo</span>
            <span class="font-['JetBrains_Mono'] text-[11px] text-[#A6853B]">F&B</span>
          </a>
          <a href="/khuyen-mai" class="cinego-mobile-link flex items-center justify-between py-2.5 px-3 rounded-lg hover:bg-black/5 hover:text-[#BA2D27] transition-all">
            <span>05. Ưu Đãi & Hội Viên</span>
            <span class="font-['JetBrains_Mono'] text-[11px] text-[#BA2D27]">Vouchers</span>
          </a>
        </nav>
      </div>

      <div class="mt-8 pt-6 border-t border-[#E5E0D5] space-y-3">
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="p-3 bg-[#F3EFE6] rounded-lg border border-[#E5E0D5]">
            <span class="text-[#7A7E8B] text-[11px] font-mono uppercase tracking-wider block">Thành viên đăng nhập:</span>
            <span class="font-bold text-[#121316] text-sm"><%= user.hoTen %></span>
            <div class="text-[11px] font-mono text-[#A6853B] font-bold mt-0.5">
              <%= (user.diemTichLuy || 0).toLocaleString('vi-VN') %> Điểm thưởng
            </div>
          </div>
          <a href="/tai-khoan/ve-cua-toi" class="flex items-center justify-center gap-2 h-10 w-full bg-[#121316] text-white font-bold text-xs uppercase tracking-wider rounded-lg shadow-sm hover:bg-[#BA2D27] transition-colors">
            <span class="material-symbols-outlined text-base text-[#D4AF37]">confirmation_number</span>
            <span>Vé Của Tôi</span>
          </a>
          <a href="/dang-xuat" class="flex items-center justify-center gap-2 h-10 w-full border border-[#BA2D27] text-[#BA2D27] hover:bg-[#BA2D27] hover:text-white font-bold text-xs uppercase tracking-wider rounded-lg transition-colors">
            <span class="material-symbols-outlined text-base">logout</span>
            <span>Đăng Xuất</span>
          </a>
        <% } else { %>
          <a href="/dang-nhap" class="flex items-center justify-center h-10 w-full border border-[#121316] text-[#121316] hover:bg-black/5 font-bold text-xs uppercase tracking-wider rounded-lg transition-colors">
            Đăng Nhập
          </a>
          <a href="/dang-ky" class="flex items-center justify-center h-10 w-full bg-[#BA2D27] hover:bg-[#8E1F1A] text-white font-bold text-xs uppercase tracking-wider rounded-lg transition-colors shadow-sm">
            Đăng Ký Tài Khoản
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Global scripts for Header UI -->
  <script>
    function toggleSearchModal(show) {
      const modal = document.getElementById('search-modal');
      if (!modal) return;
      if (show) {
        if (typeof modal.showModal === 'function') {
          if (!modal.open) modal.showModal();
        } else {
          modal.classList.remove('hidden');
        }
        setTimeout(() => document.getElementById('searchInput')?.focus(), 60);
      } else {
        if (typeof modal.close === 'function') {
          if (modal.open) modal.close();
        } else {
          modal.classList.add('hidden');
        }
      }
    }

    // Native backdrop light-dismiss for search modal
    document.getElementById('search-modal')?.addEventListener('click', function(e) {
      if (e.target === this) {
        toggleSearchModal(false);
      }
    });

    function toggleMobileMenu(show) {
      const drawer = document.getElementById('mobile-drawer');
      if (drawer) drawer.classList.toggle('hidden', !show);
    }

    function selectQuickCinema(cinemaName) {
      const label = document.getElementById('header-cinema-label');
      if (label) label.innerText = cinemaName;
      const menu = document.getElementById('quick-cinema-menu');
      if (menu) menu.classList.add('hidden');
      const arrow = document.getElementById('quick-cinema-arrow');
      if (arrow) arrow.style.transform = 'rotate(0deg)';
      document.getElementById('quick-cinema-trigger')?.setAttribute('aria-expanded', 'false');
    }

    // Debounced Live Search Autocomplete with AbortController
    let searchDebounce = null;
    let searchAbortController = null;
    document.getElementById('searchInput')?.addEventListener('input', function(e) {
      clearTimeout(searchDebounce);
      if (searchAbortController) {
        searchAbortController.abort();
      }
      const val = e.target.value.trim();
      const resultsBox = document.getElementById('searchResults');
      if (!val || val.length < 2) {
        if (resultsBox) resultsBox.classList.add('hidden');
        return;
      }

      searchDebounce = setTimeout(async () => {
        searchAbortController = new AbortController();
        try {
          const res = await fetch('/api/tim-kiem?tuKhoa=' + encodeURIComponent(val), {
            signal: searchAbortController.signal
          });
          const list = await res.json();
          if (resultsBox) {
            resultsBox.innerHTML = '';
            if (list.length === 0) {
              resultsBox.innerHTML = '<div class="py-4 text-xs font-[\'JetBrains_Mono\'] text-[#7A7E8B]">Không tìm thấy tác phẩm phù hợp.</div>';
            } else {
              list.forEach(item => {
                const row = document.createElement('a');
                row.href = '/chi-tiet-phim/' + item._id;
                row.className = 'flex items-center gap-3 py-3 hover:bg-[#F3EFE6] transition-colors';
                row.innerHTML = `
                  <img src="${item.posterUrl || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=100&q=80'}" 
                       class="w-10 h-14 object-cover border border-[#E5E0D5] rounded" 
                       alt="${item.title}" 
                       loading="lazy" 
                       decoding="async" 
                       width="40" 
                       height="56" />
                  <div>
                    <div class="font-bold text-sm text-[#121316] font-serif">${item.title}</div>
                    <div class="text-[11px] font-['JetBrains_Mono'] text-[#7A7E8B] mt-0.5">${item.ageRating || 'P'} • Đang Chiếu</div>
                  </div>
                `;
                resultsBox.appendChild(row);
              });
            }
            resultsBox.classList.remove('hidden');
          }
        } catch(err) {
          if (err.name !== 'AbortError') console.error(err);
        }
      }, 250);
    });

    // Dropdown Controllers: Quick Cinema & User Menu with smooth indicator arrows
    function toggleCinemaDropdown(e) {
      if (e) e.stopPropagation();
      const menu = document.getElementById('quick-cinema-menu');
      const userMenu = document.getElementById('user-profile-menu');
      const cinemaArrow = document.getElementById('quick-cinema-arrow');
      const userArrow = document.getElementById('user-profile-arrow');
      
      if (userMenu) {
        userMenu.classList.add('hidden');
        document.getElementById('user-profile-trigger')?.setAttribute('aria-expanded', 'false');
        if (userArrow) userArrow.style.transform = 'rotate(0deg)';
      }
      if (!menu) return;
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        document.getElementById('quick-cinema-trigger')?.setAttribute('aria-expanded', 'true');
        if (cinemaArrow) cinemaArrow.style.transform = 'rotate(180deg)';
      } else {
        menu.classList.add('hidden');
        document.getElementById('quick-cinema-trigger')?.setAttribute('aria-expanded', 'false');
        if (cinemaArrow) cinemaArrow.style.transform = 'rotate(0deg)';
      }
    }

    function toggleUserDropdown(e) {
      if (e) e.stopPropagation();
      const menu = document.getElementById('user-profile-menu');
      const cinemaMenu = document.getElementById('quick-cinema-menu');
      const cinemaArrow = document.getElementById('quick-cinema-arrow');
      const userArrow = document.getElementById('user-profile-arrow');

      if (cinemaMenu) {
        cinemaMenu.classList.add('hidden');
        document.getElementById('quick-cinema-trigger')?.setAttribute('aria-expanded', 'false');
        if (cinemaArrow) cinemaArrow.style.transform = 'rotate(0deg)';
      }
      if (!menu) return;
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        document.getElementById('user-profile-trigger')?.setAttribute('aria-expanded', 'true');
        if (userArrow) userArrow.style.transform = 'rotate(180deg)';
      } else {
        menu.classList.add('hidden');
        document.getElementById('user-profile-trigger')?.setAttribute('aria-expanded', 'false');
        if (userArrow) userArrow.style.transform = 'rotate(0deg)';
      }
    }

    // Đóng dropdown khi click bên ngoài menu
    document.addEventListener('click', function(e) {
      const qMenu = document.getElementById('quick-cinema-menu');
      const uMenu = document.getElementById('user-profile-menu');
      const cinemaArrow = document.getElementById('quick-cinema-arrow');
      const userArrow = document.getElementById('user-profile-arrow');

      if (qMenu && !qMenu.classList.contains('hidden') && !e.target.closest('#quick-cinema-menu') && !e.target.closest('#quick-cinema-trigger')) {
        qMenu.classList.add('hidden');
        document.getElementById('quick-cinema-trigger')?.setAttribute('aria-expanded', 'false');
        if (cinemaArrow) cinemaArrow.style.transform = 'rotate(0deg)';
      }
      if (uMenu && !uMenu.classList.contains('hidden') && !e.target.closest('#user-profile-menu') && !e.target.closest('#user-profile-trigger')) {
        uMenu.classList.add('hidden');
        document.getElementById('user-profile-trigger')?.setAttribute('aria-expanded', 'false');
        if (userArrow) userArrow.style.transform = 'rotate(0deg)';
      }
    });

    // Keyboard shortcut Ctrl+K / Cmd+K to open Search modal
    document.addEventListener('keydown', function(e) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        toggleSearchModal(true);
      }
      if (e.key === 'Escape') {
        toggleSearchModal(false);
        const qMenu = document.getElementById('quick-cinema-menu');
        const uMenu = document.getElementById('user-profile-menu');
        const cinemaArrow = document.getElementById('quick-cinema-arrow');
        const userArrow = document.getElementById('user-profile-arrow');
        if (qMenu) qMenu.classList.add('hidden');
        if (uMenu) uMenu.classList.add('hidden');
        if (cinemaArrow) cinemaArrow.style.transform = 'rotate(0deg)';
        if (userArrow) userArrow.style.transform = 'rotate(0deg)';
      }
    });

    // Tự động làm sáng màu mục Menu đang truy cập trên Header
    (function highlightActiveMenu() {
      const p = window.location.pathname;
      document.querySelectorAll('.cinego-nav-link').forEach(link => {
        const href = link.getAttribute('href');
        let isActive = false;
        if (href === '/') {
          isActive = (p === '/');
        } else {
          isActive = (p === href || (href !== '/' && p.startsWith(href)));
        }
        if (isActive) {
          link.classList.remove('text-[#474A54]');
          link.classList.add('text-[#BA2D27]', 'bg-[#F9EBEA]/80', 'font-extrabold');
          const badge = link.querySelector('.nav-num-badge');
          if (badge) {
            badge.classList.remove('text-[#A6853B]', 'opacity-75');
            badge.classList.add('text-[#BA2D27]', 'opacity-100', 'font-bold');
          }
        }
      });

      document.querySelectorAll('.cinego-mobile-link').forEach(link => {
        const href = link.getAttribute('href');
        let isActive = false;
        if (href === '/') {
          isActive = (p === '/');
        } else {
          isActive = (p === href || (href !== '/' && p.startsWith(href)));
        }
        if (isActive) {
          link.classList.add('text-[#BA2D27]', 'font-extrabold', 'pl-3', 'border-l-4', 'border-[#BA2D27]', 'bg-[#F9EBEA]/40');
        }
      });
    })();
  </script>

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — CineGo' : 'CineGo — Nền Tảng Giám Tuyển & Đặt Vé Điện Ảnh Quy Nhơn' %></title>
  
  <!-- Curatorial Typography: Plus Jakarta Sans + Be Vietnam Pro + Playfair Display + JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Material Symbols Icons (Restrained, functional only) -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@200..600,0..1&display=swap" rel="stylesheet" />
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            paper: {
              DEFAULT: '#FAF8F5',
              subtle: '#F3EFE6',
              pure: '#FFFFFF',
              dim: '#ECE7DD'
            },
            ink: {
              primary: '#121316',
              secondary: '#474A54',
              muted: '#7A7E8B',
              faint: '#A6AAB6'
            },
            cinnabar: {
              DEFAULT: '#BA2D27',
              dark: '#8E1F1A',
              soft: '#F9EBEA'
            },
            brass: {
              DEFAULT: '#A6853B',
              soft: '#FBF6EB'
            },
            theater: {
              DEFAULT: '#0E1015',
              surface: '#151820',
              elevated: '#1D212C'
            }
          },
          fontFamily: {
            sculpted: ['"Playfair Display"', '"Times New Roman"', 'serif'],
            editorial: ['"Playfair Display"', '"Times New Roman"', 'serif'],
            serif: ['"Playfair Display"', '"Times New Roman"', 'serif'],
            sans: ['"Plus Jakarta Sans"', '"Be Vietnam Pro"', '"Segoe UI"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'Consolas', 'monospace']
          }
        }
      }
    }
  </script>

  <!-- CineGo Contemporary Cinema Editorial CSS -->
  <link rel="stylesheet" href="/css/cinego-editorial.css?v=8.0">
  <link rel="stylesheet" href="/css/style.css?v=8.0">
</head>

<body class="bg-[#FAF8F5] text-[#121316] font-['Plus_Jakarta_Sans'] antialiased min-h-screen flex flex-col selection:bg-[#BA2D27] selection:text-white">

  <!-- =========================================================================
       1. BROADSHEET TICKER STRIP (CHRONICLE DISPATCH)
       ========================================================================= -->
  <aside class="w-full bg-[#F3EFE6] border-b border-[#E5E0D5] text-[11px] font-['JetBrains_Mono'] py-2 px-6 sm:px-10 lg:px-14 text-[#7A7E8B]">
    <div class="max-w-[1520px] mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-3 tracking-wider">
        <span class="inline-block w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
        <span class="text-[#121316] font-semibold">ĐIỆN ẢNH QUY NHƠN</span>
        <span class="hidden md:inline text-[#CDC6B8]">/</span>
        <span class="hidden md:inline">CGV KIM CÚC • STARLIGHT NGUYỄN KIM • DCINE QUY NHƠN</span>
      </div>
      <div class="flex items-center gap-5 text-[#474A54]">
        <span class="hidden sm:inline">HÔM NAY: 08:30 — 23:30</span>
        <a href="/bap-nuoc" class="text-[#A6853B] hover:underline font-bold transition-colors">
          Quầy Bắp Nước Online →
        </a>
        <a href="/khuyen-mai" class="text-[#BA2D27] hover:underline font-bold transition-colors">
          Khuyến Mãi & Ưu Đãi →
        </a>
      </div>
    </div>
  </aside>

  <!-- =========================================================================
       2. EDITORIAL MASTHEAD NAVIGATION (EXPANSIVE WIDE HEADER)
       ========================================================================= -->
  <header class="sticky top-0 w-full z-40 bg-[#FAF8F5]/95 backdrop-blur-md border-b border-[#E5E0D5] transition-all duration-200">
    <div class="max-w-[1520px] mx-auto px-6 sm:px-10 lg:px-14 h-20 flex items-center justify-between gap-6">
      
      <!-- LOGO / MASTHEAD -->
      <a href="/" class="flex flex-col group shrink-0" aria-label="CineGo Trang Chủ">
        <span class="font-serif font-bold text-2xl sm:text-3xl tracking-[0.16em] text-[#121316] group-hover:text-[#BA2D27] transition-colors leading-none">
          CINEGO
        </span>
        <span class="font-['JetBrains_Mono'] text-[9px] tracking-[0.3em] text-[#7A7E8B] uppercase mt-1">
          Cinema & Archive
        </span>
      </a>

      <!-- CURATED NUMERICAL INDEX MENU -->
      <nav class="hidden lg:flex items-center gap-7 text-[12px] font-bold tracking-wider uppercase text-[#474A54]" aria-label="Điều hướng chính">
        <a href="/" class="cinego-nav-link hover:text-[#BA2D27] transition-all flex items-center gap-1.5 py-2">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B]">01.</span> Trang Chủ
        </a>
        <a href="/phim" class="cinego-nav-link hover:text-[#BA2D27] transition-all flex items-center gap-1.5 py-2">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B]">02.</span> Lịch Chiếu
        </a>
        <a href="/he-thong-rap" class="cinego-nav-link hover:text-[#BA2D27] transition-all flex items-center gap-1.5 py-2">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B]">03.</span> 3 Cụm Rạp
        </a>
        <a href="/bap-nuoc" class="cinego-nav-link hover:text-[#BA2D27] transition-all flex items-center gap-1.5 py-2">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B]">04.</span> Bắp Nước & Combo
        </a>
        <a href="/khuyen-mai" class="cinego-nav-link hover:text-[#BA2D27] transition-all flex items-center gap-1.5 py-2">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B]">05.</span> Ưu Đãi & Hội Viên
        </a>
      </nav>

      <!-- RIGHT UTILITY CONTROLS -->
      <div class="flex items-center gap-4 sm:gap-6">
        
        <!-- Search Trigger Button -->
        <button type="button" 
                onclick="toggleSearchModal(true)" 
                class="flex items-center gap-2 text-[12px] font-['JetBrains_Mono'] text-[#474A54] hover:text-[#121316] py-2 px-3 border border-[#E5E0D5] hover:border-[#121316] transition-colors rounded-none"
                aria-label="Tìm kiếm phim">
          <span class="material-symbols-outlined text-base">search</span>
          <span class="hidden md:inline uppercase text-[10px] tracking-wider">Tìm kiếm</span>
        </button>

        <!-- Quick Cinema Selector Pill -->
        <div class="hidden xl:flex items-center">
          <div class="relative inline-block text-left">
            <button type="button" 
                    id="quick-cinema-trigger"
                    popovertarget="quick-cinema-menu"
                    onclick="if(!this.popoverTargetElement) document.getElementById('quick-cinema-menu')?.classList.toggle('hidden')"
                    class="flex items-center gap-2 text-[11px] font-['JetBrains_Mono'] text-[#121316] bg-[#F3EFE6] px-3.5 py-2 border border-[#E5E0D5] hover:border-[#CDC6B8] transition-colors uppercase tracking-wider cursor-pointer"
                    aria-haspopup="menu"
                    aria-controls="quick-cinema-menu">
              <span class="w-1.5 h-1.5 rounded-full bg-[#BA2D27]"></span>
              <span id="header-cinema-label">CGV Kim Cúc</span>
              <span class="material-symbols-outlined text-[14px]">expand_more</span>
            </button>
            <div id="quick-cinema-menu" popover="auto" class="cinego-popover absolute right-0 mt-1 w-64 bg-white border border-[#E5E0D5] shadow-xl py-1 z-50 text-xs font-['Plus_Jakarta_Sans']">
              <div class="px-3 py-1.5 text-[10px] font-['JetBrains_Mono'] uppercase tracking-widest text-[#7A7E8B] border-b border-[#E5E0D5]">
                Chọn cụm rạp Quy Nhơn
              </div>
              <a href="/he-thong-rap#cgv" onclick="selectQuickCinema('CGV Kim Cúc')" class="block px-3 py-2 text-[#121316] hover:bg-[#FAF8F5] hover:text-[#BA2D27] font-medium">
                CGV Kim Cúc Plaza
              </a>
              <a href="/he-thong-rap#starlight" onclick="selectQuickCinema('Starlight Quy Nhơn')" class="block px-3 py-2 text-[#121316] hover:bg-[#FAF8F5] hover:text-[#BA2D27] font-medium">
                Starlight Nguyễn Kim
              </a>
              <a href="/he-thong-rap#dcine" onclick="selectQuickCinema('DCine Quy Nhơn')" class="block px-3 py-2 text-[#121316] hover:bg-[#FAF8F5] hover:text-[#BA2D27] font-medium">
                DCine Quy Nhơn
              </a>
            </div>
          </div>
        </div>

        <!-- User Authentication State -->
        <% if (typeof user !== 'undefined' && user) { %>
          <% if (user.vaiTro === 'admin') { %>
            <a href="/admin" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#BA2D27] text-white text-[11px] font-['JetBrains_Mono'] font-bold uppercase tracking-wider hover:bg-[#8E1F1A] transition-colors shadow-sm" title="Truy cập Trang Quản Trị Hệ Thống">
              <span class="material-symbols-outlined text-sm">admin_panel_settings</span>
              <span>Trang Quản Trị</span>
            </a>
          <% } %>

          <!-- Logged In Menu -->
          <div class="relative">
            <button type="button" 
                    id="user-profile-trigger"
                    popovertarget="user-profile-menu"
                    onclick="if(!this.popoverTargetElement) document.getElementById('user-profile-menu')?.classList.toggle('hidden')" 
                    class="flex items-center gap-2.5 py-1.5 px-3 border border-[#E5E0D5] hover:border-[#121316] bg-white transition-all cursor-pointer"
                    aria-haspopup="menu"
                    aria-controls="user-profile-menu">
              <span class="w-7 h-7 bg-[#121316] text-[#FAF8F5] flex items-center justify-center font-serif font-bold text-xs">
                <%= (user.hoTen && user.hoTen.length > 0) ? user.hoTen.charAt(0).toUpperCase() : 'U' %>
              </span>
              <span class="hidden sm:inline font-bold text-xs text-[#121316] max-w-[120px] truncate">
                <%= user.hoTen || 'Thành viên' %>
              </span>
              <span class="material-symbols-outlined text-[14px] text-[#7A7E8B]">expand_more</span>
            </button>

            <!-- Dropdown Menu -->
            <div id="user-profile-menu" popover="auto" class="cinego-popover absolute right-0 mt-2 w-56 bg-white border border-[#E5E0D5] shadow-xl py-2 z-50 text-xs font-['Plus_Jakarta_Sans']">
              <div class="px-4 py-2 border-b border-[#E5E0D5]">
                <div class="font-bold text-[#121316] truncate"><%= user.hoTen %></div>
                <div class="text-[11px] font-['JetBrains_Mono'] text-[#7A7E8B] truncate"><%= user.email %></div>
                <div class="mt-1 inline-block px-1.5 py-0.5 text-[9px] font-['JetBrains_Mono'] uppercase tracking-widest bg-[#F3EFE6] text-[#BA2D27] font-bold">
                  <%= user.vaiTro === 'admin' ? 'Quản trị viên' : 'Hội viên CineGo' %>
                </div>
              </div>

              <% if (user.vaiTro === 'admin') { %>
                <a href="/admin" class="flex items-center gap-2 px-4 py-2.5 text-[#BA2D27] hover:bg-[#FAF8F5] font-bold">
                  <span class="material-symbols-outlined text-sm">dashboard</span>
                  Bảng Quản Trị Hệ Thống
                </a>
              <% } %>

              <a href="/tai-khoan/thong-tin" class="flex items-center gap-2 px-4 py-2 text-[#474A54] hover:bg-[#FAF8F5] hover:text-[#121316]">
                <span class="material-symbols-outlined text-sm">person</span>
                Hồ Sơ & Thể Loại Yêu Thích
              </a>
              <a href="/tai-khoan/ve-cua-toi" class="flex items-center gap-2 px-4 py-2 text-[#474A54] hover:bg-[#FAF8F5] hover:text-[#121316]">
                <span class="material-symbols-outlined text-sm">confirmation_number</span>
                Vé Của Tôi (E-Ticket)
              </a>
              <a href="/khuyen-mai" class="flex items-center gap-2 px-4 py-2 text-[#474A54] hover:bg-[#FAF8F5] hover:text-[#121316]">
                <span class="material-symbols-outlined text-sm">loyalty</span>
                Ví Voucher & Điểm Thưởng
              </a>
              <div class="border-t border-[#E5E0D5] my-1"></div>
              <a href="/dang-xuat" class="flex items-center gap-2 px-4 py-2 text-[#BA2D27] hover:bg-[#FAF8F5] font-bold">
                <span class="material-symbols-outlined text-sm">logout</span>
                Đăng Xuất
              </a>
            </div>
          </div>
        <% } else { %>
          <!-- Guest Links -->
          <div class="flex items-center gap-3">
            <a href="/dang-nhap" class="text-xs font-bold uppercase tracking-wider text-[#121316] hover:text-[#BA2D27] transition-colors py-2 px-2">
              Đăng Nhập
            </a>
            <a href="/dang-ky" class="btn-editorial-primary text-xs !py-2 !px-3.5">
              Đăng Ký
            </a>
          </div>
        <% } %>

        <!-- Mobile Drawer Menu Trigger -->
        <button type="button" 
                onclick="toggleMobileMenu(true)" 
                class="lg:hidden p-2 text-[#121316] hover:text-[#BA2D27] border border-[#E5E0D5]" 
                aria-label="Mở danh mục">
          <span class="material-symbols-outlined text-2xl">menu</span>
        </button>

      </div>
    </div>
  </header>

  <!-- =========================================================================
       3. SEARCH OVERLAY MODAL (NATIVE HTML5 DIALOG PATTERN)
       ========================================================================= -->
  <dialog id="search-modal" class="cinego-dialog p-0 m-auto bg-transparent border-none" aria-labelledby="searchDialogTitle">
    <div class="bg-[#FAF8F5] border border-[#E5E0D5] w-[92vw] max-w-2xl p-6 sm:p-8 shadow-2xl relative text-[#121316]">
      <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-4">
        <span id="searchDialogTitle" class="font-serif text-xs uppercase tracking-[0.25em] text-[#7A7E8B]">Tra cứu tác phẩm điện ảnh</span>
        <button type="button" onclick="toggleSearchModal(false)" class="text-[#7A7E8B] hover:text-[#121316] p-1" aria-label="Đóng tra cứu">
          <span class="material-symbols-outlined text-xl">close</span>
        </button>
      </div>

      <form action="/tim-kiem" method="GET" class="mt-6">
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-0 text-xl text-[#7A7E8B]">search</span>
          <input type="text" 
                 id="searchInput"
                 name="keyword" 
                 placeholder="Nhập tên phim, đạo diễn hoặc thể loại..." 
                 autocomplete="off"
                 class="w-full pl-8 pr-4 py-3 bg-transparent border-b-2 border-[#121316] text-lg sm:text-xl font-['Plus_Jakarta_Sans'] font-medium text-[#121316] placeholder:text-[#A6AAB6] focus:outline-none focus:border-[#BA2D27]" />
        </div>
      </form>

      <!-- Instant Live Results Container -->
      <div id="searchResults" class="hidden mt-4 max-h-80 overflow-y-auto divide-y divide-[#E5E0D5]"></div>

      <div class="mt-6 flex flex-wrap gap-2 text-[11px] font-['JetBrains_Mono'] text-[#7A7E8B]">
        <span class="text-[#121316] font-bold">Gợi ý từ khóa:</span>
        <a href="/tim-kiem?keyword=Hành+động" class="hover:text-[#BA2D27] underline">Hành Động</a>
        <span>•</span>
        <a href="/tim-kiem?keyword=Khoa+học" class="hover:text-[#BA2D27] underline">Khoa Học Viễn Tưởng</a>
        <span>•</span>
        <a href="/tim-kiem?keyword=Tình+cảm" class="hover:text-[#BA2D27] underline">Tâm Lý - Tình Cảm</a>
        <span>•</span>
        <a href="/phim?status=DangChieu" class="hover:text-[#BA2D27] underline">Phim Đang Chiếu</a>
      </div>
    </div>
  </dialog>

  <!-- =========================================================================
       4. MOBILE SLIDING DRAWER
       ========================================================================= -->
  <div id="mobile-drawer" class="hidden fixed inset-0 z-50 bg-[#121316]/70 backdrop-blur-sm">
    <div class="fixed top-0 right-0 w-full max-w-sm h-full bg-[#FAF8F5] border-l border-[#E5E0D5] p-6 flex flex-col justify-between overflow-y-auto">
      <div>
        <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-4">
          <span class="font-serif font-bold text-xl tracking-[0.16em] text-[#121316]">CINEGO</span>
          <button type="button" onclick="toggleMobileMenu(false)" class="text-[#7A7E8B] hover:text-[#121316]">
            <span class="material-symbols-outlined text-2xl">close</span>
          </button>
        </div>

        <nav class="mt-8 flex flex-col gap-5 font-['Plus_Jakarta_Sans'] text-sm uppercase font-bold text-[#121316]">
          <a href="/" class="cinego-mobile-link flex items-center justify-between hover:text-[#BA2D27] pb-3 border-b border-[#E5E0D5] transition-all">
            <span>01. Trang Chủ</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[#7A7E8B]">Home</span>
          </a>
          <a href="/phim" class="cinego-mobile-link flex items-center justify-between hover:text-[#BA2D27] pb-3 border-b border-[#E5E0D5] transition-all">
            <span>02. Lịch Chiếu Phim</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[#7A7E8B]">Movies</span>
          </a>
          <a href="/he-thong-rap" class="cinego-mobile-link flex items-center justify-between hover:text-[#BA2D27] pb-3 border-b border-[#E5E0D5] transition-all">
            <span>03. Hệ Thống 3 Cụm Rạp</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[#7A7E8B]">Quy Nhơn</span>
          </a>
          <a href="/bap-nuoc" class="cinego-mobile-link flex items-center justify-between hover:text-[#BA2D27] pb-3 border-b border-[#E5E0D5] transition-all">
            <span>04. Bắp Nước & Combo</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[#A6853B]">Concessions</span>
          </a>
          <a href="/khuyen-mai" class="cinego-mobile-link flex items-center justify-between hover:text-[#BA2D27] pb-3 border-b border-[#E5E0D5] transition-all">
            <span>05. Ưu Đãi & Hội Viên</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[#BA2D27]">Vouchers</span>
          </a>
        </nav>
      </div>

      <div class="mt-8 pt-6 border-t border-[#E5E0D5] space-y-4">
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="text-xs">
            <span class="text-[#7A7E8B] block">Đang đăng nhập:</span>
            <span class="font-bold text-[#121316] text-sm"><%= user.hoTen %></span>
          </div>
          <a href="/tai-khoan/ve-cua-toi" class="btn-editorial-secondary w-full text-center">Vé Của Tôi</a>
          <a href="/dang-xuat" class="btn-editorial-primary w-full text-center !bg-[#BA2D27]">Đăng Xuất</a>
        <% } else { %>
          <a href="/dang-nhap" class="btn-editorial-secondary w-full text-center">Đăng Nhập</a>
          <a href="/dang-ky" class="btn-editorial-primary w-full text-center">Đăng Ký Tài Khoản</a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Global scripts for Header UI -->
  <script>
    function toggleSearchModal(show) {
      const modal = document.getElementById('search-modal');
      if (!modal) return;
      if (show) {
        if (typeof modal.showModal === 'function') {
          if (!modal.open) modal.showModal();
        } else {
          modal.classList.remove('hidden');
        }
        setTimeout(() => document.getElementById('searchInput')?.focus(), 60);
      } else {
        if (typeof modal.close === 'function') {
          if (modal.open) modal.close();
        } else {
          modal.classList.add('hidden');
        }
      }
    }

    // Native backdrop light-dismiss for search modal
    document.getElementById('search-modal')?.addEventListener('click', function(e) {
      if (e.target === this) {
        toggleSearchModal(false);
      }
    });

    function toggleMobileMenu(show) {
      const drawer = document.getElementById('mobile-drawer');
      if (drawer) drawer.classList.toggle('hidden', !show);
    }

    function selectQuickCinema(cinemaName) {
      const label = document.getElementById('header-cinema-label');
      if (label) label.innerText = cinemaName;
      const menu = document.getElementById('quick-cinema-menu');
      if (menu) {
        if (typeof menu.hidePopover === 'function' && menu.matches(':popover-open')) {
          menu.hidePopover();
        }
        menu.classList.add('hidden');
      }
    }

    // Debounced Live Search Autocomplete with AbortController
    let searchDebounce = null;
    let searchAbortController = null;
    document.getElementById('searchInput')?.addEventListener('input', function(e) {
      clearTimeout(searchDebounce);
      if (searchAbortController) {
        searchAbortController.abort();
      }
      const val = e.target.value.trim();
      const resultsBox = document.getElementById('searchResults');
      if (!val || val.length < 2) {
        if (resultsBox) resultsBox.classList.add('hidden');
        return;
      }

      searchDebounce = setTimeout(async () => {
        searchAbortController = new AbortController();
        try {
          const res = await fetch('/api/tim-kiem?tuKhoa=' + encodeURIComponent(val), {
            signal: searchAbortController.signal
          });
          const list = await res.json();
          if (resultsBox) {
            resultsBox.innerHTML = '';
            if (list.length === 0) {
              resultsBox.innerHTML = '<div class="py-4 text-xs font-[\'JetBrains_Mono\'] text-[#7A7E8B]">Không tìm thấy tác phẩm phù hợp.</div>';
            } else {
              list.forEach(item => {
                const row = document.createElement('a');
                row.href = '/chi-tiet-phim/' + item._id;
                row.className = 'flex items-center gap-3 py-3 hover:bg-[#F3EFE6] transition-colors';
                row.innerHTML = `
                  <img src="${item.posterUrl || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=100&q=80'}" 
                       class="w-10 h-14 object-cover border border-[#E5E0D5]" 
                       alt="${item.title}" 
                       loading="lazy" 
                       decoding="async" 
                       width="40" 
                       height="56" />
                  <div>
                    <div class="font-bold text-sm text-[#121316] font-serif">${item.title}</div>
                    <div class="text-[11px] font-['JetBrains_Mono'] text-[#7A7E8B] mt-0.5">${item.ageRating || 'P'} • Đang Chiếu</div>
                  </div>
                `;
                resultsBox.appendChild(row);
              });
            }
            resultsBox.classList.remove('hidden');
          }
        } catch(err) {
          if (err.name !== 'AbortError') console.error(err);
        }
      }, 250);
    });

    // Close dropdowns on outside click (fallback for browsers without Popover API)
    document.addEventListener('click', function(e) {
      const qMenu = document.getElementById('quick-cinema-menu');
      const uMenu = document.getElementById('user-profile-menu');
      if (qMenu && !qMenu.matches?.(':popover-open') && !e.target.closest('#quick-cinema-menu') && !e.target.closest('button[popovertarget="quick-cinema-menu"]')) {
        qMenu.classList.add('hidden');
      }
      if (uMenu && !uMenu.matches?.(':popover-open') && !e.target.closest('#user-profile-menu') && !e.target.closest('button[popovertarget="user-profile-menu"]')) {
        uMenu.classList.add('hidden');
      }
    });

    // Tự động làm sáng màu mục Menu đang truy cập trên Header
    (function highlightActiveMenu() {
      const p = window.location.pathname;
      document.querySelectorAll('.cinego-nav-link').forEach(link => {
        const href = link.getAttribute('href');
        let isActive = false;
        if (href === '/') {
          isActive = (p === '/');
        } else {
          isActive = (p === href || (href !== '/' && p.startsWith(href)));
        }
        if (isActive) {
          link.classList.remove('text-[#474A54]');
          link.classList.add('text-[#BA2D27]', 'border-b-2', 'border-[#BA2D27]', 'font-extrabold', 'bg-[#F9EBEA]/60', 'px-2', 'rounded-t-sm');
          const badge = link.querySelector('.nav-num-badge');
          if (badge) {
            badge.classList.remove('text-[#7A7E8B]', 'text-[#A6853B]');
            badge.classList.add('text-[#BA2D27]', 'font-bold');
          }
        }
      });

      document.querySelectorAll('.cinego-mobile-link').forEach(link => {
        const href = link.getAttribute('href');
        let isActive = false;
        if (href === '/') {
          isActive = (p === '/');
        } else {
          isActive = (p === href || (href !== '/' && p.startsWith(href)));
        }
        if (isActive) {
          link.classList.add('text-[#BA2D27]', 'font-extrabold', 'pl-3', 'border-l-4', 'border-[#BA2D27]', 'bg-[#F9EBEA]/40');
        }
      });
    })();
  </script>

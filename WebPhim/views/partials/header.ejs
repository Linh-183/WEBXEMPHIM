<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — CineGo' : 'CineGo — Nền Tảng Giám Tuyển & Đặt Vé Điện Ảnh Quy Nhơn' %></title>
  
  <!-- Curatorial Typography: Plus Jakarta Sans + Be Vietnam Pro + Playfair Display + JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Material Symbols Icons (Restrained, functional only) -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@200..600,0..1&display=swap" rel="stylesheet" />
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            paper: {
              DEFAULT: '#FAF8F5',
              subtle: '#F3EFE6',
              pure: '#FFFFFF',
              dim: '#ECE7DD'
            },
            ink: {
              primary: '#121316',
              secondary: '#474A54',
              muted: '#7A7E8B',
              faint: '#A6AAB6'
            },
            cinnabar: {
              DEFAULT: '#BA2D27',
              dark: '#8E1F1A',
              soft: '#F9EBEA'
            },
            brass: {
              DEFAULT: '#A6853B',
              soft: '#FBF6EB'
            },
            theater: {
              DEFAULT: '#0E1015',
              surface: '#151820',
              elevated: '#1D212C'
            }
          },
          fontFamily: {
            sculpted: ['"Playfair Display"', '"Times New Roman"', 'serif'],
            editorial: ['"Playfair Display"', '"Times New Roman"', 'serif'],
            serif: ['"Playfair Display"', '"Times New Roman"', 'serif'],
            sans: ['"Plus Jakarta Sans"', '"Be Vietnam Pro"', '"Segoe UI"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'Consolas', 'monospace']
          }
        }
      }
    }
  </script>

  <!-- CineGo Contemporary Cinema Editorial CSS -->
  <link rel="stylesheet" href="/css/cinego-editorial.css?v=8.0">
  <link rel="stylesheet" href="/css/style.css?v=8.0">
</head>

<body class="bg-[#FAF8F5] text-[#121316] font-['Plus_Jakarta_Sans'] antialiased min-h-screen flex flex-col selection:bg-[#BA2D27] selection:text-white overflow-x-hidden">

  <!-- =========================================================================
       1. BROADSHEET TICKER STRIP (CHRONICLE DISPATCH)
       ========================================================================= -->
  <aside class="w-full bg-[#F3EFE6] border-b border-[#E5E0D5] text-[11px] font-['JetBrains_Mono'] py-1.5 px-4 sm:px-6 lg:px-8 text-[#7A7E8B]">
    <div class="max-w-[1520px] mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-2.5 tracking-wider truncate">
        <span class="inline-block w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
        <span class="text-[#121316] font-semibold">ĐIỆN ẢNH QUY NHƠN</span>
      </div>
      <div class="flex items-center gap-4 text-[#474A54] text-[11px] shrink-0">
        <span class="hidden sm:inline">HÔM NAY: 08:30 — 23:30</span>
        <a href="/bap-nuoc" class="text-[#A6853B] hover:underline font-bold transition-colors">
          Quầy Bắp Nước Online →
        </a>
        <a href="/khuyen-mai" class="text-[#BA2D27] hover:underline font-bold transition-colors">
          Khuyến Mãi & Ưu Đãi →
        </a>
      </div>
    </div>
  </aside>

  <!-- =========================================================================
       2. EDITORIAL MASTHEAD NAVIGATION (COMPACT & BALANCED)
       ========================================================================= -->
  <header class="sticky top-0 w-full z-40 bg-[#FAF8F5]/95 backdrop-blur-md border-b border-[#E5E0D5] transition-all duration-200">
    <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-[68px] flex items-center justify-between gap-3 lg:gap-4">
      
      <!-- LOGO / MASTHEAD -->
      <a href="/" class="flex flex-col group shrink-0" aria-label="CineGo Trang Chủ">
        <span class="font-serif font-bold text-xl sm:text-2xl tracking-[0.14em] text-[#121316] group-hover:text-[#BA2D27] transition-colors leading-none">
          CINEGO
        </span>
        <span class="font-['JetBrains_Mono'] text-[8.5px] tracking-[0.25em] text-[#7A7E8B] uppercase mt-0.5">
          Cinema & Archive
        </span>
      </a>

      <!-- CURATED NUMERICAL INDEX MENU -->
      <nav class="hidden lg:flex items-center gap-3 xl:gap-5 text-[11.5px] font-bold tracking-wider uppercase text-[#474A54]" aria-label="Điều hướng chính">
        <a href="/" class="cinego-nav-link hover:text-[#BA2D27] transition-all flex items-center gap-1 py-1.5 whitespace-nowrap">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B]">01.</span> Trang Chủ
        </a>
        <a href="/phim" class="cinego-nav-link hover:text-[#BA2D27] transition-all flex items-center gap-1 py-1.5 whitespace-nowrap">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B]">02.</span> Lịch Chiếu
        </a>
        <a href="/he-thong-rap" class="cinego-nav-link hover:text-[#BA2D27] transition-all flex items-center gap-1 py-1.5 whitespace-nowrap">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B]">03.</span> 3 Cụm Rạp
        </a>
        <a href="/bap-nuoc" class="cinego-nav-link hover:text-[#BA2D27] transition-all flex items-center gap-1 py-1.5 whitespace-nowrap">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B]">04.</span> Bắp Nước & Combo
        </a>
        <a href="/khuyen-mai" class="cinego-nav-link hover:text-[#BA2D27] transition-all flex items-center gap-1 py-1.5 whitespace-nowrap">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B]">05.</span> Ưu Đãi & Hội Viên
        </a>
        <a href="/tai-khoan/ve-cua-toi" class="cinego-nav-link hover:text-[#BA2D27] transition-all flex items-center gap-1 py-1.5 whitespace-nowrap">
          <span class="nav-num-badge font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B]">06.</span> Vé Của Tôi
        </a>
      </nav>

      <!-- RIGHT UTILITY CONTROLS -->
      <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
        
        <!-- INLINE SEARCH WITH DIRECT DROPDOWN (NO POPUP MODAL) -->
        <div class="relative" id="headerSearchContainer">
          <form action="/tim-kiem" method="GET" class="flex items-center border border-[#E5E0D5] hover:border-[#121316] focus-within:border-[#121316] bg-white transition-colors">
            <span class="material-symbols-outlined text-[17px] text-[#7A7E8B] pl-2 select-none">search</span>
            <input type="text"
                   id="headerSearchInput"
                   name="keyword"
                   placeholder="Tìm kiếm..."
                   autocomplete="off"
                   class="w-24 sm:w-36 lg:w-44 py-1.5 px-2 text-[11px] font-['Plus_Jakarta_Sans'] text-[#121316] placeholder:text-[#A6AAB6] bg-transparent focus:outline-none"
                   onfocus="openHeaderSearchDropdown()" />
            <button type="button" id="headerSearchClear" onclick="clearHeaderSearchInput()" class="hidden pr-2 text-[#A6AAB6] hover:text-[#121316]">
              <span class="material-symbols-outlined text-[15px]">close</span>
            </button>
          </form>

          <!-- DROPDOWN ANCHORED DIRECTLY BELOW SEARCH -->
          <div id="headerSearchDropdown" class="hidden absolute right-0 top-full mt-2 w-80 sm:w-96 bg-[#FAF8F5] border-2 border-[#121316] shadow-2xl z-50 p-4 max-h-[420px] overflow-y-auto">
            <div class="flex items-center justify-between pb-2 border-b border-[#E5E0D5] text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">
              <span class="font-bold uppercase tracking-wider">KẾT QUẢ TÌM KIẾM</span>
              <span id="headerSearchCount" class="text-[#BA2D27] font-bold"></span>
            </div>

            <div id="headerSearchResults" class="divide-y divide-[#E5E0D5] mt-1">
              <div class="py-4 text-center text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">
                Nhập tên phim, đạo diễn hoặc thể loại...
              </div>
            </div>

            <div class="pt-3 mt-3 border-t border-[#E5E0D5] text-[10.5px] font-['JetBrains_Mono'] text-[#7A7E8B] flex flex-wrap items-center gap-2">
              <span class="text-[#121316] font-bold">Gợi ý:</span>
              <a href="/tim-kiem?keyword=Hành+động" class="hover:text-[#BA2D27] underline">Hành Động</a> •
              <a href="/tim-kiem?keyword=Khoa+học" class="hover:text-[#BA2D27] underline">Viễn Tưởng</a> •
              <a href="/phim?status=DangChieu" class="hover:text-[#BA2D27] underline">Đang Chiếu</a>
            </div>
          </div>
        </div>

        <!-- User Authentication State -->
        <% if (typeof user !== 'undefined' && user) { %>
          <% if (user.vaiTro === 'admin') { %>
            <a href="/admin" class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1.5 bg-[#BA2D27] text-white text-[10.5px] font-['JetBrains_Mono'] font-bold uppercase tracking-wider hover:bg-[#8E1F1A] transition-colors shadow-sm whitespace-nowrap" title="Truy cập Trang Quản Trị Hệ Thống">
              <span class="material-symbols-outlined text-[15px]">admin_panel_settings</span>
              <span>Quản Trị</span>
            </a>
          <% } %>

          <!-- Logged In Menu -->
          <div class="relative inline-block text-left" id="userMenuDropdownContainer">
            <button type="button" 
                    id="user-profile-trigger"
                    onclick="toggleUserDropdown(event)" 
                    class="flex items-center gap-2 py-1.5 px-2.5 border border-[#E5E0D5] hover:border-[#121316] bg-white transition-all cursor-pointer select-none whitespace-nowrap"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-controls="user-profile-menu">
              <span class="w-6 h-6 bg-[#121316] text-[#FAF8F5] flex items-center justify-center font-serif font-bold text-[11px] shrink-0">
                <%= (user.hoTen && user.hoTen.length > 0) ? user.hoTen.charAt(0).toUpperCase() : 'U' %>
              </span>
              <span class="hidden sm:inline font-bold text-xs text-[#121316] max-w-[220px] truncate" title="<%= user.hoTen %>">
                <%= user.hoTen || 'Thành viên' %>
              </span>
              <span class="material-symbols-outlined text-[14px] text-[#7A7E8B]">expand_more</span>
            </button>

            <!-- Dropdown Menu -->
            <div id="user-profile-menu" class="hidden absolute right-0 top-full mt-2 w-64 bg-white border border-[#E5E0D5] shadow-2xl py-2 z-50 text-xs font-['Plus_Jakarta_Sans'] whitespace-normal">
              <div class="px-4 py-2 border-b border-[#E5E0D5]">
                <div class="font-bold text-[#121316] truncate"><%= user.hoTen %></div>
                <div class="text-[11px] font-['JetBrains_Mono'] text-[#7A7E8B] truncate"><%= user.email %></div>
                <div class="mt-1 inline-block px-1.5 py-0.5 text-[9px] font-['JetBrains_Mono'] uppercase tracking-widest bg-[#F3EFE6] text-[#BA2D27] font-bold">
                  <%= user.vaiTro === 'admin' ? 'Quản trị viên' : 'Hội viên CineGo' %>
                </div>
              </div>

              <% if (user.vaiTro === 'admin') { %>
                <a href="/admin" class="flex items-center gap-2 px-4 py-2.5 text-[#BA2D27] hover:bg-[#FAF8F5] font-bold">
                  <span class="material-symbols-outlined text-sm">dashboard</span>
                  Bảng Quản Trị Hệ Thống
                </a>
              <% } %>

              <a href="/tai-khoan/thong-tin" class="flex items-center gap-2 px-4 py-2 text-[#474A54] hover:bg-[#FAF8F5] hover:text-[#121316]">
                <span class="material-symbols-outlined text-sm">person</span>
                Hồ Sơ & Thể Loại Yêu Thích
              </a>
              <a href="/tai-khoan/ve-cua-toi" class="flex items-center gap-2 px-4 py-2 text-[#474A54] hover:bg-[#FAF8F5] hover:text-[#121316]">
                <span class="material-symbols-outlined text-sm">confirmation_number</span>
                Vé Của Tôi (E-Ticket)
              </a>
              <a href="/khuyen-mai" class="flex items-center gap-2 px-4 py-2 text-[#474A54] hover:bg-[#FAF8F5] hover:text-[#121316]">
                <span class="material-symbols-outlined text-sm">loyalty</span>
                Ví Voucher & Điểm Thưởng
              </a>
              <div class="border-t border-[#E5E0D5] my-1"></div>
              <a href="/dang-xuat" class="flex items-center gap-2 px-4 py-2 text-[#BA2D27] hover:bg-[#FAF8F5] font-bold">
                <span class="material-symbols-outlined text-sm">logout</span>
                Đăng Xuất
              </a>
            </div>
          </div>
        <% } else { %>
          <!-- Guest Links -->
          <div class="flex items-center gap-2 sm:gap-3">
            <a href="/dang-nhap" class="text-xs font-bold uppercase tracking-wider text-[#121316] hover:text-[#BA2D27] transition-colors py-2 px-2 whitespace-nowrap">
              Đăng Nhập
            </a>
            <a href="/dang-ky" class="btn-editorial-primary text-xs !py-2 !px-3.5 whitespace-nowrap">
              Đăng Ký
            </a>
          </div>
        <% } %>

        <!-- Mobile Drawer Menu Trigger -->
        <button type="button" 
                onclick="toggleMobileMenu(true)" 
                class="lg:hidden p-2 text-[#121316] hover:text-[#BA2D27] border border-[#E5E0D5]" 
                aria-label="Mở danh mục">
          <span class="material-symbols-outlined text-2xl">menu</span>
        </button>

      </div>
    </div>
  </header>



  <!-- =========================================================================
       4. MOBILE SLIDING DRAWER
       ========================================================================= -->
  <div id="mobile-drawer" class="hidden fixed inset-0 z-50 bg-[#121316]/70 backdrop-blur-sm">
    <div class="fixed top-0 right-0 w-full max-w-sm h-full bg-[#FAF8F5] border-l border-[#E5E0D5] p-6 flex flex-col justify-between overflow-y-auto">
      <div>
        <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-4">
          <span class="font-serif font-bold text-xl tracking-[0.16em] text-[#121316]">CINEGO</span>
          <button type="button" onclick="toggleMobileMenu(false)" class="text-[#7A7E8B] hover:text-[#121316] cursor-pointer">
            <span class="material-symbols-outlined text-2xl">close</span>
          </button>
        </div>

        <nav class="mt-8 flex flex-col gap-5 font-['Plus_Jakarta_Sans'] text-sm uppercase font-bold text-[#121316]">
          <a href="/" class="cinego-mobile-link flex items-center justify-between hover:text-[#BA2D27] pb-3 border-b border-[#E5E0D5] transition-all">
            <span>01. Trang Chủ</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[#7A7E8B]">Home</span>
          </a>
          <a href="/phim" class="cinego-mobile-link flex items-center justify-between hover:text-[#BA2D27] pb-3 border-b border-[#E5E0D5] transition-all">
            <span>02. Lịch Chiếu Phim</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[#7A7E8B]">Movies</span>
          </a>
          <a href="/he-thong-rap" class="cinego-mobile-link flex items-center justify-between hover:text-[#BA2D27] pb-3 border-b border-[#E5E0D5] transition-all">
            <span>03. Hệ Thống 3 Cụm Rạp</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[#7A7E8B]">Quy Nhơn</span>
          </a>
          <a href="/bap-nuoc" class="cinego-mobile-link flex items-center justify-between hover:text-[#BA2D27] pb-3 border-b border-[#E5E0D5] transition-all">
            <span>04. Bắp Nước & Combo</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[#A6853B]">Concessions</span>
          </a>
          <a href="/khuyen-mai" class="cinego-mobile-link flex items-center justify-between hover:text-[#BA2D27] pb-3 border-b border-[#E5E0D5] transition-all">
            <span>05. Ưu Đãi & Hội Viên</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[#BA2D27]">Vouchers</span>
          </a>
          <a href="/tai-khoan/ve-cua-toi" class="cinego-mobile-link flex items-center justify-between hover:text-[#BA2D27] pb-3 border-b border-[#E5E0D5] transition-all">
            <span>06. Vé Của Tôi</span>
            <span class="font-['JetBrains_Mono'] text-xs text-[#BA2D27]">E-Ticket</span>
          </a>
        </nav>
      </div>

      <div class="mt-8 pt-6 border-t border-[#E5E0D5] space-y-4">
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="text-xs">
            <span class="text-[#7A7E8B] block">Đang đăng nhập:</span>
            <span class="font-bold text-[#121316] text-sm"><%= user.hoTen %></span>
          </div>
          <a href="/tai-khoan/ve-cua-toi" class="btn-editorial-secondary w-full text-center">Vé Của Tôi</a>
          <a href="/dang-xuat" class="btn-editorial-primary w-full text-center !bg-[#BA2D27]">Đăng Xuất</a>
        <% } else { %>
          <a href="/dang-nhap" class="btn-editorial-secondary w-full text-center">Đăng Nhập</a>
          <a href="/dang-ky" class="btn-editorial-primary w-full text-center">Đăng Ký Tài Khoản</a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Global scripts for Header UI -->
  <script>
    function openHeaderSearchDropdown() {
      const dropdown = document.getElementById('headerSearchDropdown');
      if (dropdown) dropdown.classList.remove('hidden');
    }

    function closeHeaderSearchDropdown() {
      const dropdown = document.getElementById('headerSearchDropdown');
      if (dropdown) dropdown.classList.add('hidden');
    }

    function clearHeaderSearchInput() {
      const input = document.getElementById('headerSearchInput');
      const clearBtn = document.getElementById('headerSearchClear');
      const resultsBox = document.getElementById('headerSearchResults');
      const countEl = document.getElementById('headerSearchCount');
      if (input) {
        input.value = '';
        input.focus();
      }
      if (clearBtn) clearBtn.classList.add('hidden');
      if (countEl) countEl.innerText = '';
      if (resultsBox) {
        resultsBox.innerHTML = '<div class="py-4 text-center text-xs font-[\'JetBrains_Mono\'] text-[#7A7E8B]">Nhập tên phim, đạo diễn hoặc thể loại...</div>';
      }
    }

    // Dismiss search dropdown on click outside
    document.addEventListener('click', function(e) {
      const container = document.getElementById('headerSearchContainer');
      if (container && !container.contains(e.target)) {
        closeHeaderSearchDropdown();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeHeaderSearchDropdown();
      }
    });

    function toggleMobileMenu(show) {
      const drawer = document.getElementById('mobile-drawer');
      if (drawer) drawer.classList.toggle('hidden', !show);
    }

    // Debounced Live Search Autocomplete with AbortController
    let searchDebounce = null;
    let searchAbortController = null;
    document.getElementById('headerSearchInput')?.addEventListener('input', function(e) {
      clearTimeout(searchDebounce);
      if (searchAbortController) {
        searchAbortController.abort();
      }
      const val = e.target.value.trim();
      const resultsBox = document.getElementById('headerSearchResults');
      const clearBtn = document.getElementById('headerSearchClear');
      const countEl = document.getElementById('headerSearchCount');

      if (clearBtn) clearBtn.classList.toggle('hidden', !val);

      if (!val || val.length < 1) {
        if (countEl) countEl.innerText = '';
        if (resultsBox) {
          resultsBox.innerHTML = '<div class="py-4 text-center text-xs font-[\'JetBrains_Mono\'] text-[#7A7E8B]">Nhập tên phim, đạo diễn hoặc thể loại...</div>';
        }
        return;
      }

      openHeaderSearchDropdown();

      searchDebounce = setTimeout(async () => {
        searchAbortController = new AbortController();
        try {
          const res = await fetch('/api/tim-kiem?tuKhoa=' + encodeURIComponent(val), {
            signal: searchAbortController.signal
          });
          const list = await res.json();
          if (resultsBox) {
            resultsBox.innerHTML = '';
            if (countEl) countEl.innerText = `(${list.length})`;
            if (list.length === 0) {
              resultsBox.innerHTML = '<div class="py-6 text-center text-xs font-[\'JetBrains_Mono\'] text-[#7A7E8B]">Không tìm thấy phim phù hợp với từ khóa này.</div>';
            } else {
              list.forEach(item => {
                const row = document.createElement('a');
                row.href = '/chi-tiet-phim/' + item._id;
                row.className = 'flex items-center gap-3 py-2.5 px-2 hover:bg-white border border-transparent hover:border-[#E5E0D5] transition-all rounded-xs';
                row.innerHTML = `
                  <img src="${item.posterUrl || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=100&q=80'}" 
                       class="w-10 h-14 object-cover border border-[#E5E0D5] shrink-0" 
                       alt="${item.title}" 
                       loading="lazy" 
                       decoding="async" 
                       width="40" 
                       height="56" />
                  <div class="flex-1 min-w-0 text-left">
                    <div class="font-bold text-xs text-[#121316] font-['Plus_Jakarta_Sans'] truncate">${item.title}</div>
                    <div class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B] mt-0.5 truncate">${item.genre || 'Điện ảnh'}</div>
                    <div class="text-[10px] font-['JetBrains_Mono'] text-[#BA2D27] font-semibold mt-0.5">${item.status === 'DangChieu' ? 'Đang Chiếu' : 'Sắp Chiếu'} • ${item.ageRating || 'P'}</div>
                  </div>
                  <span class="material-symbols-outlined text-sm text-[#A6AAB6] shrink-0">chevron_right</span>
                `;
                resultsBox.appendChild(row);
              });
            }
          }
        } catch(err) {
          if (err.name !== 'AbortError') console.error(err);
        }
      }, 200);
    });

    // Dropdown Controller: User Profile Menu
    function toggleUserDropdown(e) {
      if (e) e.stopPropagation();
      const menu = document.getElementById('user-profile-menu');
      if (!menu) return;
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        document.getElementById('user-profile-trigger')?.setAttribute('aria-expanded', 'true');
      } else {
        menu.classList.add('hidden');
        document.getElementById('user-profile-trigger')?.setAttribute('aria-expanded', 'false');
      }
    }

    // Đóng dropdown khi click bên ngoài menu
    document.addEventListener('click', function(e) {
      const uMenu = document.getElementById('user-profile-menu');
      if (uMenu && !uMenu.classList.contains('hidden') && !e.target.closest('#user-profile-menu') && !e.target.closest('#user-profile-trigger')) {
        uMenu.classList.add('hidden');
        document.getElementById('user-profile-trigger')?.setAttribute('aria-expanded', 'false');
      }
    });

    // Tự động làm sáng màu mục Menu đang truy cập trên Header
    (function highlightActiveMenu() {
      const p = window.location.pathname;
      document.querySelectorAll('.cinego-nav-link').forEach(link => {
        const href = link.getAttribute('href');
        let isActive = false;
        if (href === '/') {
          isActive = (p === '/');
        } else {
          isActive = (p === href || (href !== '/' && p.startsWith(href)));
        }
        if (isActive) {
          link.classList.remove('text-[#474A54]');
          link.classList.add('text-[#BA2D27]', 'font-extrabold');
          const badge = link.querySelector('.nav-num-badge');
          if (badge) {
            badge.classList.remove('text-[#7A7E8B]');
            badge.classList.add('text-[#BA2D27]', 'font-bold');
          }
        }
      });

      document.querySelectorAll('.cinego-mobile-link').forEach(link => {
        const href = link.getAttribute('href');
        let isActive = false;
        if (href === '/') {
          isActive = (p === '/');
        } else {
          isActive = (p === href || (href !== '/' && p.startsWith(href)));
        }
        if (isActive) {
          link.classList.add('text-[#BA2D27]', 'font-extrabold', 'pl-3', 'border-l-4', 'border-[#BA2D27]', 'bg-[#F9EBEA]/40');
        }
      });
    })();
  </script>

  <!-- =========================================================================
       EDITORIAL BROADSHEET COLOPHON FOOTER
       ========================================================================= -->
  <footer class="mt-auto bg-[#F3EFE6] border-t border-[#E5E0D5] text-[#474A54] font-['Plus_Jakarta_Sans']">
    
    <!-- Top Ledger Strip -->
    <div class="border-b border-[#E5E0D5] py-4 px-6 sm:px-10 lg:px-14">
      <div class="max-w-[1520px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-['JetBrains_Mono']">
        <div class="flex items-center gap-3">
          <span class="font-bold text-[#121316] uppercase tracking-wider">CINEGO ARCHIVE</span>
          <span class="text-[#CDC6B8]">•</span>
          <span class="text-[#7A7E8B]">NỀN TẢNG ĐẶT VÉ ĐIỆN ẢNH ĐƯƠNG ĐẠI TẠI TP. QUY NHƠN</span>
        </div>
        <div class="flex items-center gap-6 text-[#7A7E8B]">
          <span>HOTLINE ĐẶT VÉ: <strong class="text-[#121316]">12345678</strong></span>
          <a href="#top" class="text-[#BA2D27] hover:underline font-bold">Về đầu trang ↑</a>
        </div>
      </div>
    </div>

    <!-- Main Broadsheet Columns -->
    <div class="max-w-[1520px] mx-auto px-6 sm:px-10 lg:px-14 py-14">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
        
        <!-- Col 1: Masthead & Essence (Span 4) -->
        <div class="lg:col-span-4 space-y-4">
          <div class="flex flex-col">
            <span class="font-['Georgia'] font-bold text-2xl tracking-[0.16em] text-[#121316]">
              CINEGO
            </span>
            <span class="font-['JetBrains_Mono'] text-[9px] tracking-[0.3em] text-[#7A7E8B] uppercase mt-0.5">
              Quy Nhơn Cinema Chronicle
            </span>
          </div>
          <p class="text-xs text-[#7A7E8B] leading-relaxed max-w-sm">
            Nền tảng giám tuyển và phân phối vé điện ảnh hiện đại cho 3 cụm rạp hàng đầu tại Quy Nhơn. Tối ưu trải nghiệm đặt vé với sơ đồ ghế trực quan và ưu đãi độc quyền.
          </p>
          <div class="pt-2 font-['JetBrains_Mono'] text-[11px] text-[#7A7E8B] space-y-1">
            <div>GIẤY PHÉP ĐIỆN ẢNH SỐ: <span class="text-[#121316] font-semibold">48/GP-BTTTT</span></div>
            <div>BẢN QUYỀN THUỘC VỀ: <span class="text-[#121316] font-semibold">CINEGO VIETNAM © 2024 — 2026</span></div>
          </div>
        </div>

        <!-- Col 2: The 3 Quy Nhon Cinemas Dossier (Span 4) -->
        <div class="lg:col-span-4 space-y-3">
          <h4 class="font-['Georgia'] text-xs font-bold uppercase tracking-[0.2em] text-[#121316] pb-2 border-b border-[#E5E0D5]">
            Hệ Thống 3 Cụm Rạp Quy Nhơn
          </h4>
          <ul class="space-y-3 text-xs">
            <li class="border-l-2 border-[#BA2D27] pl-3 py-0.5">
              <strong class="text-[#121316] block font-semibold">1. CGV Kim Cúc Plaza</strong>
              <span class="text-[#7A7E8B] block text-[11px]">Tầng 3, TTTM Kim Cúc Plaza, P. Ghềnh Ráng</span>
            </li>
            <li class="border-l-2 border-[#121316] pl-3 py-0.5">
              <strong class="text-[#121316] block font-semibold">2. Starlight Nguyễn Kim</strong>
              <span class="text-[#7A7E8B] block text-[11px]">Tầng 8, TTTM Nguyễn Kim, An Dương Vương</span>
            </li>
            <li class="border-l-2 border-[#A6853B] pl-3 py-0.5">
              <strong class="text-[#121316] block font-semibold">3. DCine Quy Nhơn</strong>
              <span class="text-[#7A7E8B] block text-[11px]">Tầng 4 Trung Tâm Phú Tài, Trần Hưng Đạo</span>
            </li>
          </ul>
        </div>

        <!-- Col 3: Editorial Directory (Span 2) -->
        <div class="lg:col-span-2 space-y-3">
          <h4 class="font-['Georgia'] text-xs font-bold uppercase tracking-[0.2em] text-[#121316] pb-2 border-b border-[#E5E0D5]">
            Mục Lục
          </h4>
          <ul class="space-y-2 text-xs font-medium">
            <li><a href="/" class="hover:text-[#BA2D27] transition-colors">Trang Chủ</a></li>
            <li><a href="/phim?status=DangChieu" class="hover:text-[#BA2D27] transition-colors">Phim Đang Chiếu</a></li>
            <li><a href="/phim?status=SapChieu" class="hover:text-[#BA2D27] transition-colors">Phim Sắp Chiếu</a></li>
            <li><a href="/he-thong-rap" class="hover:text-[#BA2D27] transition-colors">Cụm Rạp Quy Nhơn</a></li>
            <li><a href="/bap-nuoc" class="hover:text-[#BA2D27] transition-colors text-[#A6853B] font-bold">Bắp Nước & Combo</a></li>
            <li><a href="/khuyen-mai" class="hover:text-[#BA2D27] transition-colors">Khuyến Mãi & Voucher</a></li>
            <li><a href="/tai-khoan/thong-tin" class="hover:text-[#BA2D27] transition-colors">Hội Viên Thân Thiết</a></li>
          </ul>
        </div>

        <!-- Col 4: Customer Care & Standards (Span 2) -->
        <div class="lg:col-span-2 space-y-3">
          <h4 class="font-['Georgia'] text-xs font-bold uppercase tracking-[0.2em] text-[#121316] pb-2 border-b border-[#E5E0D5]">
            Dịch Vụ & Hỗ Trợ
          </h4>
          <div class="space-y-2 text-[11px] font-['JetBrains_Mono'] text-[#7A7E8B]">
            <div class="p-2.5 bg-white border border-[#E5E0D5]">
              <span class="text-[#10B981] font-bold block mb-1">TỔNG ĐÀI HỖ TRỢ</span>
              Hotline: <strong class="text-[#121316]">12345678</strong> (08:30 – 23:30 hàng ngày).
            </div>
            <div class="p-2.5 bg-white border border-[#E5E0D5]">
              <span class="text-[#BA2D27] font-bold block mb-1">VÉ ĐIỆN TỬ E-TICKET</span>
              Mã QR thông minh, vào rạp trực tiếp không cần đổi vé giấy.
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom Colophon Bar -->
    <div class="border-t border-[#E5E0D5] py-6 px-6 sm:px-10 lg:px-14 bg-[#FAF8F5]">
      <div class="max-w-[1520px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">
        <div>
          THIẾT KẾ THEO QUY CHUẨN ĐỒ HỌA BIÊN TẬP ĐIỆN ẢNH ĐƯƠNG ĐẠI (CONTEMPORARY CINEMA EDITORIAL).
        </div>
        <div class="flex items-center gap-4 text-[11px]">
          <span>ĐIỀU KHOẢN SỬ DỤNG</span>
          <span>•</span>
          <span>CHÍNH SÁCH BẢO MẬT</span>
          <span>•</span>
          <span>QUY CHẾ HOẠT ĐỘNG</span>
        </div>
      </div>
    </div>

  </footer>

  <!-- Toast Notification System Anchor -->
  <div id="cinego-toast-container" class="fixed bottom-6 right-6 z-[99999] flex flex-col gap-2.5 pointer-events-none max-w-sm sm:max-w-md w-full px-4 sm:px-0"
    <% if (typeof flashError !== 'undefined' && flashError) { %> data-flash-error="<%= flashError %>"<% } %>
    <% if (typeof flashSuccess !== 'undefined' && flashSuccess) { %> data-flash-success="<%= flashSuccess %>"<% } %>
    <% if (typeof flashWarning !== 'undefined' && flashWarning) { %> data-flash-warning="<%= flashWarning %>"<% } %>
    <% if (typeof flashInfo !== 'undefined' && flashInfo) { %> data-flash-info="<%= flashInfo %>"<% } %>
    <% if (typeof error !== 'undefined' && error) { %> data-view-error="<%= error %>"<% } %>
    <% if (typeof success !== 'undefined' && success) { %> data-view-success="<%= success %>"<% } %>
  ></div>

  <!-- Trailer Player Modal -->
  <div id="trailerModal" class="hidden fixed inset-0 z-50 bg-[#0E1015]/90 backdrop-blur-md flex items-center justify-center p-4">
    <div class="relative w-full max-w-4xl bg-black border border-white/20 shadow-2xl overflow-hidden">
      <div class="flex items-center justify-between p-4 bg-[#151820] border-b border-white/10 text-white font-['JetBrains_Mono'] text-xs">
        <span id="trailerModalTitle" class="truncate font-semibold tracking-wider">Trailer Thước Phim</span>
        <button type="button" onclick="closeTrailerModal()" class="text-white/70 hover:text-white transition-colors">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
      <div class="aspect-video w-full bg-black">
        <iframe id="trailerIframe" class="w-full h-full" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>
  </div>

  <!-- Main client JavaScripts -->
  <script src="/js/cinego-toast.js?v=6.0"></script>
  <script src="/js/cinego-mock-data.js?v=5.0"></script>
  <script src="/js/cinego-main.js?v=5.0"></script>

</body>
</html>

    <!-- Admin Global Footer Strip -->
    <footer class="mt-auto bg-white border-t border-[#E5E0D5] py-4 px-6 sm:px-8 text-xs font-['JetBrains_Mono'] text-[#7A7E8B] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        CINEGO ADMIN CONSOLE © 2024 — 2026. QUẢN TRỊ HỆ THỐNG 3 CỤM RẠP QUY NHƠN.
      </div>
      <div class="flex items-center gap-4 text-[11px]">
        <span>HỆ THỐNG MẠNG NỘI BỘ</span>
        <span>•</span>
        <span>KẾT NỐI MONGODB ỔN ĐỊNH</span>
        <span>•</span>
        <span>HOTLINE HỖ TRỢ: <strong class="text-[#121316]">12345678</strong></span>
      </div>
    </footer>

  </div><!-- End Main Content Wrapper -->

  <!-- Toast Notification System Anchor for Admin -->
  <div id="cinego-toast-container" class="fixed bottom-6 right-6 z-[99999] flex flex-col gap-2.5 pointer-events-none max-w-sm sm:max-w-md w-full px-4 sm:px-0"
    <% if (typeof flashError !== 'undefined' && flashError) { %> data-flash-error="<%= flashError %>"<% } %>
    <% if (typeof flashSuccess !== 'undefined' && flashSuccess) { %> data-flash-success="<%= flashSuccess %>"<% } %>
    <% if (typeof flashWarning !== 'undefined' && flashWarning) { %> data-flash-warning="<%= flashWarning %>"<% } %>
    <% if (typeof flashInfo !== 'undefined' && flashInfo) { %> data-flash-info="<%= flashInfo %>"<% } %>
    <% if (typeof error !== 'undefined' && error) { %> data-view-error="<%= error %>"<% } %>
    <% if (typeof success !== 'undefined' && success) { %> data-view-success="<%= success %>"<% } %>
  ></div>

  <!-- Admin Toast Script -->
  <script src="/js/cinego-toast.js?v=6.0"></script>
</body>
</html>

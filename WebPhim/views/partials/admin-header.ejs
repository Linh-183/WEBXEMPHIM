<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — CineGo Admin' : 'CineGo Quản Trị Hệ Thống Điện Ảnh' %></title>
  
  <!-- Curatorial Typography & Monospace (Hỗ trợ 100% tiếng Việt có dấu, chống vỡ font) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Material Symbols Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            admin: {
              paper: '#FAF8F5',
              surface: '#FFFFFF',
              dim: '#F3EFE6',
              sidebar: '#121316',
              border: '#E5E0D5',
              ink: '#121316',
              muted: '#7A7E8B'
            },
            cinnabar: '#BA2D27'
          },
          fontFamily: {
            sculpted: ['"Be Vietnam Pro"', '"Plus Jakarta Sans"', 'sans-serif'],
            editorial: ['"Be Vietnam Pro"', '"Plus Jakarta Sans"', 'sans-serif'],
            serif: ['"Be Vietnam Pro"', '"Plus Jakarta Sans"', 'sans-serif'],
            sans: ['"Plus Jakarta Sans"', '"Be Vietnam Pro"', '"Segoe UI"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'Consolas', 'monospace']
          }
        }
      }
    }
  </script>

  <link rel="stylesheet" href="/css/cinego-editorial.css?v=8.0">
  <link rel="stylesheet" href="/css/style.css?v=8.0">

  <style>
    /* Đồng bộ 100% font Be Vietnam Pro toàn cục nhưng bảo vệ tuyệt đối icon Material Symbols */
    html, body, button, input, select, textarea, h1, h2, h3, h4, h5, h6, p, a, div, label, .font-serif, .editorial-heading, [class*="font-serif"] {
      font-family: 'Be Vietnam Pro', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    }
    span:not(.material-symbols-outlined):not(.material-icons):not([class*="material-symbols"]):not([class*="material-icons"]) {
      font-family: 'Be Vietnam Pro', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    }
    .material-symbols-outlined,
    .material-symbols,
    .material-icons,
    [class*="material-symbols"],
    [class*="material-icons"] {
      font-family: 'Material Symbols Outlined', 'Material Icons' !important;
      font-weight: normal !important;
      font-style: normal !important;
      font-size: 24px;
      line-height: 1 !important;
      letter-spacing: normal !important;
      text-transform: none !important;
      display: inline-block !important;
      white-space: nowrap !important;
      word-wrap: normal !important;
      direction: ltr !important;
      -webkit-font-feature-settings: 'liga' 1 !important;
      font-feature-settings: 'liga' 1 !important;
      -webkit-font-smoothing: antialiased !important;
    }
  </style>
</head>

<body class="bg-[#FAF8F5] text-[#121316] font-['Plus_Jakarta_Sans'] antialiased min-h-screen flex selection:bg-[#BA2D27] selection:text-white">

  <!-- =========================================================================
       1. SWISS EDITORIAL FIXED SIDEBAR (LEFT 16rem = 64)
       ========================================================================= -->
  <aside id="admin-sidebar" class="fixed left-0 top-0 h-screen w-64 bg-[#121316] text-[#FAF8F5] z-50 flex flex-col border-r border-white/10 shadow-2xl overflow-y-auto">
    
    <!-- Sidebar Brand -->
    <div class="p-6 border-b border-white/10">
      <a href="/admin" class="flex flex-col group">
        <span class="font-serif font-black text-2xl tracking-[0.16em] text-[#FAF8F5] group-hover:text-[#BA2D27] transition-colors leading-none">
          CINEGO
        </span>
        <span class="font-['JetBrains_Mono'] text-[9px] tracking-[0.25em] text-white/50 uppercase mt-1">
          HỆ THỐNG QUẢN TRỊ RẠP
        </span>
      </a>
    </div>

    <!-- Navigation Menu Groups -->
    <nav class="flex-1 px-3 py-6 space-y-6 text-xs font-semibold font-['Plus_Jakarta_Sans']" id="admin-sidebar-nav">
      
      <!-- Group 1: TỔNG QUAN & BÁO CÁO -->
      <div>
        <span class="px-3 text-[10px] font-bold font-['JetBrains_Mono'] text-white/40 uppercase tracking-widest block mb-2">
          01. TỔNG QUAN & DOANH THU
        </span>
        <div class="space-y-1">
          <a class="flex items-center gap-2.5 px-3 py-2 text-white/80 hover:text-white hover:bg-white/10 transition-all font-medium" href="/admin">
            <span class="material-symbols-outlined text-lg text-[#BA2D27]">dashboard</span> Dashboard Tổng Quan
          </a>
          <a class="flex items-center gap-2.5 px-3 py-2 text-white/80 hover:text-white hover:bg-white/10 transition-all font-medium" href="/admin/bao-cao">
            <span class="material-symbols-outlined text-lg text-[#10B981]">bar_chart</span> Báo Cáo Doanh Thu
          </a>
          <a class="flex items-center gap-2.5 px-3 py-2 text-white/80 hover:text-white hover:bg-white/10 transition-all font-medium" href="/admin/giao-dich">
            <span class="material-symbols-outlined text-lg text-[#F59E0B]">receipt_long</span> Quản Lý Giao Dịch
          </a>
        </div>
      </div>

      <!-- Group 2: QUẢN LÝ PHIM & SUẤT CHIẾU -->
      <div>
        <span class="px-3 text-[10px] font-bold font-['JetBrains_Mono'] text-white/40 uppercase tracking-widest block mb-2">
          02. ĐIỆN ẢNH & LỊCH CHIẾU
        </span>
        <div class="space-y-1">
          <a class="flex items-center gap-2.5 px-3 py-2 text-white/80 hover:text-white hover:bg-white/10 transition-all font-medium" href="/admin/phim">
            <span class="material-symbols-outlined text-lg text-[#3B82F6]">movie</span> Danh Mục Phim
          </a>
          <a class="flex items-center gap-2.5 px-3 py-2 text-white/80 hover:text-white hover:bg-white/10 transition-all font-medium" href="/admin/suat-chieu">
            <span class="material-symbols-outlined text-lg text-[#6366F1]">schedule</span> Quản Lý Suất Chiếu
          </a>
        </div>
      </div>

      <!-- Group 3: GHẾ NGỒI & F&B -->
      <div>
        <span class="px-3 text-[10px] font-bold font-['JetBrains_Mono'] text-white/40 uppercase tracking-widest block mb-2">
          03. GHẾ NGỒI & F&B
        </span>
        <div class="space-y-1">
          <a class="flex items-center gap-2.5 px-3 py-2 text-white/80 hover:text-white hover:bg-white/10 transition-all font-medium" href="/admin/so-do-ghe">
            <span class="material-symbols-outlined text-lg text-[#14B8A6]">chair</span> Sơ Đồ Ghế Phòng
          </a>
          <a class="flex items-center gap-2.5 px-3 py-2 text-white/80 hover:text-white hover:bg-white/10 transition-all font-medium" href="/admin/combo">
            <span class="material-symbols-outlined text-lg text-[#EC4899]">fastfood</span> Bắp Nước & Combo
          </a>
        </div>
      </div>

      <!-- Group 4: KHUYẾN MÃI & KHÁCH HÀNG -->
      <div>
        <span class="px-3 text-[10px] font-bold font-['JetBrains_Mono'] text-white/40 uppercase tracking-widest block mb-2">
          04. ƯU ĐÃI & TÀI KHOẢN
        </span>
        <div class="space-y-1">
          <a class="flex items-center gap-2.5 px-3 py-2 text-white/80 hover:text-white hover:bg-white/10 transition-all font-medium" href="/admin/khuyen-mai">
            <span class="material-symbols-outlined text-lg text-[#EC4899]">loyalty</span> Quản Lý Voucher & Ưu Đãi
          </a>
          <a class="flex items-center gap-2.5 px-3 py-2 text-white/80 hover:text-white hover:bg-white/10 transition-all font-medium" href="/admin/nguoi-dung">
            <span class="material-symbols-outlined text-lg text-[#8B5CF6]">group</span> Danh Sách Người Dùng
          </a>
        </div>
      </div>

    </nav>

    <!-- Bottom Sidebar Return to Website -->
    <div class="p-4 border-t border-white/10 bg-[#0E1015] font-['JetBrains_Mono'] text-xs">
      <a href="/" class="flex items-center gap-2 text-white/70 hover:text-[#BA2D27] transition-colors py-2">
        <span class="material-symbols-outlined text-base">arrow_back</span>
        <span>Về Website Khách Hàng</span>
      </a>
      <a href="/dang-xuat" class="flex items-center gap-2 text-[#BA2D27] hover:underline font-bold py-1">
        <span class="material-symbols-outlined text-base">logout</span>
        <span>Đăng Xuất Admin</span>
      </a>
    </div>

  </aside>

  <!-- =========================================================================
       2. TOP ADMIN HEADER STRIP (MAIN CONTENT WRAPPER STARTS)
       ========================================================================= -->
  <div class="flex-1 flex flex-col min-w-0 ml-64 bg-[#FAF8F5]">
    
    <!-- Top Action Toolbar -->
    <header class="h-16 bg-white border-b border-[#E5E0D5] px-6 sm:px-8 flex items-center justify-between gap-4 sticky top-0 z-30">
      
      <!-- Left: Breadcrumb Context -->
      <div class="flex items-center gap-3 font-['JetBrains_Mono'] text-xs text-[#7A7E8B]">
        <span class="text-[#BA2D27] font-bold">ADMIN CONSOLE</span>
        <span>/</span>
        <span class="text-[#121316] font-semibold">Quy Nhơn 3 Cụm Rạp</span>
      </div>

      <!-- Right: User Admin Monogram -->
      <div class="flex items-center gap-4 text-xs font-['JetBrains_Mono']">
        <span class="hidden sm:inline text-[#7A7E8B]">Phiên làm việc:</span>
        <div class="flex items-center gap-2 bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-1.5">
          <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
          <span class="font-bold text-[#121316]"><%= (typeof user !== 'undefined' && user) ? user.hoTen : 'Quản Trị Viên' %></span>
        </div>
      </div>

    </header>

    <script>
      // Làm sáng màu mục Menu đang truy cập trong Sidebar Admin
      (function highlightActiveAdminNav() {
        const p = window.location.pathname;
        document.querySelectorAll('#admin-sidebar-nav a').forEach(a => {
          const href = a.getAttribute('href');
          let isActive = false;
          if (href === '/admin') {
            isActive = (p === '/admin');
          } else {
            isActive = (p === href || (href !== '/admin' && p.startsWith(href)));
          }
          if (isActive) {
            a.classList.remove('text-white/80', 'hover:bg-white/10');
            a.classList.add('bg-[#BA2D27]', 'text-white', 'font-bold', 'shadow-md', 'border-l-4', 'border-white', 'pl-2');
            const icon = a.querySelector('.material-symbols-outlined');
            if (icon) {
              icon.classList.remove('text-[#BA2D27]', 'text-[#10B981]', 'text-[#F59E0B]', 'text-[#3B82F6]', 'text-[#A6853B]', 'text-[#6366F1]', 'text-[#EAB308]', 'text-[#14B8A6]', 'text-[#EC4899]', 'text-[#8B5CF6]');
              icon.classList.add('text-white');
            }
          }
        });
      })();
    </script>

    <!-- Main Content Container will be injected here -->

<%- include('partials/admin-header') %>

<main class="p-6 sm:p-10 space-y-8 max-w-7xl">
  
  <!-- Header Title & Add Action -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-[#E5E0D5]">
    <div>
      <span class="archival-index">QUẢN LÝ DANH MỤC ĐIỆN ẢNH</span>
      <h1 class="editorial-headline text-3xl font-bold mt-1">Danh Sách Phim Chiếu Rạp</h1>
      <p class="text-xs text-[#7A7E8B] mt-0.5 font-light">Cập nhật, điều chỉnh thông tin và lịch chiếu phim tại 3 rạp Quy Nhơn.</p>
    </div>

    <a href="/admin/phim/them" class="btn-editorial-primary text-xs !py-3 !px-5 flex items-center gap-2">
      <span class="material-symbols-outlined text-base">add</span>
      <span>Thêm Phim Mới</span>
    </a>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="bg-white border border-[#E5E0D5] p-4 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2 w-full sm:w-80 bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs">
      <span class="material-symbols-outlined text-[#7A7E8B] text-lg">search</span>
      <input type="text" id="adminMovieSearch" placeholder="Tìm tên phim, thể loại..." class="bg-transparent border-none text-xs text-[#121316] placeholder-[#A6AAB6] focus:outline-none w-full" oninput="filterAdminMovies()" />
    </div>

    <!-- Quick Status Tabs -->
    <div class="flex items-center gap-1.5 text-xs font-['JetBrains_Mono']">
      <button onclick="filterMovieStatus('all', this)" class="movie-status-btn px-3 py-1.5 bg-[#121316] text-white font-bold">Tất Cả</button>
      <button onclick="filterMovieStatus('DangChieu', this)" class="movie-status-btn px-3 py-1.5 bg-[#FAF8F5] border border-[#E5E0D5] text-[#474A54] hover:text-[#121316]">Đang Chiếu</button>
      <button onclick="filterMovieStatus('SapChieu', this)" class="movie-status-btn px-3 py-1.5 bg-[#FAF8F5] border border-[#E5E0D5] text-[#474A54] hover:text-[#121316]">Sắp Chiếu</button>
    </div>
  </div>

  <!-- Movies Table (Swiss Style High Density) -->
  <div class="bg-white border border-[#E5E0D5] overflow-x-auto shadow-sm">
    <table class="w-full text-left text-xs font-['Plus_Jakarta_Sans'] border-collapse">
      <thead>
        <tr class="border-b border-[#E5E0D5] text-[#7A7E8B] uppercase font-bold text-[10px] bg-[#FAF8F5] font-['JetBrains_Mono']">
          <th class="py-3.5 px-4 w-12 text-center">STT</th>
          <th class="py-3.5 px-4">Tác Phẩm</th>
          <th class="py-3.5 px-4">Thể Loại</th>
          <th class="py-3.5 px-4">Thời Lượng</th>
          <th class="py-3.5 px-4">Trạng Thái</th>
          <th class="py-3.5 px-4">Độ Tuổi</th>
          <th class="py-3.5 px-4 text-right">Thao Tác</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#E5E0D5]" id="adminMoviesTbody">
        <% if (typeof movies !== 'undefined' && movies && movies.length > 0) { %>
          <% movies.forEach((phim, index) => { %>
            <tr class="hover:bg-[#FAF8F5] transition-colors movie-row" data-status="<%= phim.status %>" data-title="<%= (phim.title || '').toLowerCase() %>">
              <td class="py-3.5 px-4 text-center font-['JetBrains_Mono'] font-bold text-[#7A7E8B]"><%= index + 1 %></td>
              <td class="py-3.5 px-4">
                <div class="flex items-center gap-3">
                  <img src="<%= phim.posterUrl %>" alt="<%= phim.title %>" class="w-10 h-14 object-cover border border-[#E5E0D5] shrink-0" />
                  <div class="min-w-0">
                    <p class="font-bold text-sm text-[#121316] truncate max-w-xs"><%= phim.title %></p>
                    <p class="text-[11px] font-['JetBrains_Mono'] text-[#7A7E8B]">Đạo diễn: <%= phim.director || 'Chưa cập nhật' %></p>
                  </div>
                </div>
              </td>
              <td class="py-3.5 px-4 text-[#474A54]"><%= phim.genre %></td>
              <td class="py-3.5 px-4 font-['JetBrains_Mono'] text-[#121316]"><%= phim.duration %> phút</td>
              <td class="py-3.5 px-4 font-['JetBrains_Mono']">
                <% if (phim.status === 'DangChieu') { %>
                  <span class="px-2 py-0.5 text-[10px] font-bold uppercase bg-[#E8F8F0] text-[#10B981] border border-[#10B981]/30">
                    Đang Chiếu
                  </span>
                <% } else { %>
                  <span class="px-2 py-0.5 text-[10px] font-bold uppercase bg-[#FBF6EB] text-[#A6853B] border border-[#A6853B]/30">
                    Sắp Chiếu
                  </span>
                <% } %>
              </td>
              <td class="py-3.5 px-4">
                <span class="px-1.5 py-0.5 bg-[#FAF8F5] border border-[#E5E0D5] font-['JetBrains_Mono'] text-[10px] font-bold text-[#121316]">
                  <%= phim.ageRating || 'P' %>
                </span>
              </td>
              <td class="py-3.5 px-4 text-right">
                <div class="flex items-center justify-end gap-2 font-['JetBrains_Mono']">
                  <a href="/admin/phim/sua/<%= phim._id %>" class="px-2.5 py-1 bg-white border border-[#E5E0D5] hover:border-[#121316] text-xs font-semibold text-[#121316]">
                    Sửa
                  </a>
                  <form action="/admin/phim/xoa/<%= phim._id %>" method="POST" onsubmit="return confirm('Bạn chắc chắn muốn xóa phim này khỏi rạp?')" class="inline">
                    <button type="submit" class="px-2.5 py-1 bg-white border border-[#E5E0D5] hover:border-[#BA2D27] hover:text-[#BA2D27] text-xs font-semibold text-[#7A7E8B]">
                      Xóa
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" class="py-12 text-center text-[#7A7E8B] font-['JetBrains_Mono']">
              Chưa có phim nào trong danh mục cơ sở dữ liệu.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

</main>

<script>
  function filterMovieStatus(status, btn) {
    document.querySelectorAll('.movie-status-btn').forEach(b => {
      b.classList.remove('bg-[#121316]', 'text-white', 'font-bold');
      b.classList.add('bg-[#FAF8F5]', 'text-[#474A54]');
    });
    btn.classList.remove('bg-[#FAF8F5]', 'text-[#474A54]');
    btn.classList.add('bg-[#121316]', 'text-white', 'font-bold');

    document.querySelectorAll('.movie-row').forEach(row => {
      if (status === 'all' || row.dataset.status === status) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  }

  function filterAdminMovies() {
    const q = document.getElementById('adminMovieSearch').value.toLowerCase();
    document.querySelectorAll('.movie-row').forEach(row => {
      const title = row.dataset.title || '';
      if (title.includes(q)) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  }
</script>

<%- include('partials/admin-footer') %>

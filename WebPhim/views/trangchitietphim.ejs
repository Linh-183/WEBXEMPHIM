<%- include('partials/header') %>

<main class="min-h-screen">

  <!-- =========================================================================
       1. CINEMATIC BACKDROP HERO & EDITORIAL METADATA
       ========================================================================= -->
  <section class="bg-[#0E1015] text-[#FAF8F5] border-b border-white/10 relative overflow-hidden">
    
    <!-- Atmospheric Ambient Light -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#0E1015] via-[#0E1015]/80 to-transparent z-10"></div>
    <div class="absolute inset-0 opacity-20 filter blur-xl scale-110">
      <img src="<%= phim.posterUrl || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=1600&q=80' %>" 
           alt="Backdrop Ambience" 
           class="w-full h-full object-cover" />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-14 lg:py-20 relative z-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Left Column: Monumental 3:4 Poster Canvas (Span 4) -->
        <div class="lg:col-span-4 flex justify-center lg:justify-start">
          <div class="cinego-detail-poster-frame bg-[#151820] border border-white/20 shadow-2xl" 
               style="width: 340px; height: 453px; min-width: 340px; min-height: 453px; max-width: 340px; max-height: 453px; flex-shrink: 0; position: relative; overflow: hidden;">
            <img src="<%= phim.posterUrl || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=800&q=80' %>" 
                 alt="<%= phim.title %>" 
                 fetchpriority="high"
                 loading="eager"
                 decoding="async"
                 width="340"
                 height="453"
                 style="width: 340px; height: 453px; min-width: 340px; min-height: 453px; max-width: 340px; max-height: 453px; object-fit: cover; object-position: center; display: block; transform: none;" />
            
            <div class="absolute top-3 left-3 bg-[#BA2D27] text-white font-['JetBrains_Mono'] text-[10px] font-bold px-2.5 py-1">
              <%= phim.ageRating || 'T16' %>
            </div>

            <% if (phim.status === 'DangChieu') { %>
              <div class="absolute top-3 right-3 bg-[#10B981] text-white font-['JetBrains_Mono'] text-[10px] font-bold px-2 py-1 uppercase">
                Đang Chiếu
              </div>
            <% } else { %>
              <div class="absolute top-3 right-3 bg-[#A6853B] text-white font-['JetBrains_Mono'] text-[10px] font-bold px-2 py-1 uppercase">
                Sắp Chiếu
              </div>
            <% } %>
          </div>
        </div>

        <!-- Right Column: Editorial Title, Synopsis & Ledger (Span 8) -->
        <div class="lg:col-span-8 space-y-6">
          
          <div class="flex items-center gap-3 font-['JetBrains_Mono'] text-xs">
            <span class="text-[#C5A059] uppercase tracking-wider font-semibold">TÁC PHẨM ĐIỆN ẢNH CHIẾU RẠP</span>
            <span class="text-white/30">/</span>
            <span class="text-white/60"><%= phim.genre || 'Tâm lý, Hành động' %></span>
          </div>

          <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-normal leading-[1.02] tracking-tight text-[#FAF8F5]">
            <%= phim.title %>
          </h1>

          <!-- Critic Ledger -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-4 border-y border-white/10 font-['JetBrains_Mono'] text-xs text-white/60">
            <div>
              <span class="block text-white/40 text-[10px] uppercase">Đạo Diễn</span>
              <span class="text-white font-medium"><%= phim.director || 'Chưa cập nhật' %></span>
            </div>
            <div>
              <span class="block text-white/40 text-[10px] uppercase">Thời Lượng</span>
              <span class="text-white font-medium"><%= phim.duration ? (phim.duration + ' Phút') : '120 Phút' %></span>
            </div>
            <div>
              <span class="block text-white/40 text-[10px] uppercase">Khởi Chiếu</span>
              <span class="text-white font-medium">
                <%= phim.releaseDate ? new Date(phim.releaseDate).toLocaleDateString('vi-VN') : 'Đang chiếu' %>
              </span>
            </div>
            <div>
              <span class="block text-white/40 text-[10px] uppercase">Phân Loại</span>
              <span class="text-[#BA2D27] font-bold"><%= phim.ageRating || 'P' %></span>
            </div>
          </div>

          <!-- Synopsis Preview -->
          <div class="space-y-2">
            <span class="font-serif text-xs uppercase tracking-[0.2em] text-white/50 block">NỘI DUNG TÁC PHẨM</span>
            <p class="text-sm text-[#C5C8D1] leading-relaxed max-w-2xl font-['Plus_Jakarta_Sans'] font-light">
              <%= phim.description || 'Chưa có thông tin tóm tắt chi tiết cho tác phẩm này. Vui lòng đón xem trực tiếp tại rạp để cảm nhận trọn vẹn giá trị điện ảnh.' %>
            </p>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4 pt-3">
            <a href="#showtimes-section" class="btn-editorial-cinnabar text-sm">
              <span>Xem Lịch Chiếu & Đặt Vé</span>
              <span class="font-['JetBrains_Mono'] text-xs">↓</span>
            </a>
            <% if (phim.trailerUrl) { %>
              <button type="button" 
                      data-trailer="<%= phim.trailerUrl %>"
                      data-title="<%= phim.title %> (Trailer)"
                      onclick="openTrailerModal(this.dataset.trailer, this.dataset.title)" 
                      class="btn-editorial-secondary !border-white/30 !text-white hover:!bg-white hover:!text-[#0E1015]">
                <span class="material-symbols-outlined text-base">play_circle</span>
                <span>Xem Trailer</span>
              </button>
            <% } %>
            <button type="button" 
                    onclick="handleShareMovie('<%= phim.title %>', window.location.href)" 
                    class="btn-editorial-secondary !border-white/30 !text-white hover:!bg-white hover:!text-[#0E1015]"
                    aria-label="Chia sẻ thông tin tác phẩm">
              <span class="material-symbols-outlined text-base">share</span>
              <span>Chia Sẻ</span>
            </button>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       2. INTERACTIVE SCREENING SCHEDULE MATRIX (QUY NHON THEATERS)
       ========================================================================= -->
  <section id="showtimes-section" class="max-w-7xl mx-auto px-4 sm:px-8 py-16">
    
    <div class="border-b border-[#E5E0D5] pb-6 mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <span class="archival-index">LỊCH CHIẾU HÔM NAY & TUẦN NÀY</span>
        <h2 class="editorial-headline mt-1">Chọn Suất Chiếu Tại 3 Cụm Rạp Quy Nhơn</h2>
      </div>
      <div class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">
        CẬP NHẬT TỨC THỜI THEO PHÒNG CHIẾU
      </div>
    </div>

    <!-- Horizontal Date Selector Strip -->
    <div class="flex items-center gap-3 overflow-x-auto pb-4 mb-10 hide-scrollbar">
      <% 
        const today = new Date();
        const daysOfWeek = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
        const yNowDetail = today.getFullYear();
        const mNowDetail = String(today.getMonth() + 1).padStart(2, '0');
        const dNowDetail = String(today.getDate()).padStart(2, '0');
        const todayIsoDetail = `${yNowDetail}-${mNowDetail}-${dNowDetail}`;
        const nowHourDetail = today.getHours();
        const nowMinDetail = today.getMinutes();
        const isPastDetailServer = (tStr) => {
          const [h, m] = (tStr || '').split(':').map(Number);
          if (isNaN(h) || isNaN(m)) return false;
          return (h < nowHourDetail || (h === nowHourDetail && m <= nowMinDetail));
        };
        for (let i = 0; i < 7; i++) {
          const d = new Date(today);
          d.setDate(today.getDate() + i);
          const isToday = i === 0;
          const dayName = isToday ? 'Hôm Nay' : daysOfWeek[d.getDay()];
          const dateStr = d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' });
          const fullIso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      %>
        <button type="button" 
                onclick="filterShowtimesByDate('<%= fullIso %>', this)"
                class="date-pill-btn px-4 py-3 border border-[#E5E0D5] text-center shrink-0 min-w-[100px] transition-all <%= isToday ? 'bg-[#121316] text-white border-[#121316]' : 'bg-white text-[#121316] hover:border-[#121316]' %>">
          <span class="block text-[10px] font-['JetBrains_Mono'] uppercase tracking-wider text-[#7A7E8B] <%= isToday ? '!text-white/70' : '' %>">
            <%= dayName %>
          </span>
          <span class="block text-base font-bold font-['Plus_Jakarta_Sans'] mt-0.5">
            <%= dateStr %>
          </span>
        </button>
      <% } %>
    </div>

    <%
      const renderShowtimePill = (cin, time, tag) => {
        const isPast = isPastDetailServer(time);
        if (isPast) {
    %>
          <span data-cinema="<%= cin %>" data-time="<%= time %>" data-tag="<%= tag %>" class="detail-showtime-btn px-4 py-2.5 bg-[#FAF8F5] border border-[#E5E0D5] opacity-50 cursor-not-allowed text-xs font-['JetBrains_Mono'] font-bold text-[#A6AAB6] text-center min-w-[90px]" title="Suất <%= time %> hôm nay đã kết thúc hoặc qua giờ chiếu">
            <%= time %>
            <span class="detail-tag block text-[9px] font-normal text-[#A6AAB6]">Đã chiếu</span>
          </span>
    <%  } else { %>
          <a href="/dat-ve/<%= phim._id %>?cinema=<%= encodeURIComponent(cin) %>&date=<%= todayIsoDetail %>&time=<%= time %>" data-cinema="<%= cin %>" data-time="<%= time %>" data-tag="<%= tag %>" class="detail-showtime-btn px-4 py-2.5 bg-[#FAF8F5] border border-[#E5E0D5] hover:border-[#BA2D27] hover:bg-[#BA2D27] hover:text-white transition-all text-xs font-['JetBrains_Mono'] font-bold text-[#121316] text-center min-w-[90px]" title="Đặt vé suất <%= time %>">
            <%= time %>
            <span class="detail-tag block text-[9px] font-normal opacity-70"><%= tag %></span>
          </a>
    <%  }
      };
    %>

    <!-- The 3 Quy Nhon Cinemas Screening Matrices -->
    <div class="space-y-8">
      
      <!-- 1. CGV Kim Cúc Plaza -->
      <div class="bg-white border border-[#E5E0D5] p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-[#E5E0D5] gap-2 mb-6">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#BA2D27]"></span>
              <h3 class="font-serif text-xl font-bold text-[#121316]">
                CGV Kim Cúc Plaza Quy Nhơn
              </h3>
            </div>
            <span class="text-xs text-[#7A7E8B] block mt-0.5">
              Tầng 3, Kim Cúc Plaza, Khu đô thị An Phú Thịnh, P. Ghềnh Ráng
            </span>
          </div>
          <span class="text-xs font-['JetBrains_Mono'] text-[#10B981] font-semibold">
            Định dạng: IMAX Laser, 2D Digital
          </span>
        </div>

        <div class="space-y-4">
          <div class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B] uppercase">Phòng Chiếu 1 (IMAX Laser):</div>
          <div class="flex flex-wrap gap-3">
            <% renderShowtimePill('CGV Kim Cúc Plaza', '09:30', 'Ghế VIP'); %>
            <% renderShowtimePill('CGV Kim Cúc Plaza', '13:15', 'Ghế VIP'); %>
            <% renderShowtimePill('CGV Kim Cúc Plaza', '16:45', 'Ghế VIP'); %>
            <% renderShowtimePill('CGV Kim Cúc Plaza', '19:30', 'Giờ Vàng'); %>
            <% renderShowtimePill('CGV Kim Cúc Plaza', '22:15', 'Suất Khuya'); %>
          </div>
        </div>
      </div>

      <!-- 2. Starlight Nguyễn Kim -->
      <div class="bg-white border border-[#E5E0D5] p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-[#E5E0D5] gap-2 mb-6">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#121316]"></span>
              <h3 class="font-serif text-xl font-bold text-[#121316]">
                Starlight Nguyễn Kim Quy Nhơn
              </h3>
            </div>
            <span class="text-xs text-[#7A7E8B] block mt-0.5">
              Tầng 4, TTTM Nguyễn Kim, 06 Trần Phú, TP. Quy Nhơn
            </span>
          </div>
          <span class="text-xs font-['JetBrains_Mono'] text-[#10B981] font-semibold">
            Định dạng: 2D Digital, 3D
          </span>
        </div>

        <div class="space-y-4">
          <div class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B] uppercase">Phòng Chiếu 2 (2D Digital):</div>
          <div class="flex flex-wrap gap-3">
            <% renderShowtimePill('Starlight Nguyễn Kim', '10:00', 'Standard'); %>
            <% renderShowtimePill('Starlight Nguyễn Kim', '14:00', 'Standard'); %>
            <% renderShowtimePill('Starlight Nguyễn Kim', '18:00', 'Giờ Vàng'); %>
            <% renderShowtimePill('Starlight Nguyễn Kim', '20:45', 'Giờ Vàng'); %>
          </div>
        </div>
      </div>

      <!-- 3. DCine Quy Nhơn -->
      <div class="bg-white border border-[#E5E0D5] p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-[#E5E0D5] gap-2 mb-6">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#A6853B]"></span>
              <h3 class="font-serif text-xl font-bold text-[#121316]">
                DCine Quy Nhơn
              </h3>
            </div>
            <span class="text-xs text-[#7A7E8B] block mt-0.5">
              Ngã ba Đống Đa, P. Thị Nại, TP. Quy Nhơn
            </span>
          </div>
          <span class="text-xs font-['JetBrains_Mono'] text-[#10B981] font-semibold">
            Định dạng: Laser 4K, VIP Lounge
          </span>
        </div>

        <div class="space-y-4">
          <div class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B] uppercase">Hall A (Laser Projector):</div>
          <div class="flex flex-wrap gap-3">
            <% renderShowtimePill('Dcine Quy Nhơn', '11:15', 'Laser 4K'); %>
            <% renderShowtimePill('Dcine Quy Nhơn', '15:30', 'Laser 4K'); %>
            <% renderShowtimePill('Dcine Quy Nhơn', '19:00', 'VIP Sofa'); %>
            <% renderShowtimePill('Dcine Quy Nhơn', '21:30', 'VIP Sofa'); %>
          </div>
        </div>
      </div>

    </div>

  </section>

  <!-- =========================================================================
       REVIEWS & AUDIENCE RATINGS (CHỈ KHÁN GIẢ ĐÃ XEM MỚI ĐƯỢC ĐÁNH GIÁ)
       ========================================================================= -->
  <section id="danh-gia-phim" class="py-12 border-t border-[#E5E0D5] bg-[#FAF8F5]">
    <div class="max-w-[1520px] mx-auto px-6 sm:px-10 lg:px-14">
      
      <!-- Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-[#E5E0D5] mb-8">
        <div>
          <span class="font-['JetBrains_Mono'] text-[11px] text-[#A6853B] font-bold uppercase tracking-wider block">GÓC NHÌN KHÁN GIẢ</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#121316] mt-1">Bình Phẩm & Đánh Giá Điện Ảnh</h2>
          <p class="text-xs text-[#7A7E8B] mt-1 font-light">Chỉ những khán giả đã mua vé và trải nghiệm phim tại rạp mới được gửi nhận xét khách quan.</p>
        </div>

        <!-- Rating Score Badge -->
        <div class="flex items-center gap-3 bg-white border border-[#E5E0D5] p-3 px-5 shadow-xs">
          <span class="text-3xl font-serif font-bold text-[#BA2D27]"><%= (typeof avgRating !== 'undefined' && avgRating) ? avgRating : '5.0' %></span>
          <div>
            <div class="text-[#A6853B] text-sm">★★★★★</div>
            <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B] block mt-0.5"><%= (typeof reviews !== 'undefined' && reviews) ? reviews.length : 0 %> bình luận đã xác thực</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left: Review Submission Form (Only for viewers who bought ticket) (Span 5) -->
        <div class="lg:col-span-5">
          <div class="bg-white border border-[#E5E0D5] p-6 space-y-5">
            <h3 class="font-serif text-lg font-bold text-[#121316]">Gửi Nhận Xét Của Bạn</h3>

            <% if (typeof hasWatched !== 'undefined' && hasWatched) { %>
              <form id="movieReviewForm" onsubmit="submitMovieReview(event)" class="space-y-4 text-xs font-['Plus_Jakarta_Sans']">
                <!-- Star Rating Picker -->
                <div>
                  <label class="block font-['JetBrains_Mono'] text-[10.5px] font-bold text-[#7A7E8B] uppercase mb-2">Chấm điểm tác phẩm:</label>
                  <div class="flex items-center gap-2 text-2xl text-[#A6853B]" id="starContainer">
                    <button type="button" onclick="selectMovieStar(1)" class="star-btn cursor-pointer transition-transform hover:scale-125">★</button>
                    <button type="button" onclick="selectMovieStar(2)" class="star-btn cursor-pointer transition-transform hover:scale-125">★</button>
                    <button type="button" onclick="selectMovieStar(3)" class="star-btn cursor-pointer transition-transform hover:scale-125">★</button>
                    <button type="button" onclick="selectMovieStar(4)" class="star-btn cursor-pointer transition-transform hover:scale-125">★</button>
                    <button type="button" onclick="selectMovieStar(5)" class="star-btn cursor-pointer transition-transform hover:scale-125">★</button>
                    <span id="starTextLabel" class="text-xs font-['JetBrains_Mono'] font-bold text-[#121316] ml-2">5.0 (Xuất sắc)</span>
                  </div>
                  <input type="hidden" id="selectedStarValue" value="<%= (typeof myReview !== 'undefined' && myReview) ? myReview.rating : 5 %>" />
                </div>

                <!-- Comment Input -->
                <div>
                  <label class="block font-['JetBrains_Mono'] text-[10.5px] font-bold text-[#7A7E8B] uppercase mb-1.5">Bình luận cảm nhận:</label>
                  <textarea id="reviewCommentText" rows="4" required placeholder="Cảm nghĩ của bạn về cốt truyện, diễn xuất, kỹ xảo, âm thanh hoặc trải nghiệm tại rạp..." class="w-full bg-[#FAF8F5] border border-[#E5E0D5] p-3 text-xs text-[#121316] placeholder:text-[#A6AAB6] focus:outline-none focus:border-[#121316]"><%= (typeof myReview !== 'undefined' && myReview) ? myReview.comment : '' %></textarea>
                </div>

                <!-- Verified Badge -->
                <div class="p-2.5 bg-emerald-50 border border-emerald-200 text-emerald-800 text-[11px] font-['JetBrains_Mono'] flex items-center gap-2">
                  <span class="material-symbols-outlined text-base">verified</span>
                  <span>Đã xác thực vé xem phim: Bạn đủ điều kiện gửi bình phẩm.</span>
                </div>

                <button type="submit" id="btnSubmitReview" class="btn-editorial-primary w-full py-3 text-xs font-bold text-center block !bg-[#BA2D27] hover:!bg-[#8E1F1A]">
                  <%= (typeof alreadyReviewed !== 'undefined' && alreadyReviewed) ? 'CẬP NHẬT ĐÁNH GIÁ →' : 'GỬI ĐÁNH GIÁ ĐIỆN ẢNH →' %>
                </button>
              </form>
            <% } else { %>
              <!-- Notice for users who haven't watched yet -->
              <div class="p-6 bg-[#FAF8F5] border border-[#E5E0D5] text-center space-y-3">
                <span class="material-symbols-outlined text-3xl text-[#7A7E8B]">lock</span>
                <h4 class="font-serif font-bold text-sm text-[#121316]">Chỉ Người Đã Xem Mới Được Đánh Giá</h4>
                <p class="text-xs text-[#7A7E8B] leading-relaxed">
                  Để đảm bảo tính khách quan và trung thực, hệ thống CineGo chỉ mở quyền đánh giá cho tài khoản đã có vé xem phim này tại cụm rạp.
                </p>
                <div class="pt-2">
                  <% if (typeof user !== 'undefined' && user) { %>
                    <a href="#cum-rap-chieu" class="btn-editorial-primary text-xs !py-2.5 !px-5 inline-block">
                      Đặt Vé Phim Này Để Mở Khóa Đánh Giá →
                    </a>
                  <% } else { %>
                    <a href="/dang-nhap?returnTo=/phim/<%= phim._id %>" class="btn-editorial-primary text-xs !py-2.5 !px-5 inline-block">
                      Đăng Nhập Tài Khoản →
                    </a>
                  <% } %>
                </div>
              </div>
            <% } %>

          </div>
        </div>

        <!-- Right: Reviews Feed (Span 7) -->
        <div class="lg:col-span-7 space-y-4">
          <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
            <div class="space-y-3">
              <% reviews.forEach(function(rev) { %>
                <div class="bg-white border border-[#E5E0D5] p-5 space-y-2 hover:border-[#121316] transition-all">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <div class="w-8 h-8 rounded-full bg-[#121316] text-white flex items-center justify-center font-bold text-xs">
                        <%= (rev.user && rev.user.hoTen) ? rev.user.hoTen.charAt(0).toUpperCase() : 'K' %>
                      </div>
                      <div>
                        <div class="flex items-center gap-1.5">
                          <span class="font-bold text-xs text-[#121316] font-['Plus_Jakarta_Sans']"><%= (rev.user && rev.user.hoTen) ? rev.user.hoTen : 'Khán Giả' %></span>
                          <span class="px-1.5 py-0.2 bg-[#F3EFE6] border border-[#E5E0D5] text-[9.5px] font-['JetBrains_Mono'] text-[#A6853B] font-bold">✓ Đã Xem</span>
                        </div>
                        <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">
                          <%= new Date(rev.createdAt).toLocaleDateString('vi-VN') %>
                        </span>
                      </div>
                    </div>

                    <!-- Stars -->
                    <div class="text-[#A6853B] text-xs font-bold font-['JetBrains_Mono']">
                      <%= '★'.repeat(rev.rating || 5) %> <span class="text-[#121316] ml-1"><%= (rev.rating || 5).toFixed(1) %></span>
                    </div>
                  </div>

                  <p class="text-xs text-[#474A54] leading-relaxed pt-1 font-normal font-['Plus_Jakarta_Sans']">
                    <%= rev.comment %>
                  </p>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="bg-white border border-[#E5E0D5] p-10 text-center space-y-2">
              <span class="material-symbols-outlined text-3xl text-[#A6AAB6]">rate_review</span>
              <h4 class="font-serif font-bold text-sm text-[#121316]">Chưa Có Bình Phẩm Nào</h4>
              <p class="text-xs text-[#7A7E8B]">Hãy là một trong những khán giả đầu tiên đặt vé và chia sẻ cảm nghĩ về bộ phim này!</p>
            </div>
          <% } %>
        </div>

      </div>

    </div>
  </section>

</main>

<script>
  const todayDetailIso = '<%= todayIsoDetail %>';
  let activeDetailDate = todayDetailIso;

  function filterShowtimesByDate(dateStr, btnElement) {
    activeDetailDate = dateStr;
    document.querySelectorAll('.date-pill-btn').forEach(btn => {
      btn.classList.remove('bg-[#121316]', 'text-white', 'border-[#121316]');
      btn.classList.add('bg-white', 'text-[#121316]');
      const tag = btn.querySelector('span');
      if (tag) tag.classList.remove('!text-white/70');
    });

    btnElement.classList.remove('bg-white', 'text-[#121316]');
    btnElement.classList.add('bg-[#121316]', 'text-white', 'border-[#121316]');
    const activeTag = btnElement.querySelector('span');
    if (activeTag) activeTag.classList.add('!text-white/70');

    updateDetailShowtimesDisplay();

    if (window.cinegoToast) {
      window.cinegoToast.info('Đang hiển thị lịch chiếu ngày: ' + dateStr);
    }
  }

  function updateDetailShowtimesDisplay() {
    const isToday = (activeDetailDate === todayDetailIso);
    const now = new Date();
    const nowH = now.getHours();
    const nowM = now.getMinutes();

    document.querySelectorAll('.detail-showtime-btn').forEach(el => {
      const cin = el.getAttribute('data-cinema');
      const time = el.getAttribute('data-time');
      const tag = el.getAttribute('data-tag') || 'Standard';
      if (!time) return;

      const [hStr, mStr] = time.split(':');
      const h = parseInt(hStr, 10);
      const m = parseInt(mStr, 10);
      const isPast = isToday && (h < nowH || (h === nowH && m <= nowM));

      const tagEl = el.querySelector('.detail-tag');

      if (isPast) {
        el.className = 'detail-showtime-btn px-4 py-2.5 bg-[#FAF8F5] border border-[#E5E0D5] opacity-50 cursor-not-allowed text-xs font-[\'JetBrains_Mono\'] font-bold text-[#A6AAB6] text-center min-w-[90px]';
        el.removeAttribute('href');
        el.style.pointerEvents = 'none';
        el.title = `Suất ${time} hôm nay đã kết thúc hoặc qua giờ chiếu`;
        if (tagEl) {
          tagEl.className = 'detail-tag block text-[9px] font-normal text-[#A6AAB6]';
          tagEl.innerText = 'Đã chiếu';
        }
      } else {
        el.className = 'detail-showtime-btn px-4 py-2.5 bg-[#FAF8F5] border border-[#E5E0D5] hover:border-[#BA2D27] hover:bg-[#BA2D27] hover:text-white transition-all text-xs font-[\'JetBrains_Mono\'] font-bold text-[#121316] text-center min-w-[90px]';
        el.href = `/dat-ve/<%= phim._id %>?cinema=${encodeURIComponent(cin)}&date=${activeDetailDate}&time=${time}`;
        el.style.pointerEvents = 'auto';
        el.title = `Đặt vé suất ${time} ngày ${activeDetailDate}`;
        if (tagEl) {
          tagEl.className = 'detail-tag block text-[9px] font-normal opacity-70';
          tagEl.innerText = tag;
        }
      }
    });
  }

  async function handleShareMovie(title, url) {
    if (navigator.share) {
      try {
        await navigator.share({
          title: title + ' — CineGo Quy Nhơn',
          text: 'Đặt vé xem phim ' + title + ' tại CineGo Quy Nhơn:',
          url: url
        });
      } catch (err) {
        if (err.name !== 'AbortError') console.error(err);
      }
    } else if (navigator.clipboard) {
      try {
        await navigator.clipboard.writeText(url);
        if (window.cinegoToast) {
          window.cinegoToast.success('Đã sao chép liên kết phim vào bộ nhớ tạm!');
        }
      } catch (e) {
        prompt('Sao chép đường dẫn xem phim:', url);
      }
    } else {
      prompt('Sao chép đường dẫn xem phim:', url);
    }
  }

  // ==========================================
  // MOVIE REVIEW & STAR RATING SYSTEM
  // ==========================================
  function selectMovieStar(n) {
    document.getElementById('selectedStarValue').value = n;
    const labels = ['', '1.0 (Kém hấp dẫn)', '2.0 (Tạm được)', '3.0 (Khá ổn)', '4.0 (Rất đáng xem)', '5.0 (Xuất sắc)'];
    document.getElementById('starTextLabel').innerText = labels[n] || (n + '.0');

    const starBtns = document.querySelectorAll('#starContainer .star-btn');
    starBtns.forEach((btn, idx) => {
      if (idx < n) {
        btn.classList.add('text-[#A6853B]');
        btn.classList.remove('text-[#CBD5E1]');
      } else {
        btn.classList.remove('text-[#A6853B]');
        btn.classList.add('text-[#CBD5E1]');
      }
    });
  }

  async function submitMovieReview(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitReview');
    const rating = parseInt(document.getElementById('selectedStarValue')?.value || '5', 10);
    const comment = document.getElementById('reviewCommentText')?.value.trim();

    if (!comment) {
      if (window.cinegoToast) window.cinegoToast.warning('Vui lòng nhập nội dung đánh giá cảm nhận!');
      else alert('Vui lòng nhập nội dung đánh giá cảm nhận!');
      return;
    }

    if (btn) {
      btn.disabled = true;
      btn.innerText = 'Đang gửi đánh giá...';
    }

    try {
      const res = await fetch('/api/danh-gia', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          movieId: '<%= phim._id %>',
          rating,
          comment
        })
      });
      const data = await res.json();
      if (data.success) {
        if (window.cinegoToast) window.cinegoToast.success(data.message || 'Gửi đánh giá thành công!');
        else alert(data.message || 'Gửi đánh giá thành công!');
        setTimeout(() => window.location.reload(), 800);
      } else {
        if (window.cinegoToast) window.cinegoToast.error(data.message || 'Lỗi gửi đánh giá');
        else alert(data.message || 'Lỗi gửi đánh giá');
        if (btn) {
          btn.disabled = false;
          btn.innerText = 'GỬI ĐÁNH GIÁ ĐIỆN ẢNH →';
        }
      }
    } catch (err) {
      if (window.cinegoToast) window.cinegoToast.error('Lỗi kết nối khi gửi đánh giá: ' + err.message);
      if (btn) {
        btn.disabled = false;
        btn.innerText = 'GỬI ĐÁNH GIÁ ĐIỆN ẢNH →';
      }
    }
  }
</script>

<%- include('partials/footer') %>

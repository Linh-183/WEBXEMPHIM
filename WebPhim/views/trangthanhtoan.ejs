<%- include('partials/header') %>

<%
  const defaultSystemVouchers = [
    {
      code: 'CINEGO50K',
      title: 'Giảm 50.000đ cho đơn đặt vé xem phim',
      discountType: 'fixed',
      discountValue: 50000,
      minOrderValue: 100000
    },
    {
      code: 'CHAOBANMOI',
      title: 'Ưu đãi thành viên mới CineGo',
      discountType: 'fixed',
      discountValue: 20000,
      minOrderValue: 75000
    },
    {
      code: 'VIP20',
      title: 'Giảm 20% cho hạng vé Standard & VIP',
      discountType: 'percentage',
      discountValue: 20,
      minOrderValue: 120000
    }
  ];

  const userUsedSet = new Set((typeof usedVoucherCodes !== 'undefined' && Array.isArray(usedVoucherCodes)) ? usedVoucherCodes.map(c => String(c).trim().toUpperCase()) : []);

  const dbVouchers = (typeof vouchers !== 'undefined' && Array.isArray(vouchers) && vouchers.length > 0) ? vouchers : [];
  const walletVouchers = (typeof savedVouchers !== 'undefined' && Array.isArray(savedVouchers) && savedVouchers.length > 0) ? savedVouchers : [];
  const mergedV = [...walletVouchers, ...dbVouchers];
  const seenCodes = new Set();
  const availableVouchers = [];

  // Lọc sạch triệt để: voucher nào đã dùng trong DB / vé cũ thì biến mất hoàn toàn
  mergedV.forEach(v => {
    if (v && v.code) {
      const upper = v.code.trim().toUpperCase();
      if (!seenCodes.has(upper) && !userUsedSet.has(upper)) {
        seenCodes.add(upper);
        availableVouchers.push(v);
      }
    }
  });

  if (availableVouchers.length === 0) {
    defaultSystemVouchers.forEach(v => {
      const upper = v.code.trim().toUpperCase();
      if (!seenCodes.has(upper) && !userUsedSet.has(upper)) {
        seenCodes.add(upper);
        availableVouchers.push(v);
      }
    });
  }

  const nRows = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.rows) ? seatConfig.rows : 6;
  const nCols = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.cols) ? seatConfig.cols : 10;
  let sMatrix = {};
  if (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.seatMatrix) {
    sMatrix = (typeof seatConfig.seatMatrix === 'string') ? JSON.parse(seatConfig.seatMatrix) : seatConfig.seatMatrix;
  }
  const vipStartRow = Math.max(1, Math.floor(nRows * 0.45));
  var activeSeats = (typeof seats !== 'undefined' && Array.isArray(seats)) ? seats : ((typeof seats === 'string' && seats) ? seats.split(',').map(s => s.trim()).filter(Boolean) : []);
%>

<style>
  /* Đồng bộ duy nhất 1 font Be Vietnam Pro toàn diện */
  .checkout-container,
  .checkout-container * {
    font-family: 'Be Vietnam Pro', system-ui, -apple-system, sans-serif !important;
  }
  /* Card thanh toán luôn giữ cố định border-2 để khi click không bao giờ bị giật / nhảy kích thước */
  .payment-method-card {
    border-width: 2px !important;
    box-sizing: border-box !important;
    transition: border-color 0.15s ease, background-color 0.15s ease !important;
  }
</style>

<main class="checkout-container py-6 sm:py-8 pb-16 bg-[#FAF8F5] text-[#121316]">
  <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- =========================================================================
         1. EDITORIAL CHECKOUT MASTHEAD & 5-MINUTE COUNTDOWN BAR
         ========================================================================= -->
    <div class="pb-4 border-b border-[#E5E0D5] mb-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <span class="text-[11px] text-[#7A7E8B] uppercase tracking-wider block font-semibold">
            BƯỚC 4 / HOÀN TẤT ĐẶT VÉ
          </span>
          <h1 class="text-xl sm:text-2xl font-extrabold text-[#121316] mt-0.5 tracking-tight">
            Xác Nhận Đơn Hàng & Thanh Toán
          </h1>
        </div>

        <!-- Actions: Return & Countdown Timer -->
        <div class="flex items-center gap-3">
          <button type="button" 
                  onclick="cancelAndReturnToSeats()" 
                  class="bg-white border border-[#E5E0D5] hover:border-[#BA2D27] text-[#BA2D27] py-2 px-3.5 flex items-center gap-2 text-xs font-bold transition-all shadow-2xs select-none cursor-pointer">
            <span>←</span>
            <span>CHỌN LẠI GHẾ</span>
          </button>

          <!-- 5-Minute Cancellation Widget -->
          <div class="bg-white border border-[#E5E0D5] py-2 px-4 flex items-center gap-2.5 shadow-2xs select-none">
            <span class="text-sm text-[#BA2D27]">⏱</span>
            <span class="text-[11px] text-[#7A7E8B] uppercase font-medium">Giữ vé:</span>
            <span id="countdownTimer" class="text-base font-black text-[#BA2D27]">05:00</span>
          </div>
        </div>
      </div>

      <!-- Live Dynamic Countdown Progress Bar -->
      <div class="w-full bg-[#E5E0D5] h-1.5 mt-3 overflow-hidden">
        <div id="countdownProgressBar" class="bg-[#BA2D27] h-full w-full transition-all duration-1000 ease-linear"></div>
      </div>
    </div>

    <form id="checkoutForm" action="/xac-nhan-thanh-toan" method="POST">
      
      <!-- Hidden Required Inputs for Express Handler -->
      <input type="hidden" name="phimId" value="<%= phim ? phim._id : '' %>" />
      <input type="hidden" name="cinema" id="input_cinema" value="<%= typeof cinema !== 'undefined' ? cinema : 'CGV Kim Cúc Plaza' %>" />
      <input type="hidden" name="showDate" id="input_showDate" value="<%= typeof showDate !== 'undefined' && showDate ? showDate : new Date().toISOString().split('T')[0] %>" />
      <input type="hidden" name="showTime" id="input_showTime" value="<%= typeof showTime !== 'undefined' ? showTime : '19:30' %>" />
      <input type="hidden" name="seats" id="input_seats" value="<%= typeof seats !== 'undefined' && Array.isArray(seats) ? seats.join(',') : (typeof seats !== 'undefined' ? seats : '') %>" />
      <input type="hidden" name="total" id="input_base_total" value="<%= typeof total !== 'undefined' ? total : 0 %>" />
      <input type="hidden" name="finalAmount" id="input_final_amount" value="<%= typeof total !== 'undefined' ? total : 0 %>" />
      <input type="hidden" name="voucherCode" id="input_voucher_code" value="" />
      <input type="hidden" name="discountAmount" id="input_discount_amount" value="0" />
      <input type="hidden" name="comboDetails" value="<%= typeof comboDetails !== 'undefined' ? comboDetails : '' %>" />
      <input type="hidden" name="comboTotal" value="<%= typeof comboTotal !== 'undefined' ? comboTotal : 0 %>" />

      <!-- =========================================================================
           2. BỐ CỤC 2 CỘT CÂN ĐỐI, THOÁNG ĐÃNG THEO CHUẨN UI/UX PRO MAX:
              - CỘT TRÁI: Sơ đồ phòng chiếu + KHỐI VOUCHER ƯU ĐÃI + Thông tin người nhận vé
              - CỘT PHẢI: PHIẾU XÁC NHẬN ĐƠN HÀNG (KHÔNG TRƯỢT DÍNH) + Phương thức thanh toán (Không Icon, Không Nhảy)
           ========================================================================= -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- =====================================================================
             CỘT TRÁI (Span 7): SƠ ĐỒ GHẾ + MÃ VOUCHER ƯU ĐÃI + THÔNG TIN NHẬN VÉ
             ===================================================================== -->
        <div class="lg:col-span-7 space-y-5">
          
          <!-- KHỐI 1: VỊ TRÍ GHẾ NGỒI TRONG PHÒNG CHIẾU -->
          <div class="bg-white border border-[#E5E0D5] p-5 sm:p-6 space-y-4 shadow-2xs">
            <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-3">
              <div>
                <span class="text-[10px] text-[#BA2D27] font-bold uppercase tracking-wider block">SƠ ĐỒ PHÒNG CHIẾU</span>
                <h2 class="text-base font-bold text-[#121316] mt-0.5">
                  Vị Trí Ghế Ngồi Của Bạn
                </h2>
              </div>
              <div class="text-right">
                <span class="text-xs text-[#7A7E8B] block font-medium">
                  <%= typeof cinema !== 'undefined' ? cinema : 'CGV Kim Cúc Plaza' %> • <%= typeof showTime !== 'undefined' ? showTime : '19:30' %>
                </span>
                <span class="inline-block mt-0.5 px-2.5 py-0.5 text-[10px] font-bold uppercase bg-[#EFEBE3] text-[#121316]">
                  <%= (phim && phim.format && !phim.format.toLowerCase().includes('imax')) ? phim.format : 'Rạp Thường (2D)' %>
                </span>
              </div>
            </div>

            <!-- Mini Auditorium Seat Map (Đầy đủ hàng ghế theo cấu hình rạp thực tế) -->
            <div class="bg-[#0E1015] p-4 sm:p-5 border border-white/10 overflow-x-auto text-white">
              <div class="w-3/5 mx-auto h-1.5 bg-gradient-to-r from-transparent via-[#BA2D27]/80 to-transparent mb-1.5"></div>
              <div class="text-center text-[9px] text-white/50 tracking-widest uppercase mb-3">
                MÀN HÌNH CHIẾU
              </div>

              <!-- Seat Rows Visualizer -->
              <div class="space-y-1.5 max-w-full mx-auto text-center overflow-x-auto py-1" id="checkoutSeatVisualizer">
                <% for(let r = 0; r < nRows; r++) { 
                  const rChar = String.fromCharCode(65 + r);
                  const isLastRow = (r === nRows - 1);
                  const isVIPRow = (!isLastRow && r >= vipStartRow);
                %>
                  <div class="flex items-center justify-center gap-1 sm:gap-1.5">
                    <span class="w-3.5 text-[9px] font-bold <%= isVIPRow ? 'text-[#D97706]' : 'text-white/40' %>"><%= rChar %></span>

                    <% if (isLastRow) { %>
                      <% for(let c = 1; c <= nCols; c += 2) { 
                        const pairCode = (c + 1 <= nCols) ? `${rChar}${c}-${rChar}${c+1}` : `${rChar}${c}`;
                        const isSelected = activeSeats.includes(pairCode);
                      %>
                        <div class="w-9 sm:w-11 h-5 flex items-center justify-center text-[8px] font-bold <%= isSelected ? 'bg-[#BA2D27] text-white ring-1 ring-white' : 'bg-white/10 text-white/40' %>" title="<%= pairCode %>">
                          <%= pairCode %>
                        </div>
                      <% } %>
                    <% } else { %>
                      <% for(let c = 1; c <= nCols; c++) { 
                        const sCode = rChar + c;
                        let sType = sMatrix[sCode] || (isVIPRow ? 'vip' : 'standard');
                        const isSelected = activeSeats.includes(sCode);
                      %>
                        <% if (sType === 'empty') { %>
                          <div class="w-5 sm:w-6 h-5 invisible"></div>
                        <% } else { %>
                          <div class="w-5 sm:w-6 h-5 flex items-center justify-center text-[8px] font-bold <%= isSelected ? 'bg-[#BA2D27] text-white ring-1 ring-white' : (isVIPRow ? 'bg-white/10 text-[#D97706] border-b border-[#D97706]' : 'bg-white/10 text-white/40') %>" title="<%= sCode %>">
                            <%= c %>
                          </div>
                        <% } %>
                      <% } %>
                    <% } %>

                    <span class="w-3.5 text-[9px] font-bold <%= isVIPRow ? 'text-[#D97706]' : 'text-white/40' %>"><%= rChar %></span>
                  </div>
                <% } %>
              </div>

              <!-- Seat Preview Legend -->
              <div class="mt-3 pt-2.5 border-t border-white/10 flex items-center justify-center gap-5 text-[10px]">
                <div class="flex items-center gap-1.5">
                  <div class="w-3 h-3 bg-[#BA2D27]"></div>
                  <span class="text-white font-bold">Ghế bạn đang chọn (<%= activeSeats.length %> ghế)</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <div class="w-3 h-3 bg-white/10"></div>
                  <span class="text-white/40">Ghế khác</span>
                </div>
              </div>
            </div>

            <!-- List of selected seats badge -->
            <div class="flex flex-wrap items-center justify-between gap-2 pt-1 text-xs">
              <span class="text-[#7A7E8B] text-xs">Mã số ghế đã chọn:</span>
              <div class="flex flex-wrap gap-1.5">
                <% if (activeSeats.length > 0) { %>
                  <% activeSeats.forEach(s => { %>
                    <span class="px-2.5 py-1 bg-[#121316] text-white font-bold text-xs"><%= s %></span>
                  <% }); %>
                <% } else { %>
                  <span class="text-[#BA2D27] font-bold">Chưa chọn ghế</span>
                <% } %>
              </div>
            </div>
          </div>

          <!-- KHỐI 2: MÃ ƯU ĐÃI / VOUCHER CINEGO (CHUYỂN QUA BÊN TRÁI RỘNG RÃI, VOUCHER ĐÃ DÙNG SẼ TỰ MẤT) -->
          <div class="bg-white border border-[#E5E0D5] p-5 sm:p-6 space-y-4 shadow-2xs">
            <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-3">
              <div>
                <span class="text-[10px] text-[#BA2D27] font-bold uppercase tracking-wider block">KHUYẾN MÃI & GIẢM GIÁ</span>
                <h3 class="text-base font-bold text-[#121316] mt-0.5">
                  Mã Ưu Đãi / Voucher CineGo
                </h3>
              </div>
              <% if (availableVouchers && availableVouchers.length > 0) { %>
                <span class="px-2.5 py-1 bg-[#F9EBEA] text-[#BA2D27] text-xs font-bold border border-[#BA2D27]/20">
                  <%= availableVouchers.length %> mã khả dụng
                </span>
              <% } %>
            </div>

            <!-- Input nhập mã + Nút áp dụng -->
            <div class="flex items-center gap-2">
              <input type="text" 
                     id="voucherCodeInput" 
                     placeholder="Nhập mã ưu đãi của bạn (VD: CINEGO50K)..." 
                     class="flex-1 bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs uppercase font-bold text-[#121316] focus:outline-none focus:border-[#121316] transition-colors" />
              <button type="button" 
                      id="btnApplyVoucher" 
                      onclick="checkAndApplyVoucher()" 
                      class="px-5 py-2.5 bg-[#121316] hover:bg-[#BA2D27] text-white text-xs font-bold transition-colors shrink-0 shadow-xs cursor-pointer">
                Áp Dụng
              </button>
            </div>

            <div id="voucherFeedback" class="hidden p-2.5 text-xs font-semibold mt-1"></div>

            <!-- DANH SÁCH MÃ VOUCHER ĐANG CÓ (LỌC SẠCH MÃ ĐÃ DÙNG) -->
            <% if (availableVouchers && availableVouchers.length > 0) { %>
              <div class="pt-2 border-t border-[#E5E0D5]/80 space-y-2.5">
                <div class="flex items-center justify-between text-[11px] font-bold text-[#6B7280] uppercase">
                  <span>DANH SÁCH VOUCHER ÁP DỤNG ĐƯỢC HÔM NAY:</span>
                  <span class="text-[10px] font-normal text-[#9CA3AF]">Chạm 1 chạm để áp dụng</span>
                </div>

                <div class="grid grid-cols-1 gap-2 max-h-[220px] overflow-y-auto pr-1" id="availableVouchersContainer">
                  <% availableVouchers.forEach(function(v) { 
                      const isPercent = (v.discountType === 'percentage' || v.discountType === 'percent');
                      const discText = isPercent ? ('-' + v.discountValue + '%') : ('-' + Number(v.discountValue).toLocaleString('vi-VN') + 'đ');
                  %>
                    <div class="voucher-card-item p-3 bg-[#FAF8F5] hover:bg-[#F3EFE6] border border-[#E5E0D5] hover:border-[#BA2D27]/60 transition-all cursor-pointer flex items-center justify-between gap-3 select-none group"
                         onclick="fillAndApplyVoucher('<%= v.code %>')"
                         data-voucher-code="<%= v.code %>">
                      <div class="min-w-0">
                        <div class="flex items-center gap-2">
                          <span class="font-extrabold text-xs text-[#121316] tracking-wider group-hover:text-[#BA2D27]"><%= v.code %></span>
                          <span class="px-2 py-0.5 bg-[#BA2D27] text-white text-[10px] font-bold">
                            <%= discText %>
                          </span>
                        </div>
                        <div class="text-xs text-[#474A54] truncate mt-1"><%= v.title || 'Ưu đãi đặt vé xem phim' %></div>
                        <% if (v.minOrderValue && v.minOrderValue > 0) { %>
                          <div class="text-[10px] text-[#7A7E8B] mt-0.5">Đơn tối thiểu: <%= Number(v.minOrderValue).toLocaleString('vi-VN') %>đ</div>
                        <% } %>
                      </div>
                      <button type="button" class="btn-voucher-action px-3 py-1.5 bg-white group-hover:bg-[#BA2D27] group-hover:text-white border border-[#E5E0D5] group-hover:border-[#BA2D27] text-[#121316] text-xs font-bold transition-colors shrink-0 shadow-2xs">
                        Dùng mã
                      </button>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% } else { %>
              <div class="pt-2 border-t border-[#E5E0D5]/80">
                <div class="p-3 bg-[#FAF8F5] border border-[#E5E0D5] text-xs text-[#7A7E8B] text-center">
                  <%= userUsedSet.size > 0 ? 'Bạn đã sử dụng hết các mã ưu đãi khả dụng.' : 'Hiện tại chưa có mã ưu đãi công khai.' %>
                </div>
              </div>
            <% } %>
          </div>

          <!-- KHỐI 3: THÔNG TIN KHÁCH HÀNG & NHẬN VÉ ĐIỆN TỬ -->
          <div class="bg-white border border-[#E5E0D5] p-5 sm:p-6 space-y-3.5 shadow-2xs">
            <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-2.5">
              <h3 class="text-sm font-bold text-[#121316]">
                Thông Tin Người Nhận Vé
              </h3>
              <span class="text-[10px] text-[#10B981] font-bold">XÁC THỰC TỨC THÌ</span>
            </div>

            <div class="space-y-2 text-xs">
              <div class="flex justify-between py-1 border-b border-[#FAF8F5]">
                <span class="text-[#6B7280]">Họ và tên:</span>
                <span class="font-bold text-[#121316]"><%= (typeof user !== 'undefined' && user && user.hoTen) ? user.hoTen : 'Khách Hàng CineGo' %></span>
              </div>
              <div class="flex justify-between py-1 border-b border-[#FAF8F5]">
                <span class="text-[#6B7280]">Số điện thoại:</span>
                <span class="font-bold text-[#121316]"><%= (typeof user !== 'undefined' && user && user.soDienThoai) ? user.soDienThoai : 'Liên kết tài khoản' %></span>
              </div>
              <div class="flex justify-between py-1">
                <span class="text-[#6B7280]">Email nhận vé:</span>
                <span class="font-bold text-[#121316]"><%= (typeof user !== 'undefined' && user && user.email) ? user.email : 'Tài khoản đăng nhập' %></span>
              </div>
            </div>

            <div class="p-3 bg-[#FAF8F5] border border-[#E5E0D5] text-[11px] text-[#6B7280] leading-relaxed">
              💡 <strong>Lưu ý nhận vé:</strong> Sau khi thanh toán, mã QR và vé điện tử hiển thị tức thì trên màn hình và lưu trong mục <em>"Vé Của Tôi"</em>. Bạn chỉ cần xuất trình mã QR tại rạp để vào xem phim.
            </div>
          </div>

        </div>

        <!-- =====================================================================
             CỘT PHẢI (Span 5): PHIẾU XÁC NHẬN ĐƠN HÀNG (KHÔNG TRƯỢT THEO KHI CUỘN)
             ===================================================================== -->
        <div class="lg:col-span-5">
          <div class="bg-white border border-[#E5E0D5] p-5 sm:p-6 space-y-4 shadow-sm">
            
            <!-- Movie Stamp Header -->
            <div class="flex items-start justify-between border-b border-[#E5E0D5] pb-3">
              <div>
                <span class="text-[10px] text-[#7A7E8B] uppercase tracking-widest block font-semibold">
                  PHIẾU XÁC NHẬN ĐƠN HÀNG
                </span>
                <h3 class="text-base sm:text-lg font-bold text-[#121316] mt-1 leading-snug">
                  <%= phim ? phim.title : 'Phim Đã Chọn' %>
                </h3>
                <div class="flex items-center flex-wrap gap-2 mt-1">
                  <span class="text-xs text-[#BA2D27] font-semibold">
                    <%= typeof cinema !== 'undefined' ? cinema : 'CGV Kim Cúc Plaza' %>
                  </span>
                  <span class="text-[#CDC6B8]">•</span>
                  <span class="px-2 py-0.5 text-[10px] font-bold uppercase bg-[#EFEBE3] text-[#121316]">
                    <%= (phim && phim.format && !phim.format.toLowerCase().includes('imax')) ? phim.format : 'Rạp Thường (2D)' %>
                  </span>
                </div>
              </div>
              <div class="w-9 h-9 bg-[#121316] text-white flex items-center justify-center font-bold text-xs shrink-0">
                2D
              </div>
            </div>

            <!-- Screening Details Ledger -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs py-2 border-b border-[#E5E0D5]">
              <div>
                <span class="text-[#7A7E8B] block text-[10px] uppercase font-medium">Suất Chiếu:</span>
                <span class="font-bold text-[#121316]"><%= typeof showTime !== 'undefined' ? showTime : '19:30' %></span>
              </div>
              <div>
                <span class="text-[#7A7E8B] block text-[10px] uppercase font-medium">Ngày Chiếu:</span>
                <span class="font-bold text-[#121316]"><%= typeof showDate !== 'undefined' && showDate ? showDate : new Date().toISOString().split('T')[0] %></span>
              </div>
              <div>
                <span class="text-[#7A7E8B] block text-[10px] uppercase font-medium">Định Dạng:</span>
                <span class="font-bold text-[#121316]"><%= (phim && phim.format && !phim.format.toLowerCase().includes('imax')) ? phim.format : 'Rạp Thường (2D)' %></span>
              </div>
              <div class="col-span-2 sm:col-span-3 pt-1">
                <span class="text-[#7A7E8B] block text-[10px] uppercase font-medium">Ghế Ngồi Đã Chọn:</span>
                <div class="flex flex-wrap gap-1 mt-1">
                  <% if (typeof seats !== 'undefined' && Array.isArray(seats) && seats.length > 0) { %>
                    <% seats.forEach(s => { %>
                      <span class="px-2.5 py-0.5 bg-[#BA2D27] text-white font-bold text-xs"><%= s %></span>
                    <% }); %>
                  <% } else if (typeof seats === 'string' && seats) { %>
                    <span class="px-2.5 py-0.5 bg-[#BA2D27] text-white font-bold text-xs"><%= seats %></span>
                  <% } else { %>
                    <span class="text-[#A6AAB6] italic font-normal">Chưa có ghế</span>
                  <% } %>
                </div>
              </div>

              <!-- BẮP NƯỚC ĐẶT KÈM (KHÔNG EMOJI, CHỮ SẠCH SẼ) -->
              <% if (typeof comboDetails !== 'undefined' && comboDetails && comboDetails.trim() !== '') { %>
                <div class="col-span-2 sm:col-span-3 pt-2.5 border-t border-[#E5E0D5]">
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="text-[#856404] font-bold text-[10px] uppercase tracking-wider">
                      BẮP NƯỚC ĐẶT KÈM (F&B):
                    </span>
                    <span class="text-[#121316] font-bold text-xs"><%= Number(typeof comboTotal !== 'undefined' ? comboTotal : 0).toLocaleString('vi-VN') %> đ</span>
                  </div>
                  <div class="space-y-1">
                    <% 
                      const comboArr = comboDetails.split(',').map(s => s.trim()).filter(Boolean);
                      comboArr.forEach(c => {
                    %>
                      <div class="flex items-center justify-between text-[11px] bg-[#FAF8F5] p-1.5 px-2.5 border border-[#E5E0D5]">
                        <span class="text-[#121316] font-medium"><%= c %></span>
                        <span class="text-[#10B981] font-bold text-[10px]">Fast-Track</span>
                      </div>
                    <% }); %>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- Itemized Pricing Breakdown -->
            <div class="space-y-1.5 text-xs border-b border-[#E5E0D5] pb-3">
              <div class="flex justify-between text-[#474A54]">
                <span>Tạm tính vé xem phim:</span>
                <span class="font-bold text-[#121316]"><%= (typeof total !== 'undefined' ? total - (typeof comboTotal !== 'undefined' ? comboTotal : 0) : 0).toLocaleString('vi-VN') %> đ</span>
              </div>
              
              <% if (typeof comboTotal !== 'undefined' && comboTotal > 0) { %>
                <div class="flex justify-between text-[#474A54]">
                  <span>Combo Bắp nước:</span>
                  <span class="font-bold text-[#121316]"><%= Number(comboTotal).toLocaleString('vi-VN') %> đ</span>
                </div>
              <% } %>

              <div id="voucherDiscountRow" class="hidden flex justify-between text-[#BA2D27] font-bold">
                <span>Giảm giá voucher:</span>
                <span id="voucherDiscountDisplay">-0 đ</span>
              </div>

              <div class="flex justify-between text-[#7A7E8B]">
                <span>Phí dịch vụ & tiện ích:</span>
                <span class="text-[#10B981] font-bold">0 đ (Miễn phí)</span>
              </div>
            </div>

            <!-- =================================================================
                 PHƯƠNG THỨC THANH TOÁN (KHÔNG ICON, KHÔNG GIẬT NHẢY, THOÁNG ĐẸP)
                 ================================================================= -->
            <div class="pt-1 border-t border-[#E5E0D5]">
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10.5px] font-bold text-[#6B7280] uppercase tracking-wider">
                  PHƯƠNG THỨC THANH TOÁN
                </span>
                <span class="text-[9.5px] font-bold text-[#10B981]">MIỄN PHÍ</span>
              </div>

              <div class="grid grid-cols-2 gap-2.5 text-xs" id="paymentMethodContainer">
                
                <!-- 1. VietQR 24/7 -->
                <label class="payment-method-card flex items-center gap-2.5 p-3 bg-[#FAF8F5] border-2 border-[#121316] cursor-pointer select-none">
                  <input type="radio" name="payment_method" value="vietqr" checked class="accent-[#BA2D27] cursor-pointer w-4 h-4 shrink-0" />
                  <span class="font-bold text-[#121316] text-xs truncate">VietQR 24/7 (Khuyên dùng)</span>
                </label>

                <!-- 2. Ví MoMo -->
                <label class="payment-method-card flex items-center gap-2.5 p-3 bg-white border-2 border-[#E5E0D5] hover:border-[#121316] cursor-pointer select-none">
                  <input type="radio" name="payment_method" value="momo" class="accent-[#BA2D27] cursor-pointer w-4 h-4 shrink-0" />
                  <span class="font-bold text-[#121316] text-xs truncate">Ví MoMo</span>
                </label>

                <!-- 3. Ví ZaloPay -->
                <label class="payment-method-card flex items-center gap-2.5 p-3 bg-white border-2 border-[#E5E0D5] hover:border-[#121316] cursor-pointer select-none">
                  <input type="radio" name="payment_method" value="zalopay" class="accent-[#BA2D27] cursor-pointer w-4 h-4 shrink-0" />
                  <span class="font-bold text-[#121316] text-xs truncate">Ví ZaloPay</span>
                </label>

                <!-- 4. VNPAY-QR -->
                <label class="payment-method-card flex items-center gap-2.5 p-3 bg-white border-2 border-[#E5E0D5] hover:border-[#121316] cursor-pointer select-none">
                  <input type="radio" name="payment_method" value="vnpay" class="accent-[#BA2D27] cursor-pointer w-4 h-4 shrink-0" />
                  <span class="font-bold text-[#121316] text-xs truncate">VNPAY-QR</span>
                </label>

                <!-- 5. Thẻ ATM / Thẻ Quốc Tế -->
                <label class="payment-method-card col-span-2 flex items-center gap-2.5 p-3 bg-white border-2 border-[#E5E0D5] hover:border-[#121316] cursor-pointer select-none">
                  <input type="radio" name="payment_method" value="atm" class="accent-[#BA2D27] cursor-pointer w-4 h-4 shrink-0" />
                  <span class="font-bold text-[#121316] text-xs truncate">Thẻ ATM Nội Địa / Thẻ Quốc Tế (Visa, Master)</span>
                </label>

              </div>
            </div>

            <!-- Đường kẻ vé đứt đoạn với vết khuyết -->
            <div class="relative py-1.5">
              <div class="border-t border-dashed border-[#E5E0D5]"></div>
              <div class="absolute -left-6 sm:-left-7 top-1/2 -translate-y-1/2 w-4 h-4 bg-[#FAF8F5]"></div>
              <div class="absolute -right-6 sm:-right-7 top-1/2 -translate-y-1/2 w-4 h-4 bg-[#FAF8F5]"></div>
            </div>

            <!-- Final Grand Total -->
            <div class="flex items-baseline justify-between pt-1">
              <div>
                <span class="block text-[11px] uppercase font-bold text-[#7A7E8B] tracking-wider">TỔNG TIỀN PHẢI TRẢ:</span>
                <span class="text-[9.5px] text-[#A6AAB6]">Đã bao gồm thuế GTGT</span>
              </div>
              <div class="text-right">
                <span id="grandTotalDisplay" class="text-2xl sm:text-3xl font-black text-[#BA2D27]">
                  <%= (typeof total !== 'undefined' ? Number(total) : 0).toLocaleString('vi-VN') %> đ
                </span>
              </div>
            </div>

            <!-- Submit CTA Button -->
            <button type="submit" 
                    id="btnSubmitPayment" 
                    onclick="isPaymentSubmitted = true;" 
                    class="w-full py-3.5 px-4 bg-[#BA2D27] hover:bg-[#8E1F1A] text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer select-none">
              <span>XÁC NHẬN THANH TOÁN & NHẬN VÉ →</span>
            </button>

            <div class="text-center text-[10px] text-[#7A7E8B] pt-0.5">
              Bằng việc bấm xác nhận, bạn đồng ý với các <a href="#" class="underline hover:text-[#BA2D27]">Quy chế hoàn/hủy vé</a> của CineGo.
            </div>

          </div>
        </div>

      </div>

    </form>

  </div>
</main>

<!-- =========================================================================
     3. 5-MINUTE TIMEOUT CANCELLATION MODAL
     ========================================================================= -->
<div id="timeoutModal" class="hidden fixed inset-0 z-50 bg-[#121316]/90 backdrop-blur-md flex items-center justify-center p-4">
  <div class="bg-white border-2 border-[#BA2D27] max-w-md w-full p-6 text-center space-y-4 shadow-2xl relative">
    <div class="w-12 h-12 bg-red-100 text-[#BA2D27] flex items-center justify-center mx-auto text-2xl font-bold">
      ⏱
    </div>
    
    <h3 class="text-xl font-bold text-[#121316]">
      Hết Thời Gian Giữ Vé
    </h3>
    
    <p class="text-xs text-[#474A54] leading-relaxed">
      Phiên giao dịch đã hết thời gian thực hiện. Vui lòng quay lại để đặt vé mới.
    </p>

    <div class="pt-2">
      <button type="button" onclick="cancelAndReturnToSeats()" class="w-full py-2.5 bg-[#BA2D27] hover:bg-[#8E1F1A] text-white text-xs font-bold block text-center uppercase tracking-wider transition-colors cursor-pointer">
        Quay Lại Chọn Suất Chiếu Khác →
      </button>
    </div>
  </div>
</div>

<script>
  let baseTotal = <%= typeof total !== 'undefined' ? Number(total) : 0 %>;
  let currentFinal = baseTotal;
  let appliedVoucherCode = '';

  const bookingMeta = {
    movieId: '<%= phim ? phim._id : "" %>',
    cinema: '<%= typeof cinema !== "undefined" ? cinema : "" %>',
    showDate: '<%= typeof showDate !== "undefined" ? showDate : "" %>',
    showTime: '<%= typeof showTime !== "undefined" ? showTime : "" %>',
    seats: <%- JSON.stringify(typeof seats !== 'undefined' ? seats : []) %>
  };

  function sendBeaconRelease() {
    if (isPaymentSubmitted) return;
    try {
      const blob = new Blob([JSON.stringify(bookingMeta)], { type: 'application/json' });
      if (navigator.sendBeacon) {
        navigator.sendBeacon('/api/huy-giu-ghe', blob);
      } else {
        fetch('/api/huy-giu-ghe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(bookingMeta),
          keepalive: true
        });
      }
    } catch(e) {}
  }

  async function releaseSeatsImmediately() {
    sendBeaconRelease();
  }

  function cancelAndReturnToSeats() {
    const seatsStr = Array.isArray(bookingMeta.seats) ? bookingMeta.seats.join(',') : (bookingMeta.seats || '');
    const returnUrl = `/dat-ve/${bookingMeta.movieId}?release=true&cinema=${encodeURIComponent(bookingMeta.cinema)}&date=${encodeURIComponent(bookingMeta.showDate)}&time=${encodeURIComponent(bookingMeta.showTime)}&seats=${encodeURIComponent(seatsStr)}`;
    sendBeaconRelease();
    window.location.href = returnUrl;
  }

  let isPaymentSubmitted = false;
  const mainPaymentForm = document.getElementById('checkoutForm');
  if (mainPaymentForm) {
    mainPaymentForm.addEventListener('submit', () => {
      isPaymentSubmitted = true;
      if (heartbeatTimer) clearInterval(heartbeatTimer);
      window.removeEventListener('pagehide', sendBeaconRelease);
      window.removeEventListener('beforeunload', sendBeaconRelease);
    });
  }

  // 1. Tự động nhả ghế tức thì khi người dùng đóng tab, back trang hoặc tắt trình duyệt (chỉ khi CHƯA bấm thanh toán)
  window.addEventListener('pagehide', sendBeaconRelease);
  window.addEventListener('beforeunload', sendBeaconRelease);

  // 2. Tự động nhả ghế khi người dùng click vào bất kỳ liên kết nội bộ nào để chuyển trang
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', (e) => {
        if (isPaymentSubmitted) return;
        const href = link.getAttribute('href');
        const target = link.getAttribute('target');
        if (target === '_blank') return;
        if (href && !href.startsWith('#') && !href.startsWith('javascript:')) {
          sendBeaconRelease();
        }
      });
    });
  });

  // 3. Cơ chế NHỊP TIM (HEARTBEAT)
  let heartbeatTimer = null;
  if (bookingMeta.seats && bookingMeta.seats.length > 0) {
    heartbeatTimer = setInterval(() => {
      if (isPaymentSubmitted) {
        clearInterval(heartbeatTimer);
        return;
      }
      fetch('/api/heartbeat-giu-ghe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bookingMeta)
      }).catch(err => {});
    }, 15000);
  }

  // ==========================================
  // 5-MINUTE COUNTDOWN TIMER & AUTO-CANCEL LOGIC
  // ==========================================
  const TOTAL_SECONDS = 300; // 5 minutes
  let remainingSeconds = TOTAL_SECONDS;
  const timerDisplay = document.getElementById('countdownTimer');
  const progressBar = document.getElementById('countdownProgressBar');
  const timeoutModal = document.getElementById('timeoutModal');

  const countdownInterval = setInterval(() => {
    remainingSeconds--;

    if (remainingSeconds <= 0) {
      clearInterval(countdownInterval);
      if (heartbeatTimer) clearInterval(heartbeatTimer);
      if (timerDisplay) timerDisplay.innerText = '00:00';
      if (progressBar) progressBar.style.width = '0%';
      releaseSeatsImmediately();
      if (timeoutModal) timeoutModal.classList.remove('hidden');
      const submitBtn = document.getElementById('btnSubmitPayment');
      if (submitBtn) submitBtn.disabled = true;
      return;
    }

    const minutes = Math.floor(remainingSeconds / 60);
    const seconds = remainingSeconds % 60;
    const formatted = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    
    if (timerDisplay) timerDisplay.innerText = formatted;
    if (progressBar) {
      const percentage = (remainingSeconds / TOTAL_SECONDS) * 100;
      progressBar.style.width = percentage + '%';
    }
  }, 1000);

  // ==========================================
  // VOUCHER APPLICATION & ONE-CLICK LOGIC
  // ==========================================
  function fillAndApplyVoucher(code) {
    const input = document.getElementById('voucherCodeInput');
    if (!input) return;

    if (appliedVoucherCode && appliedVoucherCode.toUpperCase() === code.toUpperCase()) {
      // Hủy áp dụng nếu bấm lại voucher đang dùng
      input.value = '';
      appliedVoucherCode = '';
      currentFinal = baseTotal;
      document.getElementById('input_voucher_code').value = '';
      document.getElementById('input_discount_amount').value = 0;
      document.getElementById('input_final_amount').value = baseTotal;
      document.getElementById('voucherDiscountRow').classList.add('hidden');
      document.getElementById('grandTotalDisplay').innerText = baseTotal.toLocaleString('vi-VN') + ' đ';
      const feedback = document.getElementById('voucherFeedback');
      if (feedback) feedback.classList.add('hidden');
      syncVoucherListUI();
      return;
    }

    input.value = code;
    checkAndApplyVoucher();
  }

  function syncVoucherListUI() {
    const activeCode = appliedVoucherCode ? appliedVoucherCode.toUpperCase() : '';
    document.querySelectorAll('.voucher-card-item').forEach(card => {
      const cardCode = (card.getAttribute('data-voucher-code') || '').toUpperCase();
      const actionBtn = card.querySelector('.btn-voucher-action');
      if (activeCode && cardCode === activeCode) {
        card.classList.add('border-[#BA2D27]', 'bg-[#F9EBEA]');
        card.classList.remove('border-[#E5E0D5]', 'bg-[#FAF8F5]');
        if (actionBtn) {
          actionBtn.innerText = '✓ Đang dùng';
          actionBtn.className = 'btn-voucher-action px-3 py-1.5 bg-[#BA2D27] text-white border border-[#BA2D27] text-xs font-bold shrink-0 shadow-2xs';
        }
      } else {
        card.classList.remove('border-[#BA2D27]', 'bg-[#F9EBEA]');
        card.classList.add('border-[#E5E0D5]', 'bg-[#FAF8F5]');
        if (actionBtn) {
          actionBtn.innerText = 'Dùng mã';
          actionBtn.className = 'btn-voucher-action px-3 py-1.5 bg-white group-hover:bg-[#BA2D27] group-hover:text-white border border-[#E5E0D5] group-hover:border-[#BA2D27] text-[#121316] text-xs font-bold transition-colors shrink-0 shadow-2xs';
        }
      }
    });
  }

  async function checkAndApplyVoucher() {
    const code = document.getElementById('voucherCodeInput').value.trim();
    const feedback = document.getElementById('voucherFeedback');
    if (!code) {
      feedback.classList.remove('hidden');
      feedback.className = 'p-2.5 bg-red-50 text-red-700 border border-red-200 text-xs mt-1.5';
      feedback.innerText = 'Vui lòng nhập mã voucher!';
      return;
    }

    try {
      const res = await fetch('/api/kiem-tra-voucher', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, currentTotal: baseTotal, orderType: 'movie' })
      });
      const data = await res.json();

      feedback.classList.remove('hidden');
      if (data.success) {
        feedback.className = 'p-2.5 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs mt-1.5';
        feedback.innerText = '✓ ' + (data.message || 'Áp dụng mã ưu đãi thành công!');

        let discount = 0;
        if (data.discountType === 'fixed') {
          discount = data.discountValue;
        } else if (data.discountType === 'percentage' || data.discountType === 'percent') {
          discount = Math.round((baseTotal * data.discountValue) / 100);
          if (data.maxDiscountValue > 0 && discount > data.maxDiscountValue) {
            discount = data.maxDiscountValue;
          }
        }

        appliedVoucherCode = code.toUpperCase();
        currentFinal = Math.max(0, baseTotal - discount);
        document.getElementById('voucherDiscountRow').classList.remove('hidden');
        document.getElementById('voucherDiscountDisplay').innerText = '-' + discount.toLocaleString('vi-VN') + ' đ';
        document.getElementById('grandTotalDisplay').innerText = currentFinal.toLocaleString('vi-VN') + ' đ';
        document.getElementById('input_final_amount').value = currentFinal;
        document.getElementById('input_voucher_code').value = appliedVoucherCode;
        document.getElementById('input_discount_amount').value = discount;

        if (window.cinegoToast) window.cinegoToast.success('Áp dụng mã giảm: -' + discount.toLocaleString('vi-VN') + 'đ');
        syncVoucherListUI();
      } else {
        appliedVoucherCode = '';
        feedback.className = 'p-2.5 bg-red-50 text-red-700 border border-red-200 text-xs mt-1.5';
        feedback.innerText = '✕ ' + (data.message || 'Mã không hợp lệ!');
        document.getElementById('input_voucher_code').value = '';
        document.getElementById('input_discount_amount').value = 0;
        document.getElementById('voucherDiscountRow').classList.add('hidden');
        document.getElementById('grandTotalDisplay').innerText = baseTotal.toLocaleString('vi-VN') + ' đ';
        document.getElementById('input_final_amount').value = baseTotal;
        syncVoucherListUI();
      }
    } catch (e) {
      appliedVoucherCode = '';
      feedback.classList.remove('hidden');
      feedback.className = 'p-2.5 bg-red-50 text-red-700 border border-red-200 text-xs mt-1.5';
      feedback.innerText = '✕ Lỗi kết nối hoặc mã ưu đãi không hợp lệ!';
      document.getElementById('input_voucher_code').value = '';
      document.getElementById('input_discount_amount').value = 0;
      document.getElementById('voucherDiscountRow').classList.add('hidden');
      document.getElementById('grandTotalDisplay').innerText = baseTotal.toLocaleString('vi-VN') + ' đ';
      syncVoucherListUI();
    }
  }

  // ==========================================
  // DYNAMIC PAYMENT METHOD SELECTION & HIGHLIGHT (KHÔNG GIẬT NHẢY BORDER)
  // ==========================================
  function updatePaymentMethodCards() {
    const cards = document.querySelectorAll('.payment-method-card');
    cards.forEach(card => {
      const radio = card.querySelector('input[name="payment_method"]');
      if (radio && radio.checked) {
        card.classList.remove('border-[#E5E0D5]', 'bg-white');
        card.classList.add('border-[#121316]', 'bg-[#FAF8F5]');
      } else {
        card.classList.remove('border-[#121316]', 'bg-[#FAF8F5]');
        card.classList.add('border-[#E5E0D5]', 'bg-white');
      }
    });
  }

  document.querySelectorAll('input[name="payment_method"]').forEach(radio => {
    radio.addEventListener('change', updatePaymentMethodCards);
  });

  // Run on ready to sync active card & attach auto-clear cart on submit
  document.addEventListener('DOMContentLoaded', () => {
    updatePaymentMethodCards();
    syncVoucherListUI();

    const autoVoucher = '<%= (typeof preVoucher !== "undefined" && preVoucher) ? preVoucher : "" %>';
    if (autoVoucher) {
      fillAndApplyVoucher(autoVoucher);
    }

    const chkForm = document.getElementById('checkoutForm');
    if (chkForm) {
      chkForm.addEventListener('submit', function() {
        try {
          if (typeof window.clearHeaderCart === 'function') {
            window.clearHeaderCart();
          } else {
            localStorage.removeItem('cinego_cart');
          }
        } catch(e) {}
      });
    }
  });
</script>

<%- include('partials/footer') %>

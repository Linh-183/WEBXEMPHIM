<%- include('partials/header') %>

<% if (typeof error !== 'undefined' && error) { %>
  <div data-toast-error="<%= error %>"></div>
<% } %>

<% 
  // Chuẩn hóa thời gian Việt Nam (Asia/Ho_Chi_Minh - UTC+7)
  const nowVN = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Ho_Chi_Minh' }));
  const todayBooking = nowVN;
  const yearNow = todayBooking.getFullYear();
  const monthNow = String(todayBooking.getMonth() + 1).padStart(2, '0');
  const dayNow = String(todayBooking.getDate()).padStart(2, '0');
  const initDateIso = `${yearNow}-${monthNow}-${dayNow}`;
  const currentHNow = todayBooking.getHours();
  const currentMNow = todayBooking.getMinutes();
  const daysOfWeekVi = ['CN', 'T.HAI', 'T.BA', 'T.TƯ', 'T.NĂM', 'T.SÁU', 'T.BẢY'];

  const normCinEjs = (s) => (s || '').toString().toLowerCase().replace(/[^a-z0-9]/g, '');
  const targetCinEjs = normCinEjs('CGV Kim Cúc Plaza');
  let initShowtimesList = [];
  if (typeof phim !== 'undefined' && phim && Array.isArray(phim.showtimes)) {
    const foundSt = phim.showtimes.find(s => {
      const cin = normCinEjs(s.cinema);
      const isCin = cin === targetCinEjs || cin.includes(targetCinEjs) || targetCinEjs.includes(cin);
      let sDate = s.date;
      if (sDate && sDate.includes('T')) sDate = sDate.split('T')[0];
      const isDate = (sDate === initDateIso);
      return isCin && isDate && s.times && s.times.length > 0;
    });
    if (foundSt) {
      const arr = Array.isArray(foundSt.times) ? foundSt.times : [foundSt.times];
      initShowtimesList = arr.map(t => (t || '').trim()).filter(Boolean);
    }
  }

  const isShowtimePastServer = (tStr, dIso) => {
    if (dIso < initDateIso) return true;
    if (dIso > initDateIso) return false;
    const [h, m] = (tStr || '').split(':').map(Number);
    if (isNaN(h) || isNaN(m)) return false;
    return (h < currentHNow || (h === currentHNow && m <= currentMNow));
  };
  const validFutureTimes = initShowtimesList.filter(t => !isShowtimePastServer(t, initDateIso));
  let initDefaultTime = validFutureTimes.length > 0 ? validFutureTimes[0] : '';

  const nRows = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.rows) ? seatConfig.rows : 6;
  const nCols = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.cols) ? seatConfig.cols : 10;
  const pStd = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.priceStandard) ? seatConfig.priceStandard : 75000;
  const pVIP = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.priceVIP) ? seatConfig.priceVIP : 95000;
  const pCouple = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.priceCouple) ? seatConfig.priceCouple : 170000;
  let sMatrix = {};
  if (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.seatMatrix) {
    sMatrix = (typeof seatConfig.seatMatrix === 'string') ? JSON.parse(seatConfig.seatMatrix) : seatConfig.seatMatrix;
  }
  const vipStartRow = Math.max(1, Math.floor(nRows * 0.45));
%>

<style>
  /* Đồng bộ duy nhất 1 font chữ Be Vietnam Pro trên toàn bộ trang đặt vé */
  #bookingPageContainer,
  #bookingPageContainer * {
    font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, sans-serif !important;
  }
  #bookingPageContainer a,
  #bookingPageContainer a:hover,
  #bookingPageContainer button,
  #bookingPageContainer button:hover,
  #bookingPageContainer div:hover,
  #bookingPageContainer span:hover {
    text-decoration: none !important;
  }

  /* Định dạng sơ đồ ghế ngồi chuẩn màu sắc trang web (Rạp tối, ghế vuông vức nổi bật) */
  .cinema-auditorium-box {
    background-color: #0E1015 !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
  }

  /* Màn hình cong kinh điển của rạp phim */
  .cinema-screen-arc-classic {
    width: 82%;
    max-width: 560px;
    height: 16px;
    margin: 0 auto 1.5rem auto;
    border-top: 3.5px solid #FAF8F5;
    border-radius: 50% 50% 0 0;
    box-shadow: 0 -10px 25px rgba(255, 255, 255, 0.35);
    position: relative;
    text-align: center;
  }

  .seat-unit {
    width: 32px;
    height: 30px;
    border-radius: 2px;
    font-size: 10px;
    font-weight: 700;
    transition: all 0.15s ease;
    user-select: none;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  /* 1. Ghế thường trống: Nền trắng sạch, viền xám sáng, chữ đen */
  .seat-unit.seat-free {
    background-color: #FFFFFF !important;
    color: #111827 !important;
    border: 1px solid #CBD5E1 !important;
  }
  .seat-unit.seat-free:hover {
    border-color: #BA2D27 !important;
    color: #BA2D27 !important;
    transform: scale(1.15);
    z-index: 10;
    box-shadow: 0 4px 10px rgba(186, 45, 39, 0.4) !important;
  }
  /* 2. Ghế VIP trống: Nền trắng, viền đáy vàng hổ phách nổi bật chuẩn CineGo */
  .seat-unit.seat-free.is-vip {
    background-color: #FFFFFF !important;
    color: #111827 !important;
    border-top: 1px solid #CBD5E1 !important;
    border-left: 1px solid #CBD5E1 !important;
    border-right: 1px solid #CBD5E1 !important;
    border-bottom: 3.5px solid #D97706 !important;
  }
  .seat-unit.seat-free.is-vip:hover {
    border-color: #D97706 !important;
    transform: scale(1.15);
    z-index: 10;
    box-shadow: 0 4px 10px rgba(217, 119, 6, 0.4) !important;
  }
  /* 3. Ghế Đôi Sweetbox */
  .seat-unit.seat-free.is-couple {
    width: 76px !important;
    background-color: #FFFFFF !important;
    color: #111827 !important;
    border: 1px solid #CBD5E1 !important;
  }
  .seat-unit.seat-free.is-couple:hover {
    border-color: #EC4899 !important;
    color: #EC4899 !important;
    transform: scale(1.1);
  }
  /* 4. Ghế đang chọn: Đỏ chuẩn nhận diện CineGo (#BA2D27) */
  .seat-unit.seat-selected {
    background-color: #BA2D27 !important;
    color: #FFFFFF !important;
    border: 1.5px solid #FFFFFF !important;
    transform: scale(1.1);
    box-shadow: 0 0 14px rgba(186, 45, 39, 0.7) !important;
    z-index: 5;
  }
  /* 5. Ghế đã bán */
  .seat-unit.seat-sold {
    background-color: #64748B !important;
    color: #FFFFFF !important;
    opacity: 0.45 !important;
    border: 1px solid #475569 !important;
    cursor: not-allowed !important;
    text-decoration: line-through;
  }
  /* 6. Ghế đang giữ */
  .seat-unit.seat-held {
    background-color: #1E232E !important;
    color: #D97706 !important;
    border: 1px dashed #D97706 !important;
    cursor: not-allowed !important;
  }
  @media (max-width: 640px) {
    .seat-unit {
      width: 25px !important;
      height: 25px !important;
      font-size: 8px !important;
    }
    .seat-unit.seat-free.is-couple {
      width: 54px !important;
      font-size: 7.5px !important;
    }
  }
</style>

<!-- MAIN CONTAINER: NỀN GIẤY ẤM ÁP CHUẨN CINEGO (#F5F3ED) -->
<main id="bookingPageContainer" class="min-h-screen py-5 sm:py-6 pb-20 bg-[#F5F3ED] text-[#111827]">
  <div class="max-w-[1460px] mx-auto px-4 sm:px-6">

    <!-- =========================================================================
         TOP BAR: TIÊU ĐỀ & TIẾN TRÌNH STEPPER (KHUNG VUÔNG VỨC)
         ========================================================================= -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b border-[#E5E0D5] mb-5">
      
      <!-- Left: Back button (vuông vức) + Title -->
      <div class="flex items-center gap-3">
        <a href="/phim/<%= phim._id %>" class="w-9 h-9 border border-[#E5E0D5] bg-white hover:bg-[#EAE6DC] text-[#111827] text-base font-bold transition-colors flex items-center justify-center shrink-0 shadow-xs select-none" title="Quay lại">
          ←
        </a>
        <div>
          <span class="text-[10.5px] font-bold uppercase tracking-wider text-[#6B7280] block">ĐẶT VÉ TRỰC TUYẾN</span>
          <h1 class="text-lg sm:text-2xl font-black text-[#111827] leading-tight">Chọn Suất Chiếu, Ghế & Bắp Nước</h1>
        </div>
      </div>

      <!-- Right: Stepper (Gọn gàng, vuông vức) -->
      <div class="flex items-center gap-1.5 sm:gap-2 text-xs flex-wrap">
        <span class="px-2.5 py-1 bg-[#10B981]/15 text-[#059669] border border-[#10B981]/30 font-semibold text-[11px]">✓ 1. Suất chiếu</span>
        <span class="text-[#D1D5DB]">/</span>
        <span class="px-2.5 py-1 bg-[#BA2D27] text-white font-bold text-[11px] shadow-xs">2. Chọn ghế</span>
        <span class="text-[#D1D5DB]">/</span>
        <span class="px-2.5 py-1 bg-white border border-[#E5E0D5] text-[#111827] font-bold text-[11px]">3. Bắp nước</span>
        <span class="text-[#D1D5DB]">/</span>
        <span class="text-[#6B7280] text-[11px] font-medium">4. Thanh toán</span>
      </div>

    </div>

    <!-- =========================================================================
         BỐ CỤC 2 CỘT CHUẨN VUÔNG VỨC:
         - Cột trái: 3 Khối (1. Suất chiếu, 2. Chọn ghế, 3. Bắp nước mở rộng có chọn vị)
         - Cột phải: Hóa đơn tạm tính & Nút chuyển tiếp sang thanh toán
         ========================================================================= -->
    <form id="bookingForm" action="/thanh-toan" method="POST">
      
      <!-- Hidden inputs gửi sang trang thanh toán -->
      <input type="hidden" name="movieId" value="<%= phim._id %>" />
      <input type="hidden" name="cinema" id="input_cinema" value="CGV Kim Cúc Plaza" />
      <input type="hidden" name="showDate" id="input_showDate" value="<%= initDateIso %>" />
      <input type="hidden" name="showTime" id="input_showTime" value="<%= initDefaultTime %>" />
      <input type="hidden" name="seats" id="input_seats" value="" />
      <input type="hidden" name="total" id="input_total" value="0" />
      <input type="hidden" name="comboDetails" id="input_comboDetails" value="" />
      <input type="hidden" name="comboTotal" id="input_comboTotal" value="0" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

        <!-- =====================================================================
             CỘT TRÁI (Khoảng 68% - span 8): 3 Khối chức năng VUÔNG VỨC
             ===================================================================== -->
        <div class="lg:col-span-8 space-y-4">

          <!-- KHỐI 1: THÔNG TIN SUẤT CHIẾU (KHUNG VUÔNG VỨC, KHÔNG BO GÓC) -->
          <div class="bg-white border border-[#E5E0D5] p-4 shadow-xs">
            <div class="flex items-center justify-between pb-3 border-b border-[#E5E0D5]">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 bg-[#BA2D27] text-white text-[11px] font-bold flex items-center justify-center">1</span>
                <h2 class="font-bold text-sm text-[#111827]">Thông Tin Suất Chiếu</h2>
              </div>
            </div>

            <!-- 3 Ô: Rạp (Nhấn vào là chọn được) - Ngày - Giờ (Khung vuông vức) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5 pt-3">
              
              <!-- Ô 1: Rạp Chiếu (Vuông vức, nhấn chọn rạp dễ dàng) -->
              <div class="bg-[#FAF8F5] hover:bg-[#F3EFE6] border border-[#E5E0D5] hover:border-[#BA2D27]/40 p-3 relative cursor-pointer transition-all select-none" onclick="toggleCinemaDropdown(event)">
                <div class="flex items-center justify-between text-[10.5px] font-bold text-[#6B7280] uppercase mb-1">
                  <span>RẠP & PHÒNG CHIẾU</span>
                  <span class="text-[#BA2D27] font-bold text-[11px]">
                    ĐỔI RẠP ▾
                  </span>
                </div>
                <div class="font-black text-sm text-[#111827] truncate mt-1" id="labelSelectedCinema">CGV Kim Cúc Plaza</div>

                <!-- Dropdown chọn rạp nổi bật (vuông vức) -->
                <div id="cinemaDropdownList" class="hidden absolute top-full left-0 right-0 mt-1 bg-white border border-[#E5E0D5] shadow-2xl z-30 py-1 overflow-hidden">
                  <div onclick="selectCinema('CGV Kim Cúc Plaza', event)" class="cinema-option-btn w-full px-3.5 py-2.5 text-xs text-left hover:bg-[#FAF8F5] flex items-center justify-between text-[#BA2D27] font-bold border-b border-[#F3EFE6]">
                    <span>CGV Kim Cúc Plaza</span>
                  </div>
                  <div onclick="selectCinema('Starlight Nguyễn Kim', event)" class="cinema-option-btn w-full px-3.5 py-2.5 text-xs text-left hover:bg-[#FAF8F5] flex items-center justify-between text-[#374151] font-semibold border-b border-[#F3EFE6]">
                    <span>Starlight Nguyễn Kim</span>
                  </div>
                  <div onclick="selectCinema('DCine Quy Nhơn', event)" class="cinema-option-btn w-full px-3.5 py-2.5 text-xs text-left hover:bg-[#FAF8F5] flex items-center justify-between text-[#374151] font-semibold">
                    <span>DCine Quy Nhơn</span>
                  </div>
                </div>
              </div>

              <!-- Ô 2: Chọn Ngày Chiếu (Khung vuông vức) -->
              <div class="bg-[#FAF8F5] border border-[#E5E0D5] p-3">
                <div class="flex items-center justify-between text-[10.5px] font-bold text-[#6B7280] uppercase mb-1">
                  <span>CHỌN NGÀY CHIẾU</span>
                  <span class="text-[10px] text-[#6B7280]">Tháng <%= monthNow %></span>
                </div>
                <div class="flex items-center gap-1.5 overflow-x-auto py-0.5 pb-1 no-scrollbar" id="datePillsContainer">
                  <% 
                    for (let i = 0; i < 7; i++) { 
                      const d = new Date(todayBooking);
                      d.setDate(todayBooking.getDate() + i);
                      const isToday = (i === 0);
                      const isTomorrow = (i === 1);
                      const dayName = isToday ? 'H.NAY' : (isTomorrow ? 'N.MAI' : daysOfWeekVi[d.getDay()]);
                      const dateStr = d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' }).replace('/', '-');
                      const fullIso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
                  %>
                    <button type="button" 
                            onclick="selectDate('<%= fullIso %>', '<%= dayName %> <%= dateStr %>', this)" 
                            class="date-pill-btn px-2.5 py-1 text-center transition-all cursor-pointer shrink-0 select-none <%= isToday ? 'bg-[#BA2D27] text-white font-bold shadow-xs' : 'bg-white text-[#374151] border border-[#E5E0D5] hover:border-[#BA2D27]' %>" 
                            data-iso="<%= fullIso %>">
                      <div class="text-[9px] uppercase <%= isToday ? 'text-white/90' : 'text-[#6B7280]' %> leading-none"><%= dayName %></div>
                      <div class="text-[11px] font-bold mt-0.5 leading-none"><%= dateStr %></div>
                    </button>
                  <% } %>
                </div>
              </div>

              <!-- Ô 3: Giờ Chiếu (Khung vuông vức) -->
              <div class="bg-[#FAF8F5] border border-[#E5E0D5] p-3">
                <div class="flex items-center justify-between text-[10.5px] font-bold text-[#6B7280] uppercase mb-1">
                  <span>GIỜ CHIẾU</span>
                </div>
                <div class="flex items-center gap-1.5 flex-wrap overflow-y-auto max-h-[56px]" id="timeOptionsList">
                  <!-- Rendered via JS -->
                </div>
              </div>

            </div>
          </div>

          <!-- KHỐI 2: SƠ ĐỒ CHỌN GHẾ (MÀN HÌNH CŨ + DÃY GHẾ CHUẨN MÀU RẠP) -->
          <div class="cinema-auditorium-box p-4 sm:p-6 relative overflow-hidden shadow-md text-white">
            
            <!-- Header: Tên khối + Ghế đang chọn + Chú thích giá màu chuẩn rạp -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-white/10 gap-2">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 bg-[#BA2D27] text-white text-[11px] font-bold flex items-center justify-center">2</span>
                <h2 class="font-bold text-sm text-white">Sơ đồ chọn ghế</h2>
                <span id="headerSelectedSeats" class="text-xs text-[#BA2D27] font-bold ml-1"></span>
              </div>
              
              <!-- Chú thích loại ghế (Legend trên góc phải đúng màu web gốc) -->
              <div class="flex items-center gap-3 sm:gap-4 text-[11px] text-white/80 flex-wrap font-medium">
                <div class="flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 bg-white border border-[#CBD5E1]"></span>
                  <span>Ghế Trống</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 bg-white border-b-[3.5px] border-b-[#D97706] border-[#CBD5E1]"></span>
                  <span class="text-[#D97706] font-bold">Ghế VIP</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 bg-[#BA2D27] text-white flex items-center justify-center text-[9px] font-bold">✓</span>
                  <span class="text-white font-bold">Đang Chọn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 bg-[#64748B] opacity-60 text-white flex items-center justify-center text-[9px]">✕</span>
                  <span class="text-white/50">Đã Bán</span>
                </div>
              </div>
            </div>

            <!-- Màn hình chiếu cong thanh lịch kinh điển -->
            <div class="pt-5 pb-2 text-center">
              <div class="cinema-screen-arc-classic"></div>
              <div class="text-center text-[10.5px] font-bold tracking-[0.25em] text-white/60 uppercase mb-4">
                MÀN HÌNH CHIẾU (SCREEN)
              </div>
            </div>

            <!-- Thông báo chưa có suất chiếu -->
            <div id="noShowtimeNotice" class="hidden max-w-md mx-auto my-4 p-3 bg-amber-500/10 border border-amber-500/30 text-center text-xs text-amber-300">
              ⚠️ Cụm rạp và ngày này hiện chưa có suất chiếu khả dụng. Vui lòng chọn ngày khác hoặc cụm rạp khác ở Khối 1.
            </div>

            <!-- Ma trận ghế ngồi (Chọn được nhiều ghế trên nhiều hàng) -->
            <div class="w-full overflow-x-auto py-2 text-center" id="auditoriumSeatMatrix">
              <div class="w-max min-w-full sm:min-w-[540px] max-w-2xl mx-auto space-y-2 sm:space-y-3 transition-opacity px-1">
                <% for(let r = 0; r < nRows; r++) { %>
                  <% 
                    const rChar = String.fromCharCode(65 + r); 
                    const isLastRow = (r === nRows - 1);
                    const isVIPRow = (!isLastRow && r >= vipStartRow);
                  %>

                  <div class="flex items-center justify-center gap-1 sm:gap-1.5">
                    <span class="w-4 sm:w-5 text-[10px] sm:text-xs font-bold <%= isVIPRow ? 'text-[#D97706]' : 'text-white/50' %>"><%= rChar %></span>

                    <% if (isLastRow) { %>
                      <% for(let c = 1; c <= nCols; c += 2) { %>
                        <% 
                          const sNum = Math.ceil(c / 2);
                          const pairLabel = 'SWEET ' + String(sNum).padStart(2, '0');
                          const pairCode = (c + 1 <= nCols) ? `${rChar}${c}-${rChar}${c+1}` : `${rChar}${c}`; 
                        %>
                        <div class="seat-unit seat-free is-couple" data-seat="<%= pairCode %>" data-price="<%= pCouple %>" data-type="couple"><%= pairLabel %></div>
                      <% } %>
                    <% } else { %>
                      <% for(let c = 1; c <= nCols; c++) { %>
                        <% 
                          const sCode = rChar + c;
                          let sType = sMatrix[sCode];
                          if (!sType) {
                            sType = isVIPRow ? 'vip' : 'standard';
                          }
                          const sPrice = (sType === 'vip') ? pVIP : ((sType === 'couple') ? pCouple : pStd);
                          const sClass = (sType === 'vip') ? 'is-vip' : ((sType === 'couple') ? 'is-couple' : '');
                        %>
                        <% if (sType === 'empty') { %>
                          <div class="w-[25px] sm:w-[32px] h-[25px] sm:h-[30px] invisible"></div>
                        <% } else { %>
                          <div class="seat-unit seat-free <%= sClass %>" data-seat="<%= sCode %>" data-price="<%= sPrice %>" data-type="<%= sType %>"><%= c %></div>
                        <% } %>
                      <% } %>
                    <% } %>

                    <span class="w-4 sm:w-5 text-[10px] sm:text-xs font-bold <%= isVIPRow ? 'text-[#D97706]' : 'text-white/50' %>"><%= rChar %></span>
                  </div>

                <% } %>
              </div>
            </div>

          </div>

          <!-- KHỐI 3: BẮP & NƯỚC (VUÔNG VỨC, CÓ CHỌN VỊ VÀ ĐẦY ĐỦ TOÀN BỘ COMBO) -->
          <div class="bg-white border border-[#E5E0D5] p-4 sm:p-5 shadow-xs">
            <div class="flex items-center justify-between pb-3 border-b border-[#E5E0D5]">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 bg-[#BA2D27] text-white text-[11px] font-bold flex items-center justify-center">3</span>
                <h2 class="font-bold text-sm text-[#111827]">Bắp & Nước (Combo Ưu Đãi)</h2>
              </div>
              <span id="comboBadgeSummary" class="text-xs font-bold text-[#BA2D27]">Chưa chọn món</span>
            </div>

            <!-- Lưới combo vuông vức mở rộng -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 pt-3.5">
              <% 
                const sampleCombos = [
                  {
                    id: 'combo_solo',
                    name: 'Combo Solo',
                    desc: '1 Bắp Rang + 1 Coca',
                    price: 85000,
                    flavors: ['Vị Phô Mai', 'Vị Ngọt (Caramel)', 'Vị Mặn'],
                    img: 'https://images.unsplash.com/photo-1585647347483-22b66260dfff?auto=format&fit=crop&w=400&q=80'
                  },
                  {
                    id: 'combo_couple',
                    name: 'Combo Couple',
                    desc: '1 Bắp Phô Mai + 2 Nước',
                    price: 139000,
                    flavors: ['Vị Phô Mai', 'Vị Caramel', 'Vị Bơ Tỏi'],
                    img: 'https://images.unsplash.com/photo-1572177191856-3cde618dee1f?auto=format&fit=crop&w=400&q=80'
                  },
                  {
                    id: 'combo_family',
                    name: 'Family VIP -20%',
                    desc: '2 Bắp + 3 Nước + Snack',
                    price: 199000,
                    flavors: ['Vị Phô Mai + Caramel', '2 Vị Phô Mai', '2 Vị Ngọt'],
                    img: 'https://images.unsplash.com/photo-1505686994434-e3cc5abf1330?auto=format&fit=crop&w=400&q=80'
                  }
                ];
                const displayCombos = (typeof combos !== 'undefined' && Array.isArray(combos) && combos.length > 0)
                  ? combos.map((c, i) => {
                      const flvs = (c.flavors && c.flavors.length > 0) 
                        ? c.flavors 
                        : ['Vị Phô Mai', 'Vị Ngọt Caramel', 'Vị Mặn Truyền Thống'];
                      return {
                        id: 'combo_' + (c._id || i),
                        name: c.name,
                        desc: c.description || (c.items ? c.items.map(it => it.name).join(' + ') : 'Bắp nước rạp phim'),
                        price: c.price,
                        flavors: flvs,
                        img: c.imageUrl || sampleCombos[i % sampleCombos.length].img
                      };
                    })
                  : sampleCombos;
              %>

              <% displayCombos.forEach(function(item) { %>
                <div class="bg-[#FAF8F5] border border-[#E5E0D5] p-3 flex flex-col justify-between combo-card hover:border-[#BA2D27]/40 transition-all select-none shadow-2xs"
                     data-id="<%= item.id %>"
                     data-name="<%= item.name %>"
                     data-price="<%= item.price %>">
                  <div>
                    <div class="flex items-center gap-3">
                      <img src="<%= item.img %>" 
                           alt="<%= item.name %>" 
                           class="w-14 h-14 object-cover border border-[#E5E0D5] shrink-0" />
                      <div class="overflow-hidden">
                        <h4 class="font-bold text-xs sm:text-sm text-[#111827] truncate"><%= item.name %></h4>
                        <p class="text-[10.5px] text-[#6B7280] line-clamp-1 mt-0.5"><%= item.desc %></p>
                        <span class="text-xs sm:text-sm font-black text-[#BA2D27] block mt-1"><%= Number(item.price).toLocaleString('vi-VN') %>đ</span>
                      </div>
                    </div>

                    <!-- TÙY CHỌN VỊ BẮP NƯỚC (DỄ DÀNG CHỌN VỊ THEO Ý MUỐN) -->
                    <div class="mt-2.5 pt-2 border-t border-[#E5E0D5]/70 flex items-center justify-between text-xs">
                      <span class="text-[11px] font-semibold text-[#6B7280]">Chọn vị:</span>
                      <select id="flavor_<%= item.id %>" onchange="changeComboFlavor('<%= item.id %>')" class="bg-white border border-[#E5E0D5] text-[11.5px] font-semibold text-[#111827] py-1 px-2 focus:outline-none focus:border-[#BA2D27] cursor-pointer">
                        <% item.flavors.forEach(function(flv) { %>
                          <option value="<%= flv %>"><%= flv %></option>
                        <% }); %>
                      </select>
                    </div>
                  </div>

                  <!-- Nút + Thêm hoặc Stepper [- 1 +] -->
                  <div class="mt-3 pt-2 border-t border-[#E5E0D5]/50 flex items-center justify-between">
                    <span class="text-[10px] text-[#9CA3AF]">Số lượng:</span>
                    <button type="button" onclick="stepCombo(this, 1)" class="btn-add-combo px-3.5 py-1.5 bg-white hover:bg-[#BA2D27] hover:text-white border border-[#E5E0D5] text-[#111827] font-bold text-xs transition-colors cursor-pointer shadow-xs">
                      + Thêm
                    </button>
                    <div class="stepper-combo hidden items-center gap-1.5">
                      <button type="button" onclick="stepCombo(this, -1)" class="w-6 h-6 bg-white hover:bg-[#F3EFE6] border border-[#E5E0D5] text-[#111827] font-bold text-xs flex items-center justify-center transition-colors select-none">-</button>
                      <span id="qty_<%= item.id %>" class="text-xs font-bold w-4 text-center text-[#111827]">0</span>
                      <button type="button" onclick="stepCombo(this, 1)" class="w-6 h-6 bg-[#BA2D27] hover:bg-[#8E1F1A] text-white font-bold text-xs flex items-center justify-center transition-colors shadow-xs select-none">+</button>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>

        </div>

        <!-- =====================================================================
             CỘT PHẢI (Khoảng 32% - span 4): HÓA ĐƠN VUÔNG VỨC & TIẾP TỤC THANH TOÁN
             Đã bỏ Voucher và Phương thức thanh toán (sẽ có ở trang thanh toán tiếp theo)
             ===================================================================== -->
        <div class="lg:col-span-4 sticky top-20">
          <div class="bg-white border border-[#E5E0D5] p-5 text-[#111827] shadow-xs space-y-4">
            
            <!-- Movie Header with Poster (Vuông vức) -->
            <div class="flex gap-3 pb-3 border-b border-[#E5E0D5]">
              <img src="<%= phim.posterUrl %>" alt="<%= phim.title %>" class="w-16 h-22 object-cover border border-[#E5E0D5] shrink-0 shadow-xs" />
              <div class="overflow-hidden flex flex-col justify-center">
                <div class="flex items-center gap-1.5 mb-1">
                  <span class="px-1.5 py-0.2 bg-[#BA2D27] text-white text-[9.5px] font-bold"><%= phim.ageRating || 'P' %></span>
                  <span class="px-1.5 py-0.2 bg-[#E5E7EB] text-[#374151] text-[9.5px] font-semibold"><%= (phim && phim.format && !phim.format.toLowerCase().includes('imax')) ? phim.format : '2D' %></span>
                </div>
                <h3 class="font-extrabold text-sm sm:text-base text-[#111827] line-clamp-2 leading-snug"><%= phim.title %></h3>
                <span class="text-xs text-[#6B7280] mt-1 block">⏱ <%= phim.duration || 120 %> phút</span>
              </div>
            </div>

            <!-- Booking Info Ledger -->
            <div class="space-y-1.5 text-xs border-b border-[#E5E0D5] pb-3 font-medium">
              <div class="flex justify-between text-[#6B7280]">
                <span>Rạp:</span>
                <span class="font-bold text-[#111827] text-right" id="sideCinema">CGV Kim Cúc Plaza</span>
              </div>
              <div class="flex justify-between text-[#6B7280]">
                <span>Suất:</span>
                <span class="font-bold text-[#BA2D27] text-right" id="sideShowtime"><%= initDefaultTime %> | <%= initDateIso %></span>
              </div>
              <div class="flex justify-between text-[#6B7280] items-start">
                <span class="shrink-0">Ghế:</span>
                <div class="text-right font-bold text-[#BA2D27] flex flex-wrap justify-end gap-1 max-w-[200px]" id="sideSeatsContainer">
                  <span class="text-[#9CA3AF] italic font-normal">Chưa chọn ghế</span>
                </div>
              </div>
            </div>

            <!-- Price Breakdown Ledger -->
            <div class="space-y-2 text-xs border-b border-[#E5E0D5] pb-3">
              <div class="flex justify-between text-[#6B7280]">
                <span>Vé xem phim <span id="sideSeatCount" class="text-[#9CA3AF] font-normal">(0x)</span>:</span>
                <span class="font-bold text-[#111827]" id="sideSeatTotal">0 đ</span>
              </div>
              <div class="flex justify-between text-[#6B7280]">
                <span id="sideComboLabel">Combo Bắp Nước:</span>
                <span class="font-bold text-[#111827]" id="sideComboTotal">0 đ</span>
              </div>
              <div class="flex justify-between text-[#6B7280]">
                <span>Phí dịch vụ:</span>
                <span class="font-bold text-[#059669]">0 đ (Miễn phí)</span>
              </div>
            </div>

            <!-- Đường kẻ vé đứt đoạn với 2 vết khuyết tròn -->
            <div class="relative py-2">
              <div class="border-t border-dashed border-[#E5E0D5]"></div>
              <div class="absolute -left-5 top-1/2 -translate-y-1/2 w-4 h-4 bg-[#F5F3ED]"></div>
              <div class="absolute -right-5 top-1/2 -translate-y-1/2 w-4 h-4 bg-[#F5F3ED]"></div>
            </div>

            <!-- Total Price Row (Đỏ chuẩn CineGo) -->
            <div>
              <div class="flex items-baseline justify-between">
                <div>
                  <span class="block text-xs font-bold uppercase text-[#6B7280] tracking-wider">TỔNG THANH TOÁN:</span>
                  <span class="text-[10px] text-[#9CA3AF]">Đã bao gồm VAT</span>
                </div>
                <div class="text-2xl font-black text-[#BA2D27] tracking-tight" id="sideGrandTotal">
                  0 đ
                </div>
              </div>
            </div>

            <!-- Big Submit CTA Button: XÁC NHẬN & TIẾP TỤC THANH TOÁN -->
            <button type="submit" id="btnContinueCheckout" disabled class="w-full mt-2 py-3.5 px-4 bg-[#BA2D27] hover:bg-[#8E1F1A] text-white font-bold text-xs uppercase tracking-wider shadow-md disabled:opacity-40 disabled:cursor-not-allowed transition-all flex items-center justify-center gap-2 cursor-pointer select-none">
              <span>VUI LÒNG CHỌN GHẾ NGỒI</span>
            </button>

            <p class="text-[10px] text-center text-[#7A7E8B] leading-relaxed">
              Bước tiếp theo: Áp dụng mã voucher ưu đãi & Chọn phương thức thanh toán.
            </p>

          </div>
        </div>

      </div>

    </form>

  </div>
</main>

<%- include('partials/footer') %>

<script>
  // Dữ liệu suất chiếu từ server
  const rawShowtimes = <%- JSON.stringify((typeof phim !== 'undefined' && phim && phim.showtimes) ? phim.showtimes : []) %>;
  const currentMovieId = '<%= (typeof phim !== 'undefined' && phim && phim._id) ? phim._id : "" %>';
  const initialCinema = 'CGV Kim Cúc Plaza';
  let initialDate = '<%= initDateIso %>';
  let selectedCinema = initialCinema;
  let selectedDate = initialDate;
  let selectedTime = '<%= initDefaultTime %>';

  let selectedSeats = [];
  let seatTotal = 0;
  let comboItems = {};
  let comboTotal = 0;

  const normCin = (s) => (s || '').toString().toLowerCase().replace(/[^a-z0-9]/g, '');

  function toggleCinemaDropdown(e) {
    if (e) e.stopPropagation();
    const dd = document.getElementById('cinemaDropdownList');
    if (dd) dd.classList.toggle('hidden');
  }

  document.addEventListener('click', () => {
    const dd = document.getElementById('cinemaDropdownList');
    if (dd) dd.classList.add('hidden');
  });

  function selectCinema(name, e) {
    if (e) e.stopPropagation();
    selectedCinema = name;
    document.getElementById('labelSelectedCinema').innerText = name;
    document.getElementById('sideCinema').innerText = name;
    document.getElementById('input_cinema').value = name;
    
    document.querySelectorAll('.cinema-option-btn').forEach(btn => {
      if (btn.innerText.includes(name)) {
        btn.classList.add('text-[#BA2D27]', 'font-bold');
        btn.classList.remove('text-[#374151]', 'font-semibold');
      } else {
        btn.classList.remove('text-[#BA2D27]', 'font-bold');
        btn.classList.add('text-[#374151]', 'font-semibold');
      }
    });

    const dd = document.getElementById('cinemaDropdownList');
    if (dd) dd.classList.add('hidden');

    selectedSeats = [];
    seatTotal = 0;
    updateBottomSummary();
    renderTimeOptions();
  }

  function selectDate(dateIso, label, btnEl) {
    selectedDate = dateIso;
    document.getElementById('input_showDate').value = dateIso;

    document.querySelectorAll('.date-pill-btn').forEach(b => {
      b.className = 'date-pill-btn px-2.5 py-1 text-center transition-all cursor-pointer shrink-0 select-none bg-white text-[#374151] border border-[#E5E0D5] hover:border-[#BA2D27]';
      const dName = b.querySelector('div:first-child');
      if (dName) dName.className = 'text-[9px] uppercase text-[#6B7280] leading-none';
    });

    if (btnEl) {
      btnEl.className = 'date-pill-btn px-2.5 py-1 text-center transition-all cursor-pointer shrink-0 select-none bg-[#BA2D27] text-white font-bold shadow-xs';
      const dName = btnEl.querySelector('div:first-child');
      if (dName) dName.className = 'text-[9px] uppercase text-white/90 leading-none';
    }

    selectedSeats = [];
    seatTotal = 0;
    updateBottomSummary();
    renderTimeOptions();
  }

  function isShowtimePastClient(timeStr, dateIso) {
    if (!timeStr) return true;
    const now = new Date();
    const todayIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    if (dateIso < todayIso) return true;
    if (dateIso > todayIso) return false;
    const [h, m] = timeStr.split(':').map(Number);
    if (isNaN(h) || isNaN(m)) return false;
    return (h < now.getHours() || (h === now.getHours() && m <= now.getMinutes()));
  }

  function renderTimeOptions() {
    const listEl = document.getElementById('timeOptionsList');
    const noticeEl = document.getElementById('noShowtimeNotice');
    if (!listEl) return;

    listEl.innerHTML = '';
    const targetCin = normCin(selectedCinema);
    let times = [];

    const found = rawShowtimes.find(st => {
      const cin = normCin(st.cinema);
      const isCin = cin === targetCin || cin.includes(targetCin) || targetCin.includes(cin);
      let sDate = st.date;
      if (sDate && sDate.includes('T')) sDate = sDate.split('T')[0];
      return isCin && (sDate === selectedDate);
    });

    if (found && found.times) {
      const arr = Array.isArray(found.times) ? found.times : [found.times];
      times = arr.map(t => (t || '').trim()).filter(Boolean);
    }

    if (times.length === 0) {
      listEl.innerHTML = '<span class="text-[#9CA3AF] text-xs italic py-1">Chưa có suất</span>';
      selectedTime = '';
      document.getElementById('input_showTime').value = '';
      document.getElementById('sideShowtime').innerText = `--:-- | ${selectedDate}`;
      if (noticeEl) noticeEl.classList.remove('hidden');
      refreshSeatsView();
      return;
    }

    if (noticeEl) noticeEl.classList.add('hidden');
    let hasSelected = false;

    times.forEach(tStr => {
      const isPast = isShowtimePastClient(tStr, selectedDate);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.time = tStr;

      if (isPast) {
        btn.disabled = true;
        btn.className = 'px-2.5 py-1 text-xs font-semibold bg-[#F3EFE6] border border-[#E5E0D5] text-[#9CA3AF] cursor-not-allowed select-none';
        btn.innerText = tStr;
        btn.title = 'Suất chiếu này đã qua giờ chiếu';
      } else {
        const isCurrent = (!hasSelected && (selectedTime === tStr || !selectedTime));
        if (isCurrent) {
          hasSelected = true;
          selectedTime = tStr;
        }
        btn.className = isCurrent
          ? 'time-pill-btn px-2.5 py-1 text-xs font-bold bg-[#BA2D27] text-white border border-[#BA2D27] shadow-xs cursor-pointer select-none transition-all'
          : 'time-pill-btn px-2.5 py-1 text-xs font-semibold bg-white text-[#374151] border border-[#E5E0D5] hover:border-[#BA2D27] cursor-pointer select-none transition-all';
        btn.innerText = tStr;
        btn.onclick = () => selectTime(tStr, btn);
      }
      listEl.appendChild(btn);
    });

    if (!hasSelected) {
      const firstValid = times.find(t => !isShowtimePastClient(t, selectedDate));
      if (firstValid) {
        selectedTime = firstValid;
        const targetBtn = listEl.querySelector(`button[data-time="${firstValid}"]`);
        if (targetBtn) {
          targetBtn.className = 'time-pill-btn px-2.5 py-1 text-xs font-bold bg-[#BA2D27] text-white border border-[#BA2D27] shadow-xs cursor-pointer select-none transition-all';
        }
      } else {
        selectedTime = '';
      }
    }

    document.getElementById('input_showTime').value = selectedTime;
    document.getElementById('sideShowtime').innerText = selectedTime ? `${selectedTime} | ${selectedDate}` : `--:-- | ${selectedDate}`;
    refreshSeatsView();
  }

  function selectTime(tStr, btnEl) {
    selectedTime = tStr;
    document.getElementById('input_showTime').value = tStr;
    document.getElementById('sideShowtime').innerText = `${selectedTime} | ${selectedDate}`;

    document.querySelectorAll('.time-pill-btn').forEach(b => {
      b.className = 'time-pill-btn px-2.5 py-1 text-xs font-semibold bg-white text-[#374151] border border-[#E5E0D5] hover:border-[#BA2D27] cursor-pointer select-none transition-all';
    });
    if (btnEl) {
      btnEl.className = 'time-pill-btn px-2.5 py-1 text-xs font-bold bg-[#BA2D27] text-white border border-[#BA2D27] shadow-xs cursor-pointer select-none transition-all';
    }

    selectedSeats = [];
    seatTotal = 0;
    updateBottomSummary();
    refreshSeatsView();
  }

  // Tương tác ghế (Cho phép chọn nhiều ghế trên nhiều hàng)
  function setupSeatInteractions() {
    document.querySelectorAll('.seat-unit').forEach(el => {
      el.addEventListener('click', () => {
        if (!selectedTime) {
          if (window.cinegoToast) window.cinegoToast.warning('Vui lòng chọn suất chiếu trước khi chọn ghế!');
          return;
        }
        if (el.classList.contains('seat-sold') || el.classList.contains('seat-held') || el.classList.contains('invisible')) {
          return;
        }

        const seatCode = el.getAttribute('data-seat');
        const price = Number(el.getAttribute('data-price')) || 0;
        const type = el.getAttribute('data-type') || 'standard';

        const isSelected = el.classList.contains('seat-selected');

        if (isSelected) {
          el.classList.remove('seat-selected');
          el.classList.add('seat-free');
          selectedSeats = selectedSeats.filter(s => s.code !== seatCode);
          seatTotal -= price;
        } else {
          if (selectedSeats.length >= 8) {
            if (window.cinegoToast) window.cinegoToast.warning('Bạn chỉ được chọn tối đa 8 ghế cho 1 lần đặt!');
            return;
          }

          el.classList.remove('seat-free');
          el.classList.add('seat-selected');
          selectedSeats.push({ code: seatCode, price, type });
          seatTotal += price;
        }

        if (seatTotal < 0) seatTotal = 0;
        updateBottomSummary();
      });
    });
  }

  function removeSelectedSeat(code) {
    const el = document.querySelector(`.seat-unit[data-seat="${code}"]`);
    if (el) {
      el.classList.remove('seat-selected');
      el.classList.add('seat-free');
    }
    const idx = selectedSeats.findIndex(s => s.code === code);
    if (idx !== -1) {
      seatTotal -= selectedSeats[idx].price;
      selectedSeats.splice(idx, 1);
    }
    if (seatTotal < 0) seatTotal = 0;
    updateBottomSummary();
  }

  // Đổi vị combo trực tiếp
  function changeComboFlavor(itemId) {
    const flavorSelect = document.getElementById('flavor_' + itemId);
    const selectedFlavor = flavorSelect ? flavorSelect.value : '';
    if (comboItems[itemId]) {
      comboItems[itemId].flavor = selectedFlavor;
      updateBottomSummary();
    }
  }

  // Tương tác bắp nước
  function stepCombo(btn, delta) {
    const card = btn.closest('.combo-card');
    if (!card) return;
    const id = card.getAttribute('data-id');
    const baseName = card.getAttribute('data-name');
    const price = Number(card.getAttribute('data-price')) || 0;
    const flavorSelect = document.getElementById('flavor_' + id);
    const flavor = flavorSelect ? flavorSelect.value : '';

    if (!comboItems[id]) {
      comboItems[id] = { id, name: baseName, price, qty: 0, flavor: flavor };
    }
    comboItems[id].flavor = flavor;
    comboItems[id].qty += delta;
    if (comboItems[id].qty < 0) comboItems[id].qty = 0;

    const currentQty = comboItems[id].qty;
    const qtyEl = document.getElementById('qty_' + id);
    if (qtyEl) qtyEl.innerText = currentQty;

    const btnAdd = card.querySelector('.btn-add-combo');
    const stepper = card.querySelector('.stepper-combo');
    if (currentQty > 0) {
      if (btnAdd) btnAdd.classList.add('hidden');
      if (stepper) stepper.classList.remove('hidden');
      if (stepper) stepper.classList.add('flex');
    } else {
      if (btnAdd) btnAdd.classList.remove('hidden');
      if (stepper) stepper.classList.add('hidden');
      if (stepper) stepper.classList.remove('flex');
    }

    updateBottomSummary();
  }

  // Cập nhật hóa đơn tạm tính
  function updateBottomSummary() {
    const sideSeats = document.getElementById('sideSeatsContainer');
    const sideCount = document.getElementById('sideSeatCount');
    const sideSeatTot = document.getElementById('sideSeatTotal');
    const sideComboTot = document.getElementById('sideComboTotal');
    const sideComboLabel = document.getElementById('sideComboLabel');
    const sideGrand = document.getElementById('sideGrandTotal');
    const btnSubmit = document.getElementById('btnContinueCheckout');
    const headSeatsBadge = document.getElementById('headerSelectedSeats');
    const comboBadge = document.getElementById('comboBadgeSummary');

    let totalComboCount = 0;
    let comboDescList = [];
    comboTotal = 0;

    for (const key in comboItems) {
      if (comboItems[key].qty > 0) {
        totalComboCount += comboItems[key].qty;
        comboTotal += comboItems[key].price * comboItems[key].qty;
        const flvText = comboItems[key].flavor ? ` (${comboItems[key].flavor})` : '';
        comboDescList.push(`${comboItems[key].name}${flvText} x${comboItems[key].qty}`);
      }
    }

    document.getElementById('input_comboDetails').value = comboDescList.join(', ');
    document.getElementById('input_comboTotal').value = comboTotal;

    if (comboBadge) {
      if (totalComboCount === 1) {
        comboBadge.innerText = `Đã chọn: ${comboDescList[0]}`;
      } else if (totalComboCount > 1) {
        comboBadge.innerText = `Đã chọn: ${totalComboCount} món (${comboTotal.toLocaleString('vi-VN')}đ)`;
      } else {
        comboBadge.innerText = 'Chưa chọn món';
      }
    }

    if (sideComboTot) {
      sideComboTot.innerText = comboTotal > 0 ? (comboTotal.toLocaleString('vi-VN') + ' đ') : '0 đ';
    }
    if (sideComboLabel) {
      if (totalComboCount > 0) {
        sideComboLabel.innerText = `Bắp nước (${totalComboCount}x):`;
      } else {
        sideComboLabel.innerText = 'Combo Bắp Nước:';
      }
    }

    const subTotal = seatTotal + comboTotal;
    document.getElementById('input_total').value = subTotal;

    if (selectedSeats.length === 0) {
      if (sideSeats) sideSeats.innerHTML = '<span class="text-[#9CA3AF] italic font-normal">Chưa chọn ghế</span>';
      if (sideCount) sideCount.innerText = '(0x)';
      if (sideSeatTot) sideSeatTot.innerText = '0 đ';
      if (sideGrand) sideGrand.innerText = comboTotal > 0 ? (subTotal.toLocaleString('vi-VN') + ' đ') : '0 đ';
      if (headSeatsBadge) headSeatsBadge.innerText = '';
      if (btnSubmit) {
        btnSubmit.disabled = true;
        btnSubmit.innerHTML = '<span>VUI LÒNG CHỌN GHẾ NGỒI</span>';
      }
      document.getElementById('input_seats').value = '';
    } else {
      const seatCodes = selectedSeats.map(s => s.code);
      if (sideSeats) {
        sideSeats.innerHTML = selectedSeats.map(s => 
          `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 bg-[#BA2D27] text-white text-[11px] font-bold shadow-xs">
            ${s.code}
            <span class="cursor-pointer text-white/80 hover:text-white font-normal ml-0.5" onclick="removeSelectedSeat('${s.code}')" title="Bỏ chọn">✕</span>
          </span>`
        ).join('');
      }
      if (sideCount) sideCount.innerText = `(${selectedSeats.length}x)`;
      if (sideSeatTot) sideSeatTot.innerText = seatTotal.toLocaleString('vi-VN') + ' đ';
      if (sideGrand) sideGrand.innerText = subTotal.toLocaleString('vi-VN') + ' đ';
      if (headSeatsBadge) headSeatsBadge.innerText = `(${seatCodes.join(', ')} đang chọn)`;
      if (btnSubmit) {
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = `<span>XÁC NHẬN & TIẾP TỤC THANH TOÁN (${subTotal.toLocaleString('vi-VN')}đ) →</span>`;
      }
      document.getElementById('input_seats').value = seatCodes.join(',');
    }
  }

  // Trạng thái ghế từ API
  async function refreshSeatsView() {
    if (!selectedTime) return;
    try {
      const url = `/api/ghe-da-dat?movieId=${encodeURIComponent(currentMovieId)}&cinema=${encodeURIComponent(selectedCinema)}&showDate=${encodeURIComponent(selectedDate)}&showTime=${encodeURIComponent(selectedTime)}`;
      const res = await fetch(url);
      const data = await res.json();
      
      const soldList = data.bookedSeats || [];
      const heldList = data.heldSeats || [];

      document.querySelectorAll('.seat-unit').forEach(el => {
        const code = el.getAttribute('data-seat');
        if (!code) return;

        if (soldList.includes(code)) {
          el.className = 'seat-unit seat-sold';
          el.innerText = '✕';
          el.title = 'Ghế này đã được mua';
        } else if (heldList.includes(code)) {
          el.className = 'seat-unit seat-held';
          el.innerText = '⌛';
          el.title = 'Ghế đang được giữ chỗ';
        } else {
          const type = el.getAttribute('data-type') || 'standard';
          const isSelected = selectedSeats.some(s => s.code === code);
          if (isSelected) {
            el.className = 'seat-unit seat-selected';
            el.innerText = code.includes('-') ? code : code.replace(/^[A-Za-z]+/, '');
          } else {
            const extra = (type === 'vip') ? 'is-vip' : ((type === 'couple') ? 'is-couple' : '');
            el.className = `seat-unit seat-free ${extra}`;
            el.innerText = code.includes('-') ? code : code.replace(/^[A-Za-z]+/, '');
          }
        }
      });
    } catch(err) {
      console.warn('Lỗi lấy trạng thái ghế:', err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupSeatInteractions();
    renderTimeOptions();
    updateBottomSummary();

    // Ràng buộc bảo vệ: Bắt buộc đăng nhập khi bấm xác nhận thanh toán vé & bắp nước
    const isUserLoggedIn = <%= (typeof user !== 'undefined' && user && user._id) ? 'true' : 'false' %>;
    const bookingFormEl = document.getElementById('bookingForm');
    if (bookingFormEl) {
      bookingFormEl.addEventListener('submit', (e) => {
        if (!isUserLoggedIn) {
          e.preventDefault();
          if (window.cinegoToast) {
            window.cinegoToast.warning('Vui lòng đăng nhập tài khoản CineGo để hoàn tất đặt vé & bắp nước!');
          }
          setTimeout(() => {
            window.location.href = '/dang-nhap?returnTo=' + encodeURIComponent(window.location.pathname + window.location.search);
          }, 700);
        }
      });
    }
  });
</script>

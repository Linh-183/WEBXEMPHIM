<%- include('partials/header') %>

<% if (typeof error !== 'undefined' && error) { %>
  <div data-toast-error="<%= error %>"></div>
<% } %>

<% 
  // Chuẩn hóa thời gian Việt Nam (Asia/Ho_Chi_Minh - UTC+7)
  const nowVN = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Ho_Chi_Minh' }));
  const todayBooking = nowVN;
  const yearNow = todayBooking.getFullYear();
  const monthNow = String(todayBooking.getMonth() + 1).padStart(2, '0');
  const dayNow = String(todayBooking.getDate()).padStart(2, '0');
  const initDateIso = `${yearNow}-${monthNow}-${dayNow}`;
  const currentHNow = todayBooking.getHours();
  const currentMNow = todayBooking.getMinutes();
  const daysOfWeekVi = ['CN', 'T.HAI', 'T.BA', 'T.TƯ', 'T.NĂM', 'T.SÁU', 'T.BẢY'];

  const normCinEjs = (s) => (s || '').toString().toLowerCase().replace(/[^a-z0-9]/g, '');
  const targetCinEjs = normCinEjs('CGV Kim Cúc Plaza');
  let initShowtimesList = [];
  if (typeof phim !== 'undefined' && phim && Array.isArray(phim.showtimes)) {
    const foundSt = phim.showtimes.find(s => {
      const cin = normCinEjs(s.cinema);
      const isCin = cin === targetCinEjs || cin.includes(targetCinEjs) || targetCinEjs.includes(cin);
      let sDate = s.date;
      if (sDate && sDate.includes('T')) sDate = sDate.split('T')[0];
      const isDate = (sDate === initDateIso);
      return isCin && isDate && s.times && s.times.length > 0;
    });
    if (foundSt) {
      const arr = Array.isArray(foundSt.times) ? foundSt.times : [foundSt.times];
      initShowtimesList = arr.map(t => (t || '').trim()).filter(Boolean);
    }
  }

  const isShowtimePastServer = (tStr, dIso) => {
    if (dIso < initDateIso) return true;
    if (dIso > initDateIso) return false;
    const [h, m] = (tStr || '').split(':').map(Number);
    if (isNaN(h) || isNaN(m)) return false;
    return (h < currentHNow || (h === currentHNow && m <= currentMNow));
  };
  const validFutureTimes = initShowtimesList.filter(t => !isShowtimePastServer(t, initDateIso));
  let initDefaultTime = validFutureTimes.length > 0 ? validFutureTimes[0] : '';

  const nRows = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.rows) ? seatConfig.rows : 6;
  const nCols = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.cols) ? seatConfig.cols : 10;
  const pStd = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.priceStandard) ? seatConfig.priceStandard : 75000;
  const pVIP = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.priceVIP) ? seatConfig.priceVIP : 95000;
  const pCouple = (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.priceCouple) ? seatConfig.priceCouple : 170000;
  let sMatrix = {};
  if (typeof seatConfig !== 'undefined' && seatConfig && seatConfig.seatMatrix) {
    sMatrix = (typeof seatConfig.seatMatrix === 'string') ? JSON.parse(seatConfig.seatMatrix) : seatConfig.seatMatrix;
  }
  const vipStartRow = Math.max(1, Math.floor(nRows * 0.45));
%>

<style>
  /* Định dạng ghế ngồi trong phòng chiếu tối ưu tương phản cao */
  .seat-unit {
    width: 33px;
    height: 31px;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 700;
    transition: all 0.15s ease;
    user-select: none;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .seat-unit.seat-free {
    background-color: #1F2432 !important;
    color: #CBD5E1 !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
  }
  .seat-unit.seat-free:hover {
    border-color: #BA2D27 !important;
    color: #FFFFFF !important;
    transform: scale(1.15);
    z-index: 10;
    box-shadow: 0 4px 12px rgba(186, 45, 39, 0.4);
  }
  .seat-unit.seat-free.is-vip {
    background-color: #27221A !important;
    border: 1px solid rgba(217, 119, 6, 0.6) !important;
    color: #FBBF24 !important;
  }
  .seat-unit.seat-free.is-vip:hover {
    border-color: #F59E0B !important;
    color: #FFFFFF !important;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
  }
  .seat-unit.seat-free.is-couple {
    width: 74px !important;
    background-color: #2B1724 !important;
    border: 1px solid rgba(236, 72, 153, 0.6) !important;
    color: #F472B6 !important;
  }
  .seat-unit.seat-free.is-couple:hover {
    border-color: #EC4899 !important;
    color: #FFFFFF !important;
    box-shadow: 0 4px 12px rgba(236, 72, 153, 0.4);
  }
  .seat-unit.seat-selected {
    background-color: #BA2D27 !important;
    color: #FFFFFF !important;
    border: 1.5px solid #FFFFFF !important;
    transform: scale(1.1);
    box-shadow: 0 0 16px rgba(186, 45, 39, 0.8) !important;
    z-index: 5;
  }
  .seat-unit.seat-sold {
    background-color: #141722 !important;
    color: rgba(255, 255, 255, 0.25) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    cursor: not-allowed !important;
    text-decoration: none;
  }
  .seat-unit.seat-held {
    background-color: #1A1D27 !important;
    color: rgba(255, 255, 255, 0.5) !important;
    border: 1px dashed #D97706 !important;
    cursor: not-allowed !important;
  }
  @media (max-width: 640px) {
    .seat-unit {
      width: 25px !important;
      height: 25px !important;
      font-size: 8px !important;
      border-radius: 3px !important;
    }
    .seat-unit.seat-free.is-couple {
      width: 54px !important;
      font-size: 7.5px !important;
    }
  }
</style>

<!-- MAIN CONTAINER: NỀN GIẤY ẤM ÁP CHUẨN CINEGO (#FAF8F5) -->
<main class="min-h-screen py-5 sm:py-7 pb-24 bg-[#FAF8F5] text-[#111827] font-['Be_Vietnam_Pro',sans-serif]">
  <div class="max-w-[1480px] mx-auto px-4 sm:px-6 lg:px-8">

    <!-- =========================================================================
         TOP BAR: TIÊU ĐỀ & TIẾN TRÌNH STEPPER (THEO ĐÚNG BỐ CỤC ẢNH MẪU CỦA BẠN)
         ========================================================================= -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3.5 pb-4 border-b border-[#E5E0D5] mb-5">
      
      <!-- Left: Back button + Subtitle + Main Title -->
      <div class="flex items-center gap-3">
        <a href="/phim/<%= phim._id %>" class="w-9 h-9 rounded-lg border border-[#E5E0D5] bg-white hover:bg-[#F3EFE6] text-[#111827] transition-colors flex items-center justify-center shrink-0 shadow-xs" title="Quay lại chi tiết phim">
          <span class="material-symbols-outlined text-[19px]">arrow_back</span>
        </a>
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-[#BA2D27] block">ĐẶT VÉ TRỰC TUYẾN • BẢO MẬT 100%</span>
          <h1 class="text-lg sm:text-2xl font-extrabold text-[#111827] leading-tight">Hoàn tất đặt vé & Thanh toán</h1>
        </div>
      </div>

      <!-- Right: Stepper & Countdown Timer (Theo đúng ảnh mẫu) -->
      <div class="flex items-center gap-1.5 sm:gap-2 text-xs flex-wrap">
        <span class="px-2.5 py-1 bg-[#10B981]/10 text-[#059669] border border-[#10B981]/30 rounded-md font-semibold text-[11px] flex items-center gap-1">✓ Suất chiếu</span>
        <span class="text-[#D1D5DB]">/</span>
        <span class="px-2.5 py-1 bg-[#BA2D27] text-white rounded-md font-bold text-[11px] flex items-center gap-1.5 shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>2. Chọn ghế
        </span>
        <span class="text-[#D1D5DB]">/</span>
        <span class="text-[#6B7280] text-[11px] font-medium">3. Bắp nước</span>
        <span class="text-[#D1D5DB]">/</span>
        <span class="text-[#6B7280] text-[11px] font-medium">4. Thanh toán</span>
        <span class="px-2.5 py-1 bg-[#BA2D27]/10 text-[#BA2D27] border border-[#BA2D27]/30 rounded-md font-mono text-[11px] font-bold flex items-center gap-1.5 ml-1">
          <span class="w-1.5 h-1.5 rounded-full bg-[#BA2D27] animate-ping"></span>
          <span id="bookingTimerText">05:00</span>
        </span>
      </div>

    </div>

    <!-- =========================================================================
         BỐ CỤC 2 CỘT (SPLIT-SCREEN THEO ĐÚNG HÌNH MẪU PHÁC HỌA)
         Cột trái (68% - 4 khối thao tác) | Cột phải (32% - Hóa đơn trực tiếp)
         ========================================================================= -->
    <form id="bookingForm" action="/thanh-toan" method="POST">
      
      <!-- Hidden inputs matching Express Route requirements -->
      <input type="hidden" name="movieId" value="<%= phim._id %>" />
      <input type="hidden" name="cinema" id="input_cinema" value="CGV Kim Cúc Plaza" />
      <input type="hidden" name="showDate" id="input_showDate" value="<%= initDateIso %>" />
      <input type="hidden" name="showTime" id="input_showTime" value="<%= initDefaultTime %>" />
      <input type="hidden" name="seats" id="input_seats" value="" />
      <input type="hidden" name="total" id="input_total" value="0" />
      <input type="hidden" name="comboDetails" id="input_comboDetails" value="" />
      <input type="hidden" name="comboTotal" id="input_comboTotal" value="0" />
      <input type="hidden" name="preVoucher" id="input_preVoucher" value="" />
      <input type="hidden" name="payment_method" id="input_payment_method" value="momo" />
      <input type="hidden" name="voucherCode" id="input_voucherCode" value="" />
      <input type="hidden" name="discountAmount" id="input_discountAmount" value="0" />
      <input type="hidden" name="finalAmount" id="input_finalAmount" value="0" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

        <!-- =====================================================================
             CỘT TRÁI (Khoảng 68% - span 8): 4 KHỐI THAO TÁC THEO ĐÚNG ẢNH
             1. Thông tin suất chiếu (Rạp, Ngày, Giờ)
             2. Sơ đồ chọn ghế (Màn hình cong, ma trận ghế)
             3. Bắp nước combo ưu đãi (3 combo ngang)
             4. Phương thức thanh toán & Voucher
             ===================================================================== -->
        <div class="lg:col-span-8 space-y-4">

          <!-- KHỐI 1: THÔNG TIN SUẤT CHIẾU (1 DÒNG 3 Ô GỌN GÀNG ĐÚNG ẢNH MẪU) -->
          <div class="bg-white border border-[#E5E0D5] rounded-xl p-4 shadow-xs">
            <div class="flex items-center justify-between pb-3 border-b border-[#E5E0D5]">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-[#BA2D27] text-white text-[11px] font-bold flex items-center justify-center">1</span>
                <h2 class="font-bold text-sm text-[#111827]">Thông Tin Suất Chiếu</h2>
              </div>
              <span class="text-xs text-[#059669] bg-[#10B981]/10 px-2.5 py-0.5 rounded-full font-medium flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
                Phòng IMAX Laser chuẩn quốc tế
              </span>
            </div>

            <!-- 3 Ô CHỌN: RẠP - NGÀY - GIỜ -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5 pt-3">
              
              <!-- Ô 1: Rạp & Phòng Chiếu (Có dropdown Đổi rạp) -->
              <div class="bg-[#FAF8F5] border border-[#E5E0D5] rounded-lg p-2.5 relative">
                <div class="flex items-center justify-between text-[10.5px] font-bold text-[#6B7280] uppercase mb-1">
                  <span class="flex items-center gap-1">📍 RẠP & PHÒNG CHIẾU</span>
                  <button type="button" onclick="toggleCinemaDropdown(event)" class="text-[#BA2D27] hover:underline cursor-pointer text-[10.5px] font-bold flex items-center">
                    <span>Đổi rạp</span>
                    <span class="material-symbols-outlined text-[13px]">expand_more</span>
                  </button>
                </div>
                <div class="font-bold text-xs sm:text-[13px] text-[#111827] truncate" id="labelSelectedCinema">CGV Kim Cúc Plaza</div>
                <div class="text-[11px] text-[#6B7280] truncate mt-0.5">Phòng 01 • Màn hình IMAX Laser</div>

                <!-- Dropdown chọn rạp -->
                <div id="cinemaDropdownList" class="hidden absolute top-full left-0 right-0 mt-1.5 bg-white border border-[#E5E0D5] shadow-2xl rounded-lg z-30 py-1 overflow-hidden">
                  <button type="button" onclick="selectCinema('CGV Kim Cúc Plaza')" class="cinema-option-btn w-full px-3 py-2 text-xs text-left hover:bg-[#FAF8F5] flex items-center justify-between text-[#BA2D27] font-bold border-b border-[#F3EFE6]">
                    <span>CGV Kim Cúc Plaza</span>
                    <span class="text-[10px] text-[#6B7280]">Ghềnh Ráng</span>
                  </button>
                  <button type="button" onclick="selectCinema('Starlight Nguyễn Kim')" class="cinema-option-btn w-full px-3 py-2 text-xs text-left hover:bg-[#FAF8F5] flex items-center justify-between text-[#374151] border-b border-[#F3EFE6]">
                    <span>Starlight Nguyễn Kim</span>
                    <span class="text-[10px] text-[#6B7280]">Trần Phú</span>
                  </button>
                  <button type="button" onclick="selectCinema('DCine Quy Nhơn')" class="cinema-option-btn w-full px-3 py-2 text-xs text-left hover:bg-[#FAF8F5] flex items-center justify-between text-[#374151]">
                    <span>DCine Quy Nhơn</span>
                    <span class="text-[10px] text-[#6B7280]">Đống Đa</span>
                  </button>
                </div>
              </div>

              <!-- Ô 2: Chọn Ngày Chiếu (Pills ngang theo ngày) -->
              <div class="bg-[#FAF8F5] border border-[#E5E0D5] rounded-lg p-2.5">
                <div class="flex items-center justify-between text-[10.5px] font-bold text-[#6B7280] uppercase mb-1">
                  <span>📅 CHỌN NGÀY CHIẾU</span>
                  <span class="text-[10px] text-[#6B7280]">Tháng <%= monthNow %></span>
                </div>
                <div class="flex items-center gap-1.5 overflow-x-auto py-0.5 pb-1 no-scrollbar" id="datePillsContainer">
                  <% 
                    for (let i = 0; i < 7; i++) { 
                      const d = new Date(todayBooking);
                      d.setDate(todayBooking.getDate() + i);
                      const isToday = (i === 0);
                      const isTomorrow = (i === 1);
                      const dayName = isToday ? 'H.NAY' : (isTomorrow ? 'N.MAI' : daysOfWeekVi[d.getDay()]);
                      const dateStr = d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' });
                      const fullIso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
                  %>
                    <button type="button" 
                            onclick="selectDate('<%= fullIso %>', '<%= dayName %> <%= dateStr %>', this)" 
                            class="date-pill-btn px-2.5 py-1 rounded-md text-center transition-all cursor-pointer shrink-0 select-none <%= isToday ? 'bg-[#BA2D27] text-white font-bold shadow-xs' : 'bg-white text-[#374151] border border-[#E5E0D5] hover:border-[#BA2D27]/40' %>" 
                            data-iso="<%= fullIso %>">
                      <div class="text-[9px] uppercase <%= isToday ? 'text-white/90' : 'text-[#6B7280]' %> leading-none"><%= dayName %></div>
                      <div class="text-[11px] font-bold mt-0.5 leading-none"><%= dateStr %></div>
                    </button>
                  <% } %>
                </div>
              </div>

              <!-- Ô 3: Giờ Chiếu -->
              <div class="bg-[#FAF8F5] border border-[#E5E0D5] rounded-lg p-2.5">
                <div class="flex items-center justify-between text-[10.5px] font-bold text-[#6B7280] uppercase mb-1">
                  <span>🕒 GIỜ CHIẾU</span>
                  <span class="px-1.5 py-0.2 bg-[#111827] text-white text-[9.5px] rounded-xs font-semibold">IMAX 2D</span>
                </div>
                <div class="flex items-center gap-1.5 flex-wrap overflow-y-auto max-h-[56px]" id="timeOptionsList">
                  <!-- Được render tự động bằng JS -->
                </div>
              </div>

            </div>
          </div>

          <!-- KHỐI 2: SƠ ĐỒ CHỌN GHẾ (PHÒNG CHIẾU RẠP TỐI ƯU ÁNH SÁNG & TƯƠNG PHẢN ĐÚNG ẢNH MẪU) -->
          <div class="bg-[#0E1015] border border-[#1E232E] rounded-xl p-4 sm:p-5 text-white relative overflow-hidden shadow-md">
            
            <!-- Header của sơ đồ ghế: Tên khối + Ghế đang chọn + Chú thích giá góc phải -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-white/10 gap-2">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-[#BA2D27] text-white text-[11px] font-bold flex items-center justify-center">2</span>
                <h2 class="font-bold text-sm text-white">Sơ Đồ Chọn Ghế</h2>
                <span id="headerSelectedSeats" class="text-xs text-[#BA2D27] font-semibold ml-1"></span>
              </div>
              
              <!-- Chú thích loại ghế (Legend trên góc phải đúng như ảnh) -->
              <div class="flex items-center gap-2.5 sm:gap-3.5 text-[11px] text-white/70 flex-wrap">
                <div class="flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 rounded-xs bg-[#1F2432] border border-white/20"></span>
                  <span>Trống (<%= Math.round(pStd/1000) %>k)</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 rounded-xs bg-[#27221A] border-b-2 border-b-[#D97706]"></span>
                  <span class="text-[#FBBF24] font-bold">VIP (<%= Math.round(pVIP/1000) %>k)</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 rounded-xs bg-[#BA2D27] text-white flex items-center justify-center text-[9px] font-bold">✓</span>
                  <span class="text-white font-bold">Chọn</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-3.5 h-3.5 rounded-xs bg-[#141722] border border-white/10 text-white/30 flex items-center justify-center text-[9px]">✕</span>
                  <span class="text-white/40">Đã mua</span>
                </div>
              </div>
            </div>

            <!-- Vệt sáng màn hình cong IMAX Laser (Ánh sáng đỏ tỏa nhẹ đúng như ảnh) -->
            <div class="relative py-4 text-center">
              <div class="w-4/5 max-w-lg mx-auto h-2 bg-gradient-to-r from-transparent via-[#BA2D27] to-transparent rounded-full shadow-[0_0_20px_rgba(186,45,39,0.9)] opacity-95"></div>
              <div class="text-[10px] font-bold uppercase tracking-[0.25em] text-white/50 mt-2">MÀN HÌNH CHIẾU IMAX LASER</div>
            </div>

            <!-- Thông báo chưa có suất chiếu -->
            <div id="noShowtimeNotice" class="hidden max-w-md mx-auto my-4 p-3 bg-amber-500/10 border border-amber-500/30 text-center text-xs text-amber-300 rounded-lg">
              ⚠️ Cụm rạp và ngày này hiện chưa có suất chiếu khả dụng. Vui lòng chọn ngày khác hoặc cụm rạp khác ở Khối 1.
            </div>

            <!-- Ma trận ghế ngồi -->
            <div class="w-full overflow-x-auto py-2 text-center" id="auditoriumSeatMatrix">
              <div class="w-max min-w-full sm:min-w-[540px] max-w-2xl mx-auto space-y-1.5 sm:space-y-2.5 transition-opacity px-1">
                <% for(let r = 0; r < nRows; r++) { %>
                  <% 
                    const rChar = String.fromCharCode(65 + r); 
                    const isLastRow = (r === nRows - 1);
                    const isVIPRow = (!isLastRow && r >= vipStartRow);
                  %>

                  <div class="flex items-center justify-center gap-1 sm:gap-1.5">
                    <span class="w-4 sm:w-5 font-mono text-[10px] sm:text-xs font-bold <%= isVIPRow ? 'text-[#FBBF24]' : 'text-white/40' %>"><%= rChar %></span>

                    <% if (isLastRow) { %>
                      <% for(let c = 1; c <= nCols; c += 2) { %>
                        <% const pairCode = (c + 1 <= nCols) ? `${rChar}${c}-${rChar}${c+1}` : `${rChar}${c}`; %>
                        <div class="seat-unit seat-free is-couple" data-seat="<%= pairCode %>" data-price="<%= pCouple %>" data-type="couple"><%= pairCode %></div>
                      <% } %>
                    <% } else { %>
                      <% for(let c = 1; c <= nCols; c++) { %>
                        <% 
                          const sCode = rChar + c;
                          let sType = sMatrix[sCode];
                          if (!sType) {
                            sType = isVIPRow ? 'vip' : 'standard';
                          }
                          const sPrice = (sType === 'vip') ? pVIP : ((sType === 'couple') ? pCouple : pStd);
                          const sClass = (sType === 'vip') ? 'is-vip' : ((sType === 'couple') ? 'is-couple' : '');
                        %>
                        <% if (sType === 'empty') { %>
                          <div class="w-[25px] sm:w-[33px] h-[25px] sm:h-[31px] invisible"></div>
                        <% } else { %>
                          <div class="seat-unit seat-free <%= sClass %>" data-seat="<%= sCode %>" data-price="<%= sPrice %>" data-type="<%= sType %>"><%= c %></div>
                        <% } %>
                      <% } %>
                    <% } %>

                    <span class="w-4 sm:w-5 font-mono text-[10px] sm:text-xs font-bold <%= isVIPRow ? 'text-[#FBBF24]' : 'text-white/40' %>"><%= rChar %></span>
                  </div>

                <% } %>
              </div>
            </div>

          </div>

          <!-- KHỐI 3: BẮP & NƯỚC (COMBO ƯU ĐÃI NẰM NGANG ĐÚNG NHƯ ẢNH MẪU) -->
          <div class="bg-white border border-[#E5E0D5] rounded-xl p-4 shadow-xs">
            <div class="flex items-center justify-between pb-3 border-b border-[#E5E0D5]">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-[#BA2D27] text-white text-[11px] font-bold flex items-center justify-center">3</span>
                <h2 class="font-bold text-sm text-[#111827]">Bắp & Nước (Combo Ưu Đãi)</h2>
              </div>
              <span id="comboBadgeSummary" class="text-xs text-[#6B7280]">Chưa chọn món</span>
            </div>

            <!-- 3 Thẻ combo bắp nước nằm ngang đúng như mẫu ảnh -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3">
              <% 
                // Danh sách 3 combo mẫu chuẩn thương hiệu CineGo như phác họa
                const sampleCombos = [
                  {
                    id: 'combo_solo',
                    name: 'Combo Solo',
                    desc: '1 Bắp Rang + 1 Coca',
                    price: 85000,
                    img: 'https://images.unsplash.com/photo-1585647347483-22b66260dfff?auto=format&fit=crop&w=400&q=80'
                  },
                  {
                    id: 'combo_couple',
                    name: 'Combo Couple',
                    desc: '1 Bắp Phô Mai + 2 Nước',
                    price: 139000,
                    img: 'https://images.unsplash.com/photo-1572177191856-3cde618dee1f?auto=format&fit=crop&w=400&q=80'
                  },
                  {
                    id: 'combo_family',
                    name: 'Family VIP -20%',
                    desc: '2 Bắp + 3 Nước + Snack',
                    price: 199000,
                    img: 'https://images.unsplash.com/photo-1505686994434-e3cc5abf1330?auto=format&fit=crop&w=400&q=80'
                  }
                ];
                const displayCombos = (typeof combos !== 'undefined' && Array.isArray(combos) && combos.length >= 3)
                  ? combos.slice(0, 3).map((c, i) => ({
                      id: 'combo_' + (c._id || i),
                      name: c.name,
                      desc: c.description || (c.items ? c.items.map(it => it.name).join(' + ') : 'Bắp nước rạp phim'),
                      price: c.price,
                      img: c.imageUrl || sampleCombos[i].img
                    }))
                  : sampleCombos;
              %>

              <% displayCombos.forEach(function(item) { %>
                <div class="bg-[#FAF8F5] border border-[#E5E0D5] rounded-lg p-2.5 flex items-center justify-between gap-2.5 combo-card hover:border-[#BA2D27]/40 transition-all select-none shadow-2xs"
                     data-id="<%= item.id %>"
                     data-name="<%= item.name %>"
                     data-price="<%= item.price %>">
                  <div class="flex items-center gap-2.5 overflow-hidden">
                    <img src="<%= item.img %>" 
                         alt="<%= item.name %>" 
                         class="w-11 h-11 rounded-md object-cover border border-[#E5E0D5] shrink-0" />
                    <div class="overflow-hidden">
                      <h4 class="font-bold text-xs text-[#111827] truncate"><%= item.name %></h4>
                      <p class="text-[10px] text-[#6B7280] truncate"><%= item.desc %></p>
                      <span class="text-xs font-bold text-[#BA2D27] block mt-0.5"><%= Number(item.price).toLocaleString('vi-VN') %>đ</span>
                    </div>
                  </div>
                  
                  <!-- Nút thêm hoặc Stepper theo đúng ảnh -->
                  <div class="flex items-center gap-1 shrink-0">
                    <button type="button" onclick="stepCombo(this, 1)" class="btn-add-combo px-2.5 py-1 bg-white hover:bg-[#BA2D27] hover:text-white border border-[#E5E0D5] text-[#111827] font-bold text-[11px] rounded transition-colors cursor-pointer shadow-2xs">
                      + Thêm
                    </button>
                    <div class="stepper-combo hidden items-center gap-1">
                      <button type="button" onclick="stepCombo(this, -1)" class="w-6 h-6 rounded bg-white hover:bg-[#F3EFE6] border border-[#E5E0D5] text-[#111827] font-bold text-xs flex items-center justify-center transition-colors">-</button>
                      <span id="qty_<%= item.id %>" class="text-xs font-bold w-4 text-center text-[#111827]">0</span>
                      <button type="button" onclick="stepCombo(this, 1)" class="w-6 h-6 rounded bg-[#BA2D27] hover:bg-[#8E1F1A] text-white font-bold text-xs flex items-center justify-center transition-colors shadow-xs">+</button>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>

          <!-- KHỐI 4: PHƯƠNG THỨC THANH TOÁN & VOUCHER (THEO ĐÚNG 100% ẢNH MẪU CỦA BẠN) -->
          <div class="bg-white border border-[#E5E0D5] rounded-xl p-4 shadow-xs">
            <div class="flex items-center justify-between pb-3 border-b border-[#E5E0D5]">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-[#BA2D27] text-white text-[11px] font-bold flex items-center justify-center">4</span>
                <h2 class="font-bold text-sm text-[#111827]">Phương Thức Thanh Toán</h2>
              </div>
              <span class="text-xs text-[#059669] flex items-center gap-1 font-medium">
                <span class="material-symbols-outlined text-[14px]">lock</span>
                Bảo mật SSL 256-bit
              </span>
            </div>

            <!-- 4 Phương thức thanh toán nằm ngang -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-3">
              
              <!-- MoMo (Mặc định chọn) -->
              <div class="payment-method-card cursor-pointer border rounded-lg p-2.5 flex items-center gap-2.5 transition-all select-none border-[#BA2D27] bg-[#F9EBEA]" 
                   data-method="momo" 
                   onclick="selectPaymentMethod('momo', this)">
                <span class="radio-indicator w-3.5 h-3.5 rounded-full border-2 border-[#BA2D27] flex items-center justify-center shrink-0">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#BA2D27]"></span>
                </span>
                <span class="w-6 h-6 rounded bg-[#A50064] text-white text-[10px] font-bold flex items-center justify-center shrink-0">Mo</span>
                <span class="text-xs font-bold text-[#111827] truncate">MoMo</span>
              </div>

              <!-- ZaloPay -->
              <div class="payment-method-card cursor-pointer border rounded-lg p-2.5 flex items-center gap-2.5 transition-all select-none border-[#E5E0D5] bg-[#FAF8F5] hover:border-[#BA2D27]/30" 
                   data-method="zalopay" 
                   onclick="selectPaymentMethod('zalopay', this)">
                <span class="radio-indicator w-3.5 h-3.5 rounded-full border-2 border-[#CBD5E1] flex items-center justify-center shrink-0">
                  <span class="w-1.5 h-1.5 rounded-full bg-transparent"></span>
                </span>
                <span class="w-6 h-6 rounded bg-[#0068FF] text-white text-[10px] font-bold flex items-center justify-center shrink-0">Za</span>
                <span class="text-xs font-bold text-[#111827] truncate">ZaloPay</span>
              </div>

              <!-- VNPAY-QR -->
              <div class="payment-method-card cursor-pointer border rounded-lg p-2.5 flex items-center gap-2.5 transition-all select-none border-[#E5E0D5] bg-[#FAF8F5] hover:border-[#BA2D27]/30" 
                   data-method="vnpay" 
                   onclick="selectPaymentMethod('vnpay', this)">
                <span class="radio-indicator w-3.5 h-3.5 rounded-full border-2 border-[#CBD5E1] flex items-center justify-center shrink-0">
                  <span class="w-1.5 h-1.5 rounded-full bg-transparent"></span>
                </span>
                <span class="w-6 h-6 rounded bg-gradient-to-br from-[#ED1C24] to-[#005BAA] text-white text-[10px] font-bold flex items-center justify-center shrink-0">VN</span>
                <span class="text-xs font-bold text-[#111827] truncate">VNPAY-QR</span>
              </div>

              <!-- Visa/Master -->
              <div class="payment-method-card cursor-pointer border rounded-lg p-2.5 flex items-center gap-2.5 transition-all select-none border-[#E5E0D5] bg-[#FAF8F5] hover:border-[#BA2D27]/30" 
                   data-method="card" 
                   onclick="selectPaymentMethod('card', this)">
                <span class="radio-indicator w-3.5 h-3.5 rounded-full border-2 border-[#CBD5E1] flex items-center justify-center shrink-0">
                  <span class="w-1.5 h-1.5 rounded-full bg-transparent"></span>
                </span>
                <span class="w-6 h-6 rounded bg-[#E5E0D5] text-[#374151] text-[12px] flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[14px]">credit_card</span>
                </span>
                <span class="text-xs font-bold text-[#111827] truncate">Visa/Master</span>
              </div>

            </div>

            <!-- Dòng nhập mã Voucher theo đúng ảnh -->
            <div class="mt-3 pt-3 border-t border-[#E5E0D5] flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
              <div class="flex items-center gap-2 flex-1 max-w-md">
                <div class="relative flex-1">
                  <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-[#9CA3AF] material-symbols-outlined text-[15px]">confirmation_number</span>
                  <input type="text" id="voucherCodeInput" placeholder="Nhập mã voucher (VD: CINEGO50K)..." class="w-full pl-8 pr-3 py-1.5 bg-[#FAF8F5] border border-[#E5E0D5] rounded-md text-xs text-[#111827] placeholder-[#9CA3AF] uppercase font-mono tracking-wider focus:outline-none focus:border-[#BA2D27]" />
                </div>
                <button type="button" id="btnApplyVoucher" onclick="applyVoucherCode()" class="px-3.5 py-1.5 bg-[#111827] hover:bg-[#BA2D27] text-white font-bold text-xs rounded-md transition-colors shrink-0 cursor-pointer shadow-xs">
                  Áp dụng
                </button>
              </div>
              <div id="voucherFeedback" class="text-xs font-semibold flex items-center gap-1 min-h-[20px]">
                <!-- Hiển thị '✔ Giảm 50.000đ' màu xanh lá khi áp dụng thành công -->
              </div>
            </div>

          </div>

        </div>

        <!-- =====================================================================
             CỘT PHẢI (Khoảng 32% - span 4): HÓA ĐƠN & THANH TOÁN (STICKY SIDEBAR)
             Đúng 100% hình mẫu phác họa của bạn với tông màu CineGo
             ===================================================================== -->
        <div class="lg:col-span-4 sticky top-24">
          <div class="bg-white border border-[#E5E0D5] rounded-xl p-4 sm:p-5 text-[#111827] shadow-sm space-y-4">
            
            <!-- Movie Header with Poster -->
            <div class="flex gap-3 pb-3 border-b border-[#E5E0D5]">
              <img src="<%= phim.posterUrl %>" alt="<%= phim.title %>" class="w-16 h-22 object-cover rounded-lg border border-[#E5E0D5] shrink-0 shadow-xs" />
              <div class="overflow-hidden flex flex-col justify-center">
                <div class="flex items-center gap-1.5 mb-1">
                  <span class="px-1.5 py-0.2 bg-[#BA2D27] text-white text-[9.5px] font-bold rounded-xs"><%= phim.ageRating || 'P' %></span>
                  <span class="px-1.5 py-0.2 bg-[#111827] text-white text-[9.5px] font-semibold rounded-xs"><%= (phim && phim.format === 'IMAX Laser') ? 'IMAX 2D' : '2D Standard' %></span>
                </div>
                <h3 class="font-bold text-sm sm:text-base text-[#111827] line-clamp-2 leading-snug"><%= phim.title %></h3>
                <span class="text-xs text-[#6B7280] mt-1 block">⏱️ <%= phim.duration || 120 %> phút</span>
              </div>
            </div>

            <!-- Booking Info Ledger -->
            <div class="space-y-1.5 text-xs border-b border-[#E5E0D5] pb-3 font-medium">
              <div class="flex justify-between text-[#6B7280]">
                <span>Rạp:</span>
                <span class="font-bold text-[#111827] text-right" id="sideCinema">CGV Kim Cúc Plaza</span>
              </div>
              <div class="flex justify-between text-[#6B7280]">
                <span>Suất:</span>
                <span class="font-bold text-[#111827] text-right" id="sideShowtime"><%= initDefaultTime %> | <%= initDateIso %></span>
              </div>
              <div class="flex justify-between text-[#6B7280] items-start">
                <span class="shrink-0">Ghế:</span>
                <div class="text-right font-bold text-[#BA2D27] flex flex-wrap justify-end gap-1 max-w-[200px]" id="sideSeatsContainer">
                  <span class="text-[#9CA3AF] italic font-normal">Chưa chọn ghế</span>
                </div>
              </div>
            </div>

            <!-- Price Breakdown Ledger -->
            <div class="space-y-2 text-xs border-b border-[#E5E0D5] pb-3">
              <div class="flex justify-between text-[#6B7280]">
                <span>Vé xem phim <span id="sideSeatCount" class="text-[#9CA3AF] font-normal">(0x)</span>:</span>
                <span class="font-bold text-[#111827]" id="sideSeatTotal">0 đ</span>
              </div>
              <div class="flex justify-between text-[#6B7280]">
                <span>Combo Solo / Bắp nước:</span>
                <span class="font-bold text-[#111827]" id="sideComboTotal">0 đ</span>
              </div>
              <div id="sideVoucherRow" class="hidden flex justify-between text-[#6B7280]">
                <span id="sideVoucherLabel">Voucher:</span>
                <span class="font-bold text-[#059669]" id="sideVoucherDiscount">-0 đ</span>
              </div>
              <div class="flex justify-between text-[#6B7280]">
                <span>Phí dịch vụ:</span>
                <span class="font-bold text-[#059669]">0 đ (Miễn phí)</span>
              </div>
            </div>

            <!-- Total Price Row (Đỏ to đậm theo chuẩn ảnh) -->
            <div class="pt-1">
              <div class="flex items-baseline justify-between">
                <div>
                  <span class="block text-[10.5px] font-bold uppercase text-[#6B7280] tracking-wider">TỔNG THANH TOÁN:</span>
                  <span class="text-[9.5px] text-[#9CA3AF]">Đã bao gồm VAT</span>
                </div>
                <div class="text-2xl font-black text-[#BA2D27] tracking-tight" id="sideGrandTotal">
                  0 đ
                </div>
              </div>
            </div>

            <!-- Big Submit CTA Button: XÁC NHẬN & THANH TOÁN theo đúng ảnh -->
            <button type="submit" id="btnContinueCheckout" disabled class="w-full py-3.5 px-4 bg-[#BA2D27] hover:bg-[#8E1F1A] text-white font-bold text-xs uppercase tracking-wider rounded-lg shadow-md disabled:opacity-40 disabled:cursor-not-allowed transition-all flex items-center justify-center gap-2 cursor-pointer select-none">
              <span>VUI LÒNG CHỌN GHẾ NGỒI</span>
            </button>

            <!-- Trust Badges (Đúng như ảnh) -->
            <div class="space-y-1.5 pt-2 text-[10.5px] text-[#6B7280] border-t border-[#E5E0D5]">
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[14px] text-[#059669]">verified_user</span>
                  <span>Bảo mật 100%</span>
                </span>
                <span class="text-[#9CA3AF]">Hotline: 1900 6000</span>
              </div>
              <div class="flex items-center gap-1.5 text-[#9CA3AF]">
                <span class="material-symbols-outlined text-[14px] text-[#BA2D27]">qr_code_2</span>
                <span>Vé điện tử (QR Code) được gửi qua SMS & Email sau thanh toán.</span>
              </div>
            </div>

          </div>
        </div>

      </div>

    </form>

  </div>
</main>

<%- include('partials/footer') %>

<script>
  // Dữ liệu suất chiếu từ server
  const rawShowtimes = <%- JSON.stringify((typeof phim !== 'undefined' && phim && phim.showtimes) ? phim.showtimes : []) %>;
  const currentMovieId = '<%= (typeof phim !== 'undefined' && phim && phim._id) ? phim._id : "" %>';
  const initialCinema = 'CGV Kim Cúc Plaza';
  let initialDate = '<%= initDateIso %>';
  let selectedCinema = initialCinema;
  let selectedDate = initialDate;
  let selectedTime = '<%= initDefaultTime %>';

  let selectedSeats = [];
  let seatTotal = 0;
  let comboItems = {};
  let comboTotal = 0;
  let appliedVoucher = null;
  let selectedPaymentMethod = 'momo';

  const normCin = (s) => (s || '').toString().toLowerCase().replace(/[^a-z0-9]/g, '');

  function toggleCinemaDropdown(e) {
    e.stopPropagation();
    const dd = document.getElementById('cinemaDropdownList');
    if (dd) dd.classList.toggle('hidden');
  }

  document.addEventListener('click', () => {
    const dd = document.getElementById('cinemaDropdownList');
    if (dd) dd.classList.add('hidden');
  });

  function selectCinema(name) {
    selectedCinema = name;
    document.getElementById('labelSelectedCinema').innerText = name;
    document.getElementById('sideCinema').innerText = name;
    document.getElementById('input_cinema').value = name;
    
    document.querySelectorAll('.cinema-option-btn').forEach(btn => {
      if (btn.innerText.includes(name)) {
        btn.classList.add('text-[#BA2D27]', 'font-bold');
        btn.classList.remove('text-[#374151]');
      } else {
        btn.classList.remove('text-[#BA2D27]', 'font-bold');
        btn.classList.add('text-[#374151]');
      }
    });

    const dd = document.getElementById('cinemaDropdownList');
    if (dd) dd.classList.add('hidden');

    selectedSeats = [];
    seatTotal = 0;
    updateBottomSummary();
    renderTimeOptions();
  }

  function selectDate(dateIso, label, btnEl) {
    selectedDate = dateIso;
    document.getElementById('input_showDate').value = dateIso;

    document.querySelectorAll('.date-pill-btn').forEach(b => {
      b.className = 'date-pill-btn px-2.5 py-1 rounded-md text-center transition-all cursor-pointer shrink-0 select-none bg-white text-[#374151] border border-[#E5E0D5] hover:border-[#BA2D27]/40';
      const dName = b.querySelector('div:first-child');
      if (dName) dName.className = 'text-[9px] uppercase text-[#6B7280] leading-none';
    });

    if (btnEl) {
      btnEl.className = 'date-pill-btn px-2.5 py-1 rounded-md text-center transition-all cursor-pointer shrink-0 select-none bg-[#BA2D27] text-white font-bold shadow-xs';
      const dName = btnEl.querySelector('div:first-child');
      if (dName) dName.className = 'text-[9px] uppercase text-white/90 leading-none';
    }

    selectedSeats = [];
    seatTotal = 0;
    updateBottomSummary();
    renderTimeOptions();
  }

  function isShowtimePastClient(timeStr, dateIso) {
    if (!timeStr) return true;
    const now = new Date();
    const todayIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    if (dateIso < todayIso) return true;
    if (dateIso > todayIso) return false;
    const [h, m] = timeStr.split(':').map(Number);
    if (isNaN(h) || isNaN(m)) return false;
    return (h < now.getHours() || (h === now.getHours() && m <= now.getMinutes()));
  }

  function renderTimeOptions() {
    const listEl = document.getElementById('timeOptionsList');
    const noticeEl = document.getElementById('noShowtimeNotice');
    if (!listEl) return;

    listEl.innerHTML = '';
    const targetCin = normCin(selectedCinema);
    let times = [];

    const found = rawShowtimes.find(st => {
      const cin = normCin(st.cinema);
      const isCin = cin === targetCin || cin.includes(targetCin) || targetCin.includes(cin);
      let sDate = st.date;
      if (sDate && sDate.includes('T')) sDate = sDate.split('T')[0];
      return isCin && (sDate === selectedDate);
    });

    if (found && found.times) {
      const arr = Array.isArray(found.times) ? found.times : [found.times];
      times = arr.map(t => (t || '').trim()).filter(Boolean);
    }

    if (times.length === 0) {
      listEl.innerHTML = '<span class="text-[#9CA3AF] text-xs italic py-1">Chưa có suất</span>';
      selectedTime = '';
      document.getElementById('input_showTime').value = '';
      document.getElementById('sideShowtime').innerText = `--:-- | ${selectedDate}`;
      if (noticeEl) noticeEl.classList.remove('hidden');
      refreshSeatsView();
      return;
    }

    if (noticeEl) noticeEl.classList.add('hidden');
    let hasSelected = false;

    times.forEach(tStr => {
      const isPast = isShowtimePastClient(tStr, selectedDate);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.time = tStr;

      if (isPast) {
        btn.disabled = true;
        btn.className = 'px-2.5 py-1 text-xs font-semibold rounded bg-[#F3EFE6] border border-[#E5E0D5] text-[#9CA3AF] cursor-not-allowed select-none';
        btn.innerText = tStr;
        btn.title = 'Suất chiếu này đã qua giờ chiếu';
      } else {
        const isCurrent = (!hasSelected && (selectedTime === tStr || !selectedTime));
        if (isCurrent) {
          hasSelected = true;
          selectedTime = tStr;
        }
        btn.className = isCurrent
          ? 'time-pill-btn px-2.5 py-1 text-xs font-bold rounded bg-[#BA2D27] text-white border border-[#BA2D27] shadow-xs cursor-pointer select-none transition-all'
          : 'time-pill-btn px-2.5 py-1 text-xs font-semibold rounded bg-white text-[#374151] border border-[#E5E0D5] hover:border-[#BA2D27]/40 cursor-pointer select-none transition-all';
        btn.innerText = tStr;
        btn.onclick = () => selectTime(tStr, btn);
      }
      listEl.appendChild(btn);
    });

    if (!hasSelected) {
      const firstValid = times.find(t => !isShowtimePastClient(t, selectedDate));
      if (firstValid) {
        selectedTime = firstValid;
        const targetBtn = listEl.querySelector(`button[data-time="${firstValid}"]`);
        if (targetBtn) {
          targetBtn.className = 'time-pill-btn px-2.5 py-1 text-xs font-bold rounded bg-[#BA2D27] text-white border border-[#BA2D27] shadow-xs cursor-pointer select-none transition-all';
        }
      } else {
        selectedTime = '';
      }
    }

    document.getElementById('input_showTime').value = selectedTime;
    document.getElementById('sideShowtime').innerText = selectedTime ? `${selectedTime} | ${selectedDate}` : `--:-- | ${selectedDate}`;
    refreshSeatsView();
  }

  function selectTime(tStr, btnEl) {
    selectedTime = tStr;
    document.getElementById('input_showTime').value = tStr;
    document.getElementById('sideShowtime').innerText = `${selectedTime} | ${selectedDate}`;

    document.querySelectorAll('.time-pill-btn').forEach(b => {
      b.className = 'time-pill-btn px-2.5 py-1 text-xs font-semibold rounded bg-white text-[#374151] border border-[#E5E0D5] hover:border-[#BA2D27]/40 cursor-pointer select-none transition-all';
    });
    if (btnEl) {
      btnEl.className = 'time-pill-btn px-2.5 py-1 text-xs font-bold rounded bg-[#BA2D27] text-white border border-[#BA2D27] shadow-xs cursor-pointer select-none transition-all';
    }

    selectedSeats = [];
    seatTotal = 0;
    updateBottomSummary();
    refreshSeatsView();
  }

  // Phương thức thanh toán (MoMo, ZaloPay, VNPAY, Visa/Master)
  function selectPaymentMethod(method, el) {
    selectedPaymentMethod = method;
    const inpMethod = document.getElementById('input_payment_method');
    if (inpMethod) inpMethod.value = method;

    document.querySelectorAll('.payment-method-card').forEach(card => {
      card.classList.remove('border-[#BA2D27]', 'bg-[#F9EBEA]');
      card.classList.add('border-[#E5E0D5]', 'bg-[#FAF8F5]');
      const radioDot = card.querySelector('.radio-indicator span');
      if (radioDot) {
        radioDot.classList.remove('bg-[#BA2D27]');
        radioDot.classList.add('bg-transparent');
      }
      const radioBox = card.querySelector('.radio-indicator');
      if (radioBox) {
        radioBox.classList.remove('border-[#BA2D27]');
        radioBox.classList.add('border-[#CBD5E1]');
      }
    });

    if (el) {
      el.classList.remove('border-[#E5E0D5]', 'bg-[#FAF8F5]');
      el.classList.add('border-[#BA2D27]', 'bg-[#F9EBEA]');
      const radioDot = el.querySelector('.radio-indicator span');
      if (radioDot) {
        radioDot.classList.remove('bg-transparent');
        radioDot.classList.add('bg-[#BA2D27]');
      }
      const radioBox = el.querySelector('.radio-indicator');
      if (radioBox) {
        radioBox.classList.remove('border-[#CBD5E1]');
        radioBox.classList.add('border-[#BA2D27]');
      }
    }
  }

  // Kiểm tra & áp dụng Voucher qua API
  async function applyVoucherCode() {
    const input = document.getElementById('voucherCodeInput');
    const feedback = document.getElementById('voucherFeedback');
    const code = (input ? input.value : '').trim().toUpperCase();
    if (!code) {
      if (feedback) feedback.innerHTML = '<span class="text-rose-600 font-semibold">Vui lòng nhập mã voucher!</span>';
      return;
    }

    const currentTotal = seatTotal + comboTotal;
    try {
      const res = await fetch('/api/kiem-tra-voucher', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, currentTotal, orderType: 'movie' })
      });
      const data = await res.json();
      if (data.success) {
        let discount = 0;
        if (data.discountType === 'percent') {
          discount = Math.round((currentTotal * data.discountValue) / 100);
          if (data.maxDiscountValue && discount > data.maxDiscountValue) {
            discount = data.maxDiscountValue;
          }
        } else {
          discount = Number(data.discountValue) || 0;
        }
        if (discount > currentTotal) discount = currentTotal;

        appliedVoucher = {
          code: data.code,
          discount: discount
        };

        document.getElementById('input_voucherCode').value = data.code;
        document.getElementById('input_discountAmount').value = discount;
        document.getElementById('input_preVoucher').value = data.code;

        if (feedback) {
          feedback.innerHTML = `<span class="text-[#059669] flex items-center gap-1 font-bold">✔ Giảm ${discount.toLocaleString('vi-VN')}đ</span>`;
        }
        updateBottomSummary();
      } else {
        appliedVoucher = null;
        document.getElementById('input_voucherCode').value = '';
        document.getElementById('input_discountAmount').value = 0;
        document.getElementById('input_preVoucher').value = '';
        if (feedback) {
          feedback.innerHTML = `<span class="text-rose-600 font-semibold">✕ ${data.message || 'Mã voucher không hợp lệ'}</span>`;
        }
        updateBottomSummary();
      }
    } catch (err) {
      console.error('Lỗi kiểm tra voucher:', err);
      if (feedback) feedback.innerHTML = '<span class="text-rose-600 font-semibold">✕ Không thể kiểm tra voucher lúc này</span>';
    }
  }

  // Tương tác ma trận ghế ngồi
  function setupSeatInteractions() {
    document.querySelectorAll('.seat-unit').forEach(el => {
      el.addEventListener('click', () => {
        if (!selectedTime) {
          if (window.cinegoToast) window.cinegoToast.warning('Vui lòng chọn suất chiếu trước khi chọn ghế!');
          return;
        }
        if (el.classList.contains('seat-sold') || el.classList.contains('seat-held') || el.classList.contains('invisible')) {
          return;
        }

        const seatCode = el.getAttribute('data-seat');
        const price = Number(el.getAttribute('data-price')) || 0;
        const type = el.getAttribute('data-type') || 'standard';

        const rowChar = seatCode.match(/^([A-Za-z]+)/)?.[1]?.toUpperCase();
        const isSelected = el.classList.contains('seat-selected');

        if (isSelected) {
          // Bỏ chọn ghế
          el.classList.remove('seat-selected');
          el.classList.add('seat-free');
          selectedSeats = selectedSeats.filter(s => s.code !== seatCode);
          seatTotal -= price;
        } else {
          // Chọn thêm ghế
          if (selectedSeats.length >= 8) {
            if (window.cinegoToast) window.cinegoToast.warning('Bạn chỉ được chọn tối đa 8 ghế cho 1 lần đặt vé!');
            return;
          }

          // Kiểm tra quy tắc bắt buộc cùng 1 hàng ghế
          if (selectedSeats.length > 0) {
            const firstRow = selectedSeats[0].code.match(/^([A-Za-z]+)/)?.[1]?.toUpperCase();
            if (firstRow && rowChar && firstRow !== rowChar) {
              if (window.cinegoToast) {
                window.cinegoToast.warning(`Vui lòng chỉ chọn các ghế trong cùng hàng ${firstRow}!`);
              }
              return;
            }
          }

          el.classList.remove('seat-free');
          el.classList.add('seat-selected');
          selectedSeats.push({ code: seatCode, price, type });
          seatTotal += price;
        }

        if (seatTotal < 0) seatTotal = 0;
        updateBottomSummary();
      });
    });
  }

  function removeSelectedSeat(code) {
    const el = document.querySelector(`.seat-unit[data-seat="${code}"]`);
    if (el) {
      el.classList.remove('seat-selected');
      el.classList.add('seat-free');
    }
    const idx = selectedSeats.findIndex(s => s.code === code);
    if (idx !== -1) {
      seatTotal -= selectedSeats[idx].price;
      selectedSeats.splice(idx, 1);
    }
    if (seatTotal < 0) seatTotal = 0;
    updateBottomSummary();
  }

  // Tương tác Bắp & Nước Combo
  function stepCombo(btn, delta) {
    const card = btn.closest('.combo-card');
    if (!card) return;
    const id = card.getAttribute('data-id');
    const baseName = card.getAttribute('data-name');
    const price = Number(card.getAttribute('data-price')) || 0;

    if (!comboItems[id]) {
      comboItems[id] = { id, name: baseName, price, qty: 0 };
    }
    comboItems[id].qty += delta;
    if (comboItems[id].qty < 0) comboItems[id].qty = 0;

    const currentQty = comboItems[id].qty;
    const qtyEl = document.getElementById('qty_' + id);
    if (qtyEl) qtyEl.innerText = currentQty;

    const btnAdd = card.querySelector('.btn-add-combo');
    const stepper = card.querySelector('.stepper-combo');
    if (currentQty > 0) {
      if (btnAdd) btnAdd.classList.add('hidden');
      if (stepper) stepper.classList.remove('hidden');
      if (stepper) stepper.classList.add('flex');
    } else {
      if (btnAdd) btnAdd.classList.remove('hidden');
      if (stepper) stepper.classList.add('hidden');
      if (stepper) stepper.classList.remove('flex');
    }

    comboTotal = 0;
    const comboDescList = [];
    for (const key in comboItems) {
      if (comboItems[key].qty > 0) {
        comboTotal += comboItems[key].price * comboItems[key].qty;
        comboDescList.push(`${comboItems[key].name} x${comboItems[key].qty}`);
      }
    }

    document.getElementById('input_comboDetails').value = comboDescList.join(', ');
    document.getElementById('input_comboTotal').value = comboTotal;

    updateBottomSummary();
  }

  // Cập nhật hóa đơn trực tiếp (Right Column Live Invoice)
  function updateBottomSummary() {
    const sideSeats = document.getElementById('sideSeatsContainer');
    const sideCount = document.getElementById('sideSeatCount');
    const sideSeatTot = document.getElementById('sideSeatTotal');
    const sideComboTot = document.getElementById('sideComboTotal');
    const sideVoucherRow = document.getElementById('sideVoucherRow');
    const sideVoucherLabel = document.getElementById('sideVoucherLabel');
    const sideVoucherDiscount = document.getElementById('sideVoucherDiscount');
    const sideGrand = document.getElementById('sideGrandTotal');
    const btnSubmit = document.getElementById('btnContinueCheckout');
    const headSeatsBadge = document.getElementById('headerSelectedSeats');
    const comboBadge = document.getElementById('comboBadgeSummary');

    // Combo count & description
    let totalComboCount = 0;
    let comboFirstTitle = '';
    for (const key in comboItems) {
      if (comboItems[key].qty > 0) {
        totalComboCount += comboItems[key].qty;
        if (!comboFirstTitle) comboFirstTitle = `${comboItems[key].name}`;
      }
    }

    if (comboBadge) {
      if (totalComboCount === 1) {
        comboBadge.innerText = `Đã chọn: 1 ${comboFirstTitle}`;
      } else if (totalComboCount > 1) {
        comboBadge.innerText = `Đã chọn: ${totalComboCount} món (${comboTotal.toLocaleString('vi-VN')}đ)`;
      } else {
        comboBadge.innerText = 'Chưa chọn món';
      }
    }

    if (sideComboTot) {
      sideComboTot.innerText = comboTotal > 0 ? (comboTotal.toLocaleString('vi-VN') + ' đ') : '0 đ';
    }

    // Voucher recalculation
    let discountVal = 0;
    if (appliedVoucher) {
      discountVal = appliedVoucher.discount;
      if (sideVoucherRow) sideVoucherRow.classList.remove('hidden');
      if (sideVoucherLabel) sideVoucherLabel.innerText = `Voucher ${appliedVoucher.code}:`;
      if (sideVoucherDiscount) sideVoucherDiscount.innerText = `-${discountVal.toLocaleString('vi-VN')} đ`;
    } else {
      if (sideVoucherRow) sideVoucherRow.classList.add('hidden');
      if (sideVoucherDiscount) sideVoucherDiscount.innerText = '-0 đ';
    }

    const subTotal = seatTotal + comboTotal;
    const grandTotal = Math.max(0, subTotal - discountVal);

    document.getElementById('input_total').value = subTotal;
    document.getElementById('input_finalAmount').value = grandTotal;

    if (selectedSeats.length === 0) {
      if (sideSeats) sideSeats.innerHTML = '<span class="text-[#9CA3AF] italic font-normal">Chưa chọn ghế</span>';
      if (sideCount) sideCount.innerText = '(0x)';
      if (sideSeatTot) sideSeatTot.innerText = '0 đ';
      if (sideGrand) sideGrand.innerText = comboTotal > 0 ? (grandTotal.toLocaleString('vi-VN') + ' đ') : '0 đ';
      if (headSeatsBadge) headSeatsBadge.innerText = '';
      if (btnSubmit) {
        btnSubmit.disabled = true;
        btnSubmit.innerHTML = '<span>VUI LÒNG CHỌN GHẾ NGỒI</span>';
      }
      document.getElementById('input_seats').value = '';
    } else {
      const seatCodes = selectedSeats.map(s => s.code);
      if (sideSeats) {
        sideSeats.innerHTML = selectedSeats.map(s => 
          `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 bg-[#BA2D27] text-white rounded text-[11px] font-bold shadow-xs">
            ${s.code}
            <span class="cursor-pointer text-white/80 hover:text-white font-normal ml-0.5" onclick="removeSelectedSeat('${s.code}')" title="Bỏ chọn ghế này">✕</span>
          </span>`
        ).join('');
      }
      if (sideCount) sideCount.innerText = `(${selectedSeats.length}x)`;
      if (sideSeatTot) sideSeatTot.innerText = seatTotal.toLocaleString('vi-VN') + ' đ';
      if (sideGrand) sideGrand.innerText = grandTotal.toLocaleString('vi-VN') + ' đ';
      if (headSeatsBadge) headSeatsBadge.innerText = `(${seatCodes.join(', ')} đang chọn)`;
      if (btnSubmit) {
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = `<span>XÁC NHẬN & THANH TOÁN (${grandTotal.toLocaleString('vi-VN')}đ)</span><span class="material-symbols-outlined text-[16px]">arrow_forward</span>`;
      }
      document.getElementById('input_seats').value = seatCodes.join(',');
    }
  }

  // 5-minute Countdown Timer (Đồng hồ đếm ngược góc phải)
  let remainingSec = 300;
  const timerDisplay = document.getElementById('bookingTimerText');
  const timerInterval = setInterval(() => {
    remainingSec--;
    if (remainingSec <= 0) {
      clearInterval(timerInterval);
      if (timerDisplay) timerDisplay.innerText = '00:00';
      if (window.cinegoToast) window.cinegoToast.error('Đã hết 5 phút giữ vé! Vui lòng chọn lại suất chiếu.');
      return;
    }
    const m = String(Math.floor(remainingSec / 60)).padStart(2, '0');
    const s = String(remainingSec % 60).padStart(2, '0');
    if (timerDisplay) timerDisplay.innerText = `${m}:${s}`;
  }, 1000);

  // Lấy trạng thái ghế đã đặt / đang giữ từ server qua API
  async function refreshSeatsView() {
    if (!selectedTime) return;
    try {
      const url = `/api/ghe-da-dat?movieId=${encodeURIComponent(currentMovieId)}&cinema=${encodeURIComponent(selectedCinema)}&showDate=${encodeURIComponent(selectedDate)}&showTime=${encodeURIComponent(selectedTime)}`;
      const res = await fetch(url);
      const data = await res.json();
      
      const soldList = data.bookedSeats || [];
      const heldList = data.heldSeats || [];

      document.querySelectorAll('.seat-unit').forEach(el => {
        const code = el.getAttribute('data-seat');
        if (!code) return;

        if (soldList.includes(code)) {
          el.className = 'seat-unit seat-sold';
          el.innerText = '✕';
          el.title = 'Ghế này đã được thanh toán';
        } else if (heldList.includes(code)) {
          el.className = 'seat-unit seat-held';
          el.innerText = '⌛';
          el.title = 'Ghế đang được người khác giữ chỗ trong 5 phút';
        } else {
          const type = el.getAttribute('data-type') || 'standard';
          const isSelected = selectedSeats.some(s => s.code === code);
          if (isSelected) {
            el.className = 'seat-unit seat-selected';
            el.innerText = code.includes('-') ? code : code.replace(/^[A-Za-z]+/, '');
          } else {
            const extra = (type === 'vip') ? 'is-vip' : ((type === 'couple') ? 'is-couple' : '');
            el.className = `seat-unit seat-free ${extra}`;
            el.innerText = code.includes('-') ? code : code.replace(/^[A-Za-z]+/, '');
          }
        }
      });
    } catch(err) {
      console.warn('Lỗi lấy trạng thái ghế:', err);
    }
  }

  // Khởi tạo trang
  document.addEventListener('DOMContentLoaded', () => {
    setupSeatInteractions();
    renderTimeOptions();
    updateBottomSummary();

    // Hỗ trợ Enter khi nhập mã voucher
    const vInput = document.getElementById('voucherCodeInput');
    if (vInput) {
      vInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          applyVoucherCode();
        }
      });
    }

    // Tự động áp dụng voucher từ URL nếu có
    const urlParams = new URLSearchParams(window.location.search);
    const preVoucher = urlParams.get('voucher') || urlParams.get('flashVoucher');
    if (preVoucher && vInput) {
      vInput.value = preVoucher;
      applyVoucherCode();
    }
  });
</script>

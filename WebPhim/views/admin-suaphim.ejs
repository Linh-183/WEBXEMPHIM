<%- include('partials/admin-header') %>

<main class="p-6 sm:p-10 space-y-8 max-w-7xl">
  
  <div class="flex items-center gap-4 pb-6 border-b border-[#E5E0D5]">
    <a href="/admin/phim" class="w-9 h-9 border border-[#E5E0D5] bg-white hover:border-[#121316] text-[#121316] flex items-center justify-center transition-colors">
      <span class="material-symbols-outlined text-lg">arrow_back</span>
    </a>
    <div>
      <span class="archival-index">CHỈNH SỬA TÁC PHẨM</span>
      <h1 class="editorial-headline text-3xl font-bold mt-0.5"><%= phim.title %></h1>
    </div>
  </div>

  <form action="/admin/phim/sua/<%= phim._id %>" method="POST" class="grid grid-cols-1 lg:grid-cols-12 gap-8 text-xs font-['Plus_Jakarta_Sans']">
    
    <div class="lg:col-span-8 space-y-6">
      
      <div class="bg-white border border-[#E5E0D5] p-6 sm:p-8 space-y-5">
        <h2 class="font-bold text-xs text-[#121316] uppercase tracking-wider pb-3 border-b border-[#E5E0D5]">
          1. Thông Tin Phim
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Tên phim <span class="text-[#BA2D27]">*</span>
            </label>
            <input name="title" value="<%= phim.title %>" required class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-bold focus:outline-none focus:border-[#121316]" />
          </div>

          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Đạo diễn</label>
            <input name="director" value="<%= phim.director || '' %>" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] focus:outline-none focus:border-[#121316]" />
          </div>

          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Thể loại</label>
            <input name="genre" value="<%= phim.genre || '' %>" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] focus:outline-none focus:border-[#121316]" />
          </div>

          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Thời lượng (Phút) <span class="text-[#BA2D27]">*</span>
            </label>
            <input name="duration" type="number" value="<%= phim.duration %>" required class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          </div>

          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Ngày khởi chiếu</label>
            <input name="releaseDate" type="date" value="<%= phim.releaseDate ? new Date(phim.releaseDate).toISOString().split('T')[0] : '' %>" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
          </div>

          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Trạng thái phát hành</label>
            <select name="status" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-bold focus:outline-none focus:border-[#121316]">
              <option value="DangChieu" <%= phim.status === 'DangChieu' ? 'selected' : '' %>>Đang chiếu (Now Showing)</option>
              <option value="SapChieu" <%= phim.status === 'SapChieu' ? 'selected' : '' %>>Sắp chiếu (Coming Soon)</option>
            </select>
          </div>

          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Giới hạn độ tuổi</label>
            <select name="ageRating" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-bold focus:outline-none focus:border-[#121316]">
              <option value="P" <%= phim.ageRating === 'P' ? 'selected' : '' %>>P — Mọi lứa tuổi</option>
              <option value="K" <%= phim.ageRating === 'K' ? 'selected' : '' %>>K — Dưới 13 tuổi có người lớn</option>
              <option value="T13" <%= phim.ageRating === 'T13' ? 'selected' : '' %>>T13 — Khán giả từ 13 tuổi</option>
              <option value="T16" <%= phim.ageRating === 'T16' ? 'selected' : '' %>>T16 — Khán giả từ 16 tuổi</option>
              <option value="T18" <%= phim.ageRating === 'T18' ? 'selected' : '' %>>T18 — Khán giả từ 18 tuổi</option>
            </select>
          </div>

          <!-- Giá vé bán (VNĐ) -->
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Giá vé bán (VNĐ) <span class="text-[#BA2D27]">*</span>
            </label>
            <input name="price" type="number" required value="<%= phim.price || 75000 %>" placeholder="75000" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          </div>

          <!-- Giá gốc niêm yết (VNĐ) -->
          <div>
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
              Giá gốc niêm yết (VNĐ)
            </label>
            <input name="originalPrice" type="number" value="<%= phim.originalPrice || 95000 %>" placeholder="95000" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
          </div>

          <div class="sm:col-span-2">
            <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">Tóm tắt nội dung phim</label>
            <textarea name="description" rows="4" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3.5 py-2.5 text-xs text-[#121316] focus:outline-none focus:border-[#121316]"><%= phim.description || '' %></textarea>
          </div>
        </div>
      </div>

      <!-- Showtime Manager -->
      <div class="bg-white border border-[#E5E0D5] p-6 sm:p-8 space-y-4">
        <h2 class="font-bold text-xs text-[#121316] uppercase tracking-wider pb-3 border-b border-[#E5E0D5]">
          2. Suất Chiếu Tại Rạp
        </h2>

        <div class="space-y-4" id="showtimeRowsContainer">
          <% 
            const existingSts = (phim.showtimes && Array.isArray(phim.showtimes) && phim.showtimes.length > 0) ? phim.showtimes : [{ cinema: 'CGV Kim Cúc Plaza', room: 'Phòng 1 (IMAX)', date: new Date().toISOString().split('T')[0], times: ['09:30', '13:15', '19:30'] }];
            existingSts.forEach((st, idx) => {
              const timesStr = (st.times && Array.isArray(st.times)) ? st.times.join(', ') : (st.times || '09:30, 13:15, 19:30');
          %>
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 p-4 bg-[#FAF8F5] border border-[#E5E0D5] relative">
            <div class="flex flex-col">
              <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate" title="Cụm rạp">Cụm rạp</label>
              <select name="cinema" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs text-[#121316] font-semibold focus:outline-none focus:border-[#121316]">
                <option value="CGV Kim Cúc Plaza" <%= st.cinema === 'CGV Kim Cúc Plaza' ? 'selected' : '' %>>CGV Kim Cúc Plaza</option>
                <option value="Starlight Nguyễn Kim" <%= st.cinema === 'Starlight Nguyễn Kim' ? 'selected' : '' %>>Starlight Nguyễn Kim</option>
                <option value="DCine Quy Nhơn" <%= (st.cinema === 'DCine Quy Nhơn' || st.cinema === 'Dcine Quy Nhơn') ? 'selected' : '' %>>DCine Quy Nhơn</option>
              </select>
            </div>
            <div class="flex flex-col">
              <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate" title="Phòng chiếu">Phòng chiếu</label>
              <select name="room" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs text-[#121316] font-semibold focus:outline-none focus:border-[#121316]">
                <option value="Phòng 1 (IMAX)" <%= (st.room === 'Phòng 1' || st.room === 'Phòng 1 (IMAX)') ? 'selected' : '' %>>Phòng 1 (IMAX)</option>
                <option value="Phòng 2 (2D)" <%= (st.room === 'Phòng 2' || st.room === 'Phòng 2 (2D)') ? 'selected' : '' %>>Phòng 2 (2D)</option>
                <option value="Phòng 3 (VIP)" <%= (st.room === 'Phòng 3' || st.room === 'Phòng 3 (VIP)') ? 'selected' : '' %>>Phòng 3 (VIP)</option>
              </select>
            </div>
            <div class="flex flex-col">
              <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate" title="Ngày chiếu">Ngày chiếu</label>
              <input type="date" name="show_date" value="<%= st.date || new Date().toISOString().split('T')[0] %>" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
            </div>
            <div class="flex flex-col">
              <div class="flex items-center justify-between h-5 mb-1.5">
                <label class="font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] whitespace-nowrap truncate" title="Các suất chiếu">Giờ chiếu (Tự nhập giờ, cách nhau dấu phẩy)</label>
                <% if (idx > 0) { %>
                  <button type="button" onclick="this.closest('.grid').remove()" class="text-[10px] font-bold text-[#BA2D27] hover:underline">✕ Xóa</button>
                <% } %>
              </div>
              <input type="text" name="show_times" value="<%= timesStr %>" placeholder="Nhập giờ chiếu tùy ý (VD: 08:30, 14:15, 20:00)" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs font-['JetBrains_Mono'] font-bold text-[#121316] focus:outline-none focus:border-[#121316]" onblur="formatShowtimeInput(this)" />
              <span class="text-[9px] text-[#7A7E8B] font-['JetBrains_Mono'] mt-1">Định dạng HH:MM, cách nhau bởi dấu phẩy</span>
            </div>
          </div>
          <% }); %>
        </div>

        <div class="pt-2 border-t border-[#E5E0D5]">
          <button type="button" onclick="addShowtimeRow()" class="px-3 py-2 bg-white border border-[#121316] hover:bg-[#121316] hover:text-white text-xs font-['JetBrains_Mono'] font-bold text-[#121316] transition-all flex items-center gap-1.5">
            <span>+ Thêm Lịch Chiếu Khác (Rạp hoặc Ngày khác)</span>
          </button>
        </div>
      </div>

    </div>

    <div class="lg:col-span-4 space-y-6">
      
      <div class="bg-white border border-[#E5E0D5] p-6 space-y-4">
        <h3 class="font-bold text-xs text-[#121316] uppercase tracking-wider pb-2 border-b border-[#E5E0D5]">
          3. Áp Phích & Trailer
        </h3>

        <div>
          <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
            Poster URL
          </label>
          <input name="posterUrl" value="<%= phim.posterUrl %>" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
        </div>

        <div class="aspect-[3/4] bg-[#EFEBE3] border border-[#E5E0D5] overflow-hidden">
          <img src="<%= phim.posterUrl %>" alt="<%= phim.title %>" class="w-full h-full object-cover" />
        </div>

        <div>
          <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase tracking-wider mb-1">
            Trailer URL
          </label>
          <input name="trailerUrl" value="<%= phim.trailerUrl || '' %>" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 text-xs text-[#121316] font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
        </div>
      </div>

      <div class="bg-white border border-[#E5E0D5] p-6 space-y-3">
        <button type="submit" class="btn-editorial-primary w-full py-3.5 text-xs font-bold uppercase tracking-wider block text-center !bg-[#BA2D27]">
          CẬP NHẬT THÔNG TIN PHIM →
        </button>
        <a href="/admin/phim" class="btn-editorial-secondary w-full py-2.5 text-xs font-bold uppercase tracking-wider block text-center">
          QUAY LẠI
        </a>
      </div>

    </div>

  </form>

</main>

<script>
  function appendTimeChip(btn, timeStr) {
    const row = btn.closest('.grid');
    if (!row) return;
    const input = row.querySelector('input[name="show_times"]');
    if (!input) return;
    let cur = input.value.trim();
    if (!cur) {
      input.value = timeStr;
    } else {
      const existing = cur.split(',').map(s => s.trim());
      if (!existing.includes(timeStr)) {
        input.value = cur + ', ' + timeStr;
      }
    }
    formatShowtimeInput(input);
  }

  function formatShowtimeInput(input) {
    if (!input || !input.value) return;
    let val = input.value;
    let parts = val.split(/[,;\n]+/).map(p => p.trim()).filter(Boolean);
    let formatted = parts.map(p => {
      let s = p.toLowerCase().replace(/giờ|gio/g, 'h').replace(/\s+/g, '');
      let m = s.match(/^(\d{1,2})[h:.](\d{1,2})$/);
      if (m) {
        let h = parseInt(m[1], 10);
        let min = parseInt(m[2], 10);
        if (h <= 23 && min <= 59) return String(h).padStart(2, '0') + ':' + String(min).padStart(2, '0');
      }
      m = s.match(/^(\d{1,2})h?$/);
      if (m) {
        let h = parseInt(m[1], 10);
        if (h <= 23) return String(h).padStart(2, '0') + ':00';
      }
      if (/^\d{3,4}$/.test(s)) {
        const padded = s.padStart(4, '0');
        const h = parseInt(padded.slice(0, 2), 10);
        const min = parseInt(padded.slice(2), 10);
        if (h <= 23 && min <= 59) return String(h).padStart(2, '0') + ':' + String(min).padStart(2, '0');
      }
      return p;
    });
    input.value = formatted.join(', ');
  }

  function addShowtimeRow() {
    const container = document.getElementById('showtimeRowsContainer');
    if (!container) return;
    const newRow = document.createElement('div');
    newRow.className = 'grid grid-cols-1 sm:grid-cols-4 gap-3 p-4 bg-[#FAF8F5] border border-[#E5E0D5] relative';
    newRow.innerHTML = `
      <div class="flex flex-col">
        <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate">Cụm rạp</label>
        <select name="cinema" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs text-[#121316] font-semibold focus:outline-none focus:border-[#121316]">
          <option value="CGV Kim Cúc Plaza">CGV Kim Cúc Plaza</option>
          <option value="Starlight Nguyễn Kim">Starlight Nguyễn Kim</option>
          <option value="DCine Quy Nhơn">DCine Quy Nhơn</option>
        </select>
      </div>
      <div class="flex flex-col">
        <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate">Phòng chiếu</label>
        <select name="room" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs text-[#121316] font-semibold focus:outline-none focus:border-[#121316]">
          <option value="Phòng 1 (IMAX)">Phòng 1 (IMAX)</option>
          <option value="Phòng 2 (2D)">Phòng 2 (2D)</option>
          <option value="Phòng 3 (VIP)">Phòng 3 (VIP)</option>
        </select>
      </div>
      <div class="flex flex-col">
        <label class="block font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] mb-1.5 h-5 flex items-center whitespace-nowrap truncate">Ngày chiếu</label>
        <input type="date" name="show_date" value="<%= new Date().toISOString().split('T')[0] %>" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
      </div>
      <div class="flex flex-col">
        <div class="flex items-center justify-between h-5 mb-1.5">
          <label class="font-['JetBrains_Mono'] text-[10px] text-[#7A7E8B] whitespace-nowrap truncate">Giờ chiếu (Tự nhập)</label>
          <button type="button" onclick="this.closest('.grid').remove()" class="text-[10px] font-bold text-[#BA2D27] hover:underline">✕ Xóa</button>
        </div>
        <input type="text" name="show_times" placeholder="Nhập giờ chiếu tùy ý (VD: 08:30, 14:15, 20:00)" value="" class="w-full h-10 bg-white border border-[#E5E0D5] px-2.5 text-xs font-['JetBrains_Mono'] font-bold text-[#121316] focus:outline-none focus:border-[#121316]" onblur="formatShowtimeInput(this)" />
      </div>
    `;
    container.appendChild(newRow);
  }
</script>

<%- include('partials/admin-footer') %>

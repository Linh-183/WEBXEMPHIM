<%- include('partials/header') %>

<main class="min-h-screen py-14 pb-28 bg-[#FAF8F5]">
  <div class="max-w-xl mx-auto px-4 sm:px-6">
    
    <!-- TOP STATUS -->
    <div class="text-center mb-8 space-y-2">
      <span class="archival-index">GIAO DỊCH THÀNH CÔNG • VÉ HỢP LỆ</span>
      <h1 class="editorial-headline text-3xl sm:text-4xl">Vé Điện Tử CineGo Pass</h1>
      <p class="text-xs text-[#7A7E8B] font-light">
        Xuất trình mã QR này tại cửa phòng chiếu để nhân viên rạp quét vé vào cửa.
      </p>
    </div>

    <!-- ARCHITECTURAL TICKET PASS -->
    <div class="ticket-pass ticket-pass-horizontal p-6 sm:p-8 bg-white border border-[#E5E0D5] space-y-6 shadow-2xl">
      
      <!-- Pass Header -->
      <div class="flex items-center justify-between border-b border-[#E5E0D5] pb-4">
        <div>
          <span class="font-serif font-black text-xl tracking-[0.2em] text-[#121316]">CINEGO</span>
          <span class="block font-['JetBrains_Mono'] text-[9px] text-[#7A7E8B] uppercase tracking-wider">Digital Admission Pass</span>
        </div>
        <div class="text-right font-['JetBrains_Mono']">
          <span class="block text-[9px] text-[#7A7E8B] uppercase">MÃ ĐẶT CHỖ</span>
          <span class="text-sm font-bold text-[#BA2D27] tracking-wider" id="ticketCodeDisplay">
            <%= (typeof ticket !== 'undefined' && ticket && ticket._id) ? 'CNE-' + ticket._id.toString().slice(-6).toUpperCase() : 'CNE-ONLINE' %>
          </span>
        </div>
      </div>

      <!-- Film Title & Format -->
      <% 
        const currentTicket = (typeof ticket !== 'undefined' && ticket) ? ticket : null;
        const isFoodTicket = (!currentTicket || !currentTicket.movie); 
      %>
      <div class="space-y-1">
        <span class="px-2 py-0.5 <%= isFoodTicket ? 'bg-[#A6853B]' : 'bg-[#BA2D27]' %> text-white text-[10px] font-['JetBrains_Mono'] font-bold inline-block">
          <%= isFoodTicket ? 'F&B GOURMET PASS' : ((currentTicket && currentTicket.movie && currentTicket.movie.ageRating) ? currentTicket.movie.ageRating : 'P') %>
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#121316] leading-tight" id="ticketMovieTitle">
          <%= isFoodTicket ? (currentTicket && currentTicket.comboDetails ? currentTicket.comboDetails : 'Phiếu Bắp Nước Fast-Track') : (currentTicket && currentTicket.movie ? currentTicket.movie.title : 'Vé Xem Phim CineGo') %>
        </h2>
        <span class="font-['JetBrains_Mono'] text-xs text-[#7A7E8B] block mt-1">
          <%= isFoodTicket ? 'Dịch vụ ẩm thực Fast-Track • Nhận ngay tại quầy Concessions không cần xếp hàng' : 'Định dạng: 2D Laser Digital • Âm thanh vòm Dolby Surround' %>
        </span>
      </div>

      <!-- Specs Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 bg-[#FAF8F5] border border-[#E5E0D5] font-['JetBrains_Mono'] text-center">
        <div>
          <span class="block text-[9px] text-[#7A7E8B] uppercase">Cụm rạp</span>
          <span class="text-xs font-bold text-[#121316] mt-0.5 block truncate" id="ticketCinemaDisplay">
            <%= (typeof ticket !== 'undefined' && ticket && ticket.cinema) ? ticket.cinema : 'Hệ thống CineGo' %>
          </span>
        </div>
        <div>
          <span class="block text-[9px] text-[#7A7E8B] uppercase"><%= isFoodTicket ? 'Cổng nhận' : 'Phòng chiếu' %></span>
          <span class="text-xs font-bold text-[#121316] mt-0.5 block"><%= isFoodTicket ? 'Quầy Fast-Track' : 'Phòng Standard' %></span>
        </div>
        <div>
          <span class="block text-[9px] text-[#7A7E8B] uppercase"><%= isFoodTicket ? 'Ngày nhận' : 'Suất chiếu' %></span>
          <span class="text-xs font-bold text-[#121316] mt-0.5 block" id="ticketTimeDisplay">
            <% if (isFoodTicket) { %>
              <%= (typeof ticket !== 'undefined' && ticket && ticket.showDate) ? ticket.showDate : 'Hôm nay' %>
            <% } else { %>
              <%= (typeof ticket !== 'undefined' && ticket && ticket.showTime) ? ticket.showTime : '--:--' %><% if (typeof ticket !== 'undefined' && ticket && ticket.showDate) { %><br><span class="text-[10px] text-[#7A7E8B] font-normal"><%= ticket.showDate %></span><% } %>
            <% } %>
          </span>
        </div>
        <div>
          <span class="block text-[9px] text-[#7A7E8B] uppercase"><%= isFoodTicket ? 'Trạng thái' : 'Ghế ngồi' %></span>
          <span class="text-xs font-bold text-[#BA2D27] mt-0.5 block" id="ticketSeatsDisplay">
            <%= isFoodTicket ? '✓ Sẵn sàng nhận' : ((typeof ticket !== 'undefined' && ticket && ticket.seats) ? (Array.isArray(ticket.seats) ? ticket.seats.join(', ') : ticket.seats) : '--') %>
          </span>
        </div>
      </div>

      <% if (typeof ticket !== 'undefined' && ticket && ticket.comboDetails) { %>
        <div class="p-3 bg-[#FAF8F5] border border-[#E5E0D5] text-xs font-['JetBrains_Mono'] text-[#474A54] flex items-center justify-between">
          <span>Bắp nước kèm: <strong class="text-[#121316]"><%= ticket.comboDetails %></strong></span>
          <span class="text-[#121316] font-bold"><%= (ticket.comboTotal || 0).toLocaleString('vi-VN') %> đ</span>
        </div>
      <% } %>

      <div class="p-3 bg-[#FAF8F5] border border-[#E5E0D5] text-xs font-['JetBrains_Mono'] text-[#474A54] flex items-center justify-between">
        <span class="uppercase text-[10px] text-[#7A7E8B]">Tổng thanh toán:</span>
        <span class="text-sm font-bold text-[#BA2D27]">
          <%= (typeof ticket !== 'undefined' && ticket && ticket.totalPrice) ? ticket.totalPrice.toLocaleString('vi-VN') + ' đ' : '0 đ' %>
        </span>
      </div>

      <!-- Perforated Line -->
      <div class="perforated-line"></div>

      <!-- QR Code Barcode Representation -->
      <div class="p-6 bg-[#FAF8F5] border border-[#E5E0D5] flex flex-col items-center justify-center space-y-3">
        <div class="w-44 h-44 bg-white border-2 border-[#121316] p-3 flex items-center justify-center">
          <svg class="w-full h-full" viewBox="0 0 100 100" fill="#121316">
            <rect x="5" y="5" width="25" height="25" fill="#121316"/>
            <rect x="8" y="8" width="19" height="19" fill="#FFF"/>
            <rect x="12" y="12" width="11" height="11" fill="#121316"/>
            <rect x="70" y="5" width="25" height="25" fill="#121316"/>
            <rect x="73" y="8" width="19" height="19" fill="#FFF"/>
            <rect x="77" y="12" width="11" height="11" fill="#121316"/>
            <rect x="5" y="70" width="25" height="25" fill="#121316"/>
            <rect x="8" y="73" width="19" height="19" fill="#FFF"/>
            <rect x="12" y="77" width="11" height="11" fill="#121316"/>
            <rect x="35" y="15" width="8" height="6"/>
            <rect x="45" y="25" width="12" height="8"/>
            <rect x="35" y="45" width="30" height="20"/>
            <rect x="75" y="40" width="15" height="12"/>
            <rect x="40" y="75" width="12" height="10"/>
            <rect x="60" y="75" width="20" height="10"/>
          </svg>
        </div>
        <div class="text-center font-['JetBrains_Mono'] text-xs text-[#7A7E8B]">
          Mã xác thực duy nhất • Quét mã khi vào xem phim
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3 pt-2 font-['JetBrains_Mono']">
        <button type="button" onclick="window.print()" class="btn-editorial-secondary text-xs flex-1 text-center">
          In Vé (Print)
        </button>
        <a href="/tai-khoan/ve-cua-toi" class="btn-editorial-primary text-xs flex-1 text-center">
          Quản Lý Vé →
        </a>
      </div>

    </div>

  </div>
</main>

<script>
  // Tự động làm sạch giỏ hàng CineGo sau khi thanh toán thành công và nhận vé điện tử
  document.addEventListener('DOMContentLoaded', () => {
    try {
      if (typeof window.clearHeaderCart === 'function') {
        window.clearHeaderCart();
      } else {
        localStorage.removeItem('cinego_cart');
      }
    } catch(e) {}
  });
</script>

<%- include('partials/footer') %>

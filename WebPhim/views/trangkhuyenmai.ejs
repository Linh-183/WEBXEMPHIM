<%- include('partials/header') %>

<%
  const promoVouchers = (typeof vouchers !== 'undefined' && Array.isArray(vouchers)) ? vouchers.filter(v => v && !v.isReward) : [];
%>

<main class="min-h-screen py-12 pb-24 bg-[#FAF8F5]">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- =========================================================================
         1. EDITORIAL PROMOTION MASTHEAD
         ========================================================================= -->
    <div class="pb-8 border-b border-[#E5E0D5] mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="archival-index">ĐẶC QUYỀN & ƯU ĐÃI THÀNH VIÊN</span>
        <h1 class="editorial-headline mt-1">Khuyến Mãi & Ví Mã Giảm Giá</h1>
        <p class="text-xs text-[#7A7E8B] mt-1.5 font-light max-w-2xl leading-relaxed">
          Danh mục voucher giảm giá vé và dịch vụ bắp nước áp dụng tại 3 cụm rạp: CGV Kim Cúc Plaza, Starlight Nguyễn Kim và DCine Quy Nhơn.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/tai-khoan/thong-tin#section-vouchers" class="btn-editorial-secondary text-xs !py-2.5 !px-5 font-['JetBrains_Mono']">
          Xem Ví Voucher Của Tôi →
        </a>
      </div>
    </div>

    <!-- =========================================================================
         1.5 BANNER KHÁM PHÁ CHIẾN DỊCH FLASH SALE SĂN VÉ 19K (CHỈ HIỆN KHI CÓ FLASH SALE)
         ========================================================================= -->
    <% if ((typeof activeFlashSale !== 'undefined' && activeFlashSale) || (typeof upcomingFlashSale !== 'undefined' && upcomingFlashSale)) { 
         const fsBanner = (typeof activeFlashSale !== 'undefined' && activeFlashSale) ? activeFlashSale : upcomingFlashSale;
         const isLiveNow = (typeof activeFlashSale !== 'undefined' && activeFlashSale);
         const sTime = new Date(fsBanner.startTime).toLocaleTimeString('vi-VN', {hour: '2-digit', minute: '2-digit'});
         const eTime = new Date(fsBanner.endTime).toLocaleTimeString('vi-VN', {hour: '2-digit', minute: '2-digit'});
    %>
      <div class="bg-gradient-to-r from-[#121316] via-[#1E222B] to-[#121316] border-2 border-[#BA2D27] p-6 sm:p-8 mb-10 text-white shadow-lg relative overflow-hidden">
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 <%= isLiveNow ? 'bg-[#BA2D27] animate-pulse' : 'bg-[#A6853B]' %> text-white font-['JetBrains_Mono'] text-[10px] font-bold uppercase tracking-wider">
                <%= isLiveNow ? '⚡ ĐANG DIỄN RA' : '⚡ SẮP MỞ BÁN' %>
              </span>
              <span class="text-[#A6853B] font-['JetBrains_Mono'] text-xs font-semibold">CINEGO FLASH SALE (<%= sTime %> — <%= eTime %>)</span>
            </div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white tracking-wide">
              <%= fsBanner.title %>
            </h2>
            <p class="text-xs text-white/80 max-w-xl font-light leading-relaxed">
              Chương trình săn vé xem phim và voucher bắp nước cực sốc diễn ra trong khung giờ từ <%= sTime %> đến <%= eTime %> hôm nay. Số lượng có hạn, ưu tiên thành viên nhanh tay nhất!
            </p>
          </div>
          <div class="shrink-0 flex items-center gap-3">
            <a href="/flash-sale" class="inline-flex items-center gap-2 px-6 py-3.5 bg-[#BA2D27] hover:bg-[#8E1F1A] text-white font-bold text-xs uppercase tracking-wider font-['JetBrains_Mono'] transition-all shadow-md">
              <span>⚡ VÀO SĂN VÉ FLASH SALE</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    <% } %>

    <!-- =========================================================================
         2. QUICK SAVE VOUCHER STRIP (NHẬP MÃ ĐỂ LƯU TRỰC TIẾP VÀO VÍ)
         ========================================================================= -->
    <div class="bg-white border border-[#E5E0D5] p-6 sm:p-8 mb-10 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-1">
          <span class="text-[10px] font-bold font-['JetBrains_Mono'] uppercase tracking-widest text-[#BA2D27]">
            THU THẬP ƯU ĐÃI VÀO VÍ
          </span>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#121316]">
            Lưu Mã Ưu Đãi Trực Tiếp Vào Tài Khoản
          </h2>
          <p class="text-xs text-[#7A7E8B]">
            Sau khi lưu, mã giảm giá sẽ nằm trong ví cá nhân của bạn và sẵn sàng áp dụng tự động khi thanh toán vé.
          </p>
        </div>

        <form onsubmit="handleManualSaveVoucher(event)" class="flex flex-wrap sm:flex-nowrap items-center gap-2.5 w-full lg:w-auto">
          <input type="text" 
                 id="manualVoucherCode" 
                 required 
                 placeholder="Nhập mã ưu đãi..." 
                 class="w-full sm:w-64 bg-[#FAF8F5] border border-[#E5E0D5] px-4 py-2.5 text-xs text-[#121316] uppercase font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          <button type="submit" class="btn-editorial-primary text-xs !py-2.5 !px-6 whitespace-nowrap">
            LƯU MÃ VÀO VÍ →
          </button>
        </form>
      </div>
    </div>

    <!-- =========================================================================
         3. PERFORATED VOUCHERS GALLERY (LẤY TỪ DATABASE)
         ========================================================================= -->
    <div class="space-y-6">
      <div class="border-b border-[#E5E0D5] pb-4 flex items-center justify-between">
        <div>
          <span class="archival-index">DANH MỤC KHẢ DỤNG</span>
          <h3 class="font-serif text-xl font-bold text-[#121316] mt-0.5">
            Các Mã Giảm Giá Đang Phát Hành
          </h3>
        </div>
        <span class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">
          TỔNG CỘNG: <strong class="text-[#BA2D27]"><%= promoVouchers.length %> CHIẾN DỊCH</strong>
        </span>
      </div>

      <% if (promoVouchers.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% promoVouchers.forEach(v => { 
               const isFs = v.isFlashSale;
               const now = new Date();
               let fsOpen = true;
               let fsMsg = '';
               if (isFs) {
                 const fStart = v.flashStartTime ? new Date(v.flashStartTime) : null;
                 const fEnd = v.flashEndTime ? new Date(v.flashEndTime) : null;
                 const claimed = v.claimedQuantity || 0;
                 const maxL = v.maxQuantity || 50;
                 if (claimed >= maxL) {
                   fsOpen = false;
                   fsMsg = 'Hết Lượt Lưu';
                 } else if (fStart && now < fStart) {
                   fsOpen = false;
                   fsMsg = 'Chưa Mở Lưu';
                 } else if (fEnd && now > fEnd) {
                   fsOpen = false;
                   fsMsg = 'Hết Giờ';
                 }
               }
          %>
            <div class="ticket-pass ticket-pass-horizontal p-6 bg-white border border-[#E5E0D5] flex flex-col justify-between space-y-4 hover:border-[#121316] transition-all shadow-sm <%= isFs ? 'border-amber-300 ring-1 ring-amber-400/30' : '' %>">
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <span class="px-2 py-0.5 bg-[#BA2D27] text-white text-[10px] font-['JetBrains_Mono'] font-bold uppercase">
                      <%= v.discountType === 'percentage' ? ('GIẢM ' + v.discountValue + '%') : ('GIẢM ' + (v.discountValue / 1000) + 'K') %>
                    </span>
                    <% if (isFs) { %>
                      <span class="px-1.5 py-0.5 bg-amber-500 text-white text-[9px] font-['JetBrains_Mono'] font-bold uppercase animate-pulse">
                        ⚡ FLASH SALE
                      </span>
                    <% } %>
                  </div>
                  <% if (v.minOrderValue) { %>
                    <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">ĐƠN TỪ <%= (v.minOrderValue / 1000) %>K</span>
                  <% } %>
                </div>
                <h4 class="font-serif text-2xl font-black text-[#121316]">
                  <%= v.code %>
                </h4>
                <p class="text-xs text-[#474A54]"><%= v.title %></p>
                <% if (v.description) { %>
                  <p class="text-[11px] text-[#7A7E8B]"><%= v.description %></p>
                <% } %>

                <% if (isFs) { 
                     const claimed = v.claimedQuantity || 0;
                     const maxL = v.maxQuantity || 50;
                     const remaining = Math.max(0, maxL - claimed);
                %>
                  <div class="p-2 bg-[#FAF8F5] border border-[#E5E0D5] text-[10.5px] font-['JetBrains_Mono'] space-y-1 mt-2">
                    <div class="flex items-center justify-between text-[#121316]">
                      <span class="text-[#BA2D27] font-bold">⚡ Khung giờ:</span>
                      <span>
                        <%= v.flashStartTime ? new Date(v.flashStartTime).toLocaleTimeString('vi-VN', {hour:'2-digit', minute:'2-digit'}) : '00:00' %> - 
                        <%= v.flashEndTime ? new Date(v.flashEndTime).toLocaleTimeString('vi-VN', {hour:'2-digit', minute:'2-digit'}) : '23:59' %>
                      </span>
                    </div>
                    <div class="flex items-center justify-between text-[#7A7E8B]">
                      <span>Lượt còn lại:</span>
                      <strong class="text-[#BA2D27]"><%= remaining %> / <%= maxL %> lượt</strong>
                    </div>
                  </div>
                <% } %>
              </div>

              <div class="pt-4 border-t border-[#E5E0D5] flex items-center justify-between font-['JetBrains_Mono'] text-xs">
                <span class="text-[#7A7E8B] text-[10px]">
                  Hạn: <%= v.expiryDate ? new Date(v.expiryDate).toLocaleDateString('vi-VN') : 'Vô thời hạn' %>
                </span>
                <% if (isFs && !fsOpen) { %>
                  <button type="button" 
                          disabled 
                          class="bg-gray-200 text-gray-500 cursor-not-allowed text-xs !py-1.5 !px-4 font-bold flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm">schedule</span>
                    <span><%= fsMsg %></span>
                  </button>
                <% } else { %>
                  <button type="button" 
                          onclick="saveVoucherToWallet(this, '<%= v.code %>')" 
                          class="btn-editorial-primary text-xs !py-1.5 !px-4 font-bold flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm">bookmark_add</span>
                    <span>Lưu Mã Vào Ví</span>
                  </button>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <!-- Empty State khi hệ thống chưa có voucher -->
        <div class="p-12 text-center bg-white border border-[#E5E0D5] space-y-3">
          <span class="material-symbols-outlined text-4xl text-[#7A7E8B]">loyalty</span>
          <div class="space-y-1">
            <h4 class="font-serif text-base font-bold text-[#121316]">
              Hiện Chưa Có Mã Khuyến Mãi Nào Được Phát Hành
            </h4>
            <p class="text-xs text-[#7A7E8B] max-w-md mx-auto">
              Ban quản lý cụm rạp sẽ sớm phát hành các voucher ưu đãi vào dịp cuối tuần và các sự kiện ra mắt phim bom tấn.
            </p>
          </div>
          <div class="pt-2">
            <a href="/phim" class="btn-editorial-primary text-xs !py-2.5 !px-5 inline-block">
              Xem Lịch Chiếu Phim Hôm Nay →
            </a>
          </div>
        </div>
      <% } %>
    </div>

  </div>
</main>

<script>
  const isUserLoggedIn = <%= (typeof user !== 'undefined' && user && user._id) ? 'true' : 'false' %>;

  function saveVoucherToWallet(btn, code) {
    if (!isUserLoggedIn) {
      if (window.cinegoToast) {
        window.cinegoToast.warning('Bạn cần có tài khoản và đăng nhập để lưu mã ưu đãi vào ví!');
      } else {
        alert('Bạn cần có tài khoản và đăng nhập để lưu mã ưu đãi vào ví!');
      }
      setTimeout(() => {
        window.location.href = '/dang-nhap?returnTo=' + encodeURIComponent(window.location.pathname) + '&warning=' + encodeURIComponent('Vui lòng đăng nhập để lưu mã ưu đãi vào ví!');
      }, 500);
      return;
    }

    fetch('/api/luu-voucher', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        if (window.cinegoToast) window.cinegoToast.success(data.message);
        else alert(data.message);
        btn.classList.remove('btn-editorial-primary');
        btn.classList.add('bg-[#10B981]', 'text-white', 'border', 'border-[#10B981]');
        btn.innerHTML = '<span class="material-symbols-outlined text-sm">check</span><span>Đã Lưu Vào Ví</span>';
      } else {
        if (data.requireLogin) {
          window.location.href = '/dang-nhap?returnTo=' + encodeURIComponent(window.location.pathname) + '&warning=' + encodeURIComponent(data.message);
          return;
        }
        if (window.cinegoToast) window.cinegoToast.info(data.message);
        else alert(data.message);
      }
    })
    .catch(err => {
      window.location.href = '/dang-nhap?returnTo=' + encodeURIComponent(window.location.pathname) + '&warning=' + encodeURIComponent('Vui lòng đăng nhập để lưu mã ưu đãi vào ví!');
    });
  }

  function handleManualSaveVoucher(e) {
    e.preventDefault();
    const code = document.getElementById('manualVoucherCode').value.trim();
    if (!code) return;
    saveVoucherToWallet(e.target.querySelector('button'), code);
    document.getElementById('manualVoucherCode').value = '';
  }
</script>

<%- include('partials/footer') %>

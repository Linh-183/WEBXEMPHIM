          </div>
        </div>

      </div>
    </div>

  </div>
</main>

<script>
  function copyVoucher(code) {
    navigator.clipboard.writeText(code).then(() => {
      if (window.cinegoToast) {
        window.cinegoToast.success('Đã sao chép mã ưu đãi: ' + code);
      } else {
        alert('Đã sao chép mã: ' + code);
      }
    });
  }

  // Live countdown simulator
  let totalSeconds = 3600 * 1 + 24 * 60 + 45;
  setInterval(() => {
    totalSeconds--;
    if (totalSeconds < 0) totalSeconds = 7200;
    const h = Math.floor(totalSeconds / 3600);
    const m = Math.floor((totalSeconds % 3600) / 60);
    const s = totalSeconds % 60;
    document.getElementById('fs-hours').innerText = h.toString().padStart(2, '0');
    document.getElementById('fs-mins').innerText = m.toString().padStart(2, '0');
    document.getElementById('fs-secs').innerText = s.toString().padStart(2, '0');
  }, 1000);
</script>


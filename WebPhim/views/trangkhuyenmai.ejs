<%- include('partials/header') %>

<%
  const promoVouchers = (typeof vouchers !== 'undefined' && Array.isArray(vouchers)) ? vouchers : [];
%>

<main class="min-h-screen py-12 pb-24 bg-[#FAF8F5]">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- =========================================================================
         1. EDITORIAL PROMOTION MASTHEAD
         ========================================================================= -->
    <div class="pb-8 border-b border-[#E5E0D5] mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="archival-index">ĐẶC QUYỀN & ƯU ĐÃI THÀNH VIÊN</span>
        <h1 class="editorial-headline mt-1">Khuyến Mãi & Ví Mã Giảm Giá</h1>
        <p class="text-xs text-[#7A7E8B] mt-1.5 font-light max-w-2xl leading-relaxed">
          Danh mục voucher giảm giá vé và dịch vụ bắp nước áp dụng tại 3 cụm rạp: CGV Kim Cúc Plaza, Starlight Nguyễn Kim và Dcine Phú Tài Quy Nhơn.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/tai-khoan/thong-tin#section-vouchers" class="btn-editorial-secondary text-xs !py-2.5 !px-5 font-['JetBrains_Mono']">
          Xem Ví Voucher Của Tôi →
        </a>
      </div>
    </div>

    <!-- =========================================================================
         2. QUICK SAVE VOUCHER STRIP (NHẬP MÃ ĐỂ LƯU TRỰC TIẾP VÀO VÍ)
         ========================================================================= -->
    <div class="bg-white border border-[#E5E0D5] p-6 sm:p-8 mb-10 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-1">
          <span class="text-[10px] font-bold font-['JetBrains_Mono'] uppercase tracking-widest text-[#BA2D27]">
            THU THẬP ƯU ĐÃI VÀO VÍ
          </span>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-[#121316]">
            Lưu Mã Ưu Đãi Trực Tiếp Vào Tài Khoản
          </h2>
          <p class="text-xs text-[#7A7E8B]">
            Sau khi lưu, mã giảm giá sẽ nằm trong ví cá nhân của bạn và sẵn sàng áp dụng tự động khi thanh toán vé.
          </p>
        </div>

        <form onsubmit="handleManualSaveVoucher(event)" class="flex flex-wrap sm:flex-nowrap items-center gap-2.5 w-full lg:w-auto">
          <input type="text" 
                 id="manualVoucherCode" 
                 required 
                 placeholder="Nhập mã ưu đãi..." 
                 class="w-full sm:w-64 bg-[#FAF8F5] border border-[#E5E0D5] px-4 py-2.5 text-xs text-[#121316] uppercase font-['JetBrains_Mono'] font-bold focus:outline-none focus:border-[#121316]" />
          <button type="submit" class="btn-editorial-primary text-xs !py-2.5 !px-6 whitespace-nowrap">
            LƯU MÃ VÀO VÍ →
          </button>
        </form>
      </div>
    </div>

    <!-- =========================================================================
         3. PERFORATED VOUCHERS GALLERY (LẤY TỪ DATABASE)
         ========================================================================= -->
    <div class="space-y-6">
      <div class="border-b border-[#E5E0D5] pb-4 flex items-center justify-between">
        <div>
          <span class="archival-index">DANH MỤC KHẢ DỤNG</span>
          <h3 class="font-serif text-xl font-bold text-[#121316] mt-0.5">
            Các Mã Giảm Giá Đang Phát Hành
          </h3>
        </div>
        <span class="text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">
          TỔNG CỘNG: <strong class="text-[#BA2D27]"><%= promoVouchers.length %> CHIẾN DỊCH</strong>
        </span>
      </div>

      <% if (promoVouchers.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% promoVouchers.forEach(v => { %>
            <div class="ticket-pass ticket-pass-horizontal p-6 bg-white border border-[#E5E0D5] flex flex-col justify-between space-y-4 hover:border-[#121316] transition-all shadow-sm">
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="px-2 py-0.5 bg-[#BA2D27] text-white text-[10px] font-['JetBrains_Mono'] font-bold uppercase">
                    <%= v.discountType === 'percentage' ? ('GIẢM ' + v.discountValue + '%') : ('GIẢM ' + (v.discountValue / 1000) + 'K') %>
                  </span>
                  <% if (v.minOrderValue) { %>
                    <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B]">ĐƠN TỪ <%= (v.minOrderValue / 1000) %>K</span>
                  <% } %>
                </div>
                <h4 class="font-serif text-2xl font-black text-[#121316]">
                  <%= v.code %>
                </h4>
                <p class="text-xs text-[#474A54]"><%= v.title %></p>
                <% if (v.description) { %>
                  <p class="text-[11px] text-[#7A7E8B]"><%= v.description %></p>
                <% } %>
              </div>

              <div class="pt-4 border-t border-[#E5E0D5] flex items-center justify-between font-['JetBrains_Mono'] text-xs">
                <span class="text-[#7A7E8B] text-[10px]">
                  Hạn: <%= v.expiryDate ? new Date(v.expiryDate).toLocaleDateString('vi-VN') : 'Vô thời hạn' %>
                </span>
                <button type="button" 
                        onclick="saveVoucherToWallet(this, '<%= v.code %>')" 
                        class="btn-editorial-primary text-xs !py-1.5 !px-4 font-bold flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-sm">bookmark_add</span>
                  <span>Lưu Mã Vào Ví</span>
                </button>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <!-- Empty State khi hệ thống chưa có voucher -->
        <div class="p-12 text-center bg-white border border-[#E5E0D5] space-y-3">
          <span class="material-symbols-outlined text-4xl text-[#7A7E8B]">loyalty</span>
          <div class="space-y-1">
            <h4 class="font-serif text-base font-bold text-[#121316]">
              Hiện Chưa Có Mã Khuyến Mãi Nào Được Phát Hành
            </h4>
            <p class="text-xs text-[#7A7E8B] max-w-md mx-auto">
              Ban quản lý cụm rạp sẽ sớm phát hành các voucher ưu đãi vào dịp cuối tuần và các sự kiện ra mắt phim bom tấn.
            </p>
          </div>
          <div class="pt-2">
            <a href="/phim" class="btn-editorial-primary text-xs !py-2.5 !px-5 inline-block">
              Xem Lịch Chiếu Phim Hôm Nay →
            </a>
          </div>
        </div>
      <% } %>
    </div>

  </div>
</main>

<script>
  function saveVoucherToWallet(btn, code) {
    fetch('/api/luu-voucher', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        if (window.cinegoToast) window.cinegoToast.success(data.message);
        else alert(data.message);
        btn.classList.remove('btn-editorial-primary');
        btn.classList.add('bg-[#10B981]', 'text-white', 'border', 'border-[#10B981]');
        btn.innerHTML = '<span class="material-symbols-outlined text-sm">check</span><span>Đã Lưu Vào Ví</span>';
      } else {
        if (window.cinegoToast) window.cinegoToast.info(data.message);
        else alert(data.message);
      }
    })
    .catch(err => {
      if (window.cinegoToast) window.cinegoToast.error('Vui lòng đăng nhập để lưu mã ưu đãi vào ví!');
      else alert('Vui lòng đăng nhập để lưu mã ưu đãi vào ví!');
    });
  }

  function handleManualSaveVoucher(e) {
    e.preventDefault();
    const code = document.getElementById('manualVoucherCode').value.trim();
    if (!code) return;
    saveVoucherToWallet(e.target.querySelector('button'), code);
    document.getElementById('manualVoucherCode').value = '';
  }
</script>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                fontFamily: {
                    'be-vietnam': ['"Be Vietnam Pro"', 'sans-serif'],
                },
                colors: {
                    "on-primary-fixed-variant": "#930007",
                    "primary-container": "#e50914",
                    "secondary": "#b02f00",
                    "primary": "#b8000b",
                    "surface": "#f8f9fa",
                    "surface-container": "#f3f4f6",
                    "surface-container-low": "#f9fafb",
                    "surface-container-lowest": "#ffffff",
                    "on-surface": "#111827",
                    "on-surface-variant": "#4b5563",
                    "outline-variant": "#e5e7eb"
                }
            }
        }
    }
</script>

<main class="min-h-screen bg-surface pb-20 font-be-vietnam">
    <section class="relative w-full h-[500px] lg:h-[600px] bg-black"> 
        
        <div class="absolute inset-0 overflow-hidden">
            <img src="<%= phim.posterUrl %>" alt="Background" class="w-full h-full object-cover opacity-30 blur-2xl scale-110" onerror="this.src='https://placehold.co/1200x600?text=CineGo'">
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/40 to-transparent"></div>
        </div>

        <div class="relative max-w-7xl mx-auto h-full px-4 sm:px-8 flex items-end pb-12">
            <div class="flex flex-col md:flex-row gap-8 lg:gap-12 items-end md:items-stretch translate-y-16 md:translate-y-24 z-20 w-full">
                
                <div class="w-56 md:w-72 shrink-0 rounded-2xl overflow-hidden shadow-2xl border-4 border-surface-container-lowest bg-surface-container mx-auto md:mx-0">
                    <img src="<%= phim.posterUrl %>" alt="<%= phim.title %>" class="w-full h-full object-cover aspect-[2/3]" onerror="this.src='https://placehold.co/400x600?text=CineGo'">
                </div>

                <div class="flex-1 text-center md:text-left space-y-4">
                    <div class="inline-flex items-center justify-center px-3 py-1 rounded bg-primary text-white font-black text-[11px] uppercase tracking-widest shadow-sm">
                        Phân loại: <%= phim.ageRating || 'P' %>
                    </div>
                    
                    <h1 class="text-4xl md:text-5xl font-extrabold text-on-surface tracking-tight leading-tight">
                        <%= phim.title %>
                    </h1>

                    <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 text-sm font-bold text-on-surface-variant">
                        <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-lg text-primary">schedule</span> <%= phim.duration %> Phút</span>
                        <span class="w-1.5 h-1.5 rounded-full bg-outline-variant/50 hidden md:block"></span>
                        <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-lg text-primary">movie</span> <%= phim.genre %></span>
                        <span class="w-1.5 h-1.5 rounded-full bg-outline-variant/50 hidden md:block"></span>
                        <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-lg text-primary">person</span> Đạo diễn: <%= phim.director || 'Đang cập nhật' %></span>
                    </div>

                    <div class="mt-2 text-sm font-bold text-on-surface-variant flex justify-center md:justify-start">
                        <span class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-lg text-primary">calendar_today</span> 
                            Khởi chiếu: <%= phim.releaseDate ? new Date(phim.releaseDate).toLocaleDateString('vi-VN') : 'Đang cập nhật' %>
                        </span>
                    </div>

                    <div class="pt-6 flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
                        <% if (phim.status === 'DangChieu') { %>
                            <a href="/dat-ve/<%= phim._id %>" class="px-10 py-4 bg-primary text-white font-bold text-sm rounded-xl shadow-lg shadow-primary/20 hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined">local_activity</span>
                                ĐẶT VÉ NGAY
                            </a>
                        <% } else { %>
                            <button class="px-10 py-4 bg-secondary text-white font-bold text-sm rounded-xl shadow-lg shadow-secondary/20 opacity-80 cursor-not-allowed flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined">hourglass_empty</span>
                                SẮP KHỞI CHIẾU
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-8 pt-24 md:pt-32">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            <div class="lg:col-span-2 space-y-8">
                <div class="bg-surface-container-lowest p-8 rounded-2xl shadow-sm border border-outline-variant/20">
                    <h3 class="text-xl font-bold text-on-surface mb-4 flex items-center gap-2 border-b border-outline-variant/20 pb-4">
                        <span class="material-symbols-outlined text-primary">subject</span>
                        Nội Dung Phim
                    </h3>
                    <p class="text-on-surface-variant leading-relaxed font-medium text-justify">
                        <%= phim.description || 'Chưa có thông tin mô tả chi tiết cho bộ phim này.' %>
                    </p>
                </div>
            </div>

            <div class="space-y-6">
                <div class="bg-surface-container-lowest p-6 rounded-2xl border border-outline-variant/20 shadow-sm">
                    <h4 class="font-bold text-on-surface mb-4 border-b border-outline-variant/20 pb-3">Thông tin bổ sung</h4>
                    <ul class="space-y-4">
                        <li>
                            <p class="text-[11px] font-bold text-on-surface-variant opacity-70 uppercase tracking-widest mb-1">Ngôn ngữ</p>
                            <p class="font-bold text-on-surface text-sm">Tiếng Việt - Phụ đề Tiếng Anh</p>
                        </li>
                        <li>
                            <p class="text-[11px] font-bold text-on-surface-variant opacity-70 uppercase tracking-widest mb-1">Định dạng</p>
                            <p class="font-bold text-on-surface text-sm">2D Digital, Âm thanh Dolby 7.1</p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/header') %>

<main class="min-h-screen">
    <section class="relative w-full h-[600px] bg-surface-container overflow-hidden">
        <div class="absolute inset-0">
            <img alt="Hero Banner" class="w-full h-full object-cover" src="https://media.lottecinemavn.com/Media/MovieFile/MovieImg/202605/12138_105_100006.jpg" />
            <div class="absolute inset-0 bg-gradient-to-r from-surface via-transparent to-transparent opacity-90"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-60"></div>
        </div>
        <div class="relative max-w-7xl mx-auto h-full flex flex-col justify-center px-8">
            <div class="max-w-2xl space-y-6">
                <span class="inline-block px-4 py-1 bg-red-600 text-white text-xs font-bold rounded-full uppercase tracking-widest">Phim nổi bật</span>
                <h1 class="text-6xl font-black text-on-surface leading-tight tracking-tighter">
                    DORAEMON <br /><span class="text-red-700">NOBITA VÀ LÂU ĐÀI DƯỚI ĐÁY BIỂN</span>
                </h1>
                <p class="text-lg text-slate-700 max-w-md font-medium">
                    Nhóm bạn thân khám phá vương quốc dưới đáy biển và đối mặt với lâu đài ma quỷ, với sự xuất hiện của xe lưỡng cư Mizunaka Buggy.
                </p>
                <div class="flex items-center space-x-4 pt-4">
                    <a href="/phim" class="px-8 py-4 bg-red-700 text-white font-bold rounded-xl shadow-lg shadow-red-200 hover:scale-105 active:scale-95 transition-all inline-block">
                        ĐẶT VÉ NGAY
                    </a>
                    <a href="https://www.youtube.com/results?search_query=Doraemon+Nobita+và+lâu+đài+dưới+đáy+biển+Trailer" target="_blank" class="p-4 bg-white text-red-700 rounded-xl border border-red-100 hover:bg-slate-50 transition-all flex items-center justify-center">
                        <span class="material-symbols-outlined align-middle mr-2" style="font-variation-settings: 'FILL' 1;">play_arrow</span> Xem Trailer
                    </a>
                </div>
            </div>
        </div>
    </section>
    
    <section class="relative -mt-8 z-10 px-8">
        <form action="/tim-kiem" method="GET" class="max-w-4xl mx-auto bg-white shadow-2xl shadow-slate-200/50 rounded-2xl p-2 flex items-center border border-slate-100">
            <div class="flex-1 flex items-center px-4">
                <span class="material-symbols-outlined text-red-700 mr-3">search</span>
                <input name="keyword" class="w-full bg-transparent border-none focus:ring-0 py-4 text-slate-800 placeholder:text-slate-400 font-medium outline-none" placeholder="Tìm kiếm phim, rạp hoặc ưu đãi..." type="text" />
            </div>
            <div class="h-10 w-[1px] bg-slate-100 mx-2"></div>
            <div class="flex items-center px-4 cursor-pointer hover:bg-slate-50 rounded-xl transition-colors">
                <span class="material-symbols-outlined text-slate-500 mr-2">location_on</span>
                <span class="text-sm font-semibold whitespace-nowrap text-slate-700">Bình Định</span>
            </div>
            <button type="submit" class="bg-red-700 text-white px-8 py-4 rounded-xl font-bold ml-2 hover:bg-red-800 transition-colors">TÌM KIẾM</button>
        </form>
    </section>
    
    <section class="py-20 px-8 max-w-7xl mx-auto">
        <div class="flex justify-between items-end mb-12">
            <div>
                <h2 class="text-3xl font-black text-slate-900 tracking-tight uppercase">Phim Đang Chiếu</h2>
                <div class="h-1.5 w-20 bg-red-700 mt-2 rounded-full"></div>
            </div>
            <a class="text-red-700 font-bold flex items-center hover:underline decoration-2 underline-offset-4" href="/phim">
                Xem tất cả <span class="material-symbols-outlined ml-1">chevron_right</span>
            </a>
        </div>
      
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            <% if (typeof movies !== 'undefined' && movies.length > 0) { %>
                <% movies.forEach(function(phim) { %>
                    <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-100 transition-all duration-300 flex flex-col group hover:shadow-xl hover:-translate-y-1">
                        <div class="relative aspect-[2/3] overflow-hidden">
                            <img alt="<%= phim.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="<%= phim.posterUrl %>" />
                            <div class="absolute top-4 left-4 bg-red-700 text-white text-[10px] font-black px-2 py-1 rounded shadow-md">
                                <%= phim.ageRating %>
                            </div>
                        </div>
                        <div class="p-5 flex flex-col flex-1">
                            <h3 class="text-lg font-bold text-slate-900 line-clamp-2 mb-2 group-hover:text-red-700 transition-colors">
                                <%= phim.title %>
                            </h3>
                            <div class="flex items-center text-slate-500 text-xs font-medium space-x-3 mb-6">
                                <span class="flex items-center"><span class="material-symbols-outlined text-sm mr-1">schedule</span> <%= phim.duration %> phút</span>
                                <span class="flex items-center"><span class="material-symbols-outlined text-sm mr-1">movie</span> <%= phim.genre %></span>
                            </div>
                            <div class="mt-auto flex gap-2">
                                <a href="/dat-ve/<%= phim._id %>" class="flex-1 py-3 bg-red-700 text-white text-xs font-bold rounded-lg hover:bg-red-800 transition-colors text-center inline-block shadow-md shadow-red-100">ĐẶT VÉ</a>
                                <a href="/chi-tiet-phim/<%= phim._id %>" class="px-4 py-3 bg-slate-100 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-200 transition-colors text-center inline-block">CHI TIẾT</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-full py-10 text-center">
                    <p class="text-slate-500 font-medium">Hiện chưa có phim nào đang chiếu. Vui lòng kiểm tra lại sau hoặc thêm từ Admin.</p>
                </div>
            <% } %>
        </div>
    </section>
    
    <section class="bg-slate-50 py-16 px-8">
        <div class="max-w-7xl mx-auto">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-3xl font-black text-slate-900 tracking-tight uppercase">Ưu Đãi Đặc Biệt</h2>
                <a href="/khuyen-mai" class="text-slate-500 font-bold text-sm uppercase tracking-widest hover:text-red-700 transition-colors">Xem thêm</a>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <% if (typeof vouchers !== 'undefined' && vouchers.length > 0) { %>
                    <% vouchers.forEach((v, index) => { %>
                        <div class="relative h-64 rounded-2xl overflow-hidden group shadow-lg">
                            <img alt="Promo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="<%= v.imageUrl || `https://placehold.co/600x400?text=CineGo+Voucher+${index + 1}` %>" />
                            <div class="absolute inset-0 <%= index % 2 === 0 ? 'bg-gradient-to-r from-black/80 to-transparent' : 'bg-gradient-to-r from-red-900/80 to-transparent' %> flex flex-col justify-center p-8">
                                <h4 class="text-2xl font-black text-white mb-2 leading-tight uppercase"><%= v.title %></h4>
                                <p class="text-slate-200 text-sm mb-4"><%= v.description %></p>
                                <div class="flex items-center gap-3">
                                    <span class="font-mono font-bold text-yellow-300 border border-yellow-300 px-3 py-1 rounded border-dashed uppercase tracking-widest"><%= v.code %></span>
                                    <a href="/khuyen-mai" class="w-fit px-6 py-2 bg-white text-red-700 font-bold rounded-full text-xs hover:bg-slate-100 transition-colors">CHI TIẾT</a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full py-12 text-center bg-white rounded-2xl border border-slate-100 shadow-sm flex flex-col items-center justify-center">
                        <span class="material-symbols-outlined text-6xl text-slate-200 mb-4 block">local_activity</span>
                        <h4 class="text-xl font-black text-slate-700 mb-2 uppercase tracking-tight">Hiện chưa có ưu đãi nào</h4>
                        <p class="text-slate-500 text-sm font-medium">Các chương trình khuyến mãi hấp dẫn sẽ sớm được cập nhật. Bạn nhớ quay lại nhé!</p>
                    </div>
                <% } %>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/header') %>

<main class="min-h-screen flex items-center justify-center bg-surface-container-low py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="max-w-md w-full bg-surface-container-lowest p-8 rounded-3xl shadow-xl border border-outline-variant/20 relative z-10">
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 text-primary">
                <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">lock_reset</span>
            </div>
            <h2 class="text-3xl font-black text-on-surface tracking-tight">QUÊN MẬT KHẨU?</h2>
            <p class="text-sm text-on-surface-variant mt-2 font-medium">Nhập email của bạn để nhận liên kết đặt lại mật khẩu.</p>
        </div>
        
<form action="/quen-mat-khau" method="POST" class="space-y-6">
    </form>
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-2">Email xác thực</label>
                <input type="email" name="email" required placeholder="Nhập email đã đăng ký..." 
                       class="w-full px-4 py-3 rounded-xl border-slate-300 focus:ring-primary focus:border-primary transition-colors bg-surface/50">
            </div>
            
            <button type="button" class="w-full py-4 bg-slate-800 text-white font-bold rounded-xl shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all">
                GỬI YÊU CẦU
            </button>
        </form>
        
        <p class="mt-8 text-center text-sm text-slate-600 font-medium">
            Nhớ ra mật khẩu rồi? <a href="/dang-nhap" class="font-bold text-primary hover:underline underline-offset-4 decoration-2">Quay lại đăng nhập</a>
        </p>
    </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/admin-header') %>

<main class="p-6 sm:p-10 space-y-8 max-w-7xl">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-[#E5E0D5]">
    <div>
      <span class="archival-index">CẤU HÌNH PHÒNG CHIẾU</span>
      <h1 class="editorial-headline text-3xl font-bold mt-1">Thiết Kế Sơ Đồ Ghế Ngồi</h1>
      <p class="text-xs text-[#7A7E8B] mt-0.5 font-light">Xây dựng ma trận ghế, phân bổ ghế Thường, VIP, Sweetbox và định giá vé.</p>
    </div>
  </div>

  <div class="bg-white border border-[#E5E0D5] p-6 sm:p-8 space-y-6 shadow-sm">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 bg-[#FAF8F5] p-4 border border-[#E5E0D5] text-xs font-['Plus_Jakarta_Sans']">
      <div>
        <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase mb-1">Chọn Rạp</label>
        <select class="w-full bg-white border border-[#E5E0D5] p-2 text-xs font-bold text-[#121316]">
          <option>CGV Kim Cúc Plaza - Cinema 1 (IMAX)</option>
          <option>Starlight Nguyễn Kim - Phòng 1</option>
          <option>Dcine Phú Tài Center - Hall A</option>
        </select>
      </div>

      <div>
        <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase mb-1">Số hàng ghế</label>
        <input type="number" id="cfgRows" value="6" class="w-full bg-white border border-[#E5E0D5] p-2 text-xs font-['JetBrains_Mono'] font-bold text-[#121316]" />
      </div>

      <div>
        <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase mb-1">Số ghế mỗi hàng</label>
        <input type="number" id="cfgCols" value="10" class="w-full bg-white border border-[#E5E0D5] p-2 text-xs font-['JetBrains_Mono'] font-bold text-[#121316]" />
      </div>

      <div>
        <label class="block font-['JetBrains_Mono'] text-[10px] font-bold text-[#7A7E8B] uppercase mb-1">Công cụ phân loại</label>
        <select id="cfgBrush" class="w-full bg-white border border-[#E5E0D5] p-2 text-xs font-bold text-[#121316]">
          <option value="standard">Ghế Thường (Trắng - 75K)</option>
          <option value="vip">Ghế VIP (Viền Vàng - 95K)</option>
          <option value="couple">Ghế Đôi Sweetbox (170K)</option>
          <option value="empty">Lối Đi / Trống</option>
        </select>
      </div>
    </div>

    <!-- Designer Display Canvas -->
    <div class="bg-[#0E1015] border border-white/10 p-8 text-center shadow-lg">
      <div class="cinema-screen-arc"></div>

      <div class="min-w-[500px] max-w-xl mx-auto space-y-3 mt-8">
        <% const rows = ['A', 'B', 'C', 'D', 'E', 'F']; %>
        <% rows.forEach((r, rIdx) => { %>
          <div class="flex items-center justify-center gap-2">
            <span class="w-6 font-['JetBrains_Mono'] text-xs text-white/50"><%= r %></span>
            <% for (let c = 1; c <= 10; c++) { %>
              <div class="seat-unit seat-free <%= rIdx >= 3 && rIdx <= 4 ? 'is-vip' : '' %>" onclick="toggleSeatType(this)">
                <%= r %><%= c %>
              </div>
            <% } %>
            <span class="w-6 font-['JetBrains_Mono'] text-xs text-white/50"><%= r %></span>
          </div>
        <% }); %>
      </div>

      <div class="mt-8 pt-6 border-t border-white/10 flex items-center justify-center gap-6 font-['JetBrains_Mono'] text-xs text-white/70">
        <span>Trắng: Standard</span>
        <span>•</span>
        <span class="text-[#D97706]">Viền Vàng: VIP</span>
        <span>•</span>
        <span class="text-[#EC4899]">F: Sweetbox đôi</span>
      </div>
    </div>

    <div class="flex justify-end gap-3 font-['JetBrains_Mono']">
      <button type="button" onclick="alert('Đã lưu cấu hình sơ đồ phòng chiếu thành công!')" class="btn-editorial-primary text-xs !py-3 !px-8">
        LƯU CẤU HÌNH SƠ ĐỒ GHẾ →
      </button>
    </div>
  </div>

</main>

<script>
  function toggleSeatType(el) {
    const brush = document.getElementById('cfgBrush').value;
    if (brush === 'vip') {
      el.classList.add('is-vip');
    } else if (brush === 'standard') {
      el.classList.remove('is-vip');
    } else if (brush === 'empty') {
      el.style.visibility = el.style.visibility === 'hidden' ? 'visible' : 'hidden';
    }
  }
</script>

<%- include('partials/admin-footer') %>

<%- include('partials/admin-header') %>

<main class="p-6 sm:p-10 space-y-8 max-w-7xl">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-[#E5E0D5]">
    <div>
      <span class="archival-index">HẠ TẦNG PHÒNG CHIẾU</span>
      <h1 class="editorial-headline text-3xl font-bold mt-1">Quản Lý 3 Cụm Rạp Quy Nhơn</h1>
      <p class="text-xs text-[#7A7E8B] mt-0.5 font-light">Giám sát công suất phòng chiếu, tỷ lệ lấp đầy ghế và cấu hình sơ đồ phòng.</p>
    </div>

    <button type="button" onclick="alert('Tính năng thiết kế sơ đồ phòng chiếu đang mở ở chế độ cấu hình.');" class="btn-editorial-primary text-xs !py-3 !px-5 flex items-center gap-2">
      <span class="material-symbols-outlined text-base">grid_view</span>
      <span>Thiết Kế Sơ Đồ Ghế</span>
    </button>
  </div>

  <!-- 3 CINEMAS OVERVIEW TILES -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% if (typeof cinemas !== 'undefined' && cinemas.length > 0) { %>
      <% cinemas.forEach((cinema, idx) => { %>
        <div class="bg-white border border-[#E5E0D5] p-6 flex flex-col justify-between space-y-4 hover:border-[#121316] transition-all">
          <div>
            <div class="flex justify-between items-start mb-3">
              <div>
                <span class="text-[10px] font-['JetBrains_Mono'] text-[#7A7E8B] uppercase">CỤM RẠP 0<%= idx+1 %></span>
                <h3 class="font-['Georgia'] text-lg font-bold text-[#121316] mt-0.5"><%= cinema.name %></h3>
                <p class="text-[11px] text-[#7A7E8B] mt-0.5"><%= cinema.location || 'TP. Quy Nhơn' %></p>
              </div>
              <span class="px-2 py-0.5 font-['JetBrains_Mono'] text-[10px] font-bold uppercase <%= cinema.occupancyRate >= 70 ? 'bg-[#F9EBEA] text-[#BA2D27] border border-[#BA2D27]/30' : 'bg-[#E8F8F0] text-[#10B981] border border-[#10B981]/30' %>">
                <%= cinema.occupancyRate >= 70 ? 'ĐÔNG KHÁCH' : 'SẴN SÀNG' %>
              </span>
            </div>

            <!-- Stats -->
            <div class="space-y-2.5 pt-2 text-xs font-['JetBrains_Mono']">
              <div class="flex justify-between">
                <span class="text-[#7A7E8B]">Tổng ghế phòng:</span>
                <strong class="text-[#121316]"><%= cinema.totalSeats || 50 %> ghế</strong>
              </div>
              <div class="flex justify-between">
                <span class="text-[#7A7E8B]">Đã bán:</span>
                <strong class="text-[#BA2D27]"><%= cinema.occupiedSeats || 0 %> ghế</strong>
              </div>
              <div class="flex justify-between">
                <span class="text-[#7A7E8B]">Còn trống:</span>
                <strong class="text-[#10B981]"><%= cinema.emptySeats || (cinema.totalSeats || 50) %> ghế</strong>
              </div>
              <div class="flex justify-between">
                <span class="text-[#7A7E8B]">Tỷ lệ lấp đầy:</span>
                <strong class="text-[#121316]"><%= (cinema.occupancyRate || 0).toFixed(1) %>%</strong>
              </div>

              <!-- Bar -->
              <div class="w-full h-1.5 bg-[#FAF8F5] border border-[#E5E0D5] mt-2">
                <div class="h-full bg-[#BA2D27]" style="width: <%= Math.min(100, cinema.occupancyRate || 0) %>%;"></div>
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-[#E5E0D5] flex gap-2">
            <button type="button" onclick="viewCinemaSeatLayout('<%= cinema.name %>', <%= cinema.bookedSeats || '[]' %>)" class="btn-editorial-primary text-xs w-full text-center !py-2">
              Xem Sơ Đồ Ghế
            </button>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Sơ đồ ghế Modal -->
  <div id="seatLayoutModal" class="hidden fixed inset-0 z-50 bg-[#121316]/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white border border-[#121316] w-full max-w-2xl p-6 sm:p-8 space-y-6 shadow-2xl relative">
      <button type="button" onclick="closeSeatLayoutModal()" class="absolute top-4 right-4 text-[#7A7E8B] hover:text-[#121316]">
        <span class="material-symbols-outlined text-2xl">close</span>
      </button>

      <div class="border-b border-[#E5E0D5] pb-4">
        <span class="archival-index">GIÁM SÁT TRỰC QUAN SƠ ĐỒ GHẾ</span>
        <h3 class="font-['Georgia'] text-xl font-bold text-[#121316] mt-1" id="modalCinemaName">CGV Kim Cúc</h3>
      </div>

      <div class="p-6 bg-[#0E1015] border border-white/10 text-center">
        <div class="cinema-screen-arc"></div>
        <div class="grid grid-cols-10 gap-2 max-w-md mx-auto pt-6" id="modalSeatsGrid">
          <!-- 50 seats dynamically populated -->
        </div>
        <div class="mt-8 flex items-center justify-center gap-6 text-[10px] font-['JetBrains_Mono'] text-white/70">
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 bg-white inline-block"></span> Trống</span>
          <span class="flex items-center gap-1.5"><span class="w-3 h-3 bg-[#64748B] inline-block"></span> Đã bán</span>
        </div>
      </div>
    </div>
  </div>

</main>

<script>
  function viewCinemaSeatLayout(cinemaName, bookedSeats) {
    document.getElementById('modalCinemaName').innerText = cinemaName;
    const grid = document.getElementById('modalSeatsGrid');
    grid.innerHTML = '';

    const rows = ['A', 'B', 'C', 'D', 'E'];
    rows.forEach(r => {
      for (let i = 1; i <= 10; i++) {
        const code = r + i;
        const isBooked = bookedSeats && bookedSeats.includes(code);
        const div = document.createElement('div');
        div.className = `w-7 h-7 flex items-center justify-center font-['JetBrains_Mono'] text-[9px] font-bold ${
          isBooked ? 'bg-[#64748B] text-white' : 'bg-white text-[#121316]'
        }`;
        div.innerText = code;
        grid.appendChild(div);
      }
    });

    document.getElementById('seatLayoutModal').classList.remove('hidden');
  }

  function closeSeatLayoutModal() {
    document.getElementById('seatLayoutModal').classList.add('hidden');
  }
</script>

<%- include('partials/admin-footer') %>

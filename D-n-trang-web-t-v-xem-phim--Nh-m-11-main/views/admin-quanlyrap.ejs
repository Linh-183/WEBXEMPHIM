<%- include('partials/admin-header') %>

<div class="p-6 flex-1 bg-[#f4f7f6] min-h-screen">
    <div class="flex justify-between items-center mb-8 border-b border-slate-200 pb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Quản lý Rạp chiếu</h1>
            <p class="text-slate-500 text-xs mt-1">Dữ liệu hệ thống 50 ghế / rạp</p>
        </div>
        <button class="bg-[#b8000b] text-white px-5 py-2 rounded-lg font-bold text-xs uppercase tracking-wider">
            Cấu hình rạp
        </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% if (typeof cinemas !== 'undefined' && cinemas.length > 0) { %>
            <% cinemas.forEach((cinema) => { %>
                <div class="bg-white border border-slate-200 rounded-xl overflow-hidden flex flex-col">
                    
                    <div class="p-6 flex-1">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-lg font-bold text-slate-800"><%= cinema.name %></h3>
                            <span class="text-[9px] font-bold px-2 py-1 rounded border <%= cinema.isFull ? 'bg-red-50 text-red-700 border-red-200' : 'bg-green-50 text-green-700 border-green-200' %>">
                                <%= cinema.isFull ? 'HẾT CHỖ' : 'SẴN SÀNG' %>
                            </span>
                        </div>

                        <div class="space-y-3">
                            <div class="flex justify-between text-xs">
                                <span class="text-slate-500">Đã lấp đầy:</span>
                                <span class="font-bold text-slate-800"><%= cinema.occupiedSeats %> ghế</span>
                            </div>
                            <div class="flex justify-between text-xs">
                                <span class="text-slate-500">Còn trống:</span>
                                <span class="font-bold text-[#b8000b]"><%= cinema.emptySeats %> ghế</span>
                            </div>
                            
                            <div class="w-full h-1.5 bg-slate-100 rounded-full mt-4">
                                <div class="h-full rounded-full <%= cinema.isFull ? 'bg-red-600' : 'bg-[#0f172a]' %>"
                                     style="width: <%= cinema.occupancyRate %>%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex gap-2">
                        <button onclick="openCinemaDetail('<%= cinema.name %>', 50, <%= cinema.bookedSeats %>)" 
                                class="flex-1 bg-[#0f172a] text-white py-2 rounded font-bold text-[10px] uppercase tracking-wider">
                            Xem sơ đồ ghế
                        </button>
                        <button class="px-3 py-2 border border-slate-200 rounded text-slate-400 hover:text-red-600">
                            <span class="material-symbols-outlined text-sm">delete</span>
                        </button>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>

<div id="detailModal" class="fixed inset-0 z-[100] flex items-center justify-center hidden">
    <div class="absolute inset-0 bg-slate-900/60" onclick="closeModal()"></div>
    
    <div class="bg-white rounded-xl z-10 w-full max-w-lg p-8 relative">
        <div class="flex justify-between items-center mb-6">
            <h2 id="modalName" class="text-xl font-bold text-slate-800">Tên rạp</h2>
            <button onclick="closeModal()" class="text-slate-400 hover:text-black">&times;</button>
        </div>

        <div class="w-full h-1 bg-slate-200 rounded mb-8"></div> <div id="seatContainer" class="grid grid-cols-10 gap-2 mb-8">
            </div>

        <div class="flex items-center justify-between border-t border-slate-100 pt-6">
            <div class="flex gap-4 text-[10px] font-bold text-slate-400 uppercase">
                <div class="flex items-center gap-1"><div class="w-3 h-3 bg-slate-100 border border-slate-200"></div> Trống</div>
                <div class="flex items-center gap-1"><div class="w-3 h-3 bg-[#0f172a]"></div> Đã đặt</div>
            </div>
            <button onclick="closeModal()" class="px-6 py-2 bg-slate-800 text-white rounded font-bold text-[10px] uppercase">Đóng</button>
        </div>
    </div>
</div>

<script>
    function openCinemaDetail(name, totalSeats, bookedSeatsArray) {
        document.getElementById('modalName').innerText = "Sơ đồ: " + name;
        const container = document.getElementById('seatContainer');
        container.innerHTML = '';
        const rows = ['A', 'B', 'C', 'D', 'E'];

        rows.forEach(row => {
            for (let i = 1; i <= 10; i++) {
                const seatId = row + i;
                const isBooked = bookedSeatsArray.includes(seatId);

                const seatDiv = document.createElement('div');
                seatDiv.className = `aspect-square rounded flex items-center justify-center text-[8px] font-bold ${
                    isBooked 
                    ? 'bg-[#0f172a] text-white' 
                    : 'bg-slate-50 border border-slate-200 text-slate-400'
                }`;
                seatDiv.innerText = seatId;
                container.appendChild(seatDiv);
            }
        });
        document.getElementById('detailModal').classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('detailModal').classList.add('hidden');
    }
</script>
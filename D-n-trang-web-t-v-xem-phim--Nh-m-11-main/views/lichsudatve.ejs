<%- include('partials/header') %>

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                colors: {
                    "on-primary-fixed-variant": "#930007",
                    "primary-container": "#e50914",
                    "secondary": "#b02f00",
                    "primary": "#b8000b",
                    "surface": "#f8f9fa",
                    "surface-container": "#f3f4f6",
                    "surface-container-low": "#f9fafb",
                    "surface-container-lowest": "#ffffff",
                    "on-surface": "#111827",
                    "on-surface-variant": "#4b5563",
                    "outline-variant": "#e5e7eb"
                }
            }
        }
    }
</script>

<main class="bg-surface min-h-screen py-10 font-['Be_Vietnam_Pro']">
    <div class="max-w-5xl mx-auto px-4 sm:px-8">
        
        <div class="mb-10">
            <h1 class="text-4xl font-extrabold text-on-surface tracking-tight mb-2">Vé của tôi</h1>
            <p class="text-on-surface-variant opacity-70">Xem lại lịch sử những siêu phẩm bạn đã thưởng thức tại CineGo.</p>
        </div>

        <div class="flex gap-4 mb-8 overflow-x-auto pb-2" id="filter-buttons">
            <button onclick="filterTickets('all', this)" class="filter-btn px-6 py-2 rounded-full bg-primary text-white font-semibold text-sm shadow-md transition-all">Tất cả</button>
            <button onclick="filterTickets('upcoming', this)" class="filter-btn px-6 py-2 rounded-full bg-surface-container-lowest text-on-surface-variant border border-outline-variant/20 font-medium text-sm hover:bg-surface-container-low transition-all">Sắp tới</button>
            <button onclick="filterTickets('past', this)" class="filter-btn px-6 py-2 rounded-full bg-surface-container-lowest text-on-surface-variant border border-outline-variant/20 font-medium text-sm hover:bg-surface-container-low transition-all">Đã xem</button>
        </div>

        <div class="space-y-6" id="tickets-container">
            <% if (typeof tickets !== 'undefined' && tickets.length > 0) { %>
                <% 
                   const today = new Date(); 
                   today.setHours(0,0,0,0); 
                %>
                <% tickets.forEach(ticket => { %>
                    <% 
                       // Logic kiểm tra để hiện nút xóa
                       const isOldMovie = new Date(ticket.showDate) <= today;
                       const isDeletedMovie = !ticket.movie;
                       const canDelete = isOldMovie || isDeletedMovie;
                       
                       // Phân loại vé: Nếu qua ngày rồi thì là 'past' (Đã xem), ngược lại là 'upcoming' (Sắp tới)
                       const ticketType = isOldMovie ? 'past' : 'upcoming';
                    %>
                    <div class="ticket-card group bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/20 overflow-hidden flex flex-col md:flex-row relative hover:shadow-md transition-all" data-type="<%= ticketType %>">
                        
                        <% if (canDelete) { %>
                            <form action="/tai-khoan/ve-cua-toi/xoa/<%= ticket._id %>" method="POST" 
                                  onsubmit="return confirm('Bạn có chắc muốn xóa lịch sử vé này?')"
                                  class="absolute top-4 right-4 z-10">
                                <button type="submit" class="w-8 h-8 flex items-center justify-center bg-red-50 text-red-600 rounded-full hover:bg-red-600 hover:text-white transition-all shadow-sm">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </button>
                            </form>
                        <% } %>

                        <div class="w-28 md:w-36 shrink-0 overflow-hidden relative border-r border-outline-variant/10 hidden sm:block">
                            <img class="w-full h-full object-cover aspect-[2/3] group-hover:scale-105 transition-transform duration-500" 
                                 src="<%= ticket.movie ? ticket.movie.posterUrl : 'https://placehold.co/400x600?text=Phim+da+xoa' %>" 
                                 alt="Poster"/>
                            <div class="absolute top-2 left-2 px-2 py-0.5 bg-primary text-white text-[10px] font-black rounded uppercase">
                                <%= ticket.movie ? ticket.movie.ageRating : 'N/A' %>
                            </div>
                        </div>
                        
                        <div class="flex-grow p-6 md:p-8 flex flex-col justify-between border-r border-dashed border-outline-variant/30 relative">
                            <div class="absolute w-5 h-5 bg-surface rounded-full -right-[10px] top-1/2 -translate-y-1/2 hidden md:block border border-outline-variant/10"></div>
                            
                            <div>
                                <div class="flex justify-between items-start mb-2">
                                    <h2 class="text-xl md:text-2xl font-black text-on-surface leading-tight">
                                        <%= ticket.movie ? ticket.movie.title : 'Phim đã bị xóa khỏi hệ thống' %>
                                    </h2>
                                    <span class="px-3 py-1 <%= isOldMovie ? 'bg-slate-100 text-slate-600' : 'bg-green-100 text-green-700' %> text-xs font-bold rounded-full uppercase">
                                        <%= isOldMovie ? 'Đã xem' : 'Thành công' %>
                                    </span>
                                </div>
                                
                                <p class="text-primary font-extrabold mb-6 uppercase tracking-tight">
                                    <%= ticket.cinema %> - <%= ticket.room || 'Phòng chiếu Standard' %>
                                </p>
                                
                                <div class="grid grid-cols-2 gap-y-4 gap-x-8">
                                    <div>
                                        <p class="text-[10px] uppercase tracking-widest text-on-surface-variant font-black mb-1 opacity-50">Ngày chiếu</p>
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-outlined text-lg text-primary">calendar_today</span>
                                            <span class="font-bold text-sm text-on-surface"><%= ticket.showDate %></span>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-[10px] uppercase tracking-widest text-on-surface-variant font-black mb-1 opacity-50">Giờ chiếu</p>
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-outlined text-lg text-primary">schedule</span>
                                            <span class="font-bold text-sm text-on-surface"><%= ticket.showTime %></span>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-[10px] uppercase tracking-widest text-on-surface-variant font-black mb-1 opacity-50">Ghế ngồi</p>
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-outlined text-lg text-primary">event_seat</span>
                                            <span class="font-bold text-sm text-on-surface"><%= ticket.seats.join(', ') %></span>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-[10px] uppercase tracking-widest text-on-surface-variant font-black mb-1 opacity-50">Tổng tiền</p>
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-outlined text-lg text-primary">payments</span>
                                            <span class="font-black text-sm text-on-surface"><%= ticket.totalPrice.toLocaleString('vi-VN') %> đ</span>
                                        </div>
                                    </div>
                                </div>

                                <% if(ticket.comboDetails && ticket.comboDetails !== "") { %>
                                    <div class="mt-4 pt-3 border-t border-outline-variant/10">
                                        <p class="text-[10px] uppercase tracking-widest text-on-surface-variant font-black mb-1 opacity-50">Bắp nước đã đặt</p>
                                        <div class="flex items-center gap-2">
                                            <span class="material-symbols-outlined text-lg text-orange-500">fastfood</span>
                                            <span class="text-xs font-bold text-on-surface-variant"><%= ticket.comboDetails %></span>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                        
                        <div class="w-full md:w-56 p-8 bg-surface-container-low flex flex-col items-center justify-center relative shrink-0">
                            <div class="absolute w-5 h-5 bg-surface rounded-full -left-[10px] top-1/2 -translate-y-1/2 hidden md:block border border-outline-variant/10"></div>
                            
                            <div class="bg-white p-3 rounded-2xl shadow-sm mb-4 border border-outline-variant/20">
                                <img class="w-28 h-28 opacity-90" src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= ticket._id %>" alt="QR Code"/>
                            </div>
                            <p class="text-[10px] uppercase tracking-widest text-on-surface-variant font-black mb-1 opacity-50">Mã đặt vé</p>
                            <p class="font-mono font-black text-lg text-on-surface"><%= ticket._id.toString().slice(-8).toUpperCase() %></p>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="text-center py-20 bg-surface-container-lowest rounded-3xl border border-outline-variant/10 shadow-sm">
                    <span class="material-symbols-outlined text-6xl text-outline-variant mb-4">confirmation_number</span>
                    <h3 class="text-xl font-bold text-on-surface">Bạn chưa có vé nào</h3>
                    <p class="text-on-surface-variant mt-2 mb-6">Hãy khám phá những bộ phim hot nhất đang chiếu!</p>
                    <a href="/phim" class="inline-block px-8 py-3 bg-primary text-white font-bold rounded-xl shadow-lg shadow-primary/20 hover:scale-[1.05] transition-all">
                        ĐẶT VÉ NGAY
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</main>

<script>
    function filterTickets(type, btn) {
        // 1. Reset màu các nút về trạng thái xám, sau đó tô đỏ nút được bấm
        const buttons = document.querySelectorAll('.filter-btn');
        const defaultClass = "filter-btn px-6 py-2 rounded-full bg-surface-container-lowest text-on-surface-variant border border-outline-variant/20 font-medium text-sm hover:bg-surface-container-low transition-all";
        const activeClass = "filter-btn px-6 py-2 rounded-full bg-primary text-white font-semibold text-sm shadow-md transition-all";
        
        buttons.forEach(b => b.className = defaultClass);
        btn.className = activeClass;

        // 2. Ẩn/Hiện thẻ vé dựa trên data-type
        const tickets = document.querySelectorAll('.ticket-card');
        tickets.forEach(ticket => {
            if (type === 'all' || ticket.getAttribute('data-type') === type) {
                ticket.style.display = 'flex'; // Hiển thị
            } else {
                ticket.style.display = 'none'; // Ẩn đi
            }
        });
    }
</script>

<%- include('partials/footer') %>
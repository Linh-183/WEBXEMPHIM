<%- include('partials/admin-header') %>

<main class="p-6 sm:p-10 space-y-8 max-w-7xl">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-[#E5E0D5]">
    <div>
      <span class="archival-index">DỊCH VỤ ẨM THỰC RẠP</span>
      <h1 class="editorial-headline text-3xl font-bold mt-1">Quản Lý Combo Bắp Nước F&B</h1>
      <p class="text-xs text-[#7A7E8B] mt-0.5 font-light">Danh mục bắp rang bơ, nước giải khát và đồ ăn vặt phục vụ tại 3 rạp Quy Nhơn.</p>
    </div>

    <button type="button" onclick="openAddComboModal()" class="btn-editorial-primary text-xs !py-3 !px-5 flex items-center gap-2">
      <span class="material-symbols-outlined text-base">add</span>
      <span>Thêm Combo Mới</span>
    </button>
  </div>

  <!-- Grid of Combos -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <% if (typeof combos !== 'undefined' && combos && combos.length > 0) { %>
      <% combos.forEach(function(item) { %>
        <div class="bg-white border border-[#E5E0D5] p-5 flex flex-col justify-between space-y-3 hover:border-[#121316] transition-all">
          <div>
            <div class="relative aspect-video w-full border border-[#E5E0D5] overflow-hidden bg-[#FAF8F5] mb-3">
              <img src="<%= item.imageUrl || 'https://images.unsplash.com/photo-1585647347483-22b66260dfff?auto=format&fit=crop&w=400&q=80' %>" class="w-full h-full object-cover" alt="<%= item.name %>" />
              <% if (item.badge) { %>
                <span class="absolute top-2 left-2 px-2 py-0.5 bg-[#BA2D27] text-white font-['JetBrains_Mono'] text-[9px] font-bold uppercase">
                  <%= item.badge %>
                </span>
              <% } %>
            </div>
            <div class="flex items-center justify-between mb-1">
              <h3 class="font-bold text-sm text-[#121316] line-clamp-1"><%= item.name %></h3>
              <span class="font-['JetBrains_Mono'] text-xs font-bold text-[#BA2D27]">
                <%= (item.price || 0).toLocaleString('vi-VN') %> đ
              </span>
            </div>
            <p class="text-xs text-[#7A7E8B] leading-relaxed line-clamp-2"><%= item.description %></p>
            <div class="mt-2 text-[10px] font-['JetBrains_Mono'] text-[#A6AAB6]">
              Phân loại: <strong class="text-[#121316] uppercase"><%= item.category || 'combo' %></strong>
            </div>
          </div>
          <div class="pt-3 border-t border-[#E5E0D5] flex gap-2 font-['JetBrains_Mono']">
            <button type="button" 
                    onclick='openEditComboModal(<%- JSON.stringify(item) %>)' 
                    class="btn-editorial-secondary flex-1 text-xs !py-1.5">Sửa</button>
            <form action="/admin/combo/xoa/<%= item._id %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa combo này?')">
              <button type="submit" class="btn-editorial-secondary px-3 text-xs !py-1.5 text-[#BA2D27] hover:bg-[#FFF2F1]">Xóa</button>
            </form>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-span-full py-12 text-center bg-white border border-[#E5E0D5] text-xs font-['JetBrains_Mono'] text-[#7A7E8B]">
        Chưa có sản phẩm combo nào. Hãy bấm "Thêm Combo Mới" để tạo món đầu tiên.
      </div>
    <% } %>
  </div>

  <!-- MODAL: THÊM COMBO MỚI -->
  <div id="addComboModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white border border-[#E5E0D5] w-full max-w-lg p-6 sm:p-8 space-y-6 shadow-2xl relative">
      <div class="flex justify-between items-center pb-4 border-b border-[#E5E0D5]">
        <div>
          <span class="archival-index">F&B CINEGO</span>
          <h2 class="editorial-headline text-xl font-bold">Thêm Món / Combo Mới</h2>
        </div>
        <button type="button" onclick="closeAddComboModal()" class="text-[#7A7E8B] hover:text-[#121316]">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <form action="/admin/combo/them" method="POST" class="space-y-4 text-xs font-['Plus_Jakarta_Sans']">
        <div>
          <label class="block font-bold mb-1 text-[#121316]">Tên Món / Combo *</label>
          <input type="text" name="name" required placeholder="Ví dụ: Combo Cine Solo" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none focus:border-[#121316]" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-bold mb-1 text-[#121316]">Phân Loại *</label>
            <select name="category" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none">
              <option value="combo">Combo Tiết Kiệm</option>
              <option value="popcorn">Bắp Rang Nóng</option>
              <option value="drink">Nước Giải Khát</option>
              <option value="snack">Snack & Đồ Ăn</option>
            </select>
          </div>
          <div>
            <label class="block font-bold mb-1 text-[#121316]">Giá Bán (VNĐ) *</label>
            <input type="number" name="price" required placeholder="75000" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-bold mb-1 text-[#121316]">Giá Gốc (nếu có giảm)</label>
            <input type="number" name="originalPrice" placeholder="90000" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
          </div>
          <div>
            <label class="block font-bold mb-1 text-[#121316]">Huy Hiệu (Badge)</label>
            <input type="text" name="badge" placeholder="BÁN CHẠY / TIẾT KIỆM" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none focus:border-[#121316]" />
          </div>
        </div>

        <div>
          <label class="block font-bold mb-1 text-[#121316]">Link Hình Ảnh (URL)</label>
          <input type="url" name="imageUrl" placeholder="https://..." class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none focus:border-[#121316]" />
        </div>

        <div>
          <label class="block font-bold mb-1 text-[#121316]">Các Vị / Tùy Chọn (cách nhau dấu phẩy)</label>
          <input type="text" name="flavors" placeholder="Bơ truyền thống, Phô mai, Caramel" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none focus:border-[#121316]" />
        </div>

        <div>
          <label class="block font-bold mb-1 text-[#121316]">Mô Tả Chi Tiết</label>
          <textarea name="description" rows="2" placeholder="1 Bắp ngọt 64oz + 1 Nước ngọt có ga lớn 32oz..." class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none focus:border-[#121316]"></textarea>
        </div>

        <div class="pt-4 border-t border-[#E5E0D5] flex justify-end gap-3 font-['JetBrains_Mono']">
          <button type="button" onclick="closeAddComboModal()" class="btn-editorial-secondary px-4 py-2">Hủy</button>
          <button type="submit" class="btn-editorial-primary px-5 py-2">Lưu Combo</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: SỬA COMBO -->
  <div id="editComboModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white border border-[#E5E0D5] w-full max-w-lg p-6 sm:p-8 space-y-6 shadow-2xl relative">
      <div class="flex justify-between items-center pb-4 border-b border-[#E5E0D5]">
        <div>
          <span class="archival-index">F&B CINEGO</span>
          <h2 class="editorial-headline text-xl font-bold">Chỉnh Sửa Combo</h2>
        </div>
        <button type="button" onclick="closeEditComboModal()" class="text-[#7A7E8B] hover:text-[#121316]">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <form id="editComboForm" method="POST" class="space-y-4 text-xs font-['Plus_Jakarta_Sans']">
        <div>
          <label class="block font-bold mb-1 text-[#121316]">Tên Món / Combo *</label>
          <input type="text" id="edit_name" name="name" required class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none focus:border-[#121316]" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-bold mb-1 text-[#121316]">Phân Loại *</label>
            <select id="edit_category" name="category" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none">
              <option value="combo">Combo Tiết Kiệm</option>
              <option value="popcorn">Bắp Rang Nóng</option>
              <option value="drink">Nước Giải Khát</option>
              <option value="snack">Snack & Đồ Ăn</option>
            </select>
          </div>
          <div>
            <label class="block font-bold mb-1 text-[#121316]">Giá Bán (VNĐ) *</label>
            <input type="number" id="edit_price" name="price" required class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-bold mb-1 text-[#121316]">Giá Gốc</label>
            <input type="number" id="edit_originalPrice" name="originalPrice" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 font-['JetBrains_Mono'] focus:outline-none focus:border-[#121316]" />
          </div>
          <div>
            <label class="block font-bold mb-1 text-[#121316]">Huy Hiệu (Badge)</label>
            <input type="text" id="edit_badge" name="badge" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none focus:border-[#121316]" />
          </div>
        </div>

        <div>
          <label class="block font-bold mb-1 text-[#121316]">Link Hình Ảnh (URL)</label>
          <input type="url" id="edit_imageUrl" name="imageUrl" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none focus:border-[#121316]" />
        </div>

        <div>
          <label class="block font-bold mb-1 text-[#121316]">Các Vị / Tùy Chọn (cách nhau dấu phẩy)</label>
          <input type="text" id="edit_flavors" name="flavors" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none focus:border-[#121316]" />
        </div>

        <div>
          <label class="block font-bold mb-1 text-[#121316]">Mô Tả Chi Tiết</label>
          <textarea id="edit_description" name="description" rows="2" class="w-full bg-[#FAF8F5] border border-[#E5E0D5] px-3 py-2 focus:outline-none focus:border-[#121316]"></textarea>
        </div>

        <div class="pt-4 border-t border-[#E5E0D5] flex justify-end gap-3 font-['JetBrains_Mono']">
          <button type="button" onclick="closeEditComboModal()" class="btn-editorial-secondary px-4 py-2">Hủy</button>
          <button type="submit" class="btn-editorial-primary px-5 py-2">Cập Nhật</button>
        </div>
      </form>
    </div>
  </div>

</main>

<script>
  function openAddComboModal() {
    document.getElementById('addComboModal').classList.remove('hidden');
  }
  function closeAddComboModal() {
    document.getElementById('addComboModal').classList.add('hidden');
  }

  function openEditComboModal(item) {
    document.getElementById('editComboForm').action = '/admin/combo/sua/' + item._id;
    document.getElementById('edit_name').value = item.name || '';
    document.getElementById('edit_category').value = item.category || 'combo';
    document.getElementById('edit_price').value = item.price || 0;
    document.getElementById('edit_originalPrice').value = item.originalPrice || '';
    document.getElementById('edit_badge').value = item.badge || '';
    document.getElementById('edit_imageUrl').value = item.imageUrl || '';
    document.getElementById('edit_flavors').value = (item.flavors && Array.isArray(item.flavors)) ? item.flavors.join(', ') : '';
    document.getElementById('edit_description').value = item.description || '';
    document.getElementById('editComboModal').classList.remove('hidden');
  }
  function closeEditComboModal() {
    document.getElementById('editComboModal').classList.add('hidden');
  }
</script>

<%- include('partials/admin-footer') %>
